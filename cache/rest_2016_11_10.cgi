a, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>vancouverpetunia, on 10 August 2016 - 02:42 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"287511\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='https:\/\/www.bestdestinationwedding.com\/user\/287511-johnsonspartyof2\/' title='Member profile'><span itemprop=\"name\">Johnsonspartyof2<\/span><\/a> We rented the sound system and some decor from <a href='https:\/\/www.facebook.com\/loveandlacedecor\/' class='bbc_url' title='External link' rel='nofollow external'>Love & Lace Wedding Decor<\/a>. Unfortunately I don't think she is renting to Now Sapphire brides any longer. But worth asking and maybe things will change by 2018.<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"281283\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='https:\/\/www.bestdestinationwedding.com\/user\/281283-vancouverpetunia\/' title='Member profile'><span itemprop=\"name\">vancouverpetunia<\/span><\/a> Okay thank you ill give it a try.\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p style=\"text-align:center;\"><span style=\"color:#ffa07a;\"><span style=\"font-size:18px;\"><span style=\"font-family:georgia, serif;\">#ProjectDreamWedding On A Journey To Our Dream Wedding!\u00a0 <img src='https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0<\/span><\/span><\/span>","Email":"johnsonspartyof2@gmail.com","IpAddress":"162.239.253.193","GroupId":39,"GroupName":"Newbie","JoinDate":1470347711,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-287511.jpg?_r=1470362394","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"Johnsonspartyof2","Id":287511,"Name":"Johnsonspartyof2","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"162.239.253.193","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80227,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b83728151018b5b11392fe5162c04b95","RawContent":"&lt;p&gt;@[member=\"vancouverpetunia\"] I sent her a message..... now to wait for a response, fingers crossed! If you don&#039;t mind me asking, was your gazebo included in your Divine Package?&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1915278,"PostDate":1470933437,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"281283\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='https:\/\/www.bestdestinationwedding.com\/user\/281283-vancouverpetunia\/' title='Member profile'><span itemprop=\"name\">vancouverpetunia<\/span><\/a> I sent her a message..... now to wait for a response, fingers crossed! If you don't mind me asking, was your gazebo included in your Divine Package?\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p style=\"text-align:center;\"><span style=\"color:#ffa07a;\"><span style=\"font-size:18px;\"><span style=\"font-family:georgia, serif;\">#ProjectDreamWedding On A Journey To Our Dream Wedding!\u00a0 <img src='https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0<\/span><\/span><\/span>","Email":"johnsonspartyof2@gmail.com","IpAddress":"162.239.253.193","GroupId":39,"GroupName":"Newbie","JoinDate":1470347711,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-287511.jpg?_r=1470362394","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"Johnsonspartyof2","Id":287511,"Name":"Johnsonspartyof2","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"199.196.6.100","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80227,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8c7365ebe2679341e8908fddbc4bb58c","RawContent":"&lt;p&gt;@[member=\"Johnsonspartyof2\"] We had the \"arch\" with white draping (on the beach) included in our Divine package. Also the white aisle runner.&lt;\/p&gt;","Attachments":[],"Id":1915399,"PostDate":1471876815,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"287511\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='https:\/\/www.bestdestinationwedding.com\/user\/287511-johnsonspartyof2\/' title='Member profile'><span itemprop=\"name\">Johnsonspartyof2<\/span><\/a> We had the \"arch\" with white draping (on the beach) included in our Divine package. Also the white aisle runner.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>- Erin<\/p>\n<p>\u00a0<\/p>\n<p>My planning thread:\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79068-vancouverpetunia-now-sapphire-april-7-2016\/?p=1893268'>http:\/\/www.bestdestinationwedding.com\/topic\/79068-vancouverpetunia-now-sapphire-april-7-2016\/?p=1893268<\/a><\/p>\n<p>\u00a0<\/p>\n<p>My Now Sapphire review:\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/5487-now-sapphire-riviera-cancun\/'>http:\/\/www.bestdestinationwedding.com\/reviews\/r\/5487-now-sapphire-riviera-cancun\/<\/a>","Email":"ekjzwedding@gmail.com","IpAddress":"24.85.127.174","GroupId":3,"GroupName":"Member","JoinDate":1417435045,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-281283.jpg?_r=1428779369","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"vancouverpetunia","Id":281283,"Name":"vancouverpetunia","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"187.153.91.75","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80227,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ee63b3ad8a035027a6e1b385a98ebeb0","RawContent":"&lt;p&gt;Hi @[member=\"Johnsonspartyof2\"]!&lt;\/p&gt;\n&lt;p&gt;Congratulations!!&lt;\/p&gt;\n&lt;p&gt;Now Sapphire your best choice :)&lt;\/p&gt;\n&lt;p&gt;The food, the \"exclusive\" service, the WC staff, everything is awesome there, they really now their job.&lt;\/p&gt;\n&lt;p&gt;As a suggestion, ask for the Tequila Terrace for the reception and your ceremony at the beach, your pictures there are going to be lovely.&lt;\/p&gt;\n&lt;p&gt;Don\u00b4t worry it\u00b4s a rainy day, they have some really good back up plans, everything is cover.&lt;\/p&gt;\n&lt;p&gt;As i told you, your pictures there are going to be awesome there and you may be want to treasure your BIG DAY, let me show you some of my photography job right there at Now Sapphire, you are going to love it.&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/gonzalonunez.com&#039;&gt;http:\/\/gonzalonunez.com&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"http:\/\/www.gonzalonunez.com\/wp-content\/uploads\/2016\/02\/now-sapphire-wedding-photography-08.jpg\" alt=\"now-sapphire-wedding-photography-08.jpg\"&gt;&lt;img src=\"http:\/\/www.gonzalonunez.com\/wp-content\/uploads\/2016\/02\/now-sapphire-wedding-photography-10.jpg\" alt=\"now-sapphire-wedding-photography-10.jpg\"&gt;&lt;\/p&gt;","Attachments":[],"Id":1916519,"PostDate":1476921196,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi @<a hovercard-ref=\"member\" hovercard-id=\"287511\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='https:\/\/www.bestdestinationwedding.com\/user\/287511-johnsonspartyof2\/' title='Member profile'><span itemprop=\"name\">Johnsonspartyof2<\/span><\/a>!<\/p>\n<p>Congratulations!!<\/p>\n<p>Now Sapphire your best choice <img src='https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>The food, the \"exclusive\" service, the WC staff, everything is awesome there, they really now their job.<\/p>\n<p>As a suggestion, ask for the Tequila Terrace for the reception and your ceremony at the beach, your pictures there are going to be lovely.<\/p>\n<p>Don\u00b4t worry it\u00b4s a rainy day, they have some really good back up plans, everything is cover.<\/p>\n<p>As i told you, your pictures there are going to be awesome there and you may be want to treasure your BIG DAY, let me show you some of my photography job right there at Now Sapphire, you are going to love it.<\/p>\n<p><a href='http:\/\/gonzalonunez.com' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/gonzalonunez.com<\/a><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/www.gonzalonunez.com\/wp-content\/uploads\/2016\/02\/now-sapphire-wedding-photography-08.jpg\" alt=\"now-sapphire-wedding-photography-08.jpg\"><\/span><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/www.gonzalonunez.com\/wp-content\/uploads\/2016\/02\/now-sapphire-wedding-photography-10.jpg\" alt=\"now-sapphire-wedding-photography-10.jpg\"><\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<img src='http:\/\/www.gonzalonunez.com\/BDW\/firma.jpg' alt='Posted Image' class='bbc_img' \/><br \/>\n<br \/>\nGonzalo Nunez - WEDDING PHOTOGRAPHER - <a class='bbc_url' href='http:\/\/www.gonzalonunez.com'>www.gonzalonunez.com<\/a> - <a class='bbc_url' href='http:\/\/www.facebook.com\/GonzaloNunezWeddingPhotographer'>Facebook Fanpage<\/a><br \/>\nCancun, Playa del Carmen, Tulum, Riviera Maya, Mexico, rest of the world.","Email":"info@gonzalonunez.com","IpAddress":"187.179.168.180","GroupId":49,"GroupName":"Insiders","JoinDate":1282067479,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-231467.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"gonzaloNunez","Id":231467,"Name":"gonzaloNunez","IsOnline":false}}],"Id":"80227","Title":"New Bride! Now Sapphire 2018 Wedding","LastPostDate":1476921196},"Pages":{"TotalItems":15,"TotalPages":2,"CurrentPage":10,"NextPage":-1,"PreviousPage":0,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
