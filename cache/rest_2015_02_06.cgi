roupId":39,"GroupName":"Newbie","JoinDate":1421669544,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Reh0629","Id":281791,"Name":"Reh0629","IsOnline":false}},"Posts":[],"Id":"78722","Title":"Secrets Punta Cana","LastPostDate":1423066444},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":true,"CanReply":true,"CanFollow":true,"TotalPosts":10,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":574,"MovedTo":null,"MovedOn":0,"FirstPostId":1858352,"Rating":0,"RatingHits":0,"Starter":{"Id":277478,"Name":"Ella2015","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277478.png?_r=1396657918","PhotoWidth":200,"PhotoHeight":196,"PhotoType":"custom"},"IsOnline":false},"StartDate":1404632424,"LastPoster":{"Id":279087,"Name":"Msmimi","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1885141,"PostDate":1422999745,"PostContent":"\u00a0 \u00a0 \u00a0 \u00a0 My fiance and I are getting married at Flora Farms in December. \u00a0We had first decided to...","Author":{"Signature":"","Email":"jenna.l.stingley@gmail.com","IpAddress":"50.183.155.59","GroupId":39,"GroupName":"Newbie","JoinDate":1422999218,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"JennaS","Id":281992,"Name":"JennaS","IsOnline":false}},"Posts":[],"Id":"77481","Title":"Cabo Surf Hotel Brides - 2014\/2015","LastPostDate":1423064418}],"Pages":{"TotalItems":13889,"TotalPages":926,"CurrentPage":0,"NextPage":15,"PreviousPage":-1,"LastPage":13875},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
