array (
  'pid' => '1232341',
  'post' => '<div style="margin:20px; margin-top:5px; "> <div class="smallfont" style="margin-bottom:2px">Quote:</div> <table cellpadding="6" cellspacing="0" border="0" width="99%"> <tr> <td class="alt2" style="border:1px inset">  Originally Posted by <strong>redsoxgurl28</strong> <a data-ipb=\'nomediaparse\' href="/forum/post/1375887"><img class="inlineimg" src="/img/forum/go_quote.gif" border="0" alt="View Post"></a>  <div style="font-style:italic">Hi Everyone,<br /> <br /> My name is Elizabeth and I just recently got engaged. We\'re considering a destination wedding on a budget. <br /> <br /> We haven\'t officially set a date yet, but hoping May-June 2011 in Riviera Maya. Please feel free to recommend your resort for weddings!<br /> <br /> I loved Dreams Riviera Cancun, but it was a bit pricey. I\'ve asked our TA to price out a trip for the resort, so I\'m keeping my fingers crosed.</div> </td> </tr> </table> </div>you\'ll get a far better deal if you go with <a data-ipb=\'nomediaparse\' href="http://www.destinationweddings.com">Wedding Destinations and Planning | Destination Weddings .com</a><br /> It\'s 50bucks you get gr8 perks and they\'ll handle all the room and flight bookings for you and your guests!!<img src="http://files.bestdestinationwedding.com/images/smilies/thewave.gif" border="0" alt="" title="Thewave" class="inlineimg" />',
)
