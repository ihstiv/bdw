array (
  'pid' => '1232383',
  'post' => '<div style="margin:20px; margin-top:5px; "> <div class="smallfont" style="margin-bottom:2px">Quote:</div> <table cellpadding="6" cellspacing="0" border="0" width="99%"> <tr> <td class="alt2" style="border:1px inset">  Originally Posted by <strong>DanielleNDerek</strong> <a data-ipb=\'nomediaparse\' href="/forum/post/1376116"><img class="inlineimg" src="/img/forum/go_quote.gif" border="0" alt="View Post"></a>  <div style="font-style:italic">Carly if no one wants it let me know. Both my SIL\'s are prego and i can ask them if they want it and i\'ll buy it from her for them. <br /> <br /> <strong>Lizz (AKA the stroller whisperer) </strong>maybe you should just take it and keep it just in case Drew starts like a stroller again.</div> </td> </tr> </table> </div>LOL!<br /> <br /> <div style="margin:20px; margin-top:5px; "> <div class="smallfont" style="margin-bottom:2px">Quote:</div> <table cellpadding="6" cellspacing="0" border="0" width="99%"> <tr> <td class="alt2" style="border:1px inset">  Originally Posted by <strong>Christine</strong> <a data-ipb=\'nomediaparse\' href="/forum/post/1376860"><img class="inlineimg" src="/img/forum/go_quote.gif" border="0" alt="View Post"></a>  <div style="font-style:italic">Lizz I talked to Tammy about the older kid stroller thing the other nit and she said Jack wants the stroller a lot more now because if tyler\'s in he wants to be in, she said they use their double more than she thought she would</div> </td> </tr> </table> </div>Makes total sense. Thanks!',
)
--------------------------------------------------------------------------------
