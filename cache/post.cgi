> 
array (
  'pid' => '1234694',
  'post' => '<p> <br /> <br /> &nbsp;</p> <blockquote class="ipsBlockquote">Originally Posted by <strong>lorithornton</strong>&nbsp;<a data-ipb=\'nomediaparse\' href="/forum/thread/58913/date-confirmed-april-15th-2011-bahia-principe-punta-cana-domincian-republic/30#post_1376313"><img alt="View Post" class="inlineimg" src="/img/forum/go_quote.gif" style="border-bottom: 0px solid; border-left: 0px solid; border-top: 0px solid; border-right: 0px solid" /></a><br /> <br /> <div style="margin: 5px 20px 20px"> <div class="smallfont" style="margin-bottom: 2px"> Quote:</div> <table border="0" cellpadding="6" cellspacing="0" width="99%"> <tbody> <tr> <td class="alt2" style="border-bottom: 1px inset; border-left: 1px inset; border-top: 1px inset; border-right: 1px inset">  Originally Posted by <strong>EllyCifuentes</strong> <a data-ipb=\'nomediaparse\' href="/forum/post/1375176"><img alt="View Post" border="0" class="inlineimg" src="/img/forum/go_quote.gif" /></a> <div style="font-style: italic"> Hii!!<br /> <br /> Im currently looking into booking my wedding at the Gran Bahia but have not heard from anyone or gotten any information. I&#39;m gertting so frustrated and I haven&#39;t even booked the place yet. Do you think you could forward that information to me<img alt="" border="0" class="inlineimg" src="http://files.bestdestinationwedding.com/images/smilies/huh.gif" title="Huh" /> I would appreciate it forever :)<br /> <br /> Lost and confused,<br /> Elizabeth</div> </td> </tr> </tbody> </table> </div> ME TOO! I havent heard anything and this is my #1 choice..If I dont get something from them soon, Im going to change my location. If you dont mind can you send me the information as well?</blockquote> <p> <br /> <br /> here is the email address i use to be in touch with my WC. try sending an email saying your interested in getting married there. She should reply. I have been back and forth with my WC a lot lately. She isnt the lady I will be sitting with once i get to the resort, she currently just builds your file till you get there. I have been in touch with her to let her know what colours i am wanting to do, food, pics ect.</p>',
)
--------------------------------------------------------------------------------
