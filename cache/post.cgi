array (
  'pid' => '1304621',
  'post' => '<p> <br /> &nbsp;</p> <blockquote class="ipsBlockquote">Originally Posted by <strong>Mrs D To Be!</strong>&nbsp;<a data-ipb=\'nomediaparse\' href="/forum/thread/22650/post-pics-of-your-wedding-cake/10#post_430528"><img alt="View Post" class="inlineimg" src="/img/forum/go_quote.gif" style="border: 0px solid ;" /></a><br /> <br /> <div style="margin: 5px 20px 20px;"> <div class="smallfont" style="margin-bottom: 2px;"> Quote:</div> <table border="0" cellpadding="6" cellspacing="0" width="99%"> <tbody> <tr> <td class="alt2" style="border: 1px inset ;">  Originally Posted by <strong>TammyB</strong> <a data-ipb=\'nomediaparse\' href="/forum/post/423031"><img alt="View Post" border="0" class="inlineimg" src="/img/forum/go_quote.gif" /></a> <div style="font-style: italic;"> We had individual wedding cakes at our wedding.<br /> <br /> <a data-ipb=\'nomediaparse\' href="http://i90.photobucket.com/albums/k265/Tammy74_2006/myweddingcake.jpg"><img alt="Click the image to open in full size." border="0" class="tcattdimgresizer" src="http://i90.photobucket.com/albums/k265/Tammy74_2006/myweddingcake.jpg" /></a></div> </td> </tr> </tbody> </table> </div> OMG!!! these are amazing!!!<br /> <br /> where did you get these from? were they expensive? i want them now!! :)<br /> <br /> xxxxxx</blockquote> <p> <br /> These are so cute!!!</p>',
)
