array (
  'pid' => '1585519',
  'post' => '<p> I know!!! It is hilarious what we put ourselves through.<br /> &nbsp;</p> <blockquote class="ipsBlockquote">Originally Posted by <strong>meldal101010</strong>&nbsp;<a data-ipb=\'nomediaparse\' href="/t/58053/body-wraps-has-anyone-tried-these-thoughts/10#post_1276637"><img alt="View Post" class="inlineimg" src="/img/forum/go_quote.gif" /></a><br /> <br /> <div style="margin:20px; margin-top:5px; "> <div class="smallfont" style="margin-bottom:2px"> Quote:</div> <table border="0" cellpadding="6" cellspacing="0" width="99%"> <tbody> <tr> <td class="alt2" style="border:1px inset">  Originally Posted by <strong>Sapphire723</strong> <a data-ipb=\'nomediaparse\' href="/forum/post/1262120"><img alt="View Post" border="0" class="inlineimg" src="/img/forum/go_quote.gif" /></a> <div style="font-style:italic"> I\'ve had seaweed body wraps before. Personally, I like being wrapped in tin foil and left under a heat lamp to bake like a potato. I felt comfy and warm!</div> </td> </tr> </tbody> </table> </div> hahahaha...the things we girls go through. I just thought...imagine if our FIs had a forum like this &amp; talked about wrapping in tinfoil &amp; baking like a potato...sorry...i just giggled at your comment &amp; had to respond...lol</blockquote> <br /> <br /> <p> &nbsp;</p>',
)
