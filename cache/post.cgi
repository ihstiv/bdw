array (
  'pid' => '1251809',
  'post' => '<br /> <br /> <blockquote class="ipsBlockquote">Originally Posted by <strong>Jennybell1</strong>&nbsp;<a data-ipb=\'nomediaparse\' href="/forum/thread/55534/any-2012-bride-grooms-to-be-out-there/50#post_1317849"><img alt="View Post" class="inlineimg" src="/img/forum/go_quote.gif" style="border-bottom: 0px solid; border-left: 0px solid; border-top: 0px solid; border-right: 0px solid" /></a><br /> <br /> <div style="margin: 5px 20px 20px"> <div class="smallfont" style="margin-bottom: 2px"> Quote:</div> <table border="0" cellpadding="6" cellspacing="0" width="99%"> <tbody> <tr> <td class="alt2" style="border-bottom: 1px inset; border-left: 1px inset; border-top: 1px inset; border-right: 1px inset">  Originally Posted by <strong>jealousy88</strong> <a data-ipb=\'nomediaparse\' href="/forum/post/1317544"><img alt="View Post" border="0" class="inlineimg" src="/img/forum/go_quote.gif" /></a> <div style="font-style: italic"> Cute!! Too bad my wedding is in June.</div> </td> </tr> </tbody> </table> </div> I can send you my file and then all you have to do is click on the date and change it to yours? If you want anyways?<br /> THen all you have to do is connect to a printer and print away - they look just fine on regular printer paper too.<br /> <br /> Jenn</blockquote> <p> <br /> <br /> Hi Jenn</p> <p> Â </p> <p> If you don\'t mind could you please send me the file too.</p> <p> Â </p> <p> Thank you x</p>',
)
