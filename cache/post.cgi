array (
  'pid' => '1508363',
  'post' => '<p> <br /> <br /> That\'s such a cute idea!!</p> <blockquote class="ipsBlockquote">Originally Posted by <strong>snoopAsh</strong>&nbsp;<a data-ipb=\'nomediaparse\' href="/t/55498/maracas#post_1182545"><img alt="View Post" class="inlineimg" src="/img/forum/go_quote.gif" style="border-bottom: 0px solid; border-left: 0px solid; border-top: 0px solid; border-right: 0px solid" /></a><br /> <br /> <div style="margin: 5px 20px 20px"> <div class="smallfont" style="margin-bottom: 2px"> Quote:</div> <table border="0" cellpadding="6" cellspacing="0" width="99%"> <tbody> <tr> <td class="alt2" style="border-bottom: 1px inset; border-left: 1px inset; border-top: 1px inset; border-right: 1px inset">  Originally Posted by <strong>carolina24</strong> <a data-ipb=\'nomediaparse\' href="/forum/post/1182381"><img alt="View Post" border="0" class="inlineimg" src="/img/forum/go_quote.gif" /></a> <div style="font-style: italic"> wow great deal!! are you giving these as favors? in the oot bags?</div> </td> </tr> </tbody> </table> </div> They are going to have a tag that says "Shake at the kiss".<br /> <br /> I love them and am very happy with the quality! :) They are big too!</blockquote> <br /> <br /> <p> &nbsp;</p>',
)
