array (
  'pid' => '1232435',
  'post' => '<div style="margin:20px; margin-top:5px; "> <div class="smallfont" style="margin-bottom:2px">Quote:</div> <table cellpadding="6" cellspacing="0" border="0" width="99%"> <tr> <td class="alt2" style="border:1px inset">  Originally Posted by <strong>Margret</strong> <a data-ipb=\'nomediaparse\' href="/forum/post/1376359"><img class="inlineimg" src="/img/forum/go_quote.gif" border="0" alt="View Post"></a>  <div style="font-style:italic">OK Ladies, I kept telling you to wait till August for prices to drop but I could not wait any longer and booked my flights today. We are flying direct from Ottawa to Cancun for 1 week at $1244 per person (taxes all in ). We booked with West Jet for lower taxes and better times for flights. I was aimimg for under $1500 and I am happy with what I got. I booked it through Maritimes Travel. The closest rates I could find online were above $1300 with poor times of travel or flying through Toronto. My advice is to watch the rates online as they change every week. It seems that the sale travels through the country.</div> </td> </tr> </table> </div>Thats a pretty good price!',
)
--------------------------------------------------------------------------------
> Time: 1395962205 / Thu, 27 Mar 2014 23:16:45 +0000
