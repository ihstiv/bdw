array (
  'pid' => '1245956',
  'post' => '<br /> <br /> <blockquote class="ipsBlockquote">Originally Posted by <strong>MysTea</strong>&nbsp;<a data-ipb=\'nomediaparse\' href="/forum/thread/55083/any-brides-from-ny/30#post_1368973"><img alt="View Post" class="inlineimg" src="/img/forum/go_quote.gif" style="border: 0px solid;" /></a><br /> <br /> <div style="margin: 5px 20px 20px;"> <div class="smallfont" style="margin-bottom: 2px;"> Quote:</div> <table border="0" cellpadding="6" cellspacing="0" width="99%"> <tbody> <tr> <td class="alt2" style="border: 1px inset;">  Originally Posted by <strong>Danyelle</strong> <a data-ipb=\'nomediaparse\' href="/forum/post/1366508"><img alt="View Post" border="0" class="inlineimg" src="/img/forum/go_quote.gif" /></a> <div style="font-style: italic;"> Lotsa New Yorkers!!! We should do a Manhattan Meetup!</div> </td> </tr> </tbody> </table> </div> I know!! and Get some drinks!!!!!<img alt="" border="0" class="inlineimg" src="http://files.bestdestinationwedding.com/images/smilies/friday.gif" title="Friday" /></blockquote> <p> &nbsp;</p> <p> DEFINITELY!!!!<br /> &nbsp;</p>',
