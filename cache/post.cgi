array (
  'pid' => '1594453',
  'post' => '<p> <br /> Very cute!&nbsp; I love bright flowers.&nbsp; I\'m hoping to do something similar with my blue dresses :-)<br /> &nbsp;</p> <blockquote class="ipsBlockquote">Originally Posted by <strong>Jacqueline</strong>&nbsp;<a data-ipb=\'nomediaparse\' href="/t/15210/colors-of-flowers#post_255546"><img alt="View Post" class="inlineimg" src="/img/forum/go_quote.gif" /></a><br /> <br /> <div style="margin: 5px 20px 20px;"> <div class="smallfont" style="margin-bottom: 2px;"> Quote:</div> <table border="0" cellpadding="6" cellspacing="0" width="99%"> <tbody> <tr> <td class="alt2" style="border: 1px inset currentColor;">  Originally Posted by <strong>LadyCheese</strong> <a data-ipb=\'nomediaparse\' href="/forum/post/254826"><img alt="View Post" border="0" class="inlineimg" src="/img/forum/go_quote.gif" /></a> <div style="font-style: italic;"> Or maybe something like this...<br /> <a data-ipb=\'nomediaparse\' href="http://angelsaccents.com/clients/17791/1260779_sta.jpg"><img alt="Click the image to open in full size." border="0" class="tcattdimgresizer" src="http://angelsaccents.com/clients/17791/1260779_sta.jpg" /></a></div> </td> </tr> </tbody> </table> </div> I love these, the brightness will look great with the colors of the girls dresses...</blockquote> <br /> <br /> <p> &nbsp;</p>',
)
