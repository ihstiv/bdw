array (
  'pid' => '1296349',
  'post' => '<p> <br /> <br /> That was my favorite part! How nice of them to respond, lol! Great job on everything and congrats!</p> <blockquote class="ipsBlockquote">Originally Posted by <strong>azulskies</strong>&nbsp;<a data-ipb=\'nomediaparse\' href="/forum/thread/59961/azulskies-huge-maui-wedding-planning-thread/10#post_1319072"><img alt="View Post" class="inlineimg" src="/img/forum/go_quote.gif" style="border-bottom: 0px solid; border-left: 0px solid; border-top: 0px solid; border-right: 0px solid" /></a><br /> <br /> Thanks ladies!<br /> <br /> <div style="margin: 5px 20px 20px"> <div class="smallfont" style="margin-bottom: 2px"> Quote:</div> <table border="0" cellpadding="6" cellspacing="0" width="99%"> <tbody> <tr> <td class="alt2" style="border-bottom: 1px inset; border-left: 1px inset; border-top: 1px inset; border-right: 1px inset">  Originally Posted by <strong>JENISE</strong> <a data-ipb=\'nomediaparse\' href="/forum/post/1319002"><img alt="View Post" border="0" class="inlineimg" src="/img/forum/go_quote.gif" /></a> <div style="font-style: italic"> Very detailed. Awesome planning thread. Congrats on everything!<br /> Question: How\'d you get the response card from the White House? :)</div> </td> </tr> </tbody> </table> </div> We sent them an invitation using this address:<br /> The Honorable Barack and Mrs. Obama<br /> The White House<br /> Greetings Office Room 39<br /> 1600 Pennsylvania Avenue<br /> Washington, D.C. 20500<br /> <br /> Hope that helps!</blockquote> <br /> <br />',
)
