array (
  'pid' => '1447307',
  'post' => '<p> <br /> <br /> How can you find where your points are? Not sure what mine are but I\'m sure its low cause I\'m a noob</p> <blockquote class="ipsBlockquote">Originally Posted by <strong>DreaW</strong>&nbsp;<a data-ipb=\'nomediaparse\' href="/forum/thread/12751/junior-member/10#post_266494"><img alt="View Post" class="inlineimg" src="/img/forum/go_quote.gif" style="border-bottom: 0px solid; border-left: 0px solid; border-top: 0px solid; border-right: 0px solid" /></a><br /> <br /> <div style="margin: 5px 20px 20px"> <div class="smallfont" style="margin-bottom: 2px"> Quote:</div> <table border="0" cellpadding="6" cellspacing="0" width="99%"> <tbody> <tr> <td class="alt2" style="border-bottom: 1px inset; border-left: 1px inset; border-top: 1px inset; border-right: 1px inset">  Originally Posted by <strong>Alipires1</strong> <a data-ipb=\'nomediaparse\' href="/forum/post/266485"><img alt="View Post" border="0" class="inlineimg" src="/img/forum/go_quote.gif" /></a> <div style="font-style: italic"> What does play arcades mean?</div> </td> </tr> </tbody> </table> </div> <br /> Play in the arcade.....video games, there is a link above that you can play games and if you get a high score above other scores and you earn points...</blockquote> <br /> <br /> <p> &nbsp;</p>',
)
