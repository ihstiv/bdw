array (
  'pid' => '1244737',
  'post' => '<br /> <br /> <blockquote class="ipsBlockquote">Originally Posted by <strong>jfazzina</strong>&nbsp;<a data-ipb=\'nomediaparse\' href="/forum/thread/47576/dreams-riviera-cancun-brides-post-here-new-thread/1730#post_1203133"><img alt="View Post" class="inlineimg" src="/img/forum/go_quote.gif" style="border-bottom: 0px solid; border-left: 0px solid; border-top: 0px solid; border-right: 0px solid" /></a><br /> <br /> <div style="margin: 5px 20px 20px"> <div class="smallfont" style="margin-bottom: 2px"> Quote:</div> <table border="0" cellpadding="6" cellspacing="0" width="99%"> <tbody> <tr> <td class="alt2" style="border-bottom: 1px inset; border-left: 1px inset; border-top: 1px inset; border-right: 1px inset">  Originally Posted by <strong>Chelsey &amp; Travis</strong> <a data-ipb=\'nomediaparse\' href="/forum/post/1128633"><img alt="View Post" border="0" class="inlineimg" src="/img/forum/go_quote.gif" /></a> <div style="font-style: italic"> Hello! I have just booked our wedding for November 5, 2010 at DRC. I&#39;m just beginning the wedding planning process and obviously have many questions. But mostly I am wondering...does anyone have information on wedding ceremony locations at the resort? Pictures would be extra helpful!</div> </td> </tr> </tbody> </table> </div> Chelsey,<br /> <br /> You will be getting married on the 5th of Nov!! Congrats!!! We will arrive at DRC either on Sunday or Monday the 8th! we are getting married on the 11th... Fill me in... We will have around 90 guests attending... what are your colors??</blockquote> <p> <br /> Hey Jfazzina....I just saw this post!&nbsp; Congrats to you too!&nbsp; We will be there the 1st - 7th.&nbsp; How are your plans coming along?&nbsp; We will have around 40 guests and are doing turquoise and orange for colors.&nbsp; Only three more months <img alt="" height="27" src="http://files.bestdestinationwedding.com/images/smilies/woot.gif" title="" width="42" /><br /> &nbsp;</p>',
)
