array (
  'pid' => '1247005',
  'post' => '<p> <span>Quote:</span></p> <div class="quote-container"> <div class="quote-block"> Originally Posted by <strong>FutureMrsRobart</strong>&nbsp;<a data-ipb=\'nomediaparse\' href="/forum/thread/47576/dreams-riviera-cancun-brides-post-here-new-thread/3670#post_1357949"><img alt="View Post" class="inlineimg" src="/img/forum/go_quote.gif" style="border-bottom: 0px solid; border-left: 0px solid; border-top: 0px solid; border-right: 0px solid" /></a><br /> <br /> <div style="margin: 5px 20px 20px"> <div class="smallfont" style="margin-bottom: 2px"> Quote:</div> <table border="0" cellpadding="6" cellspacing="0" width="99%"> <tbody> <tr> <td class="alt2" style="border-bottom: 1px inset; border-left: 1px inset; border-top: 1px inset; border-right: 1px inset">  Originally Posted by <strong>ursula</strong> <a data-ipb=\'nomediaparse\' href="/forum/post/1357921"><img alt="View Post" border="0" class="inlineimg" src="/img/forum/go_quote.gif" /></a> <div style="font-style: italic"> Lisa, Melissa and Lindsay it looks like we&#39;ll all be there the same week!</div> </td> </tr> </tbody> </table> </div> YAY :-) We arrive at Excellence RIviera April 27th and then switch to DRC on the 4th when our guests arrive. We&#39;ll have to hook up for a little cocktail :-)</div> </div> <p> &nbsp;</p> <p> &nbsp;</p> <p> Great idea!<br /> &nbsp;</p>',
)
