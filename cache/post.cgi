array (
  'pid' => '1596183',
  'post' => '<p> <br /> I 2nd that!!&nbsp; AMAZING cake!!!<br /> &nbsp;</p> <blockquote class="ipsBlockquote">Originally Posted by <strong>trophywife</strong>&nbsp;<a data-ipb=\'nomediaparse\' href="/t/22650/post-pics-of-your-wedding-cake/40#post_551854"><img alt="View Post" class="inlineimg" src="/img/forum/go_quote.gif" /></a><br /> <br /> <div style="margin: 5px 20px 20px"> <div class="smallfont" style="margin-bottom: 2px"> Quote:</div> <table border="0" cellpadding="6" cellspacing="0" width="99%"> <tbody> <tr> <td class="alt2" style="border-bottom: 1px inset; border-left: 1px inset; border-top: 1px inset; border-right: 1px inset">  Originally Posted by <strong>GeminiLibra</strong> <a data-ipb=\'nomediaparse\' href="/forum/post/423159"><img alt="View Post" border="0" class="inlineimg" src="/img/forum/go_quote.gif" /></a> <div style="font-style: italic"> Here is the cake that I want and have been told they can do it but I have to provide the people. Our wedding is on the beach so it\'s perfect for us!<br /> <br /> <a data-ipb=\'nomediaparse\' href="http://i283.photobucket.com/albums/kk296/geminilibra_2008/weddingcake.jpg"><img alt="Click the image to open in full size." border="0" class="tcattdimgresizer" src="http://i283.photobucket.com/albums/kk296/geminilibra_2008/weddingcake.jpg" /></a></div> </td> </tr> </tbody> </table> </div> I LOVE THIS!!!!!!!!</blockquote> <br /> <br /> <p> &nbsp;</p>',
)
