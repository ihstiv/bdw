array (
  'pid' => '1321386',
  'post' => '<br /> <br /> <div class="quote-container"> <div class="quote-block"> <br /> <div style="margin: 5px 20px 20px"> <div class="smallfont" style="margin-bottom: 2px"> Quote:</div> <table border="0" cellpadding="6" cellspacing="0" width="99%"> <tbody> <tr> <td class="alt2" style="border-bottom: 1px inset; border-left: 1px inset; border-top: 1px inset; border-right: 1px inset">  Originally Posted by <strong>edna</strong> <a data-ipb=\'nomediaparse\' href="/forum/post/844186"><img alt="View Post" border="0" class="inlineimg" src="/img/forum/go_quote.gif" /></a> <div style="font-style: italic"> Congrats on the photog, regarding video our WC just gave us two suggestions one is Promovision, which is around 700-1000 they have 2 diff packages and the other one is Arte Fotografico Digital (I don\'t have the recent list)<br /> <br /> I wanted to have either Ricardo from<a data-ipb=\'nomediaparse\' href="http://www.reelove.com/"> Reelove</a> (he was our videog before we moved our date as Fer Juaristi our photog but he was booked now), Armando Orendain from <a data-ipb=\'nomediaparse\' href="http://flashbackwedding.com/">Flashbackwedding</a> or Adrian Olvera from <a data-ipb=\'nomediaparse\' href="http://www.sanjosevideo.com.mx/">San Jose Video</a> ... all of them are located in Monterrey or Reynosa and they can take a flight to PVR , and the costs are much much lower than coming from USA...<br /> <br /> HTH</div> <div style="font-style: italic"> &nbsp;</div> <div style="font-style: italic"> Thanks for all the links, who did you end up going with? What was the pricing around for the linked videographers? Thanks!</div> </td> </tr> </tbody> </table> </div> </div> </div> <br /> <br />',
)
--------------------------------------------------------------------------------
> Time: 1395962206 / Thu, 27 Mar 2014 23:16:46 +0000
> URL: /admin/index.php?adsess=845f6c850772369311b67ecf8645904c&app=forums&module=forums&section=fix&st=158250
> <br /> <br /> <div class="quote-container"> <div class="quote-block"> <br /> <div style="margin: 5px 20px 20px"> <div class="smallfont"> Quote:</div> <table border="0" cellpadding="6" cellspacing="0" width="99%"> <tbody> <tr> <td class="alt2" style="border-bottom: 1px inset; border-left: 1px inset; border-top: 1px inset; border-right: 1px inset">  Originally Posted by <strong>edna</strong> <a data-ipb='nomediaparse' href="/forum/post/844186"><img alt="View Post" border="0" class="inlineimg" src="/img/forum/go_quote.gif" /></a> <div style="font-style: italic"> Congrats on the photog, regarding video our WC just gave us two suggestions one is Promovision, which is around 700-1000 they have 2 diff packages and the other one is Arte Fotografico Digital (I don't have the recent list)<br /> <br /> I wanted to have either Ricardo from<a data-ipb='nomediaparse' href="http://www.reelove.com/"> Reelove</a> (he was our videog before we moved our date as Fer Juaristi our photog but he was booked now), Armando Orendain from <a data-ipb='nomediaparse' href="http://flashbackwedding.com/">Flashbackwedding</a> or Adrian Olvera from <a data-ipb='nomediaparse' href="http://www.sanjosevideo.com.mx/">San Jose Video</a> ... all of them are located in Monterrey or Reynosa and they can take a flight to PVR , and the costs are much much lower than coming from USA...<br /> <br /> HTH</div> <div style="font-style: italic"> &nbsp;</div> <div style="font-style: italic"> Thanks for all the links, who did you end up going with? What was the pricing around for the linked videographers? Thanks!</div> </td> </tr> </tbody> </table> </div> </div> </div> <br /> <br />
--------------------------------------------------------------------------------
