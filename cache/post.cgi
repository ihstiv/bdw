> 
array (
  'pid' => '1486425',
  'post' => '<p> thanks for the link!<br /> &nbsp;</p> <blockquote class="ipsBlockquote">Originally Posted by <strong>JamaicaBrideToBe</strong>&nbsp;<a data-ipb=\'nomediaparse\' href="/forum/thread/33549/parasols#post_628619"><img alt="View Post" class="inlineimg" src="/img/forum/go_quote.gif" style="border: 0px solid;" /></a><br /> <br /> <div style="margin:20px; margin-top:5px; "> <div class="smallfont" style="margin-bottom:2px"> Quote:</div> <table border="0" cellpadding="6" cellspacing="0" width="99%"> <tbody> <tr> <td class="alt2" style="border:1px inset">  Originally Posted by <strong>katedoeseurope</strong> <a data-ipb=\'nomediaparse\' href="/forum/post/628579"><img alt="View Post" border="0" class="inlineimg" src="/img/forum/go_quote.gif" /></a> <div style="font-style:italic"> i think ellipse22 might have meant <a data-ipb=\'nomediaparse\' href="http://www.weddingfavours.ca/pc/3050/coloured+paper+umbrellas.html">sale coloured paper umbrellas - $7.25 - weddingfavours.ca</a> they look super cute and say they ship in 1-2 weeks!</div> </td> </tr> </tbody> </table> </div> <br /> thank you 100x over!!!!! I couldn\'t find them anywhere!!!</blockquote> <br /> <br /> <p> &nbsp;</p>',
)
