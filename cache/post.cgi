array (
  'pid' => '1348885',
  'post' => '<p> <br /> this is really nice!</p> <blockquote class="ipsBlockquote">Originally Posted by <strong>bsf&amp;jpg</strong>&nbsp;<a data-ipb=\'nomediaparse\' href="/forum/thread/56553/post-your-chuppah-pics-and-inspiration-pics/10#post_1221060"><img alt="View Post" class="inlineimg" src="/img/forum/go_quote.gif" style="border: 0px solid;" /></a><br /> <br /> <div style="margin: 5px 20px 20px;"> <div class="smallfont" style="margin-bottom: 2px;"> Quote:</div> <table border="0" cellpadding="6" cellspacing="0" width="99%"> <tbody> <tr> <td class="alt2" style="border: 1px inset;">  Originally Posted by <strong>KarenM</strong> <a data-ipb=\'nomediaparse\' href="/forum/post/1219074"><img alt="View Post" border="0" class="inlineimg" src="/img/forum/go_quote.gif" /></a> <div style="font-style: italic;"> I really like those first 2!<br /> <br /> This is sort of what I\'m going for, but with aqua capiz shells hanging in the back<br /> <a data-ipb=\'nomediaparse\' href="http://i978.photobucket.com/albums/ae264/kmccreary14/canopywithshellcurtain.jpg"><img alt="Click the image to open in full size." border="0" class="tcattdimgresizer" src="http://i978.photobucket.com/albums/ae264/kmccreary14/canopywithshellcurtain.jpg" /></a></div> </td> </tr> </tbody> </table> </div> <br /> WoW! This is dreamy!!! My FI and I love this look!!!<br /> we looked at the website with the aqua beaded curtain, but how many would you need to buy?<br /> Has anyone seen it cheaper elsewhere? $70 is kinda pricey. thx!</blockquote> <br /> <br />',
)
