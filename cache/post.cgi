array (
  'pid' => '1579034',
  'post' => '<p> <br /> <br /> This is so cute</p> <blockquote class="ipsBlockquote">Originally Posted by <strong>LEIGH</strong>&nbsp;<a data-ipb=\'nomediaparse\' href="/t/3635/cup-cakes-instead-of-cake#post_51392"><img alt="View Post" class="inlineimg" src="/img/forum/go_quote.gif" /></a><br /> <br /> <div style="margin: 5px 20px 20px"> <div class="smallfont" style="margin-bottom: 2px"> Quote:</div> <table border="0" cellpadding="6" cellspacing="0" width="99%"> <tbody> <tr> <td class="alt2" style="border-bottom: 1px inset; border-left: 1px inset; border-top: 1px inset; border-right: 1px inset">  Originally Posted by <strong>Lizzy</strong> <a data-ipb=\'nomediaparse\' href="/forum/post/51285"><img alt="View Post" border="0" class="inlineimg" src="/img/forum/go_quote.gif" /></a> <div style="font-style: italic"> Has anyone researched any bakeries that do cupcakes? Maggie wants cupcakes instead of cake, but doesn\'t know where to go from here. Any suggestions?<br /> <br /> Lizzy<img alt="" border="0" class="inlineimg" src="http://files.bestdestinationwedding.com/images/smilies/confused.gif" title="Confused" /></div> </td> </tr> </tbody> </table> </div> Lizzy, I\'m in the same boat with trying to find a bakery.....I\'m trying to find one in the Cancun area..what about you? (sorry, I forgot!)</blockquote> <br /> <br /> <p> &nbsp;</p>',
)
