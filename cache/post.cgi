array (
  'pid' => '1243708',
  'post' => '<p> 6/11/11 at 5 pm!!!<br /> &nbsp;</p> <blockquote class="ipsBlockquote">Originally Posted by <strong>lisadias</strong>&nbsp;<a data-ipb=\'nomediaparse\' href="/forum/thread/57821/the-now-riviera-cancun/170#post_1373044"><img alt="View Post" class="inlineimg" src="/img/forum/go_quote.gif" style="border: 0px solid;" /></a><br /> <br /> <div style="margin:20px; margin-top:5px; "> <div class="smallfont" style="margin-bottom:2px"> Quote:</div> <table border="0" cellpadding="6" cellspacing="0" width="99%"> <tbody> <tr> <td class="alt2" style="border:1px inset">  Originally Posted by <strong>21aholden</strong> <a data-ipb=\'nomediaparse\' href="/forum/post/1372881"><img alt="View Post" border="0" class="inlineimg" src="/img/forum/go_quote.gif" /></a> <div style="font-style:italic"> I thought it would be nice to know when everyone is getting married at NOW Jade. If you want add your names and date in!<br /> <br /> Ashley &amp; Jeremy - 6/16/11</div> </td> </tr> </tbody> </table> </div> Lisa &amp; Jason April 26, 2011</blockquote> <br /> <br />',
