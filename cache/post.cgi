array (
  'pid' => '1249218',
  'post' => '<p> <br /> <br /> <span>Quote:</span></p> <div class="quote-container"> <div class="quote-block"> Originally Posted by <strong>dcairns</strong>&nbsp;<a data-ipb=\'nomediaparse\' href="/forum/thread/39815/dreams-la-romana/1110#post_1348217"><img alt="View Post" class="inlineimg" src="/img/forum/go_quote.gif" style="border-bottom: 0px solid; border-left: 0px solid; border-top: 0px solid; border-right: 0px solid" /></a><br /> <br /> <div style="margin: 5px 20px 20px"> <div class="smallfont" style="margin-bottom: 2px"> Quote:</div> <table border="0" cellpadding="6" cellspacing="0" width="99%"> <tbody> <tr> <td class="alt2" style="border-bottom: 1px inset; border-left: 1px inset; border-top: 1px inset; border-right: 1px inset">  Originally Posted by <strong>MissTaken</strong> <a data-ipb=\'nomediaparse\' href="/forum/post/1324082"><img alt="View Post" border="0" class="inlineimg" src="/img/forum/go_quote.gif" /></a> <div style="font-style: italic"> Hey I&#39;m planning a wedding at Dreams La Romana April 2011 Any advice, ideas, comments, photos etc. would be greatly appreciated!!!! xox</div> </td> </tr> </tbody> </table> </div> Hey there,<br /> <br /> So am I! so far the date is the 11th, how about you?</div> </div> <p> <br /> <br /> Hey,</p> <p> &nbsp;</p> <p> I&#39;m sorry I just noticed this message, I&nbsp;haven&#39;t been on here in a while, our date is April 13 2011 at 4:00pm! :)</p>',
)
