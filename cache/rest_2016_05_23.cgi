t":200,"PhotoType":"custom"},"FormattedName":"vancouverpetunia","Id":281283,"Name":"vancouverpetunia","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.85.127.174","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80088,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c078122a0d758a004330a4e728a4f6ad","RawContent":"&lt;p&gt;&lt;span style=\"color:rgb(29,33,41);font-family:helvetica, arial, sans-serif;\"&gt;Worn once for a few hours, no marks except under toes (see photo). True size 7. Have original box, plus forms and plastic bags for each shoe. Purchased from David&#039;s Bridal for $80 CAD + tax. Asking $40 CAD.&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif;\"&gt;I&#039;m in Vancouver, BC, Canada. If you are local we can arrange to meet for you to try them on. Buyer pays shipping if required.&amp;nbsp;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1913667,"PostDate":1463031557,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><span  style=\"color:rgb(29,33,41);font-family:helvetica, arial, sans-serif\">Worn once for a few hours, no marks except under toes (see photo). True size 7. Have original box, plus forms and plastic bags for each shoe. Purchased from David's Bridal for $80 CAD + tax. Asking $40 CAD.<\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif\">I'm in Vancouver, BC, Canada. If you are local we can arrange to meet for you to try them on. Buyer pays shipping if required.\u00a0<\/span><\/p>\n<p>\u00a0<\/p>\n<p><a class='resized_img' rel='lightbox[1913667]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2016\/post-281283-0-47813500-1463027718.jpg\" title=\"FullSizeRender (12).jpg - Size: 91.13KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2016\/post-281283-0-47813500-1463027718.jpg\" class='bbc_img linked-image' alt=\"FullSizeRender (12).jpg\" \/><\/a>\n\n<\/p>\n<p>\u00a0<\/p>\n<p><a class='resized_img' rel='lightbox[1913667]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2016\/post-281283-0-61172000-1463027779.jpg\" title=\"IMG_2880.JPG - Size: 66.68KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2016\/post-281283-0-61172000-1463027779.jpg\" class='bbc_img linked-image' alt=\"IMG_2880.JPG\" \/><\/a>\n\n<\/p>\n<p>\u00a0<\/p>\n<p><a class='resized_img' rel='lightbox[1913667]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2016\/post-281283-0-92887700-1463027785.jpg\" title=\"IMG_2879.JPG - Size: 73.76KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2016\/post-281283-0-92887700-1463027785.jpg\" class='bbc_img linked-image' alt=\"IMG_2879.JPG\" \/><\/a>\n\n<\/p>\n<p>\u00a0<\/p>\n<p><a class='resized_img' rel='lightbox[1913667]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2016\/post-281283-0-11018600-1463027731.jpg\" title=\"IMG_2881.JPG - Size: 77.06KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2016\/post-281283-0-11018600-1463027731.jpg\" class='bbc_img linked-image' alt=\"IMG_2881.JPG\" \/><\/a>\n\n<\/p>\n<p>\u00a0<\/p>\n<p><a class='resized_img' rel='lightbox[1913667]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2016\/post-281283-0-55735100-1463027724.jpg\" title=\"IMG_2882.JPG - Size: 82.32KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2016\/post-281283-0-55735100-1463027724.jpg\" class='bbc_img linked-image' alt=\"IMG_2882.JPG\" \/><\/a>\n\n<\/p>\n<p>\u00a0<\/p>\n<p><a class='resized_img' rel='lightbox[1913667]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2016\/post-281283-0-32411000-1463027926.jpg\" title=\"IMG_2883.JPG - Size: 67.62KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2016\/post-281283-0-32411000-1463027926.jpg\" class='bbc_img linked-image' alt=\"IMG_2883.JPG\" \/><\/a>\n\n<\/p>\n<p>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>- Erin<\/p>\n<p>\u00a0<\/p>\n<p>My planning thread:\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79068-vancouverpetunia-now-sapphire-april-7-2016\/?p=1893268'>http:\/\/www.bestdestinationwedding.com\/topic\/79068-vancouverpetunia-now-sapphire-april-7-2016\/?p=1893268<\/a><\/p>\n<p>\u00a0<\/p>\n<p>My Now Sapphire review:\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/5487-now-sapphire-riviera-cancun\/'>http:\/\/www.bestdestinationwedding.com\/reviews\/r\/5487-now-sapphire-riviera-cancun\/<\/a>","Email":"ekjzwedding@gmail.com","IpAddress":"24.85.127.174","GroupId":3,"GroupName":"Member","JoinDate":1417453045,"Photo":{"HasPhoto":true,"PhotoUr