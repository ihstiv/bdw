mily: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Someone I know recently did this and it literally looked like a wedding before her wedding, it was confusing... just make sure that you plan properly and do what you're envisioning. If you do, I say either way is fine!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lauramthistle@gmail.com","IpAddress":"24.34.236.241","GroupId":40,"GroupName":"Jr. Member","JoinDate":1391624556,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276518.jpg?_r=1394639305","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"LauraM","Id":276518,"Name":"LauraM","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.177.38.169","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77421,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"82a2d1853d9ada6f5dee35318d414e0b","RawContent":"&lt;p&gt;No rules! Neat idea having it before :D&lt;\/p&gt;","Attachments":[],"Id":1868791,"PostDate":1408991410,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>No rules! Neat idea having it before <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/biggrin.png' class='bbc_emoticon' alt=':D' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div><a class='bbc_url' href='http:\/\/www.TickerFactory.com\/'><\/div>\n<div><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;0;6\/st\/20150314\/e\/Our+Wedding\/k\/c1c3\/event.png\" alt=\"event.png\"><\/div>\n<div><\/a><\/div>\n","Email":"tiffmedeiros@gmail.com","IpAddress":"50.177.38.169","GroupId":40,"GroupName":"Jr. Member","JoinDate":1361741426,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-266526.jpg?_r=1427840086","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"MrsCtoB","Id":266526,"Name":"MrsCtoB","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"206.223.185.220","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77421,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"950ef0c7b7b298b9e9960dc061ced327","RawContent":"&lt;p&gt;But how do you do the wedding stuff if you aren&#039;t already married? Or do you mean to get married at home first, have a reception then leave for your DW and get married again?&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Just call me dazed and confused......&lt;\/p&gt;","Attachments":[],"Id":1868804,"PostDate":1408994227,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>But how do you do the wedding stuff if you aren't already married? Or do you mean to get married at home first, ha