emoticons\/default\/wub.png' class='bbc_emoticon' alt=':wub:' \/><\/p>\n<p>\u00a0","Email":"sadiekirby93@gmail.com","IpAddress":"99.227.229.218","GroupId":39,"GroupName":"Newbie","JoinDate":1436787422,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-283939.jpg?_r=1438893746","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"sadiekirby93","Id":283939,"Name":"sadiekirby93","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.241.131.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79480,"EditedBy":"<strong>Edited by perianjay, 10 August 2015 - 03:19 PM.<\/strong>","EditDate":1439219945,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f33f9e1cca3ae837224ecbaf4b012a0d","RawContent":"&lt;p&gt;@[member=\"sadiekirby93\"] What size are you? I&#039;m located in Markham\/Toronto and I have a dress for sale. No beading though.. it is all lace, but it&#039;s a stunning gown and you could always add a beaded belt.&lt;\/p&gt;","Attachments":[],"Id":1902239,"PostDate":1439219923,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"283939\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/283939-sadiekirby93\/' title='Member profile'><span itemprop=\"name\">sadiekirby93<\/span><\/a> What size are you? I'm located in Markham\/Toronto and I have a dress for sale. No beading though.. it is all lace, but it's a stunning gown and you could always add a beaded belt.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;1\/st\/20151215\/e\/Our+Wedding\/k\/ec4b\/event.png\" alt=\"event.png\"><\/a><br><br><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":42,"GroupName":"Sr. Member","JoinDate":1419423414,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1436293677","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"115.118.164.37","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79480,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b14acd31d5b9037eebca1ee44d4336a3","RawContent":"&lt;p&gt;Hello,&lt;\/p&gt;\n&lt;p&gt;I think instead of buying a used wedding dress, you should buy a new one. You can buy it from shoppersfeed at reasonable price.&lt;\/p&gt;","Attachments":[],"Id":1903038,"PostDate":1440144636,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello,<\/p>\n<p>I think instead of buying a used wedding dress, you should buy a new one. You can buy it from shoppersfeed at reasonable price.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"\n\t\t\t\t<a data-ipb='nomediaparse' href='https:\/\/www.shoppersfeed.com\/short-bridesmaid-dresses'>Turquoise bridesmaid dresses<\/a>\n\t\t<p>\u00a0","Email":"rayforlisa@gmail.com","IpAddress":"115.118.164.37","GroupId":39,"GroupName":"Newbie","JoinDate":1440141254,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"lisaray12","Id":284515,"Name":"lisaray12","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"209.171.88.10","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79480,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"2d6a72042750be3e997caeefc59ba14b","RawContent":"@[member=\"sadiekirby93\"]\n\nIt would be helpful to have your dress size and height. As well the same for your bridesmaid so people will know if that have something that may fit. Also have you tried the Brides Project on Broadview ave they sell used, as well as new discontinued stock from dress boutiques at a crazy discounted price.\n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1903115,"PostDate":1440284198,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"283939\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/283939-sadiekirby93\/' title='Member profile'><span itemprop=\"name\">sadiekirby93<\/span><\/a><br>\nIt would be helpful to have your dress size and height. As well the same for your bridesmaid so people will know if that have something that may fit. Also have you tried the Brides Project on Broadview ave they sell used, as well as new discontinued stock from dress boutiques at a crazy discounted price.<br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div>\u00a0<\/div>\n<div><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78914-meandhim-grand-palladium-bavaro-nov-2015\/'>My Planning Thread<\/a>\u00a0- MeandHim - Grand Palladium Bavaro - Nov 25 2015<\/div>\n<div>\u00a0<\/div>\n<div><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10765;116\/st\/20151125\/e\/Our+Wedding\/k\/461e\/event.png\" alt=\"event.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"markandshavonne@live.com","IpAddress":"70.30.85.211","GroupId":3,"GroupName":"Member","JoinDate":1365777659,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-268499.jpg?_r=1395417550","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"Meandhim","Id":268499,"Name":"Meandhim","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"72.192.215.113","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79480,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f57d8546f123a8252f1a0fbeae76d4ed","RawContent":"Hi\n\n\nI have a dress for sale! It&#039;s Kitty Chen Florence. Size 6 which fits 0-8 bc it&#039;s corset. It looks great with a belt and is light for traveling. \n\n\n\n&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.preownedweddingdresses.com\/dresses\/view\/148140&#039;&gt;https:\/\/www.preownedweddingdresses.com\/dresses\/view\/148140&lt;\/a&gt;","Attachments":[],"Id":1903124,"PostDate":1440325644,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi<br><br>\nI have a dress for sale! It's Kitty Chen Florence. Size 6 which fits 0-8 bc it's corset. It looks great with a belt and is light for traveling. <br><br><br>\n<a href='https:\/\/www.preownedweddingdresses.com\/dresses\/view\/148140' class='bbc_url' title='External link' rel='nofollow external'>https:\/\/www.preowned...ses\/view\/148140<\/a>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"Amaqt03@hotmail.com","IpAddress":"98.169.122.6","GroupId":39,"GroupName":"Newbie","JoinDate":1352496105,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-262240.jpg?_r=1421980656","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"MissAmber26","Id":262240,"Name":"MissAmber26","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.52.93.100","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79480,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5027a1eeee5afceb385208c2693d6882","RawContent":"&lt;p&gt;I am selling my wedding dress, it is an Allure mermaid style size 14, however I did get it altered. It is ivory I have many pics if interested. email me at svazquez309@[member=\"gmail\"].com&lt;\/p&gt;","Attachments":[],"Id":1904864,"PostDate":1442407224,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I am selling my wedding dress, it is an Allure mermaid style size 14, however I did get it altered. It is ivory I have many pics if interested. email me at svazquez309@<a hovercard-ref=\"member\" hovercard-id=\"219734\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/219734-gmail\/' title='Member profile'><span itemprop=\"name\">gmail<\/span><\/a>.com<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"svazquez309@gmail.com","IpAddress":"108.29.64.103","GroupId":39,"GroupName":"Newbie","JoinDate":1365951748,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Slaughter2be","Id":268563,"Name":"Slaughter2be","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"87.149.190.66","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79480,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0301e2dc9a4484977df8f96a7dcaac27","RawContent":"&lt;p&gt;Do you have all your gifts sorted out too? I bought all the kids at my wedding a little something to say thanks for coming to the big day.&lt;\/p&gt;\n&lt;p&gt;I got them some school bagpacks from &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.ergobag.com\/school-backpacks&#039;&gt;here. &lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;But it can be anything really, just giving you an idea :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;GOOD LUCK!&lt;\/p&gt;","Attachments":[],"Id":1905312,"PostDate":1443072271,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Do you have all your gifts sorted out too? I bought all the kids at my wedding a little something to say thanks for coming to the big day.<\/p>\n<p>I got them some school bagpacks from <a href='http:\/\/www.ergobag.com\/school-backpacks' class='bbc_url' title='External link' rel='nofollow external'>here. <\/a><\/p>\n<p>But it can be anything really, just giving you an idea <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>GOOD LUCK!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jammyandy89@outlook.de","IpAddress":"87.149.190.66","GroupId":39,"GroupName":"Newbie","JoinDate":1442996900,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"IggyPop","Id":284905,"Name":"IggyPop","IsOnline":false}}],"Id":"79480","Title":"Wedding Dresses For Sale!","LastPostDate":1443072271},"Pages":{"TotalItems":7,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
