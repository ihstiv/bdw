{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":14,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":267,"MovedTo":null,"MovedOn":0,"FirstPostId":1892542,"Rating":0,"RatingHits":0,"Starter":{"Id":282681,"Name":"Shaylala","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":true},"StartDate":1428627152,"LastPoster":{"Id":282681,"Name":"Shaylala","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":true},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":0,"PostDate":0,"PostContent":"","Author":{"Signature":"","Email":"","IpAddress":"","GroupId":0,"GroupName":"","JoinDate":0,"Photo":{"HasPhoto":false,"PhotoUrl":null,"PhotoWidth":0,"PhotoHeight":0,"PhotoType":""},"FormattedName":"","Id":0,"Name":"","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.73.72.212","IsFirstPost":false,"IsQueued":false,"IsVisible":false,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":false,"TopicId":79042,"EditedBy":null,"EditDate":0,"EditReason":null,"DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"772f2e72962e023d89e8cbb4661e2221","RawContent":"","Attachments":[],"Id":1892783,"PostDate":1428770626,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>babygirl99, on Today, 08:19 AM, said:<\/p><div class='blockquote'><div class='quote'><p><p>It really depends where you are flying from and where you are going and when. Mexico is cheaper than Dominican. Our TA found us the best rates in April. We got $1550 for Now Jade (5 star Riviera Maya) in April 2016 from Edmonton and Calgary. Our Toronto prices are around 1200. If you are still looking you can give my TA a try, she was able to have quotes for us within about 15-30 minutes. mbaugh@<a hovercard-ref=\"member\" hovercard-id=\"245705\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/245705-baconkotravels\/' title='Member profile'><span itemprop=\"name\">baconkotravels<\/span><\/a>.com<\/p><\/p><\/div><\/div>\n<br><br><br>\nBabygirl99 thank you!<br \/><p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>babygirl99, on Today, 08:19 AM, said:<\/p><div class='blockquote'><div class='quote'><p><p>It really depends where you are flying from and where you are going and when. Mexico is cheaper than Dominican. Our TA found us the best rates in April. We got $1550 for Now Jade (5 star Riviera Maya) in April 2016 from Edmonton and Calgary. Our Toronto prices are around 1200. If you are still looking you can give my TA a try, she was able to have quotes for us within about 15-30 minutes. mbaugh@<a hovercard-ref=\"member\" hovercard-id=\"245705\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/245705-baconkotravels\/' title='Member profile'><span itemprop=\"name\">baconkotravels<\/span><\/a>.com<\/p><\/p><\/div><\/div>\n<br><br><br>\nbabygirl99 I actually just got a quote for Now Jade for first week of May 2016 and it came back at $2100 with taxes!!! Is your $1550 including taxes??  If so that is amazing!!!<br>\nIs your TA out of Calgary?<br>\nThank you so much!! \ud83d\ude04\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"shayla.mcmahon@shaw.ca","IpAddress":"70.73.72.212","GroupId":39,"GroupName":"Newbie","JoinDate":1428547145,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Shaylala","Id":282681,"Name":"Shaylala","IsOnline":true}}],"Id":"79042","Title":"Cost For Guests","LastPostDate":1428770626},"Pages":null,"PushNotifications":[{"Key":"notifications","Value":3,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
