{"Success":true,"Data":[{"Title":"","Fields":[{"Label":"","Value":"<div>Photographing Once in a Lifetime Moments is Our Passion\u2026<\/div>\n<div>\u00a0<\/div>\n<div>We are Jasmin & Matt, Canadian destination wedding photographers born and raised in Winnipeg, Manitoba. We discovered our love of wedding photography in Montreal and now live and work in Playa del Carmen, Mexico capturing beautiful stories of couples in love, families, friends and the incredible and inspiring world we are so lucky to live in. Our method is a blend of photo-journalism and creatively styled photography, with over 20 years combined experience in photography and the arts.<\/div>\n","Type":"string"}]},{"Title":"Community Stats","Fields":[{"Label":"Group","Value":"Insiders","Type":"string"},{"Label":"Active Posts","Value":80,"Type":"int"},{"Label":"Profile Views","Value":685,"Type":"int"}]},{"Title":"Contact Methods","Fields":[{"Label":"Website URL","Value":"http:\/\/www.jasminandmatt.com","Type":"string"}]},{"Title":"Profile Information","Fields":[{"Label":"Location","Value":"Playa del Carmen, Mexico","Type":"string"},{"Label":"Interests","Value":"Photography, Cats","Type":"string"}]}],"Pages":null,"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
