leteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b7a00b6cd45da732a5134ed5a64365f5","RawContent":"&lt;p&gt;I\u2019m dealing with Laura from Toronto\u2026is Ellie in Montego Bay or Toronto? If you really want it, I would email her and ask her about the day pass\u2026.&lt;\/p&gt;","Attachments":[],"Id":1852370,"PostDate":1401296300,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I\u2019m dealing with Laura from Toronto\u2026is Ellie in Montego Bay or Toronto? If you really want it, I would email her and ask her about the day pass\u2026.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Happy Planning Future Brides!<\/p>\n<p>Love, Mrs. Gedney! <3<\/p>\n<p>11.18.2014","Email":"psaca@me.com","IpAddress":"99.227.231.192","GroupId":40,"GroupName":"Jr. Member","JoinDate":1372257073,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270939.jpg?_r=1423518723","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"pamelas21","Id":270939,"Name":"pamelas21","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"47.54.40.212","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76145,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5ed5be6e1680a31ea1fe56b88dca48f8","RawContent":"Have you considered using real touch flowers? I&#039;ve been looking at bloombridal.com they are in Toronto. They aren&#039;t \"cheap\" but at least you can keep your flowers after the wedding, they are beautiful too!!\nEllie is in Toronto. In the same office as Laura.","Attachments":[],"Id":1852372,"PostDate":1401296655,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Have you considered using real touch flowers? I've been looking at bloombridal.com they are in Toronto. They aren't \"cheap\" but at least you can keep your flowers after the wedding, they are beautiful too!!<br \/>Ellie is in Toronto. In the same office as Laura. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"falontubman@hotmail.com","IpAddress":"47.54.40.212","GroupId":39,"GroupName":"Newbie","JoinDate":1399385976,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277857.jpg?_r=1399384355","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Bridetobe771","Id":277857,"Name":"Bridetobe771","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"207.219.69.128","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76145,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0583f6bc3044a37f3ecb27c00837b1ae","RawContent":"My mom and I we&#039;re just talking about that yesterday!\n\n\nI am considering it!\n\n\n:)","Attachments":[],"Id":1852377,"PostDate":1401297652,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                My mom and I we're just talking about that yesterday!<br><br>\nI am considering it!<br><br>\n<img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Happy Planning Future Brides!<\/p>\n<p>Love, Mrs. Gedney! <3<\/p>\n<p>11.18.2014","Email":"psaca@me.com","IpAddress":"99.227.231.192","GroupId":40,"GroupName":"Jr. Member","JoinDate":1372257073,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270939.jpg?_r=1423518723","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"pamelas21","Id":270939,"Name":"pamelas21","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"47.54.40.212","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76145,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"491b5b0c3263b16c0250fbebc68faee9","RawContent":"I&#039;m not a fake flowers kind of girl but when you consider the price the resort charges and that you rally only get them for one day fake seems like a better option. And I&#039;m really shocked at how far fake flowers have come. They truly look real!","Attachments":[],"Id":1852379,"PostDate":1401298260,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I'm not a fake flowers kind of girl but when you consider the price the resort charges and that you rally only get them for one day fake seems like a better option. And I'm really shocked at how far fake flowers have come. They truly look real!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"falontubman@hotmail.com","IpAddress":"47.54.40.212","GroupId":39,"GroupName":"Newbie","JoinDate":1399385976,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277857.jpg?_r=1399384355","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Bridetobe771","Id":277857,"Name":"Bridetobe771","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"207.219.69.128","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76145,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"d27bfa97cd382bd9e2711f3ae3a34486","RawContent":"I think that&#039;s why I&#039;m frustrated! $200 for a bride bouquet I&#039;m only going to have in my hand for probably max 4 hours is crazy! :S","Attachments":[],"Id":1852380,"PostDate":1401298418,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I think that's why I'm frustrated! $200 for a bride bouquet I'm only going to have in my hand for probably max 4 hours is crazy! :S\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Happy Planning Future Brides!<\/p>\n<p>Love, Mrs. Gedney! <3<\/p>\n<p>11.18.2014","Email":"psaca@me.com","IpAddress":"99.227.231.192","GroupId":40,"GroupName":"Jr. Member","JoinDate":1372257073,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270939.jpg?_r=1423518723","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"pamelas21","Id":270939,"Name":"pamelas21","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"47.54.40.212","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76145,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"dd4248d42b0cd82237edb27625c21809","RawContent":"I&#039;ve received quotes from a few people that make real touch bouquets. Most are coming in around 150$ for a 10\" bouquet. I&#039;m defiantly going that route. I can spend the $50 elsewhere. There are lots of vendors for them On etsy and most will customize the bouquet to you exact specs.","Attachments":[],"Id":1852383,"PostDate":1401298747,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I've received quotes from a few people that make real touch bouquets. Most are coming in around 150$ for a 10\" bouquet. I'm defiantly going that route. I can spend the $50 elsewhere. There are lots of vendors for them On etsy and most will customize the bouquet to you exact specs. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"falontubman@hotmail.com","IpAddress":"47.54.40.212","GroupId":39,"GroupName":"Newbie","JoinDate":1399385976,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277857.jpg?_r=1399384355","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Bridetobe771","Id":277857,"Name":"Bridetobe771","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"207.219.69.128","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76145,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"428c765b987dd1a98343cef5b57aa314","RawContent":"What about packing them? Will they be in a box in your luggage?","Attachments":[],"Id":1852385,"PostDate":1401298835,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                What about packing them? Will they be in a box in your luggage? \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Happy Planning Future Brides!<\/p>\n<p>Love, Mrs. Gedney! <3<\/p>\n<p>11.18.2014","Email":"psaca@me.com","IpAddress":"99.227.231.192","GroupId":40,"GroupName":"Jr. Member","JoinDate":1372257073,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270939.jpg?_r=1423518723","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"pamelas21","Id":270939,"Name":"pamelas21","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"47.54.40.212","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76145,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"49f1db5ea56ef516b4f77c5786304402","RawContent":"I&#039;ve heard most girls put them in their carry on and ask each bridesmaid to do the same. I guess if they are wrapped in tissue they should be fine. And supposedly if they get any wrinkles they can be easily taken out with a hair dryer, but the real touch flowers are made of latex so I can&#039;t see them getting wrinkled.","Attachments":[],"Id":1852386,"PostDate":1401299057,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I've heard most girls put them in their carry on and ask each bridesmaid to do the same. I guess if they are wrapped in tissue they should be fine. And supposedly if they get any wrinkles they can be easily taken out with a hair dryer, but the real touch flowers are made of latex so I can't see them getting wrinkled. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"falontubman@hotmail.com","IpAddress":"47.54.40.212","GroupId":39,"GroupName":"Newbie","JoinDate":1399385976,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277857.jpg?_r=1399384355","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Bridetobe771","Id":277857,"Name":"Bridetobe771","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"69.58.97.194","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76145,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"77466c7d562a49e59ad69e6e08352ee1","RawContent":"&lt;p&gt;That&#039;s good to know! Because that&#039;s what I would be most worried about!&lt;\/p&gt;","Attachments":[],"Id":1852393,"PostDate":1401300972,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>That's good to know! Because that's what I would be most worried about!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Happy Planning Future Brides!<\/p>\n<p>Love, Mrs. Gedney! <3<\/p>\n<p>11.18.2014","Email":"psaca@me.com","IpAddress":"99.227.231.192","GroupId":40,"GroupName":"Jr. Member","JoinDate":1372257073,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270939.jpg?_r=1423518723","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"pamelas21","Id":270939,"Name":"pamelas21","IsOnline":false}}],"Pages":{"TotalItems":358,"TotalPages":36,"CurrentPage":130,"NextPage":140,"PreviousPage":120,"LastPage":350},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
