oWidth":200,"PhotoHeight":223,"PhotoType":"custom"},"FormattedName":"uhura526","Id":255974,"Name":"uhura526","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":69230,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d32c82db73451fb3a3db0afb8462fa79","RawContent":"&lt;p&gt; Pictures please!&lt;\/p&gt;","Attachments":[],"Id":1669492,"PostDate":1349183344,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Pictures please!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kristiethorn@yahoo.com","IpAddress":"199.202.144.192","GroupId":40,"GroupName":"Jr. Member","JoinDate":1330527803,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-252104.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"KristieT","Id":252104,"Name":"KristieT","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":69230,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"861b5359c785b64c99fe969187624141","RawContent":"&lt;p&gt; I only took one picture. The top was getting a bit squished from the hanger. But you can slightly see from the picture that there is a train. The top is a sweetheart with an empire waist and frills made from tulle cascading to the bottom. :)&amp;nbsp; I am not sure if this will be my TTD dress yet.&lt;\/p&gt; &lt;p id=\"yui_3_5_1_1_1349198168765_3391\"&gt; &lt;img alt=\"\" data-id=\"165361\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/165361\/width\/350\/height\/700\" \/&gt;&lt;\/p&gt;","Attachments":[],"Id":1669510,"PostDate":1349184312,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I only took one picture. The top was getting a bit squished from the hanger. But you can slightly see from the picture that there is a train. The top is a sweetheart with an empire waist and frills made from tulle cascading to the bottom. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0 I am not sure if this will be my TTD dress yet.<\/p> <p id=\"yui_3_5_1_1_1349198168765_3391\"> <span rel='lightbox'><img class='bbc_img' alt=\"\" data-id=\"165361\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/165361\/width\/350\/height\/700\" \/><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jessicaandcurtis@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1345541103,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-259435.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"somethingblue77","Id":259435,"Name":"somethingblue77","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":69230,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"140e3fff5b065b1c6b3db5d33853a262","RawContent":"&lt;p&gt; It looks beautiful!&lt;\/p&gt;","Attachments":[],"Id":1669555,"PostDate":1349188763,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> It looks beautiful!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"caravasquez@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1216131324,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-210547.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"carajoe08","Id":210547,"Name":"carajoe08","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":69230,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"15142ab319ab3ce1b46ee1defec8da98","RawContent":"[quote name=\"uhura526\"]\ndid you order your dress yet? Also did you get your TTD session dress?[\/quote] I was going to have jasmines make my dress, but i decided after seeing it made for another bride i was willing to pay for the original and I decided to go another way... I don&#039;t have a ttd dress yet but I bought allure 8815, so my funds are pretty tight:\/","Attachments":[],"Id":1669572,"PostDate":1349190038,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <blockquote class='ipsBlockquote' data-author=\"uhura526\" url=\"\/t\/81518\/dresses&#045;from&#045;dressilyme#post_1819037\"><p>did you order your dress yet? Also did you get your TTD session dress?<\/p><\/blockquote> I was going to have jasmines make my dress, but i decided after seeing it made for another bride i was willing to pay for the original and I decided to go another way... I don't have a ttd dress yet but I bought allure 8815, so my funds are pretty tight:\/\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"Enjoythepartykm@aol.com","IpAddress":"68.13.213.79","GroupId":3,"GroupName":"Member","JoinDate":1343379180,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-258455.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Tulumbride2013","Id":258455,"Name":"Tulumbride2013","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":69230,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"142b567860f720ac4d8119cbff900c22","RawContent":"It looks awesome! Congrats!","Attachments":[],"Id":1669574,"PostDate":1349190093,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                It looks awesome! Congrats!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"Enjoythepartykm@aol.com","IpAddress":"68.13.213.79","GroupId":3,"GroupName":"Member","JoinDate":1343379180,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-258455.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Tulumbride2013","Id":258455,"Name":"Tulumbride2013","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":69230,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ac626c9891f6e3d4df964e2d35796627","RawContent":"[quote]\nOriginally Posted by [b]somethingblue77[\/b] \/img\/forum\/go_quote.gif\n \n \n I only took one picture. The top was getting a bit squished from the hanger. But you can slightly see from the picture that there is a train. The top is a sweetheart with an empire waist and frills made from tulle cascading to the bottom. :)  I am not sure if this will be my TTD dress yet. \n [img]http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/165361\/width\/350\/height\/700[\/img][\/quote] \n \n \n Very nice!  Congrats! \n \n [quote]\nOriginally Posted by [b]Tulumbride2013[\/b] \/img\/forum\/go_quote.gif\n \n \n I was going to have jasmines make my dress, but i decided after seeing it made for another bride i was willing to pay for the original and I decided to go another way... I don&#039;t have a ttd dress yet but I bought allure 8815, so my funds are pretty tight:\/[\/quote] \n oh that Allure 8815 is a beautiful dress!  Great choice! I still went with Jasmine&#039;s as you know, for my dress and patiently waiting for it.  It&#039;s only been 3 weeks though. Hoping I have as much luck as most the other ladies.","Attachments":[{"Id":7264,"Name":"linterna blanca.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_10_2012\/post-30552-138237966976.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_10_2012\/post-30552-138237966976_thumb.jpg","Width":1457,"Height":1089}],"Id":1669718,"PostDate":1349210574,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>somethingblue77<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> <p> I only took one picture. The top was getting a bit squished from the hanger. But you can slightly see from the picture that there is a train. The top is a sweetheart with an empire waist and frills made from tulle cascading to the bottom. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0 I am not sure if this will be my TTD dress yet.<\/p> <p id=\"yui_3_5_1_1_1349198168765_3391\"> <span rel='lightbox'><img class='bbc_img' alt=\"\" data-id=\"165361\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/165361\/width\/350\/height\/700\" \/><\/span><\/p> <\/blockquote> <p> \u00a0<\/p> <p> \u00a0<\/p> <p> Very nice! \u00a0Congrats!<\/p> <div class=\"quote-container\"> \u00a0<\/div> <div class=\"quote-container\"> \u00a0<\/div> <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>Tulumbride2013<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> <br \/> I was going to have jasmines make my dress, but i decided after seeing it made for another bride i was willing to pay for the original and I decided to go another way... I don't have a ttd dress yet but I bought allure 8815, so my funds are pretty tight:\/<\/blockquote> <p> oh that Allure 8815 is a beautiful dress! \u00a0Great choice! I still went with Jasmine's as you know, for my dress and patiently waiting for it. \u00a0It's only been 3 weeks though. Hoping I have as much luck as most the other ladies.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lavieenrose12@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1338293803,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-255974.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":223,"PhotoType":"custom"},"FormattedName":"uhura526","Id":255974,"Name":"uhura526","IsOnline":false}}],"Id":"69230","Title":"Dresses from Dressilyme","LastPostDate":1442623369},"Pages":{"TotalItems":28,"TotalPages":3,"CurrentPage":10,"NextPage":20,"PreviousPage":0,"LastPage":20},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
