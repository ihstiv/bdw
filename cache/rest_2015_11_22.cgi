{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":120,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":8361,"MovedTo":null,"MovedOn":0,"FirstPostId":1391505,"Rating":0,"RatingHits":0,"Starter":{"Id":207912,"Name":"ACDCDCAC","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207912.jpg?_r=1386394469","PhotoWidth":180,"PhotoHeight":162,"PhotoType":"custom"},"IsOnline":false},"StartDate":1296871249,"LastPoster":{"Id":275126,"Name":"Rainmaker","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275126.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":112,"Preview":{"Id":1830924,"PostDate":1391273229,"PostContent":"Thanks Janet!","Author":{"Signature":"","Email":"cd_rain79@yahoo.com","IpAddress":"68.185.207.107","GroupId":40,"GroupName":"Jr. Member","JoinDate":1384727619,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275126.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Rainmaker","Id":275126,"Name":"Rainmaker","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":59459,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6379064f14b4db9f405e1f03b8d1942f","RawContent":"I just noticed this forum! I&#039;ll post first :) I&#039;m a Smom! My kids are Tre-15, and Ali- 12. I&#039;ve had them since they were 9 and 6 (haha, sounds funny, but you ladies know what I mean!) I never really thought about having\/wanting kids, and had never dated anyone with kids before my Husband. It&#039;s been challenging to learn the ropes of helping to raise someone else&#039;s children at times, but having these 2 in my life has been awesome :) Who&#039;s next?","Attachments":[],"Id":1391505,"PostDate":1296871249,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I just noticed this forum! I'll post first <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> I'm a Smom! My kids are Tre-15, and Ali- 12. I've had them since they were 9 and 6 (haha, sounds funny, but you ladies know what I mean!) I never really thought about having\/wanting kids, and had never dated anyone with kids before my Husband. It's been challenging to learn the ropes of helping to raise someone else's children at times, but having these 2 in my life has been awesome <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> Who's next?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"abbie.chalcraft@yahoo.com","IpAddress":"166.147.88.43","GroupId":38,"GroupName":"Moderators","JoinDate":1194486840,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207912.jpg?_r=1386394469","PhotoWidth":180,"PhotoHeight":162,"PhotoType":"custom"},"FormattedName":"ACDCDCAC","Id":207912,"Name":"ACDCDCAC","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":59459,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e219d4aa6d969c2024dd5a5e2524c3d9","RawContent":"&lt;p&gt; Aaaawwww how cute! My friend was called SMAW for a while, I guess I fall in this category. &amp;nbsp;I can identify with having no children and not sure if I want my own. &amp;nbsp;I will be gaining 4 kids and ready for the challenge!&amp;nbsp;&lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheesy.gif\" \/&gt;&lt;\/p&gt;","Attachments":[],"Id":1391550,"PostDate":1296877739,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Aaaawwww how cute! My friend was called SMAW for a while, I guess I fall in this category. \u00a0I can identify with having no children and not sure if I want my own. \u00a0I will be gaining 4 kids and ready for the challenge!\u00a0<span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheesy.gif\" \/><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><em>4\/1\/11 in St. Kitts at the Marriott I married my best-friend!!!<\/em><\/div><\/div>","Email":"misstiewill@aol.com","IpAddress":"164.82.32.13","GroupId":3,"GroupName":"Member","JoinDate":1232017038,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-213971.jpg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"big3n09","Id":213971,"Name":"big3n09","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":59459,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d03a9e24395912feb6f3121a058be1b3","RawContent":"&lt;p&gt; What a great idea!&amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; I too have no children of my own, FI has two however.&amp;nbsp; They are 15 and 12, I&#039;ve been with them since they were 12 &amp;amp; 9.&amp;nbsp; It&#039;s certainly been an adjustment for me, since I am only 27....&amp;nbsp; For anyone trying to figure out how this works, yes, FI is older than me, but 16 years.&amp;nbsp; I would like to have my own children at some point (sooner rather than later).&amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; I think one of the hardest things for me is that I don&#039;t have a support group (of friends), which would be nice to have.&amp;nbsp; My friends either have no children or are just starting their families.&amp;nbsp; So, I love the idea of this thread!&amp;nbsp; For the most part things are really good (otherwise we probably wouldn&#039;t be getting married in a couple of months, huh?!), but there are days where I&#039;d love to have someone to lean on!&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; For anyone who likes to read, the novel, &amp;quot;The Other Mothers&#039; Club&amp;quot; is a great read.&amp;nbsp; It&#039;s fiction, but wonderful!&amp;nbsp; It&#039;s by an author out of London, England - Samantha Baker.&lt;\/p&gt;","Attachments":[],"Id":1392312,"PostDate":1297023644,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> What a great idea!\u00a0<\/p> <p> \u00a0<\/p> <p> I too have no children of my own, FI has two however.\u00a0 They are 15 and 12, I've been with them since they were 12 & 9.\u00a0 It's certainly been an adjustment for me, since I am only 27....\u00a0 For anyone trying to figure out how this works, yes, FI is older than me, but 16 years.\u00a0 I would like to have my own children at some point (sooner rather than later).\u00a0<\/p> <p> \u00a0<\/p> <p> I think one of the hardest things for me is that I don't have a support group (of friends), which would be nice to have.\u00a0 My friends either have no children or are just starting their families.\u00a0 So, I love the idea of this thread!\u00a0 For the most part things are really good (otherwise we probably wouldn't be getting married in a couple of months, huh?!), but there are days where I'd love to have someone to lean on!<\/p> <p> \u00a0<\/p> <p> For anyone who likes to read, the novel, \"The Other Mothers' Club\" is a great read.\u00a0 It's fiction, but wonderful!\u00a0 It's by an author out of London, England - Samantha Baker.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><strong>Married the love of my life in April!!<\/strong><\/div><\/div>","Email":"erin82283@comcast.net","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1276041384,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-228983.jpg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"Ellabaja1983","Id":228983,"Name":"Ellabaja1983","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":59459,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9251df4bb31289cfd1ac700c96cdb59b","RawContent":"&lt;p&gt; I also have no children of my own, but my FI has a daughter who is 17.&amp;nbsp; My FI is 41 and I am 28. So this forum can be of a lot of help.&lt;\/p&gt;","Attachments":[],"Id":1392375,"PostDate":1297032712,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I also have no children of my own, but my FI has a daughter who is 17.\u00a0 My FI is 41 and I am 28. So this forum can be of a lot of help.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"CHRISTIANABREWSTER@YAHOO.COM","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1285811954,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232790.JPG?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"CBREWSTER","Id":232790,"Name":"CBREWSTER","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":59459,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c4bb75a572df3fa519bc9dace4f4ccad","RawContent":"Welcome to the Club, Ladies! :) Thanks for the book recommendation, sounds great. I&#039;m 34, so is The Hubs (yup he and ex were late-teen parents), that&#039;s how our math works out! It&#039;s tough sometimes being so close in age to the kids, but we do also have a lot of fun with them. Sometimes it can be handy, like come on guys, it wasnt that long ago we were your age! But sometimes it stinks because it&#039;s hard imagining my kid is now in high school, when I hardly feel like a \"grown up\" myself! ;)","Attachments":[],"Id":1392427,"PostDate":1297041225,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Welcome to the Club, Ladies! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> Thanks for the book recommendation, sounds great. I'm 34, so is The Hubs (yup he and ex were late-teen parents), that's how our math works out! It's tough sometimes being so close in age to the kids, but we do also have a lot of fun with them. Sometimes it can be handy, like come on guys, it wasnt that long ago we were your age! But sometimes it stinks because it's hard imagining my kid is now in high school, when I hardly feel like a \"grown up\" myself! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"abbie.chalcraft@yahoo.com","IpAddress":"166.147.88.43","GroupId":38,"GroupName":"Moderators","JoinDate":1194486840,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207912.jpg?_r=1386394469","PhotoWidth":180,"PhotoHeight":162,"PhotoType":"custom"},"FormattedName":"ACDCDCAC","Id":207912,"Name":"ACDCDCAC","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":59459,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"09033527bf079251d880e78ee4cc7427","RawContent":"&lt;p&gt; I&#039;m in this club too! I am 33 with no children.&amp;nbsp; FI is 32 with 2 kids.&amp;nbsp; A boy (14) and a girl (10).&amp;nbsp; I&#039;ve been with them since they were&amp;nbsp;9 and 5.&amp;nbsp; FI has custody of them so they live with us and visit their mother every other weekend.&amp;nbsp; We have no plans to add to the family.&amp;nbsp; I think 4 is a perfect size. &lt;span alt=\":D\" rel=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheesy.gif\"&gt;&lt;img height=\"16\" src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheesy.gif\" width=\"16\" \/&gt;&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1392952,"PostDate":1297106076,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I'm in this club too! I am 33 with no children.\u00a0 FI is 32 with 2 kids.\u00a0 A boy (14) and a girl (10).\u00a0 I've been with them since they were\u00a09 and 5.\u00a0 FI has custody of them so they live with us and visit their mother every other weekend.\u00a0 We have no plans to add to the family.\u00a0 I think 4 is a perfect size. <span alt=\":D\" rel=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheesy.gif\"><span rel='lightbox'><img class='bbc_img' height=\"16\" src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheesy.gif\" width=\"16\" \/><\/span><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ablj209@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1263003221,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-224465.jpg?_r=0","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"custom"},"FormattedName":"ablj209","Id":224465,"Name":"ablj209","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":59459,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5e30f58b3798abfdd7ccbd05bc04b2ed","RawContent":"&lt;p&gt; Ok so I top you all FI has 4 kids 17, 15, 13, and 6.  Thank God they&amp;nbsp;all have the same mother so it&#039;s only one woman I have to deal with.&amp;nbsp; When we met the youngest was on&amp;nbsp; the way so I&#039;ve been in their lives for 7 years now and to be honest the hard part is over cause 2 are almost grown now.&amp;nbsp; I&#039;m still undecided if I want my own kids but maybe we will have one just for our union.&amp;nbsp; I&#039;m 32 so it will be sooner than later for me as well, FI is 37, late teen parent too.&amp;nbsp; I have had to do some growing up as well as him and the kids but as I stated the hard part is over.&amp;nbsp; In my growing up I have learned to deal with things in a better manner so some things that use to bother me don&#039;t anymore or just aren&#039;t important.&amp;nbsp; I have a few friends who are step-moms so that helps some too, I&#039;m all&amp;nbsp;ears for anyone needing to vent cause having some support is very helpful.&lt;\/p&gt;","Attachments":[],"Id":1392963,"PostDate":1297106654,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Ok so I top you all FI has 4 kids 17, 15, 13, and 6.\u00a0\u00a0Thank God they\u00a0all have the same mother so it's only one woman I have to deal with.\u00a0 When we met the youngest was on\u00a0 the way so I've been in their lives for 7 years now and to be honest the hard part is over cause 2 are almost grown now.\u00a0 I'm still undecided if I want my own kids but maybe we will have one just for our union.\u00a0 I'm 32 so it will be sooner than later for me as well, FI is 37, late teen parent too.\u00a0 I have had to do some growing up as well as him and the kids but as I stated the hard part is over.\u00a0 In my growing up I have learned to deal with things in a better manner so some things that use to bother me don't anymore or just aren't important.\u00a0 I have a few friends who are step-moms so that helps some too, I'm all\u00a0ears for anyone needing to vent cause having some support is very helpful.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><em>4\/1\/11 in St. Kitts at the Marriott I married my best-friend!!!<\/em><\/div><\/div>","Email":"misstiewill@aol.com","IpAddress":"164.82.32.13","GroupId":3,"GroupName":"Member","JoinDate":1232017038,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-213971.jpg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"big3n09","Id":213971,"Name":"big3n09","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":59459,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"529fe8549bac01ad260f3de14947d300","RawContent":"&lt;p&gt; I am loving this forum already. It&#039;s nice to know that I can have someone to talk to that can relate. I forgot to mention that my FI daughter lives in house with us. But will be going off to college this Fall&amp;nbsp; &lt;span alt=\":D\" rel=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheesy.gif\"&gt;&lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheesy.gif\" \/&gt;! I am very undecided if I want to have any or not. After helping raise a teenager for the last 4 years makes me really think hard. &lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1393210,"PostDate":1297126516,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I am loving this forum already. It's nice to know that I can have someone to talk to that can relate. I forgot to mention that my FI daughter lives in house with us. But will be going off to college this Fall\u00a0 <span alt=\":D\" rel=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheesy.gif\"><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheesy.gif\" \/><\/span>! I am very undecided if I want to have any or not. After helping raise a teenager for the last 4 years makes me really think hard. <\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"CHRISTIANABREWSTER@YAHOO.COM","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1285811954,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232790.JPG?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"CBREWSTER","Id":232790,"Name":"CBREWSTER","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":59459,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7300b5b6f665381e1cfd783969df2834","RawContent":"This is becoming more and more of my problem the more I think about it...  It&#039;s hard because the only time I don&#039;t play that \"mother\" role is Monday and Tuesday for the most part.  There are weeks where I still have to pick up the slack for the mother if FI cannot for whatever reason.  Part of me feels like instead of having an infant, I just adopted older children, you know? \n   [quote]\nOriginally Posted by [b]CBREWSTER[\/b] \/img\/forum\/go_quote.gif\n \n \n I am loving this forum already. It&#039;s nice to know that I can have someone to talk to that can relate. I forgot to mention that my FI daughter lives in house with us. But will be going off to college this Fall  [img]http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheesy.gif[\/img]! I am very undecided if I want to have any or not. After helping raise a teenager for the last 4 years makes me really think hard.[\/quote]","Attachments":[],"Id":1393237,"PostDate":1297127964,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> This is becoming more and more of my problem the more I think about it...\u00a0 It's hard because the only time I don't play that \"mother\" role is Monday and Tuesday for the most part.\u00a0 There are weeks where I still have to pick up the slack for the mother if FI cannot for whatever reason.\u00a0 Part of me feels like instead of having an infant, I just adopted older children, you know?\u00a0<br \/> \u00a0<\/p> <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>CBREWSTER<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" style=\"border: 0px solid;\" \/><\/span><br \/> <br \/> <p> I am loving this forum already. It's nice to know that I can have someone to talk to that can relate. I forgot to mention that my FI daughter lives in house with us. But will be going off to college this Fall\u00a0 <span alt=\":D\" rel=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheesy.gif\"><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheesy.gif\" \/><\/span>! I am very undecided if I want to have any or not. After helping raise a teenager for the last 4 years makes me really think hard. <\/span><\/p> <\/blockquote> <br \/> <br \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><strong>Married the love of my life in April!!<\/strong><\/div><\/div>","Email":"erin82283@comcast.net","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1276041384,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-228983.jpg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"Ellabaja1983","Id":228983,"Name":"Ellabaja1983","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":59459,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"931041e50405bb50c726dd740aa55baf","RawContent":"&lt;p&gt; Hi Ladies,&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Well I am a single mom of a lovely 10 year old boy and I am gaining a 18 year old.&amp;nbsp; FI is 39 and I am 36 so the age difference is pretty much null and void.&amp;nbsp; The hard part, for my FI is that my son is quite at times.&amp;nbsp; Until he came into his life a year ago, my son has been going through his &amp;quot;why isn&#039;t my dad around etc..&amp;quot; so he is very cautious with FI... they both have a ball together and have formed their own bond, but I know my son somewhere in his little scientist mind is waiting for the big day to say okay... now this is real I can let go.&amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; As far as my soon to be step-daughter, we have our days for US a the guys do theirs.&amp;nbsp; It&#039;s nice because she can tell me exactly&amp;nbsp; how she feels from &amp;quot;Ms. Chanel you are the one for my dad&amp;quot; to I&#039;m not really sure how I feel about somebody else calling my dad, dad.&amp;quot;&amp;nbsp; So, we take it easy and always leave the door open for questions.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; The one thing that I told all of them FI, The Mom, daughter and my son is that I don&#039;t believe in calling anyone STEP.. so when I introduce you, you will be my daughter. And that&#039;s not to take away from anyone but that&#039;s just me.&amp;nbsp; I will always treat you, as if you are my own daughter because I do not believe in separation. His family is really supportive as well so its great.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Wow this thread it pretty cool as I realized that I typed a paragraph ;-)&lt;\/p&gt;","Attachments":[],"Id":1393249,"PostDate":1297128675,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hi Ladies,<\/p> <p> \u00a0<\/p> <p> Well I am a single mom of a lovely 10 year old boy and I am gaining a 18 year old.\u00a0 FI is 39 and I am 36 so the age difference is pretty much null and void.\u00a0 The hard part, for my FI is that my son is quite at times.\u00a0 Until he came into his life a year ago, my son has been going through his \"why isn't my dad around etc..\" so he is very cautious with FI... they both have a ball together and have formed their own bond, but I know my son somewhere in his little scientist mind is waiting for the big day to say okay... now this is real I can let go.\u00a0<\/p> <p> \u00a0<\/p> <p> As far as my soon to be step-daughter, we have our days for US a the guys do theirs.\u00a0 It's nice because she can tell me exactly\u00a0 how she feels from \"Ms. Chanel you are the one for my dad\" to I'm not really sure how I feel about somebody else calling my dad, dad.\"\u00a0 So, we take it easy and always leave the door open for questions.<\/p> <p> \u00a0<\/p> <p> The one thing that I told all of them FI, The Mom, daughter and my son is that I don't believe in calling anyone STEP.. so when I introduce you, you will be my daughter. And that's not to take away from anyone but that's just me.\u00a0 I will always treat you, as if you are my own daughter because I do not believe in separation. His family is really supportive as well so its great.<\/p> <p> \u00a0<\/p> <p> Wow this thread it pretty cool as I realized that I typed a paragraph ;-)<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><p><span>My Planning Thread: <\/span><a data-ipb='nomediaparse' href=\"http:\/\/www.bestdestinationwedding.com\/t\/78847\/coconoirs-planning-thread-picture-heavy\">http:\/\/www.bestdestinationwedding.com\/t\/78847\/coconoirs-planning-thread-picture-heavy<\/a><\/p><span><\/span><p><span>Our Wedding Feature: <\/span><a data-ipb='nomediaparse' href=\"http:\/\/www.preownedweddingdresses.com\/blog\/real-wedding-chanel-derick%E2%80%A8\">http:\/\/www.preownedweddingdresses.com\/blog\/real-wedding-chanel-derick%E2%80%A8<\/a><\/p><span><\/span><\/div><\/div>","Email":"chanel.conley@gmail.com","IpAddress":"72.78.193.252","GroupId":42,"GroupName":"Sr. Member","JoinDate":1275117649,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-228663.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"coconoir1908","Id":228663,"Name":"coconoir1908","IsOnline":false}}],"Id":"59459","Title":"Calling All StepMoms & SM2B's :)","LastPostDate":1391273229},"Pages":{"TotalItems":120,"TotalPages":12,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":110},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
