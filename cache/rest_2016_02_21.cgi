{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":1,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":128,"MovedTo":null,"MovedOn":0,"FirstPostId":1911074,"Rating":0,"RatingHits":0,"Starter":{"Id":286273,"Name":"sharpbecca","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1455856000,"LastPoster":{"Id":286273,"Name":"sharpbecca","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":22,"Preview":{"Id":1911074,"PostDate":1455856000,"PostContent":"Hello fellow brides! \u00a0 I am getting married at Dreams Punta Cana Resort & Spa in April 2016! Time...","Author":{"Signature":"","Email":"beccamouland@gmail.com","IpAddress":"162.157.245.56","GroupId":39,"GroupName":"Newbie","JoinDate":1455855194,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"sharpbecca","Id":286273,"Name":"sharpbecca","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"162.157.245.56","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79949,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b2f5d0c49065d961530613b1d12f7c0c","RawContent":"&lt;p&gt;Hello fellow brides!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I am getting married at Dreams Punta Cana Resort &amp;amp; Spa in April 2016! Time is getting close now. I was looking to see if there are any other brides getting married there during that time, or any time this year! Interested in what you fellow ladies think about the resort and the packages offered. We are having a beautiful beach ceremony&amp;nbsp; :lol:&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1911074,"PostDate":1455856000,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello fellow brides!<\/p>\n<p>\u00a0<\/p>\n<p>I am getting married at Dreams Punta Cana Resort & Spa in April 2016! Time is getting close now. I was looking to see if there are any other brides getting married there during that time, or any time this year! Interested in what you fellow ladies think about the resort and the packages offered. We are having a beautiful beach ceremony\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/laugh.png' class='bbc_emoticon' alt=':lol:' \/><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"beccamouland@gmail.com","IpAddress":"162.157.245.56","GroupId":39,"GroupName":"Newbie","JoinDate":1455855194,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"sharpbecca","Id":286273,"Name":"sharpbecca","IsOnline":false}}],"Id":"79949","Title":"Dreams Punta Cana 2016 Brides","LastPostDate":1455856000},"Pages":{"TotalItems":1,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
