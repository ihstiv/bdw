Request Time: 1 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":2,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":1045,"MovedTo":null,"MovedOn":0,"FirstPostId":1302134,"Rating":0,"RatingHits":0,"Starter":{"Id":232832,"Name":"tinydancer127","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232832.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"StartDate":1285953597,"LastPoster":{"Id":224684,"Name":"DiamondGirl","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-224684.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":70,"Preview":{"Id":1302170,"PostDate":1285954753,"PostContent":"Hi,  \u00a0  Belize was my #1 location for a destination wedding but then decided on Cancun MX becaus...","Author":{"Signature":"","Email":"sheilao_1@yahoo.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1263513837,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-224684.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"DiamondGirl","Id":224684,"Name":"DiamondGirl","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":57221,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"07d53dd5cdd8fca651280bfa42dfccc2","RawContent":"&lt;p&gt; We are trying to plan our destination wedding in Belize.&amp;nbsp; Does anyone know the best time to go?&amp;nbsp; We don&#039;t want to go at peak season, but we don&#039;t want to be there when it&#039;s pouring rain either.&amp;nbsp; Also does anyone know any good all-inclusive resorts there?&lt;\/p&gt;","Attachments":[],"Id":1302134,"PostDate":1285953597,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> We are trying to plan our destination wedding in Belize.\u00a0 Does anyone know the best time to go?\u00a0 We don't want to go at peak season, but we don't want to be there when it's pouring rain either.\u00a0 Also does anyone know any good all-inclusive resorts there?<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tinydancer127@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1285953323,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232832.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"tinydancer127","Id":232832,"Name":"tinydancer127","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":57221,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8ace1dcfd57932d490384a34abee82e4","RawContent":"&lt;p&gt; Hi,&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Belize was my #1 location for a destination wedding but then decided on Cancun MX because FI felt that it was too much traveling involved since we wanted to stay in Ambergris, Caye, in the town of san pedro. To get to the island of San Pedro, you have to take a small jumper plane or water taxi from belize city. I did both and the experience was so worth it. San pedro is a little island in Ambergris Caye where all the restaurants are, Clubs, bars, shops etc.... Pretty much highly recommended location to be. Where in belize are you looking to have your wedding? Once you know where, then you can look up all inclusive resorts within that area.&lt;\/p&gt;","Attachments":[],"Id":1302170,"PostDate":1285954753,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hi,<\/p> <p> \u00a0<\/p> <p> Belize was my #1 location for a destination wedding but then decided on Cancun MX because FI felt that it was too much traveling involved since we wanted to stay in Ambergris, Caye, in the town of san pedro. To get to the island of San Pedro, you have to take a small jumper plane or water taxi from belize city. I did both and the experience was so worth it. San pedro is a little island in Ambergris Caye where all the restaurants are, Clubs, bars, shops etc.... Pretty much highly recommended location to be. Where in belize are you looking to have your wedding? Once you know where, then you can look up all inclusive resorts within that area.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sheilao_1@yahoo.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1263513837,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-224684.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"DiamondGirl","Id":224684,"Name":"DiamondGirl","IsOnline":false}}],"Id":"57221","Title":"What's the best time to go to Belize?","LastPostDate":1285954753},"Pages":{"TotalItems":2,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
