                 font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Its your wedding have what you want and don't worry about it<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"justineatack@gmail.com","IpAddress":"31.54.1.116","GroupId":40,"GroupName":"Jr. Member","JoinDate":1409993856,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279711.jpg?_r=1410256327","PhotoWidth":200,"PhotoHeight":125,"PhotoType":"custom"},"FormattedName":"Bride2b15","Id":279711,"Name":"Bride2b15","IsOnline":false}}],"Id":"75370","Title":"Help!! close friend used the song I wanted to for their first dance.. can I still use it?!","LastPostDate":1411541741},"Pages":{"TotalItems":6,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":1,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
