{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":1,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":728,"MovedTo":null,"MovedOn":0,"FirstPostId":1904550,"Rating":0,"RatingHits":0,"Starter":{"Id":284777,"Name":"ammbeer","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1442004946,"LastPoster":{"Id":284777,"Name":"ammbeer","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":38,"Preview":{"Id":1904550,"PostDate":1442004946,"PostContent":"We have booked our wedding at the Riu Palace in Cabo April 2016 and are starting to look at the r...","Author":{"Signature":"","Email":"amberlhanson@gmail.com","IpAddress":"72.200.248.13","GroupId":39,"GroupName":"Newbie","JoinDate":1442004631,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"ammbeer","Id":284777,"Name":"ammbeer","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"72.200.248.13","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79581,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a8161737c0e6e42a90e80958ea18ec0d","RawContent":"&lt;p&gt;We have booked our wedding at the Riu Palace in Cabo April 2016 and are starting to look at the reception options. &amp;nbsp;My questions are:&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Is the Baja Norte a much better choice then the San Jose Terrace or the steak house? &amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Does the San Jose Terrace and steak house serve the regular menu that you can get at an all inclusive? Or is it a special menu?\n\n&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;How is the food for the menu for Baja Norte? &amp;nbsp;Does the site reservation and table reservation include alcohol?&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;It seems silly to pay extra at an all inclusive unless the food is really that much better? &amp;nbsp;Any advice would be great! I am just starting the planning so I am sure I will have a a lot of questions! Thanks :)&lt;\/p&gt;","Attachments":[],"Id":1904550,"PostDate":1442004946,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>We have booked our wedding at the Riu Palace in Cabo April 2016 and are starting to look at the reception options. \u00a0My questions are:<\/p>\n<p>\u00a0<\/p>\n<p>Is the Baja Norte a much better choice then the San Jose Terrace or the steak house? \u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Does the San Jose Terrace and steak house serve the regular menu that you can get at an all inclusive? Or is it a special menu?<br>\n\u00a0<\/p>\n<p>How is the food for the menu for Baja Norte? \u00a0Does the site reservation and table reservation include alcohol?<\/p>\n<p>\u00a0<\/p>\n<p>It seems silly to pay extra at an all inclusive unless the food is really that much better? \u00a0Any advice would be great! I am just starting the planning so I am sure I will have a a lot of questions! Thanks <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"amberlhanson@gmail.com","IpAddress":"72.200.248.13","GroupId":39,"GroupName":"Newbie","JoinDate":1442004631,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"ammbeer","Id":284777,"Name":"ammbeer","IsOnline":false}}],"Id":"79581","Title":"Riu Palace Wedding April 2016","LastPostDate":1442004946},"Pages":{"TotalItems":1,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
