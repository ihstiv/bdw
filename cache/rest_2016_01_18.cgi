{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":3,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":811,"MovedTo":null,"MovedOn":0,"FirstPostId":1900027,"Rating":0,"RatingHits":0,"Starter":{"Id":283870,"Name":"insignia820","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1436380743,"LastPoster":{"Id":283870,"Name":"insignia820","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":129,"Preview":{"Id":1900027,"PostDate":1436380743,"PostContent":"We are getting married there 2\/16\/16. \u00a0We are from NY and have never been to Quebec so planning h...","Author":{"Signature":"","Email":"insignia820@gmail.com","IpAddress":"63.138.60.98","GroupId":39,"GroupName":"Newbie","JoinDate":1436380027,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"insignia820","Id":283870,"Name":"insignia820","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"63.138.60.98","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79362,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"627c3a57b1ac8b67f731f6cea6124723","RawContent":"&lt;p&gt;We are getting married there 2\/16\/16. &amp;nbsp;We are from NY and have never been to Quebec so planning has been slightly rough for me but it&#039;s all coming together. &amp;nbsp;We have 30 guests coming with us from NY and I just want to make sure it&#039;s the best time for them! &amp;nbsp;The only snags I&#039;m running into are: transportation from Chateau Laurier, to Hotel de Glace, and then to Frontenac (where the reception is) - I think I need to include down time between ceremony and reception so that people have time to change from lots of layers to less for the reception and then include transportation for that? Originally I was hoping to go right from ceremony to reception and provide cocktail hour. &amp;nbsp;I also am not sure what I can bring with me\/get in terms of food and drink ahead of time (for welcome bags &amp;amp; favors), that I can bring over the border? &amp;nbsp;I&#039;m hoping that someone has or is going to be in the same shoes as me? :)&lt;\/p&gt;","Attachments":[],"Id":1900027,"PostDate":1436380743,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>We are getting married there 2\/16\/16. \u00a0We are from NY and have never been to Quebec so planning has been slightly rough for me but it's all coming together. \u00a0We have 30 guests coming with us from NY and I just want to make sure it's the best time for them! \u00a0The only snags I'm running into are: transportation from Chateau Laurier, to Hotel de Glace, and then to Frontenac (where the reception is) - I think I need to include down time between ceremony and reception so that people have time to change from lots of layers to less for the reception and then include transportation for that? Originally I was hoping to go right from ceremony to reception and provide cocktail hour. \u00a0I also am not sure what I can bring with me\/get in terms of food and drink ahead of time (for welcome bags & favors), that I can bring over the border? \u00a0I'm hoping that someone has or is going to be in the same shoes as me? <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"insignia820@gmail.com","IpAddress":"63.138.60.98","GroupId":39,"GroupName":"Newbie","JoinDate":1436380027,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"insignia820","Id":283870,"Name":"insignia820","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"208.87.237.201","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79362,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d0fb70be7122f8fe9853fa1b3a9aac5c","RawContent":"&lt;p&gt;Congrats and welcome! What an interesting place for a wedding!! You will absolutely have to post pictures of your wedding! I&#039;ll bet they&#039;ll be gorgeous!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;The Chateau Frontenac is a beautiful historic hotel. I was there many years ago and it&#039;s gorgeous. Depending on how cold it gets, the views of the frozen St Lawrence river full of ice are stunning for a photo backdrop.&amp;nbsp;Usually though in February in Quebec City, that&#039;s not an issue!&amp;nbsp;In terms of what you can bring in with you, Canada is much more lax&amp;nbsp;for bringing things in than the US. I do the trip constantly back and forth mostly crossing at Buffalo NY but also at Calis ME and we never take food with us. We will travel with an empty cooler and customs almost always asks us to open up the back of the&amp;nbsp;truck and they will look inside. It&#039;s totally different coming the other way. I always do shopping and bring back milk, cheese, fruit, vegetables, meat and never have an issue coming back to Canada. I&#039;m not sure what kind of things you&#039;re thinking about but I don&#039;t think you&#039;ll have any issue. As far as buying - Quebec City is a full on city with grocery stores and shopping so you would be able to buy almost anything I would think. You can also buy booze in grocery stores in Quebec, something you cannot do in every province in Canada. I really don&#039;t remember distances so I&#039;m afraid in terms of your transportation timing I can&#039;t help out. There are definitely limousine services - perhaps a bus type of thing if you wanted. Just search around on the internet and you should get some info.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;As well I&#039;m sure there are other Canadian brides here that might be familiar with the area and could provide more details.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck and happy planning!&lt;\/p&gt;","Attachments":[],"Id":1900104,"PostDate":1436463878,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congrats and welcome! What an interesting place for a wedding!! You will absolutely have to post pictures of your wedding! I'll bet they'll be gorgeous!<\/p>\n<p>\u00a0<\/p>\n<p>The Chateau Frontenac is a beautiful historic hotel. I was there many years ago and it's gorgeous. Depending on how cold it gets, the views of the frozen St Lawrence river full of ice are stunning for a photo backdrop.\u00a0Usually though in February in Quebec City, that's not an issue!\u00a0In terms of what you can bring in with you, Canada is much more lax\u00a0for bringing things in than the US. I do the trip constantly back and forth mostly crossing at Buffalo NY but also at Calis ME and we never take food with us. We will travel with an empty cooler and customs almost always asks us to open up the back of the\u00a0truck and they will look inside. It's totally different coming the other way. I always do shopping and bring back milk, cheese, fruit, vegetables, meat and never have an issue coming back to Canada. I'm not sure what kind of things you're thinking about but I don't think you'll have any issue. As far as buying - Quebec City is a full on city with grocery stores and shopping so you would be able to buy almost anything I would think. You can also buy booze in grocery stores in Quebec, something you cannot do in every province in Canada. I really don't remember distances so I'm afraid in terms of your transportation timing I can't help out. There are definitely limousine services - perhaps a bus type of thing if you wanted. Just search around on the internet and you should get some info.<\/p>\n<p>\u00a0<\/p>\n<p>As well I'm sure there are other Canadian brides here that might be familiar with the area and could provide more details.<\/p>\n<p>\u00a0<\/p>\n<p>Good luck and happy planning!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#ff0099;\"><em>I said \"yes\" again to the love of my life at Grand Coral Beach Club, Playa del Carmen, Mexico on our 4th anniversary - October 20, 2015<\/em><\/span><\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/ann.chadwick.5\/media_set?set=a.10153262834771016.1073741828.569791015&type=3'><span style=\"color:#ff0099;\"><em>https:\/\/www.facebook.com\/ann.chadwick.5\/media_set?set=a.10153262834771016.1073741828.569791015&type=3<\/em><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/'><span style=\"color:#ff0099;\"><em>http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/<\/em><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283458999,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"172.79.85.182","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79362,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"35c9f13d7a560a41c2e314a1f1733109","RawContent":"&lt;p&gt;Thank you so much for your help! &amp;nbsp;Very reassuring! &amp;nbsp;Finally getting very close to having everything all set! &amp;nbsp;My biggest worry was having issues at the border (since we will have quite a bit in the car with us!) :)&lt;\/p&gt;","Attachments":[],"Id":1908605,"PostDate":1450817715,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Thank you so much for your help! \u00a0Very reassuring! \u00a0Finally getting very close to having everything all set! \u00a0My biggest worry was having issues at the border (since we will have quite a bit in the car with us!) <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"insignia820@gmail.com","IpAddress":"63.138.60.98","GroupId":39,"GroupName":"Newbie","JoinDate":1436380027,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"insignia820","Id":283870,"Name":"insignia820","IsOnline":false}}],"Id":"79362","Title":"Anyone Getting Married At The Hotel De Glace?","LastPostDate":1450817715},"Pages":{"TotalItems":3,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
