24980,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206835.gif?_r=0","PhotoWidth":75,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Jackie","Id":206835,"Name":"Jackie","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":164,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"20c19be5f26e260cb319c328d5c126a7","RawContent":"i attended a DW at this resort for my FI&#039;s cousin in April of 2005. i will post some pictures for you this evening. i don&#039;t want to freak you guys out, but we did not have the best experience with this place. the worst of it was that the minister never showed up so my future father in law had to wing it and perform the ceremony for them. this resort is enormous and they have about 5 or 6 different wedding sites from what I remember, which were all very pretty. we were at the southernmost site at the Tulum end of it. let me know if you want more info...","Attachments":[],"Id":10682,"PostDate":1165457852,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                i attended a DW at this resort for my FI's cousin in April of 2005. i will post some pictures for you this evening. i don't want to freak you guys out, but we did not have the best experience with this place. the worst of it was that the minister never showed up so my future father in law had to wing it and perform the ceremony for them. this resort is enormous and they have about 5 or 6 different wedding sites from what I remember, which were all very pretty. we were at the southernmost site at the Tulum end of it. let me know if you want more info...\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><strong><i>Jen & Aaron<br>January 13, 2007<\/i><\/strong><\/div><\/div>","Email":"jengonda@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1147915200,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206735.gif?_r=0","PhotoWidth":100,"PhotoHeight":93,"PhotoType":"custom"},"FormattedName":"JENGONDA9","Id":206735,"Name":"JENGONDA9","IsOnline":false}}],"Id":"164","Title":"Gran Bahia Principe Akumal\/Tulum\/Coba - POST HERE!","LastPostDate":1448989358},"Pages":{"TotalItems":8081,"TotalPages":809,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":8080},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
