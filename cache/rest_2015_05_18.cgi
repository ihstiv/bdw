-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Mine is planning on having a suit made, but I think he will get really warm in it<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"bluestarfish@hotmail.com","IpAddress":"24.78.214.142","GroupId":40,"GroupName":"Jr. Member","JoinDate":1396233643,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Kyliewylie","Id":277410,"Name":"Kyliewylie","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.128.161.147","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":70637,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ab13baa524542995b16cdf452c071fd3","RawContent":"&lt;p&gt;I want my boys to match their dad (FI) so I think we are going to go with linen.&lt;\/p&gt;","Attachments":[],"Id":1842955,"PostDate":1396822505,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I want my boys to match their dad (FI) so I think we are going to go with linen.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"fl