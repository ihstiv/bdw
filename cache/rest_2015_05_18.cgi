{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":6,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":239,"MovedTo":null,"MovedOn":0,"FirstPostId":1895891,"Rating":0,"RatingHits":0,"Starter":{"Id":283053,"Name":"Nicole2016","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1431316005,"LastPoster":{"Id":230711,"Name":"Moments That Matter","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1895891,"PostDate":1431316005,"PostContent":"Hi has anyone had their wedding here and if so how was your experience? Did you do excursions? Ho...","Author":{"Signature":"","Email":"mrfatta2012@gmail.com","IpAddress":"69.143.75.58","GroupId":39,"GroupName":"Newbie","JoinDate":1431313416,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Nicole2016","Id":283053,"Name":"Nicole2016","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"69.143.75.58","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79172,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8e332294966da40f91bb0254144ccc6d","RawContent":"&lt;p&gt;Hi has anyone had their wedding here and if so how was your experience? Did you do excursions? How was the salon as far as hair and make up? Any advice&lt;\/p&gt;","Attachments":[],"Id":1895891,"PostDate":1431316005,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi has anyone had their wedding here and if so how was your experience? Did you do excursions? How was the salon as far as hair and make up? Any advice<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mrfatta2012@gmail.com","IpAddress":"69.143.75.58","GroupId":39,"GroupName":"Newbie","JoinDate":1431313416,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Nicole2016","Id":283053,"Name":"Nicole2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.15.187","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79172,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a4ae83cb3b45bb82c7714b93b03c71e8","RawContent":"&lt;p&gt;Congrats and welcome to BDW! This is a great site with tons of ideas that will help you on your planning journey!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Have you looked through the resort reviews yet? I&#039;m sure there have been brides that have used your resort in the past so it&#039;s worth a look. As well, do a search in the forums to see if there are current threads for the resort you&#039;ve chosen.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck and happy planning!&lt;\/p&gt;","Attachments":[],"Id":1895892,"PostDate":1431316519,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congrats and welcome to BDW! This is a great site with tons of ideas that will help you on your planning journey!<\/p>\n<p>\u00a0<\/p>\n<p>Have you looked through the resort reviews yet? I'm sure there have been brides that have used your resort in the past so it's worth a look. As well, do a search in the forums to see if there are current threads for the resort you've chosen.<\/p>\n<p>\u00a0<\/p>\n<p>Good luck and happy planning!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283458999,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1426134867","PhotoWidth":668,"PhotoHeight":600,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"204.4.182.17","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79172,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6b3fe9bcd69663aaf3ca25410facbdda","RawContent":"&lt;p&gt;I am getting married at Palma Real in Feb 2016.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I booked the bridal suite and will have the salon ladies do hair and make up. Have you done your visit yet? So the actual salon is located at the Reserve, which is a golf cart ride away, and the ladies charge something like $45\/person (per person getting ready), to come to a room at the hotel. I booked a package which includes the bridal suite and 5 hair and make ups, which comes out to a pretty good discount (you can reach out to the salon manager for different package prices), and then i am adding 5 more hairs and make up, as i have 9 bridesmaids and my mother, and myself. The manager said she could have 4 girls working on us at the same time which is great. I had to get the bridal suite because all in it ended up being cheaper then having the ladies come to a room, but the bridal suite is not that nice - its small and underwhelming, to be honest.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We are not going to do any planned excursions for the whole group, but we are having our rehearsal dinner on La Barcaza on Thurs night (just wedding party and first family) and are going to suggest different excursions for our guests that are staying longer. We are also doing the welcome bbq on Friday night with all guests - and then wedding Saturday.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1895927,"PostDate":1431368352,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I am getting married at Palma Real in Feb 2016.<\/p>\n<p>\u00a0<\/p>\n<p>I booked the bridal suite and will have the salon ladies do hair and make up. Have you done your visit yet? So the actual salon is located at the Reserve, which is a golf cart ride away, and the ladies charge something like $45\/person (per person getting ready), to come to a room at the hotel. I booked a package which includes the bridal suite and 5 hair and make ups, which comes out to a pretty good discount (you can reach out to the salon manager for different package prices), and then i am adding 5 more hairs and make up, as i have 9 bridesmaids and my mother, and myself. The manager said she could have 4 girls working on us at the same time which is great. I had to get the bridal suite because all in it ended up being cheaper then having the ladies come to a room, but the bridal suite is not that nice - its small and underwhelming, to be honest.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>We are not going to do any planned excursions for the whole group, but we are having our rehearsal dinner on La Barcaza on Thurs night (just wedding party and first family) and are going to suggest different excursions for our guests that are staying longer. We are also doing the welcome bbq on Friday night with all guests - and then wedding Saturday.<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"maria.anisimova88@gmail.com","IpAddress":"199.29.247.15","GroupId":39,"GroupName":"Newbie","JoinDate":1420724999,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"maria1488","Id":281640,"Name":"maria1488","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.228.60.204","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79172,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6e529a443a3d8c27f3d480a5727a01c2","RawContent":"[quote name=\"Nicole2016\" post=\"1895891\" timestamp=\"1431316005\"]\nHi has anyone had their wedding here and if so how was your experience? Did you do excursions? How was the salon as far as hair and make up? Any advice[\/quote]Congrats on your engagement, Nicole! You&#039;re going to love, love, love this resort! I&#039;ve been there and even the entry level rooms are amazing. Both the Paradisus Punta Cana and Paradisus Palma Real have great reputations for weddings so you won&#039;t have any issues. Hopefully you get someone really good in the Miami office though. If you have any questions, you can PM me!\n[quote name=\"maria1488\" post=\"1895927\" timestamp=\"1431368352\"]\nI am getting married at Palma Real in Feb 2016.\n\nI booked the bridal suite and will have the salon ladies do hair and make up. Have you done your visit yet? So the actual salon is located at the Reserve, which is a golf cart ride away, and the ladies charge something like $45\/person (per person getting ready), to come to a room at the hotel. I booked a package which includes the bridal suite and 5 hair and make ups, which comes out to a pretty good discount (you can reach out to the salon manager for different package prices), and then i am adding 5 more hairs and make up, as i have 9 bridesmaids and my mother, and myself. The manager said she could have 4 girls working on us at the same time which is great. I had to get the bridal suite because all in it ended up being cheaper then having the ladies come to a room, but the bridal suite is not that nice - its small and underwhelming, to be honest. \n\nWe are not going to do any planned excursions for the whole group, but we are having our rehearsal dinner on La Barcaza on Thurs night (just wedding party and first family) and are going to suggest different excursions for our guests that are staying longer. We are also doing the welcome bbq on Friday night with all guests - and then wedding Saturday.[\/quote]Congrats, Maria. I hear you about the bridal suite but it is definitely the best way to go. You&#039;ll love La Barcaza.","Attachments":[],"Id":1895954,"PostDate":1431392904,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Nicole2016, on 10 May 2015 - 07:46 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Hi has anyone had their wedding here and if so how was your experience? Did you do excursions? How was the salon as far as hair and make up? Any advice<\/p>\n<\/div>\n<\/div><\/div>\n<p>Congrats on your engagement, Nicole! You're going to love, love, love this resort! I've been there and even the entry level rooms are amazing. Both the Paradisus Punta Cana and Paradisus Palma Real have great reputations for weddings so you won't have any issues. Hopefully you get someone really good in the Miami office though. If you have any questions, you can PM me!<\/p><br \/><p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>maria1488, on 11 May 2015 - 10:19 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>I am getting married at Palma Real in Feb 2016.<\/p>\n<p>\u00a0<\/p>\n<p>I booked the bridal suite and will have the salon ladies do hair and make up. Have you done your visit yet? So the actual salon is located at the Reserve, which is a golf cart ride away, and the ladies charge something like $45\/person (per person getting ready), to come to a room at the hotel. I booked a package which includes the bridal suite and 5 hair and make ups, which comes out to a pretty good discount (you can reach out to the salon manager for different package prices), and then i am adding 5 more hairs and make up, as i have 9 bridesmaids and my mother, and myself. The manager said she could have 4 girls working on us at the same time which is great. I had to get the bridal suite because all in it ended up being cheaper then having the ladies come to a room, but the bridal suite is not that nice - its small and underwhelming, to be honest.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>We are not going to do any planned excursions for the whole group, but we are having our rehearsal dinner on La Barcaza on Thurs night (just wedding party and first family) and are going to suggest different excursions for our guests that are staying longer. We are also doing the welcome bbq on Friday night with all guests - and then wedding Saturday.<\/p>\n<\/div>\n<\/div><\/div>\n<p>Congrats, Maria. I hear you about the bridal suite but it is definitely the best way to go. You'll love La Barcaza.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"theniylife@gmail.com","IpAddress":"99.228.60.204","GroupId":39,"GroupName":"Newbie","JoinDate":1430534280,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"1weddingirl","Id":282948,"Name":"1weddingirl","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"69.143.75.58","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79172,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"491f1fe5c0d5fb49939b3490397cd607","RawContent":"Thank you I just cant seem to make my mind up between this resort and the Hard Rock. I will do my love at first site this June with Palma Real","Attachments":[],"Id":1895961,"PostDate":1431399182,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thank you I just cant seem to make my mind up between this resort and the Hard Rock. I will do my love at first site this June with Palma Real\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mrfatta2012@gmail.com","IpAddress":"69.143.75.58","GroupId":39,"GroupName":"Newbie","JoinDate":1431313416,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Nicole2016","Id":283053,"Name":"Nicole2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.114.41.176","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79172,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f235848ecea3ac8b5953279e36773390","RawContent":"&lt;p&gt;Congrats on your upcoming DR wedding, Nicole!!! and welcome to our forum community :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;In case you haven&#039;t already seen it, here&#039;s a link to some reviews: &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.tripadvisor.ca\/Hotel_Review-g147293-d583034-Reviews-Paradisus_Palma_Real-Punta_Cana_La_Altagracia_Province_Dominican_Republic.html&#039;&gt;Paradisus Palma Real Punta Cana&lt;\/a&gt; reviews&lt;\/p&gt;\n&lt;p&gt;.....and here is a link to some photos: &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/images.search.yahoo.com\/yhs\/search;_ylt=A86.JyAHulNVoWMAqCYnnIlQ;_ylu=X3oDMTByNWU4cGh1BGNvbG8DZ3ExBHBvcwMxBHZ0aWQDBHNlYwNzYw--?p=Paradisus+Palma+Real+Punta+Cana&amp;amp;fr=yhs-mozilla-001&amp;amp;hspart=mozilla&amp;amp;hsimp=yhs-001&#039;&gt;Paradisus Palma Real Punta Cana photos&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Hope you find all the answers you&#039;re looking for to compare this resort with the Hard Rock. Happy research and all the best with your decisions - cheers!!! team MTM :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-sea.xx.fbcdn.net\/hphotos-xpa1\/t31.0-8\/10830966_10153293698549487_5633169541755990092_o.jpg\" alt=\"10830966_10153293698549487_5633169541755\"&gt;&lt;\/p&gt;","Attachments":[],"Id":1896194,"PostDate":1431550838,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congrats on your upcoming DR wedding, Nicole!!! and welcome to our forum community <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>In case you haven't already seen it, here's a link to some reviews: <a href='http:\/\/www.tripadvisor.ca\/Hotel_Review-g147293-d583034-Reviews-Paradisus_Palma_Real-Punta_Cana_La_Altagracia_Province_Dominican_Republic.html' class='bbc_url' title='External link' rel='nofollow external'>Paradisus Palma Real Punta Cana<\/a> reviews<\/p>\n<p>.....and here is a link to some photos: <a href='https:\/\/images.search.yahoo.com\/yhs\/search;_ylt=A86.JyAHulNVoWMAqCYnnIlQ;_ylu=X3oDMTByNWU4cGh1BGNvbG8DZ3ExBHBvcwMxBHZ0aWQDBHNlYwNzYw--?p=Paradisus+Palma+Real+Punta+Cana&fr=yhs-mozilla-001&hspart=mozilla&hsimp=yhs-001' class='bbc_url' title='External link' rel='nofollow external'>Paradisus Palma Real Punta Cana photos<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Hope you find all the answers you're looking for to compare this resort with the Hard Rock. Happy research and all the best with your decisions - cheers!!! team MTM <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-sea.xx.fbcdn.net\/hphotos-xpa1\/t31.0-8\/10830966_10153293698549487_5633169541755990092_o.jpg\" alt=\"10830966_10153293698549487_5633169541755\"><\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280210660,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}}],"Id":"79172","Title":"New June 2016 Bride @ Paradisus Palma Real Punta Cana","LastPostDate":1431550838},"Pages":{"TotalItems":6,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":3,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
