Request Time: 0 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":5,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":411,"MovedTo":null,"MovedOn":0,"FirstPostId":1565696,"Rating":0,"RatingHits":0,"Starter":{"Id":249591,"Name":"Linda and Blair","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-249591.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"StartDate":1326080393,"LastPoster":{"Id":277650,"Name":"MrsRoy","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277650.png?_r=1402827462","PhotoWidth":60,"PhotoHeight":80,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":57,"Preview":{"Id":1565696,"PostDate":1326080393,"PostContent":"Is or has anyone been married in Costa Rica? \u00a0Our plans have recently changed so trying to find...","Author":{"Signature":"","Email":"linda.small1982@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1326079906,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-249591.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Linda and Blair","Id":249591,"Name":"Linda and Blair","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":65185,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b5df20635a18ee607a78b328484065f6","RawContent":"&lt;p&gt; Is or has anyone been married in Costa Rica? &amp;nbsp;Our plans have recently changed so trying to find another country that is reasonably priced from the UK and Canada in August (not an easy task!).&lt;\/p&gt; &lt;p&gt; Looking for any information that folk may have on this part of the world for weddings? &amp;nbsp;Planners, locations, resorts etc.&lt;\/p&gt; &lt;p&gt; Thanks!!!&lt;\/p&gt; &lt;p&gt; Linda&lt;\/p&gt;","Attachments":[],"Id":1565696,"PostDate":1326080393,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Is or has anyone been married in Costa Rica? \u00a0Our plans have recently changed so trying to find another country that is reasonably priced from the UK and Canada in August (not an easy task!).<\/p> <p> Looking for any information that folk may have on this part of the world for weddings? \u00a0Planners, locations, resorts etc.<\/p> <p> Thanks!!!<\/p> <p> Linda<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"linda.small1982@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1326079906,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-249591.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Linda and Blair","Id":249591,"Name":"Linda and Blair","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":65185,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"af1c57f52025fdc35e9533da0b314583","RawContent":"&lt;p&gt; I remember a few people talking about CR, but can&#039;t recall any actual weddings there.&amp;nbsp; But here is a link that would be sure to contain any information available:&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p id=\"yui_3_4_1_7_1326314668539_27\" style=\"line-height: normal; background-color: rgb(253,252,250); font-family: arial, helvetica, sans-serif; color: rgb(24,24,24)\"&gt; &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.bestdestinationwedding.com\/f\/99\/central-south-america-weddings\"&gt;Central &amp;amp; South America Wedding&lt;\/a&gt;&amp;nbsp;(Costa Rica &amp;amp; Belize)&lt;\/p&gt;","Attachments":[],"Id":1567080,"PostDate":1326316632,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I remember a few people talking about CR, but can't recall any actual weddings there.\u00a0 But here is a link that would be sure to contain any information available:<\/p> <p> \u00a0<\/p> <p id=\"yui_3_4_1_7_1326314668539_27\"  style=\"background-color: rgb(253,252,250);font-family: arial, helvetica, sans-serif;color: rgb(24,24,24)\"> <a href='http:\/\/www.bestdestinationwedding.com\/f\/99\/central-south-america-weddings' class='bbc_url' title=''>Central & South America Wedding<\/a>\u00a0(Costa Rica & Belize)<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"carlydorazio@gmail.com","IpAddress":"72.92.56.95","GroupId":46,"GroupName":"VIP Member","JoinDate":1177548900,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207375.jpg?_r=1414982962","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"boscobel","Id":207375,"Name":"boscobel","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":65185,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5b22427f950a1b79a512ac869b528797","RawContent":"&lt;p&gt; Hi there,&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Costa Rica is a super lovely place for a destination wedding. We are wedding photographers that live here for about half the year shooting lovely dest weddings for couples from all over. Our company is called A Brit &amp;amp; A Blonde. My name is Jessica Hill and my husband (The Brit) and I shoot the weddings together. I happily play the part of the the Blonde and the Canadian.&amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; The rest of the year we shoot fab weddings in Canada and the US.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; If you are interested to check out some of our work, check out our website: abritandablonde.com&lt;\/p&gt; &lt;p&gt; On our blog which we are always updating you can also check out our recent weddings and also peruse which ones you may like as venues for your big day.&amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Our website has our contact email address. Send me an email and I would be happy to provide you with the best top wedding planners we work with here in sunny Costa Rica.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; all the best!\n jessica&lt;\/p&gt;","Attachments":[],"Id":1567321,"PostDate":1326382270,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hi there,<\/p> <p> \u00a0<\/p> <p> Costa Rica is a super lovely place for a destination wedding. We are wedding photographers that live here for about half the year shooting lovely dest weddings for couples from all over. Our company is called A Brit & A Blonde. My name is Jessica Hill and my husband (The Brit) and I shoot the weddings together. I happily play the part of the the Blonde and the Canadian.\u00a0<\/p> <p> \u00a0<\/p> <p> The rest of the year we shoot fab weddings in Canada and the US.<\/p> <p> \u00a0<\/p> <p> If you are interested to check out some of our work, check out our website: abritandablonde.com<\/p> <p> On our blog which we are always updating you can also check out our recent weddings and also peruse which ones you may like as venues for your big day.\u00a0<\/p> <p> \u00a0<\/p> <p> Our website has our contact email address. Send me an email and I would be happy to provide you with the best top wedding planners we work with here in sunny Costa Rica.<\/p> <p> \u00a0<\/p> <p> all the best!<br \/> jessica<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jesshill2000@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1326382010,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-249788.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"aBrit aBlonde","Id":249788,"Name":"aBrit aBlonde","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"142.205.241.254","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":65185,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"46e7289b06346547a8683e5a3424965f","RawContent":"&lt;p&gt;Haven&#039;t heard of it for a wedding, but have had a few friends go for their honeymoon and they loved it and definitely recommend visiting&lt;\/p&gt;","Attachments":[],"Id":1842588,"PostDate":1396633081,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Haven't heard of it for a wedding, but have had a few friends go for their honeymoon and they loved it and definitely recommend visiting<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"bluestarfish@hotmail.com","IpAddress":"24.78.214.142","GroupId":40,"GroupName":"Jr. Member","JoinDate":1396233643,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Kyliewylie","Id":277410,"Name":"Kyliewylie","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.229.253.28","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":65185,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"77bb29132c61dc89ba245fb96e5f068f","RawContent":"Costa Rica is on my list I gave my travel agent. Very curious about prices there","Attachments":[],"Id":1855191,"PostDate":1402716040,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Costa Rica is on my list I gave my travel agent. Very curious about prices there \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"Using Tapatalk","Email":"kiannabanana69@gmail.com","IpAddress":"200.106.87.106","GroupId":3,"GroupName":"Member","JoinDate":1397902614,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277650.png?_r=1402827462","PhotoWidth":60,"PhotoHeight":80,"PhotoType":"custom"},"FormattedName":"MrsRoy","Id":277650,"Name":"MrsRoy","IsOnline":false}}],"Id":"65185","Title":"Costa Rica weddings??","LastPostDate":1402716040},"Pages":{"TotalItems":5,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
