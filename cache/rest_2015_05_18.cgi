{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":27,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":1482,"MovedTo":null,"MovedOn":0,"FirstPostId":1672428,"Rating":0,"RatingHits":0,"Starter":{"Id":241155,"Name":"casontag","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-241155.jpeg?_r=0","PhotoWidth":180,"PhotoHeight":161,"PhotoType":"custom"},"IsOnline":false},"StartDate":1349875404,"LastPoster":{"Id":258970,"Name":"MJTK","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-258970.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":112,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":57,"Preview":{"Id":1672428,"PostDate":1349875404,"PostContent":"I have wanted to get married for years, but our family has always come first. We have two little...","Author":{"Signature":"","Email":"sontag_carlie@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1308099208,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-241155.jpeg?_r=0","PhotoWidth":180,"PhotoHeight":161,"PhotoType":"custom"},"FormattedName":"casontag","Id":241155,"Name":"casontag","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":69796,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a627cd5b18312a4c74d6f78ac657be8b","RawContent":"I have wanted to get married for years, but our family has always come first. We have two little ones :)! Anyone else out there paying for their own? We have descided to take a vacation and elope with an invitation. We can&#039;t afford to pay for a large traditional wedding and our families will still be mad if we elope. So we have described to get married in key west May 19, 2013 and give our families a heads up if they want to go, but everyone will have to pay for themselves including dinner. I wish we could afford to pay at least for dinner, but that just is not possible considering we will have to pay for everything ourselves. Most of our family is on board, but some still can&#039;t afford to go. It&#039;s been so hard convincing my family that this is what I want to do! They would prefer I go to the JP and then leave for out hunneymoon. Anyone else going this route?","Attachments":[],"Id":1672428,"PostDate":1349875404,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I have wanted to get married for years, but our family has always come first. We have two little ones <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>! Anyone else out there paying for their own? We have descided to take a vacation and elope with an invitation. We can't afford to pay for a large traditional wedding and our families will still be mad if we elope. So we have described to get married in key west May 19, 2013 and give our families a heads up if they want to go, but everyone will have to pay for themselves including dinner. I wish we could afford to pay at least for dinner, but that just is not possible considering we will have to pay for everything ourselves. Most of our family is on board, but some still can't afford to go. It's been so hard convincing my family that this is what I want to do! They would prefer I go to the JP and then leave for out hunneymoon. Anyone else going this route?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sontag_carlie@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1308099208,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-241155.jpeg?_r=0","PhotoWidth":180,"PhotoHeight":161,"PhotoType":"custom"},"FormattedName":"casontag","Id":241155,"Name":"casontag","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":69796,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4501ccedc19e43217af01e90d387503b","RawContent":"&lt;p&gt; You can also choose a affordable wedding venue which suits to your budget that not cost so much and that makes your wedding in budget .&lt;\/p&gt;","Attachments":[],"Id":1779920,"PostDate":1374154764,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> You can also choose a affordable wedding venue which suits to your budget that not cost so much and that makes your wedding in budget .<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"seo4gwb@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1374144276,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-271678.png?_r=0","PhotoWidth":150,"PhotoHeight":65,"PhotoType":"custom"},"FormattedName":"raymond","Id":271678,"Name":"raymond","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":69796,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"99004dbaea5bcacf6d12a6ab00221c07","RawContent":"&lt;p&gt; We are paying for our own, and will be saving hard for the next year to do so.... we are obviously cutting a lot of things, because we can&#039; afford a massive wedding but at the same time we are adding a lot of small personal things to make it special! Your limit is your imagination! :)&lt;\/p&gt;","Attachments":[],"Id":1794880,"PostDate":1377538778,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> We are paying for our own, and will be saving hard for the next year to do so.... we are obviously cutting a lot of things, because we can' afford a massive wedding but at the same time we are adding a lot of small personal things to make it special! Your limit is your imagination! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"xarocas@hotmail.com","IpAddress":"92.24.83.173","GroupId":40,"GroupName":"Jr. Member","JoinDate":1376041591,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272399.jpeg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Xarocas","Id":272399,"Name":"Xarocas","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":69796,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"63d6f1c19649352c7caab6a5784b169f","RawContent":"A are paying for our own. We have been saving for this last year and are track for what we need.","Attachments":[],"Id":1796904,"PostDate":1378153376,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                A are paying for our own. We have been saving for this last year and are track for what we need.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"bride@cancunwedding.us","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1371843764,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270816.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"bridemoonpalace","Id":270816,"Name":"bridemoonpalace","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":69796,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"74973321d00ac8b540e1b0afaf7eb0bb","RawContent":"&lt;p&gt;We are paying our own way as well. &amp;nbsp;Since we have a year and some months to plan. I have decided to focus on the things that are most important to me. So every month I put enough away and focus on that one thing. &amp;nbsp;Even if it is saving up for a photographer. &amp;nbsp;I have had 2 garage sales, began clipping coupons again.&amp;nbsp;&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;The money I save from coupons I transfer over to a saving account before I leave the grocery store. &amp;nbsp;&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;Every penny adds up&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1798286,"PostDate":1378597302,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>We are paying our own way as well. \u00a0Since we have a year and some months to plan. I have decided to focus on the things that are most important to me. So every month I put enough away and focus on that one thing. \u00a0Even if it is saving up for a photographer. \u00a0I have had 2 garage sales, began clipping coupons again.\u00a0<\/p> <p>\u00a0<\/p> <p>The money I save from coupons I transfer over to a saving account before I leave the grocery store. \u00a0<\/p> <p>\u00a0<\/p> <p>Every penny adds up\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tracynichols@sbcglobal.net","IpAddress":"99.89.189.10","GroupId":40,"GroupName":"Jr. Member","JoinDate":1264841241,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-225165.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"traylynn","Id":225165,"Name":"traylynn","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.35.4.66","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":69796,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"023600ce2bf177db9f8536544e7efa49","RawContent":"&lt;p&gt;congrats&lt;\/p&gt;\n\n&lt;p&gt;:)&lt;\/p&gt;","Attachments":[],"Id":1822596,"PostDate":1388878355,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>congrats<\/p>\n<br \/><p><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rep264@nyu.edu","IpAddress":"108.35.101.59","GroupId":40,"GroupName":"Jr. Member","JoinDate":1388860269,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"REP","Id":275873,"Name":"REP","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.246.2.51","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":69796,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1903b539a88290664d4350865f6857ba","RawContent":"&lt;p&gt;we are paying for our own and it has been hard.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I work 3 jobs and my FI works 6days a week.&amp;nbsp; we decided to do destination bc it was more affordable and also counts as our honeymoon.&amp;nbsp; Our registry is also a honeymoon registry that will go directly to helping us afford our stay.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;When booking, I didn&#039;t care what the families thought.&amp;nbsp; If they don&#039;t want to help pay for stuff then they don&#039;t get a say.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1827540,"PostDate":1390243598,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>we are paying for our own and it has been hard.<\/p>\n<p>\u00a0<\/p>\n<p>I work 3 jobs and my FI works 6days a week.\u00a0 we decided to do destination bc it was more affordable and also counts as our honeymoon.\u00a0 Our registry is also a honeymoon registry that will go directly to helping us afford our stay.<\/p>\n<p>\u00a0<\/p>\n<p>When booking, I didn't care what the families thought.\u00a0 If they don't want to help pay for stuff then they don't get a say.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"talicea7812@gmail.com","IpAddress":"98.114.237.105","GroupId":40,"GroupName":"Jr. Member","JoinDate":1387574554,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275695.jpg?_r=1398892094","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"talicea7812","Id":275695,"Name":"talicea7812","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.239.166.98","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":69796,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"286bb2fa24f3188fae92300f49dc67aa","RawContent":"&lt;p&gt;We\u2019re paying for our own too even though my parents want to help out, but if they help out I\u2019m afraid that the money would come between us\/be used as a bargaining tool. Also, I\u2019m of the mentality that if you and your FI can\u2019t pay for your wedding, maybe you\u2019re not ready to get married! Financial independence is very important to me. My parents would be happier if we were having a huge local wedding and not a small destination wedding, but they understand that in the end it\u2019s our decision.&lt;\/p&gt;","Attachments":[],"Id":1829363,"PostDate":1390924879,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>We\u2019re paying for our own too even though my parents want to help out, but if they help out I\u2019m afraid that the money would come between us\/be used as a bargaining tool. Also, I\u2019m of the mentality that if you and your FI can\u2019t pay for your wedding, maybe you\u2019re not ready to get married! Financial independence is very important to me. My parents would be happier if we were having a huge local wedding and not a small destination wedding, but they understand that in the end it\u2019s our decision.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"smitha_r@yahoo.com","IpAddress":"99.244.114.38","GroupId":39,"GroupName":"Newbie","JoinDate":1389143480,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275928.jpg?_r=1403747949","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"mysticjade","Id":275928,"Name":"mysticjade","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"67.175.107.83","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":69796,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3edf5dfa3e1fcf5d1283536142146022","RawContent":"&lt;p&gt;That&#039;s part of the reason we chose a DW...we&#039;ve got a little one, too!.&amp;nbsp; We are combining the wedding and honeymoon at the same resort, and found a promotion that saves us a ton of money in lodging.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1831009,"PostDate":1391284830,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>That's part of the reason we chose a DW...we've got a little one, too!.\u00a0 We are combining the wedding and honeymoon at the same resort, and found a promotion that saves us a ton of money in lodging.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"a.baio330@gmail.com","IpAddress":"38.104.228.158","GroupId":40,"GroupName":"Jr. Member","JoinDate":1369663457,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-269996.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"amy330","Id":269996,"Name":"amy330","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.241.172.74","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":69796,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cc1841eeda99e5e8ae56dd3f82bb8163","RawContent":"&lt;p&gt;We&#039;re paying for our own as well. That&#039;s why we chose DW-cheaper than an AHR and we get to have our honeymoon at the same time.&lt;\/p&gt;","Attachments":[],"Id":1831026,"PostDate":1391285591,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>We're paying for our own as well. That's why we chose DW-cheaper than an AHR and we get to have our honeymoon at the same time.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"csonnel@live.com","IpAddress":"99.241.172.74","GroupId":40,"GroupName":"Jr. Member","JoinDate":1390342680,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276245.jpg?_r=1391031473","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Csonnel","Id":276245,"Name":"Csonnel","IsOnline":false}}],"Id":"69796","Title":"Paying for our own. ","LastPostDate":1406782859},"Pages":{"TotalItems":27,"TotalPages":3,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":20},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
