:"66.87.153.64","GroupId":40,"GroupName":"Jr. Member","JoinDate":1351610319,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-261914.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Maybeachbride","Id":261914,"Name":"Maybeachbride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":70637,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b74a5064827826504f7de64b0e4b4331","RawContent":"My groom and groomsmen are definitely wearing linen pants and some type of white button down. They will also be sporting TOMS. Those will be the groomsmen gifts.","Attachments":[],"Id":1699369,"PostDate":1356990764,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                My groom and groomsmen are definitely wearing linen pants and some type of white button down. They will also be sporting TOMS. Those will be the groomsmen gifts.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"Cookieg617@gmail.com","IpAddress":"68.193.163.24","GroupId":40,"GroupName":"Jr. Member","JoinDate":1337739229,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"none"},"FormattedName":"LoriGran","Id":255715,"Name":"LoriGran","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":70637,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2b74be8283374663dd6b76aa6e84a1cc","RawContent":"&lt;p&gt;This is what I have been looking for&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1798294,"PostDate":1378598301,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>This is what I have been looking for\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tracynichols@sbcglobal.net","IpAddress":"99.89.189.10","GroupId":40,"GroupName":"Jr. Member","JoinDate":1264841241,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-225165.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"traylynn","Id":225165,"Name":"traylynn","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":70637,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f2a88e699a3fcf6731444efcc7a66bc8","RawContent":"My guys are wearing off white linen pants ( I don&#039;t want them to white or my dress will look dull ), my groom will have a black dress shirt and the groomsmen will have a dark silver dress shirt. I think we will just have them wear sandals :-)","Attachments":[],"Id":1799259,"PostDate":1378923367,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                My guys are wearing off white linen pants ( I don't want them to white or my dress will look dull ), my groom will have a black dress shirt and the groomsmen will have a dark silver dress shirt. I think we will just have them wear sandals :-)\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jenny091@hotmail.ca","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1374432997,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-271765.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"jypsejenny","Id":271765,"Name":"jypsejenny","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":70637,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c0b9c9f8d0d94d35dc6a1d65e785f8a8","RawContent":"My H2b is wearing a navy Hugo Boss suit with a white open neck shirt and dark brown leather flip flops. Our boys 13, 16 and 21 are wearing the same but no jacket x","Attachments":[],"Id":1799943,"PostDate":1379111357,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                My H2b is wearing a navy Hugo Boss suit with a white open neck shirt and dark brown leather flip flops. Our boys 13, 16 and 21 are wearing the same but no jacket x\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lou.melling2@hotmail.co.uk","IpAddress":"80.193.8.249","GroupId":39,"GroupName":"Newbie","JoinDate":1375946848,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272364.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"MrsSmith2BMex","Id":272364,"Name":"MrsSmith2BMex","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.246.2.51","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":70637,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2ba7d1ea44016002238c660837915c83","RawContent":"&lt;p&gt;the grey groomsmen pic is what im going for... saw the same pic and loved it.&amp;nbsp; not sure about ties.&amp;nbsp; Groomsmen in white and FI in a color so he stands out.. not 100% yet&lt;\/p&gt;","Attachments":[],"Id":1827544,"PostDate":1390243848,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>the grey groomsmen pic is what im going for... saw the same pic and loved it.\u00a0 not sure about ties.\u00a0 Groomsmen in white and FI in a color so he stands out.. not 100% yet<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"talicea7812@gmail.com","IpAddress":"98.114.237.105","GroupId":40,"GroupName":"Jr. Member","JoinDate":1387574554,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275695.jpg?_r=1398892094","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"talicea7812","Id":275695,"Name":"talicea7812","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"67.175.107.83","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":70637,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c88d030d085fa917fc19c55873c7c106","RawContent":"&lt;p&gt;I&#039;m still stuck, too...and it&#039;s even tougher because we want him and our son to match, and he&#039;s only 1!&lt;\/p&gt;","Attachments":[],"Id":1831015,"PostDate":1391285165,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I'm still stuck, too...and it's even tougher because we want him and our son to match, and he's only 1!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"a.baio330@gmail.com","IpAddress":"38.104.228.158","GroupId":40,"GroupName":"Jr. Member","JoinDate":1369663457,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-269996.