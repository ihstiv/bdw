/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"rasuei","Id":243737,"Name":"rasuei","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62835,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"89b803cc3f0725709e5f40a126eed709","RawContent":"&lt;p&gt; The two dresses are very different silhouettes. I would choose based on your body type and which silhouette will compliment it the best.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Here is an article on theknot.com that talks about the right wedding dress for your body type: &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/wedding.theknot.com\/bridal-fashion\/wedding-dress-shopping\/articles\/wedding-gown-find-the-right-fit-for-you.aspx\"&gt;http:\/\/wedding.theknot.com\/bridal-fashion\/wedding-dress-shopping\/articles\/wedding-gown-find-the-right-fit-for-you.aspx&lt;\/a&gt;. Hopefully this will help you to decide!&lt;\/p&gt;","Attachments":[],"Id":1505238,"PostDate":1313504428,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> The two dresses are very different silhouettes. I would choose based on your body type and which silhouette will compliment it the best.<\/p> <p> \u00a0<\/p> <p> Here is an article on theknot.com that talks about the right wedding dress for your body type: <a href='http:\/\/wedding.theknot.com\/bridal-fashion\/wedding-dress-shopping\/articles\/wedding-gown-find-the-right-fit-for-you.aspx' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/wedding.thekn...it-for-you.aspx<\/a>. Hopefully this will help you to decide!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"julia.mastrapasqua@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1242427623,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-217582.jpg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"jmastr05","Id":217582,"Name":"jmastr05","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62835,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"79103edb40ea24ff997c905c32a5cb73","RawContent":"&lt;p&gt; Oh yes, these are very different dresses.&amp;nbsp; I assume you&#039;ll be ordering these online so you won&#039;t be able to try them on... but I&#039;d go to a bridal store and try on these shapes and see what flatters you most.&amp;nbsp; It&#039;s amazing how different they are in a picture vs on your body.&lt;\/p&gt;","Attachments":[],"Id":1505243,"PostDate":1313504838,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Oh yes, these are very different dresses.\u00a0 I assume you'll be ordering these online so you won't be able to try them on... but I'd go to a bridal store and try on these shapes and see what flatters you most.\u00a0 It's amazing how different they are in a picture vs on your body.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"~Trisha~<br \/>\n<a class='bbc_url' href='http:\/\/www.faberphotography.com'>www.faberphotography.com<\/a><br \/>\n<br \/>\nMy latest destination wedding photos can be found <a class='bbc_url' href='http:\/\/faberphotography.com\/destination-wedding\/'>HERE<\/a>","Email":"tfaber@wbmi.com","IpAddress":"12.24.226.126","GroupId":46,"GroupName":"VIP Member","JoinDate":1172013300,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207201.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"Tlseege","Id":207201,"Name":"Tlseege","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62835,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f92f1ce94ef5b0434418e07503658e6a","RawContent":"&lt;p&gt; I agree with Trisha above. go to a bridal store and see which shape fits you better. I did the same thing; found a dress on line and fell in love with it, but it turned out that the dress was not for me. .. ..&lt;\/p&gt;","Attachments":[],"Id":1505271,"PostDate":1313506841,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I agree with Trisha above. go to a bridal store and see which shape fits you better. I did the same thing; found a dress on line and fell in love with it, but it turned out that the dress was not for me. .. ..<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"magdal89@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1264393820,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-225008.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"bmadzia1","Id":225008,"Name":"bmadzia1","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62835,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b1bcc8a5c43770f8bd28b664c0965df6","RawContent":"&lt;p&gt; TIseege and bmadzia are right. I was attacted to flowy chiffon dresses. But since I am short, instead of looking long and flowy,&amp;nbsp;I looked like&amp;nbsp;I was a kid&amp;nbsp;wearing my moms night gown. I realized that I needed to look for a different style. Some dresses are just not for certain body times.&lt;\/p&gt;","Attachments":[],"Id":1507940,"PostDate":1313867200,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> TIseege and bmadzia are right. I was attacted to flowy chiffon dresses. But since I am short, instead of looking long and flowy,\u00a0I looked like\u00a0I was a kid\u00a0wearing my moms night gown. I realized that I needed to look for a different style. Some dresses are just not for certain body times.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"julia.mastrapasqua@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1242427623,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-217582.jpg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"jmastr05","Id":217582,"Name":"jmastr05","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62835,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"04297946f2e3e018bb0f2bd0bbad1884","RawContent":"I agree\n   [quote]\nOriginally Posted by [b]Tlseege[\/b] \/img\/forum\/go_quote.gif\n \n \n Oh yes, these are very different dresses.  I assume you&#039;ll be ordering these online so you won&#039;t be able to try them on... but I&#039;d go to a bridal store and try on these shapes and see what flatters you most.  It&#039;s amazing how different they are in a picture vs on your body.[\/quote]","Attachments":[],"Id":1508225,"PostDate":1313955563,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I agree<br \/> \u00a0<\/p> <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>Tlseege<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" style=\"border: 0px solid;\" \/><\/span><br \/> <br \/> <p> Oh yes, these are very different dresses.\u00a0 I assume you'll be ordering these online so you won't be able to try them on... but I'd go to a bridal store and try on these shapes and see what flatters you most.\u00a0 It's amazing how different they are in a picture vs on your body.<\/p> <\/blockquote> <br \/> <br \/> <p> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"vasheets@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1311732119,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-242833.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Aruba Bride","Id":242833,"Name":"Aruba Bride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62835,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"56b5c0638fd9b1b375aaa2b667e61721","RawContent":"&lt;p&gt; Both beautiful!&amp;nbsp; I liked the second one the best!&lt;\/p&gt;","Attachments":[],"Id":1508235,"PostDate":1313956549,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Both beautiful!\u00a0 I liked the second one the best!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"KerryL613@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1293575675,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-234861.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"KerryL613","Id":234861,"Name":"KerryL613","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62835,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"15f56ab9ecf5802bba0f689fc076565b","RawContent":"&lt;p&gt; I agree with everyone, definetly go to a salon and try on the dresses before hand so you know what you like.. and I&#039;m hoping you are getting married in 2012 not Nov 12th of this year, I&#039;m getting married the same date and when you order a dress sometimes theres a 2-3 month wait and our wedding is in less than 3 months..&lt;\/p&gt;","Attachments":[],"Id":1508238,"PostDate":1313956695,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I agree with everyone, definetly go to a salon and try on the dresses before hand so you know what you like.. and I'm hoping you are getting married in 2012 not Nov 12th of this year, I'm getting married the same date and when you order a dress sometimes theres a 2-3 month wait and our wedding is in less than 3 months..<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jlarruda@verizon.net","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1288842293,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-233698.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"jlarruda","Id":233698,"Name":"jlarruda","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62835,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"45e157421e1f186cdc83104a4c0d2a3a","RawContent":"&lt;p&gt; I like #2&lt;\/p&gt;","Attachments":[],"Id":1562366,"PostDate":1325538687,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I like #2<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><p><span><span style=\"font-size:12px;\"><strong>Jen<\/strong><\/span><\/span><\/p><span><\/span><\/div><\/div>","Email":"07stanggirl@comcast.net","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1321538383,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-247782.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Jber713","Id":247782,"Name":"Jber713","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62835,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bae5c7c24b0839a2a20dae40b1cc67f4","RawContent":"&lt;p&gt; I like no.1. Just like everyone said, I had a dress in mind and saw similar style online. Only after I went out and actually tried on dress, did I realized some styles are more suitable than others for my body type. &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1579249,"PostDate":1328641837,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I like no.1. Just like everyone said, I had a dress in mind and saw similar style online. Only after I went out and actually tried on dress, did I realized some styles are more suitable than others for my body type. \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mysecreteden@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1308707404,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-241418.jpg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"mysecreteden","Id":241418,"Name":"mysecreteden","IsOnline":false}}],"Id":"62835","Title":"Which dress is more beautiful ?  I really need your help","LastPostDate":1389903095},"Pages":{"TotalItems":22,"TotalPages":3,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":20},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
