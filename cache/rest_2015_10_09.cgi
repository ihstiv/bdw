0 people going.\u00a0 I'm counting the hours and minutes <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"soccer1615@aol.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1278617166,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230015.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"SOCCER1615","Id":230015,"Name":"SOCCER1615","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":66882,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"643329629ff49eb3b75b322bdf3df57b","RawContent":"Love your planning so far! And the turtle proposal was adorable!","Attachments":[],"Id":1636670,"PostDate":1341052097,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Love your planning so far! And the turtle proposal was adorable!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"Elizabeth_ann_hills@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1335989515,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-254865.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Lizrmt","Id":254865,"Name":"Lizrmt","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":66882,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"25a42c628b012102cff8406b8cda92e4","RawContent":"&lt;p&gt; My DIY creations so far:&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"\" data-id=\"164962\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/164962\/width\/350\/height\/700\" \/&gt;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"\" data-id=\"164973\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/164973\/width\/350\/height\/700\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"\" data-id=\"164974\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/164974\/width\/350\/height\/700\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"\" data-id=\"164963\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/164963\/width\/350\/height\/700\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"\" data-id=\"164964\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/164964\/width\/350\/height\/700\" \/&gt;&lt;img alt=\"\" data-id=\"164975\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/164975\/width\/350\/height\/700\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"\" data-id=\"164965\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/164965\/width\/350\/height\/700\" \/&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"\" data-id=\"164976\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/164976\/width\/350\/height\/700\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"\" data-id=\"164977\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/164977\/width\/350\/height\/700\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"\" data-id=\"164978\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/164978\/width\/350\/height\/700\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"\" data-id=\"164979\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/164979\/width\/350\/height\/700\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"color: rgb(34, 34, 34); font-family: Calibri; line-height: 18px; \"&gt;FI and I have finally managed to book the date for our wedding! August 23rd 2013 :)&lt;\/span&gt;&lt;br style=\"color: rgb(34, 34, 34); font-family: Calibri; line-height: 18px; \" \/&gt; &lt;br style=\"color: rgb(34, 34, 34); font-family: Calibri; line-height: 18px; \" \/&gt; &lt;span style=\"color: rgb(34, 34, 34); font-family: Calibri; line-height: 18px; \"&gt;We are both booked, as well as our first set of guests:&amp;nbsp;my parents and sister, FI&#039;s mum and Stepdad, my oldest school friend and her partner, my bridesmaid and FI&#039;s best man.&lt;\/span&gt;&lt;br style=\"color: rgb(34, 34, 34); font-family: Calibri; line-height: 18px; \" \/&gt; &lt;br style=\"color: rgb(34, 34, 34); font-family: Calibri; line-height: 18px; \" \/&gt; &lt;span style=\"color: rgb(34, 34, 34); font-family: Calibri; line-height: 18px; \"&gt;Here are my home made invitations. It&#039;s a bit weird sending out invites *after* some people have booked, but I guess that&#039;s one of the skewed traditions when it comes to Destination Weddings.&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"\" data-id=\"164966\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/164966\/width\/350\/height\/700\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"\" data-id=\"164967\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/164967\/width\/350\/height\/700\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"\" data-id=\"164968\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/164968\/width\/350\/height\/700\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"\" data-id=\"164969\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/164969\/width\/350\/height\/700\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"\" data-id=\"164970\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/164970\/width\/350\/height\/700\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"\" data-id=\"164971\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/164971\/width\/350\/height\/700\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"\" data-id=\"164972\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/164972\/width\/350\/height\/700\" \/&gt;&lt;\/p&gt;","Attachments":[],"Id":1668321,"PostDate":1348914582,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> My DIY creations so far:<\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"\" data-id=\"164962\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/164962\/width\/350\/height\/700\" \/><\/span><\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"\" data-id=\"164973\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/164973\/width\/350\/height\/700\" \/><\/span><\/p> <p> \u00a0<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"\" data-id=\"164974\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/164974\/width\/350\/height\/700\" \/><\/span><\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"\" data-id=\"164963\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/164963\/width\/350\/height\/700\" \/><\/span><\/p> <p> \u00a0<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"\" data-id=\"164964\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/164964\/width\/350\/height\/700\" \/><\/span><span rel='lightbox'><img class='bbc_img' alt=\"\" data-id=\"164975\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/164975\/width\/350\/height\/700\" \/><\/span><\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"\" data-id=\"164965\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/164965\/width\/350\/height\/700\" \/><\/span>\u00a0<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"\" data-id=\"164976\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/164976\/width\/350\/height\/700\" \/><\/span><\/p> <p> \u00a0<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"\" data-id=\"164977\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/164977\/width\/350\/height\/700\" \/><\/span><\/p> <p> \u00a0<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"\" data-id=\"164978\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/164978\/width\/350\/height\/700\" \/><\/span><\/p> <p> \u00a0<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"\" data-id=\"164979\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/164979\/width\/350\/height\/700\" \/><\/span><\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <p> <span  style=\"color: rgb(34, 34, 34);font-family: Calibri\">FI and I have finally managed to book the date for our wedding! August 23rd 2013 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/span><br style=\"color: rgb(34, 34, 34); font-family: Calibri; line-height: 18px; \" \/> <br style=\"color: rgb(34, 34, 34); font-family: Calibri; line-height: 18px; \" \/> <span  style=\"color: rgb(34, 34, 34);font-family: Calibri\">We are both booked, as well as our first set of guests:\u00a0my parents and sister, FI's mum and Stepdad, my oldest school friend and her partner, my bridesmaid and FI's best man.<\/span><br style=\"color: rgb(34, 34, 34); font-family: Calibri; line-height: 18px; \" \/> <br style=\"color: rgb(34, 34, 34); font-family: Calibri; line-height: 18px; \" \/> <span  style=\"color: rgb(34, 34, 34);font-family: Calibri\">Here are my home made invitations. It's a bit weird sending out invites *after* some people have booked, but I guess that's one of the skewed traditions when it comes to Destination Weddings.<\/span><\/p> <p> \u00a0<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"\" data-id=\"164966\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/164966\/width\/350\/height\/700\" \/><\/span><\/p> <p> \u00a0<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"\" data-id=\"164967\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/164967\/width\/350\/height\/700\" \/><\/span><\/p> <p> \u00a0<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"\" data-id=\"164968\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/164968\/width\/350\/height\/700\" \/><\/span><\/p> <p> \u00a0<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"\" data-id=\"164969\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/164969\/width\/350\/height\/700\" \/><\/span><\/p> <p> \u00a0<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"\" data-id=\"164970\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/164970\/width\/350\/height\/700\" \/><\/span><\/p> <p> \u00a0<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"\" data-id=\"164971\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/164971\/width\/350\/height\/700\" \/><\/span><\/p> <p> \u00a0<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"\" data-id=\"164972\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/164972\/width\/350\/height\/700\" \/><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kimmymallet@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1268405544,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/b\/bd\/bd7c2240_user-25597-avatar?_r=0","PhotoWidth":180,"PhotoHeight":119,"PhotoType":"custom"},"FormattedName":"kkimi88","Id":226396,"Name":"kkimi88","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":66882,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2bc4618ee0351b529e0d9b2e1245e192","RawContent":"&lt;p&gt; The back drop for our photobooth:&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"\" data-id=\"165041\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/165041\/width\/350\/height\/700\" \/&gt;&lt;\/p&gt;","Attachments":[],"Id":1668522,"PostDate":1349005590,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> The back drop for our photobooth:<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"\" data-id=\"165041\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/165041\/width\/350\/height\/700\" \/><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kimmymallet@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1268405544,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/b\/bd\/bd7c2240_user-25597-avatar?_r=0","PhotoWidth":180,"PhotoHeight":119,"PhotoType":"custom"},"FormattedName":"kkimi88","Id":226396,"Name":"kkimi88","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":66882,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8759fe3bcd3598a335ca46c0a29263d6","RawContent":"&lt;p&gt; Our matching straws:&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p id=\"yui_3_5_1_1_1349019711963_2657\"&gt; &lt;img alt=\"\" data-id=\"165063\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/165063\/width\/350\/height\/700\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Our ring box:&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p id=\"yui_3_5_1_1_1349019711963_3572\"&gt; &lt;img alt=\"\" data-id=\"165064\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/165064\/width\/350\/height\/700\" \/&gt;&lt;\/p&gt;","Attachments":[],"Id":1668577,"PostDate":1349022186,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Our matching straws:<\/p> <p> \u00a0<\/p> <p id=\"yui_3_5_1_1_1349019711963_2657\"> <span rel='lightbox'><img class='bbc_img' alt=\"\" data-id=\"165063\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/165063\/width\/350\/height\/700\" \/><\/span><\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <p> Our ring box:<\/p> <p> \u00a0<\/p> <p id=\"yui_3_5_1_1_1349019711963_3572\"> <span rel='lightbox'><img class='bbc_img' alt=\"\" data-id=\"165064\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/165064\/width\/350\/height\/700\" \/><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kimmymallet@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1268405544,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/b\/bd\/bd7c2240_user-25597-avatar?_r=0","PhotoWidth":180,"PhotoHeight":119,"PhotoType":"custom"},"FormattedName":"kkimi88","Id":226396,"Name":"kkimi88","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":66882,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fdef231ce58bf86e0cb24bd9d4f49408","RawContent":"&lt;p&gt; In the last few weeks we finally found bridesmaid dresses that I and both my girls loved:&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p id=\"yui_3_5_1_1_1349019711963_4538\"&gt; &lt;img alt=\"\" data-id=\"165065\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/165065\/width\/350\/height\/700\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; We also found FI&#039;s suit today! FI will be wearing this with a white shirt and turquoise accents. Groomsmen will be wearing the trousers, a white shirt and purple accents.&amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p id=\"yui_3_5_1_1_1349019711963_5319\"&gt; &lt;img alt=\"\" data-id=\"165066\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/165066\/width\/350\/height\/700\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; As yet I still have no dress, but this is what I&#039;m looking for (anyone more in the know, dress-wise, have any suggestions???)&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p id=\"yui_3_5_1_1_1349019711963_6102\"&gt; &lt;img alt=\"\" data-id=\"165067\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/165067\/width\/350\/height\/700\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; And this is the dress I have bought for my AHR.&amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p id=\"yui_3_5_1_1_1349019711963_6870\"&gt; &lt;img alt=\"\" data-id=\"165068\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/165068\/width\/350\/height\/700\" \/&gt;&lt;\/p&gt;","Attachments":[],"Id":1668579,"PostDate":1349022805,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> In the last few weeks we finally found bridesmaid dresses that I and both my girls loved:<\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <p id=\"yui_3_5_1_1_1349019711963_4538\"> <span rel='lightbox'><img class='bbc_img' alt=\"\" data-id=\"165065\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/165065\/width\/350\/height\/700\" \/><\/span><\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <p> We also found FI's suit today! FI will be wearing this with a white shirt and turquoise accents. Groomsmen will be wearing the trousers, a white shirt and purple accents.\u00a0<\/p> <p> \u00a0<\/p> <p id=\"yui_3_5_1_1_1349019711963_5319\"> <span rel='lightbox'><img class='bbc_img' alt=\"\" data-id=\"165066\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/165066\/width\/350\/height\/700\" \/><\/span><\/p> <p> \u00a0<\/p> <p> As yet I still have no dress, but this is what I'm looking for (anyone more in the know, dress-wise, have any suggestions???)<\/p> <p> \u00a0<\/p> <p id=\"yui_3_5_1_1_1349019711963_6102\"> <span rel='lightbox'><img class='bbc_img' alt=\"\" data-id=\"165067\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/165067\/width\/350\/height\/700\" \/><\/span><\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <p> And this is the dress I have bought for my AHR.\u00a0<\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <p id=\"yui_3_5_1_1_1349019711963_6870\"> <span rel='lightbox'><img class='bbc_img' alt=\"\" data-id=\"165068\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/165068\/width\/350\/height\/700\" \/><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kimmymallet@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1268405544,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/b\/bd\/bd7c2240_user-25597-avatar?_r=0","PhotoWidth":180,"PhotoHeight":119,"PhotoType":"custom"},"FormattedName":"kkimi88","Id":226396,"Name":"kkimi88","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":66882,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c909e346c144dec0c030d948f4fef871","RawContent":"Everything looks great! Love the i spy and I LOVE the AHR dress. Where did you find it or who is the designer?","Attachments":[],"Id":1668581,"PostDate":1349023560,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Everything looks great! Love the i spy and I LOVE the AHR dress. Where did you find it or who is the designer?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"Enjoythepartykm@aol.com","IpAddress":"68.13.213.79","GroupId":3,"GroupName":"Member","JoinDate":1343379180,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-258455.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Tulumbride2013","Id":258455,"Name":"Tulumbride2013","IsOnline":false}}],"Pages":{"TotalItems":56,"TotalPages":6,"CurrentPage":10,"NextPage":20,"PreviousPage":0,"LastPage":50},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
