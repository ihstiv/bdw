otoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"seka21","Id":277895,"Name":"seka21","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"174.117.76.99","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73939,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b5db43efa228acf5c33915c5abd3e93b","RawContent":"Thanks for sharing","Attachments":[],"Id":1855811,"PostDate":1403028381,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks for sharing \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"taryn_henderson@hotmail.com","IpAddress":"174.117.76.99","GroupId":40,"GroupName":"Jr. Member","JoinDate":1402938094,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"tarynh86","Id":278544,"Name":"tarynh86","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"166.137.246.32","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73939,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5e0dfc5eb6f89be4740566cdfabf4e35","RawContent":"How did you make the invitations with your cricut? They&#039;re beautiful! This is what I want mine to look like, but I don&#039;t want to pay $500 for them.","Attachments":[],"Id":1876719,"PostDate":1414067553,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                How did you make the invitations with your cricut? They're beautiful! This is what I want mine to look like, but I don't want to pay $500 for them.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"maira_a@msn.com","IpAddress":"166.137.246.32","GroupId":39,"GroupName":"Newbie","JoinDate":1414067079,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280820.jpg?_r=1414081477","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"MairaCastaneda","Id":280820,"Name":"MairaCastaneda","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"38.112.94.76","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73939,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6daa351a52feab97f3d28fce6575a607","RawContent":"&lt;p&gt;omg everything is amazing!! congrats.&amp;nbsp; where did you get the bookmarks made?&amp;nbsp; the ones that say \"you were here\"&lt;\/p&gt;","Attachments":[],"Id":1876759,"PostDate":1414081204,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>omg everything is amazing!! congrats.\u00a0 where did you get the bookmarks made?\u00a0 the ones that say \"you were here\"<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div><br><div>\u00a0<\/div>\n<div>\u00a0<\/div>\n<div>Married on June 20th, 2015 at the Grand Sunset Princess Riviera Gazebo & Reception at the Chill Out with 60 guests<\/div>\n<div>\u00a0<\/div>\n<\/div>\n<div>\u00a0<\/div>\n<p>My planning thread:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78801-veryvaleros-wedding-planning-thread-grand-sunset-princess\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78801-veryvaleros-wedding-planning-thread-grand-sunset-princess\/<\/a><\/p>\n<p>My review thread: \u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79344-grand-sunset-princess-platinum-yucatan-princess-wedding\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79344-grand-sunset-princess-platinum-yucatan-princess-wedding\/<\/a>","Email":"rebecca.valero@gmail.com","IpAddress":"38.112.94.76","GroupId":3,"GroupName":"Member","JoinDate":1396968452,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277519.jpg?_r=1439827749","PhotoWidth":200,"PhotoHeight":132,"PhotoType":"custom"},"FormattedName":"veryvalentine","Id":277519,"Name":"veryvalentine","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"184.69.200.21","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73939,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a4f41b0fe9da822561b653a06695f2f3","RawContent":"&lt;p&gt;I wish this was a new thread because I totally want to know the fonts you used!!!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Everything is FANTASTIC... &amp;nbsp;When I get home I am going to watch your video.... love all your ideas, especially the Christmas ornaments.&lt;\/p&gt;","Attachments":[],"Id":1876761,"PostDate":1414082744,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I wish this was a new thread because I totally want to know the fonts you used!!!!<\/p>\n<p>\u00a0<\/p>\n<p>Everything is FANTASTIC... \u00a0When I get home I am going to watch your video.... love all your ideas, especially the Christmas ornaments.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwe