Request Time: 0 seconds
{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73939,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6c9a1a24b0e3944dd9afc2bbc0c39068","RawContent":"Would you be willing to share the steps for the papel picado invitation and using a Cricut to achieve those results? Your invitations are beautiful!","Attachments":[],"Id":1774572,"PostDate":1372762100,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Would you be willing to share the steps for the papel picado invitation and using a Cricut to achieve those results? Your invitations are beautiful!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tallone14@msn.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1365441187,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-268329.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"tallone14","Id":268329,"Name":"tallone14","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73939,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"66d34c9d31173b86e0d703749b5e10d7","RawContent":"Lala-Would you mind sharing the program that you used to cut out your invitations?","Attachments":[],"Id":1774610,"PostDate":1372770124,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Lala-Would you mind sharing the program that you used to cut out your invitations?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tiffanyandmarkwedding@gmail.com","IpAddress":"128.172.48.117","GroupId":3,"GroupName":"Member","JoinDate":1366928812,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-268991.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"brownsugarbride","Id":268991,"Name":"brownsugarbride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73939,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"55c233c0dea8f3e7a4ba843aa423b728","RawContent":"ETA: Rather, what template did you use? I know you mentioned that you used your cricut machine.","Attachments":[],"Id":1774612,"PostDate":1372770183,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                ETA: Rather, what template did you use? I know you mentioned that you used your cricut machine.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tiffanyandmarkwedding@gmail.com","IpAddress":"128.172.48.117","GroupId":3,"GroupName":"Member","JoinDate":1366928812,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-268991.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"brownsugarbride","Id":268991,"Name":"brownsugarbride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73939,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c6e2445907d87156e2bce034362e7fed","RawContent":"&lt;p&gt; Hi!&lt;\/p&gt; &lt;p&gt; I said cricut because I figured more people know what that is...I actually used a silhouette machine (which is very similar).&amp;nbsp; I designed the template in adobe illustrator and then opened that in the silhouette program.&amp;nbsp; I drew the shapes based on an invitation I saw on Etsy, (but couldn&#039;t imagine paying $400 for just 25 invitations).&amp;nbsp; It is an extremely time consuming process and illustrator is not an easy program to use unless you have been trained or have experience with it.&amp;nbsp; There are many similar papel picado invitations available on Etsy now though&amp;nbsp;if you&#039;re interested in saving yourself the headache.&amp;nbsp; Good luck! :)&lt;\/p&gt;","Attachments":[],"Id":1776195,"PostDate":1373279256,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hi!<\/p> <p> I said cricut because I figured more people know what that is...I actually used a silhouette machine (which is very similar).\u00a0 I designed the template in adobe illustrator and then opened that in the silhouette program.\u00a0 I drew the shapes based on an invitation I saw on Etsy, (but couldn't imagine paying $400 for just 25 invitations).\u00a0 It is an extremely time consuming process and illustrator is not an easy program to use unless you have been trained or have experience with it.\u00a0 There are many similar papel picado invitations available on Etsy now though\u00a0if you're interested in saving yourself the headache.\u00a0 Good luck! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ldoney1013@aol.com","IpAddress":"70.20.201.223","GroupId":47,"GroupName":"Site Supporter","JoinDate":1328121597,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-250839.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":250,"PhotoType":"custom"},"FormattedName":"LaLa1116","Id":250839,"Name":"LaLa1116","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73939,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5579cc179d82e1764c6d966ed8f40a22","RawContent":"[quote]\nOriginally Posted by [b]LaLa1116[\/b] \/img\/forum\/go_quote.gif\n \n \n Hi! \n I said cricut because I figured more people know what that is...I actually used a silhouette machine (which is very similar).  I designed the template in adobe illustrator and then opened that in the silhouette program.  I drew the shapes based on an invitation I saw on Etsy, (but couldn&#039;t imagine paying $400 for just 25 invitations).  It is an extremely time consuming process and illustrator is not an easy program to use unless you have been trained or have experience with it.  There are many similar papel picado invitations available on Etsy now though if you&#039;re interested in saving yourself the headache.  Good luck! :)[\/quote] \n \n Thanks so much!  Your intuition is absolutely correct---I am not trained nor do I have experience with any of this! LOL LOL   Luckily, I have a wonderful friend who has a design background and who used to own a card business. She told me that she could do it, but I assumed she had a cricut machine. Actually, she has a machine and software that sound very similar to what you have, and will be doing my invites. Yay for awesome friends! \n \n P.S. Yeah, $400 for 25 invitations.  No way for my budget!","Attachments":[],"Id":1776202,"PostDate":1373280709,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>LaLa1116<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> <p> Hi!<\/p> <p> I said cricut because I figured more people know what that is...I actually used a silhouette machine (which is very similar).\u00a0 I designed the template in adobe illustrator and then opened that in the silhouette program.\u00a0 I drew the shapes based on an invitation I saw on Etsy, (but couldn't imagine paying $400 for just 25 invitations).\u00a0 It is an extremely time consuming process and illustrator is not an easy program to use unless you have been trained or have experience with it.\u00a0 There are many similar papel picado invitations available on Etsy now though\u00a0if you're interested in saving yourself the headache.\u00a0 Good luck! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p> <\/blockquote> <p> \u00a0<\/p> <p> Thanks so much!\u00a0 Your intuition is absolutely correct---I am not trained nor do I have experience with any of this! LOL LOL\u00a0\u00a0 Luckily, I have a wonderful friend who has a design background and who used to own a card business. She told me that she could do it, but I assumed she had a cricut machine. Actually, she has a machine and software that sound very similar to what you have, and will be doing my invites. Yay for awesome friends!<\/p> <p> \u00a0<\/p> <p> P.S. Yeah, $400 for 25 invitations.\u00a0 No way for my budget!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tiffanyandmarkwedding@gmail.com","IpAddress":"128.172.48.117","GroupId":3,"GroupName":"Member","JoinDate":1366928812,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-268991.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"brownsugarbride","Id":268991,"Name":"brownsugarbride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73939,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"37c322dbb7786d5c2aebac2b12229943","RawContent":"After reading this thread, I looked through the Cricut library. There is one pattern set that sort of looks like this style if you were interested in using Cricut to make these. While I don&#039;t think its an exact match, the Damask Decor cartridge has a similar style, shape, and could be a good substitute if you didn&#039;t have the Illustrator skills.","Attachments":[],"Id":1776232,"PostDate":1373285735,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                After reading this thread, I looked through the Cricut library. There is one pattern set that sort of looks like this style if you were interested in using Cricut to make these. While I don't think its an exact match, the Damask Decor cartridge has a similar style, shape, and could be a good substitute if you didn't have the Illustrator skills.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tallone14@msn.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1365441187,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-268329.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"tallone14","Id":268329,"Name":"tallone14","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73939,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"cedecd8a2bd68431427f9166430ee67f","RawContent":"&lt;p id=\"yui_3_10_0_1_1376842659147_840\"&gt; &lt;strong&gt;Hi everyone!&amp;nbsp; Sorry I&#039;ve been slacking on updating this blog!&amp;nbsp; We are at the 3 month mark now and it has been very busy around here!&amp;nbsp; We just got a new puppy and my bridal shower was yesterday&amp;nbsp;:) But today it is back to work!&amp;nbsp; Here are some of the DIY projects I&#039;ve been working on. As always, please feel free to comment here or PM me for any details or help.&lt;\/strong&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; These are the clear acrylic tumblers we purchased from discountmugs.com.&amp;nbsp; We thought because we are going to an all inclusive, our guests would appreciate the larger size and with Mexico&#039;s warm weather, the insulation will keep drinking colder.&amp;nbsp; I made the label and had a seller on etsy.com print them onto water proof labels.&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"&#10;\" data-id=\"217201\" data-type=\"61\" height=\"525\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/217201\/width\/350\/height\/700\" style=\"width: 111px; height: 167px;\" width=\"351\" \/&gt;&amp;nbsp;&lt;img alt=\"&#10;\" data-id=\"217202\" data-type=\"61\" height=\"301\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/217202\/width\/200\/height\/400\" style=\"width: 117px; height: 167px;\" width=\"201\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; These are our welcome bags.&amp;nbsp; I bought canvas bags, created the transfer and ironed it on.&amp;nbsp; It was a very time consuming project, but well worth it!&amp;nbsp; You can see more details instructions in my welcome bag post.&amp;nbsp; We are from Philadelphia and huge Phillies fans, so this bag is a combination of 2 of our favorite things...the Phillie Phanatic and Corona. :) I added welcome tags attached with yarn in our colors.&amp;nbsp; Can&#039;t wait til our guests see these.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p id=\"yui_3_10_0_1_1376842659147_1758\"&gt; &lt;img data-id=\"200079\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/200079\/width\/200\/height\/400\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; We wanted to add some candy to the bags to highlight the location\/theme, so we chose coconut taffy with palm trees, coffee flavored chuppa chup lollipops, champagne jelly belly chews &amp;amp; margarita sour balls (I like these because they are also mint green!) I added labels to the jellies and sour balls&amp;nbsp;because they arrive in huge bags&amp;nbsp;...&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p id=\"yui_3_10_0_1_1376842659147_2098\"&gt; &lt;img alt=\"&#10;\" data-id=\"217203\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/217203\/width\/200\/height\/400\" \/&gt;&amp;nbsp;&lt;img alt=\"&#10;\" data-id=\"217204\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/217204\/width\/200\/height\/400\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; I&amp;nbsp;also made \"Wedding Week Survival\"&amp;nbsp;bags filled with medicine and the essentials.&amp;nbsp; I printed \"Too Much Food, Too Much Booze, Too Much Sun, Too Much Fun\"&amp;nbsp;on glassine bags.These included travel sizes of sunblock, aloe, hand sanitizer wipes, chapstick,Tums, Dramamine (for boat the Las Caletas), Advil, flossers, Emergen-C, tic tacs (mint green of course&lt;span alt=\";)\" id=\"yui_3_10_0_1_1376842659147_2595\" rel=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/wink.gif\"&gt;&lt;img height=\"16\" id=\"yui_3_10_0_1_1376842659147_2594\" src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/wink.gif\" width=\"16\" \/&gt;) and gum.&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p id=\"yui_3_10_0_1_1376842659147_2939\"&gt; &lt;img alt=\"&#10;\" data-id=\"217205\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/217205\/width\/200\/height\/400\" \/&gt;&amp;nbsp;&lt;img alt=\"&#10;\" data-id=\"217206\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/217206\/width\/200\/height\/400\" \/&gt;&amp;nbsp;&lt;img alt=\"&#10;\" data-id=\"217207\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/217207\/width\/200\/height\/400\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; More to come...&lt;\/p&gt;","Attachments":[],"Id":1792727,"PostDate":1376830062,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p id=\"yui_3_10_0_1_1376842659147_840\"> <strong>Hi everyone!\u00a0 Sorry I've been slacking on updating this blog!\u00a0 We are at the 3 month mark now and it has been very busy around here!\u00a0 We just got a new puppy and my bridal shower was yesterday\u00a0<img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> But today it is back to work!\u00a0 Here are some of the DIY projects I've been working on. As always, please feel free to comment here or PM me for any details or help.<\/strong><\/p> <p> \u00a0<\/p> <p> These are the clear acrylic tumblers we purchased from discountmugs.com.\u00a0 We thought because we are going to an all inclusive, our guests would appreciate the larger size and with Mexico's warm weather, the insulation will keep drinking colder.\u00a0 I made the label and had a seller on etsy.com print them onto water proof labels.<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"&#10;\" data-id=\"217201\" data-type=\"61\" height=\"525\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/217201\/width\/350\/height\/700\" style=\"width: 111px; height: 167px;\" width=\"351\" \/><\/span>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"&#10;\" data-id=\"217202\" data-type=\"61\" height=\"301\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/217202\/width\/200\/height\/400\" style=\"width: 117px; height: 167px;\" width=\"201\" \/><\/span><\/p> <p> \u00a0<\/p> <p> These are our welcome bags.\u00a0 I bought canvas bags, created the transfer and ironed it on.\u00a0 It was a very time consuming project, but well worth it!\u00a0 You can see more details instructions in my welcome bag post.\u00a0 We are from Philadelphia and huge Phillies fans, so this bag is a combination of 2 of our favorite things...the Phillie Phanatic and Corona. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> I added welcome tags attached with yarn in our colors.\u00a0 Can't wait til our guests see these.<\/p> <p> \u00a0<\/p> <p id=\"yui_3_10_0_1_1376842659147_1758\"> <span rel='lightbox'><img class='bbc_img' data-id=\"200079\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/200079\/width\/200\/height\/400\" \/><\/span><\/p> <p> \u00a0<\/p> <p> We wanted to add some candy to the bags to highlight the location\/theme, so we chose coconut taffy with palm trees, coffee flavored chuppa chup lollipops, champagne jelly belly chews & margarita sour balls (I like these because they are also mint green!) I added labels to the jellies and sour balls\u00a0because they arrive in huge bags\u00a0...<\/p> <p> \u00a0<\/p> <p id=\"yui_3_10_0_1_1376842659147_2098\"> <span rel='lightbox'><img class='bbc_img' alt=\"&#10;\" data-id=\"217203\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/217203\/width\/200\/height\/400\" \/><\/span>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"&#10;\" data-id=\"217204\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/217204\/width\/200\/height\/400\" \/><\/span><\/p> <p> \u00a0<\/p> <p> I\u00a0also made \"Wedding Week Survival\"\u00a0bags filled with medicine and the essentials.\u00a0 I printed \"Too Much Food, Too Much Booze, Too Much Sun, Too Much Fun\"\u00a0on glassine bags.These included travel sizes of sunblock, aloe, hand sanitizer wipes, chapstick,Tums, Dramamine (for boat the Las Caletas), Advil, flossers, Emergen-C, tic tacs (mint green of course<span alt=\";)\" id=\"yui_3_10_0_1_1376842659147_2595\" rel=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/wink.gif\"><span rel='lightbox'><img class='bbc_img' height=\"16\" id=\"yui_3_10_0_1_1376842659147_2594\" src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/wink.gif\" width=\"16\" \/><\/span>) and gum.<\/span><\/p> <p> \u00a0<\/p> <p id=\"yui_3_10_0_1_1376842659147_2939\"> <span rel='lightbox'><img class='bbc_img' alt=\"&#10;\" data-id=\"217205\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/217205\/width\/200\/height\/400\" \/><\/span>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"&#10;\" data-id=\"217206\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/217206\/width\/200\/height\/400\" \/><\/span>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"&#10;\" data-id=\"217207\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/217207\/width\/200\/height\/400\" \/><\/span><\/p> <p> \u00a0<\/p> <p> More to come...<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ldoney1013@aol.com","IpAddress":"70.20.201.223","GroupId":47,"GroupName":"Site Supporter","JoinDate":1328121597,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-250839.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":250,"PhotoType":"custom"},"FormattedName":"LaLa1116","Id":250839,"Name":"LaLa1116","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73939,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"039bc4a6e004f381c62fd480990437ef","RawContent":"&lt;p&gt; I am the GM of an Irish pub here in Philly, so I have access to some great welcome bag extras.&amp;nbsp; My Corona rep gave me all of&amp;nbsp;this stuff&amp;nbsp;for free!&amp;nbsp; Poncho beer coozies, flip flop bottle openers, sombrero (bottle opener) and maraca key chains, and lanyards for our room keys holders.&amp;nbsp; She also gave us 4 Corona&amp;nbsp;tee shirts and&amp;nbsp;sombreros&amp;nbsp;for the groomsmen, LOL.&amp;nbsp; I told John he has to wear the sombreros onto the plane, because we don&#039;t have room in the luggage. &lt;span alt=\";)\" id=\"yui_3_10_0_1_1376842659147_4243\" rel=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/wink.gif\"&gt;&lt;img height=\"16\" id=\"yui_3_10_0_1_1376842659147_4242\" src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/wink.gif\" width=\"16\" \/&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"&#10;\" data-id=\"217209\" data-type=\"61\" height=\"135\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/217209\/width\/200\/height\/400\" style=\"width: 311px; height: 233px;\" width=\"202\" \/&gt;&amp;nbsp;&lt;img alt=\"&#10;\" data-id=\"217213\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/217213\/width\/200\/height\/400\" \/&gt;&amp;nbsp;&lt;img alt=\"&#10;\" data-id=\"217212\" data-type=\"61\" height=\"134\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/217212\/width\/200\/height\/400\" style=\"width: 281px; height: 203px;\" width=\"202\" \/&gt;&lt;\/p&gt; &lt;p&gt; Our welcome tag has a picture of dreams on front and says, \" I take this room key with me, to beach chair and bar stool, for soused or for sober, until I depart.\"&lt;\/p&gt; &lt;p id=\"yui_3_10_0_1_1376842659147_4617\"&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p id=\"yui_3_10_0_1_1376842659147_4081\"&gt; &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1792734,"PostDate":1376831277,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I am the GM of an Irish pub here in Philly, so I have access to some great welcome bag extras.\u00a0 My Corona rep gave me all of\u00a0this stuff\u00a0for free!\u00a0 Poncho beer coozies, flip flop bottle openers, sombrero (bottle opener) and maraca key chains, and lanyards for our room keys holders.\u00a0 She also gave us 4 Corona\u00a0tee shirts and\u00a0sombreros\u00a0for the groomsmen, LOL.\u00a0 I told John he has to wear the sombreros onto the plane, because we don't have room in the luggage. <span alt=\";)\" id=\"yui_3_10_0_1_1376842659147_4243\" rel=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/wink.gif\"><span rel='lightbox'><img class='bbc_img' height=\"16\" id=\"yui_3_10_0_1_1376842659147_4242\" src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/wink.gif\" width=\"16\" \/><\/span><\/span><\/p> <p> \u00a0<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"&#10;\" data-id=\"217209\" data-type=\"61\" height=\"135\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/217209\/width\/200\/height\/400\" style=\"width: 311px; height: 233px;\" width=\"202\" \/><\/span>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"&#10;\" data-id=\"217213\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/217213\/width\/200\/height\/400\" \/><\/span>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"&#10;\" data-id=\"217212\" data-type=\"61\" height=\"134\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/217212\/width\/200\/height\/400\" style=\"width: 281px; height: 203px;\" width=\"202\" \/><\/span><\/p> <p> Our welcome tag has a picture of dreams on front and says, \" I take this room key with me, to beach chair and bar stool, for soused or for sober, until I depart.\"<\/p> <p id=\"yui_3_10_0_1_1376842659147_4617\"> \u00a0<\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <p id=\"yui_3_10_0_1_1376842659147_4081\"> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ldoney1013@aol.com","IpAddress":"70.20.201.223","GroupId":47,"GroupName":"Site Supporter","JoinDate":1328121597,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-250839.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":250,"PhotoType":"custom"},"FormattedName":"LaLa1116","Id":250839,"Name":"LaLa1116","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73939,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"abf4e40fbde73dd2c3eb60b9e01b7717","RawContent":"&lt;p&gt; Hi! I just joined and this is my 1st posting.&lt;span alt=\":cheer2:\" id=\"yui_3_10_0_1_1376895136643_938\" rel=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheer2.gif\"&gt;&lt;img height=\"43\" id=\"yui_3_10_0_1_1376895136643_937\" src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheer2.gif\" width=\"55\" \/&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; You are really doing a terrific job! Your guests are going to be thrilled. That&#039;s so awesome that you can get all those freebees from your job.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; I&#039;m planning even though my wedding is a ways off. I&#039;m finding that the items for my Welcome Bags add up quickly. And every time I say \"Okay, that&#039;s it. I&#039;m not adding anything else.\" I see something else with a beach theme or my colors that I must have for my guests. LOL&lt;\/p&gt;","Attachments":[],"Id":1792859,"PostDate":1376881221,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hi! I just joined and this is my 1st posting.<span alt=\":cheer2:\" id=\"yui_3_10_0_1_1376895136643_938\" rel=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheer2.gif\"><span rel='lightbox'><img class='bbc_img' height=\"43\" id=\"yui_3_10_0_1_1376895136643_937\" src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheer2.gif\" width=\"55\" \/><\/span><\/span><\/p> <p> You are really doing a terrific job! Your guests are going to be thrilled. That's so awesome that you can get all those freebees from your job.<\/p> <p> \u00a0<\/p> <p> I'm planning even though my wedding is a ways off. I'm finding that the items for my Welcome Bags add up quickly. And every time I say \"Okay, that's it. I'm not adding anything else.\" I see something else with a beach theme or my colors that I must have for my guests. LOL<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mrswithclass@aol.com","IpAddress":"96.227.248.106","GroupId":40,"GroupName":"Jr. Member","JoinDate":1376876103,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272718.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"1BeachBride","Id":272718,"Name":"1BeachBride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73939,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"86429ac6f9880387218dd09fc7419e52","RawContent":"&lt;p&gt; Here are the bridal party gifts...&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; We&amp;nbsp;are&amp;nbsp;buying the girls an hour long&amp;nbsp;massage at Las Caletas on the morning of the wedding.&amp;nbsp; We are also giving them mint green robes by Love Ophelia and earrings from Etsy to wearing during the wedding.&lt;\/p&gt; &lt;p id=\"yui_3_10_0_1_1377484625728_985\"&gt; &lt;img alt=\"&#10;\" data-id=\"217841\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/217841\/width\/200\/height\/400\" \/&gt;&amp;nbsp;&lt;img alt=\"&#10;\" data-id=\"217842\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/217842\/width\/200\/height\/400\" \/&gt;&amp;nbsp;&lt;img alt=\"&#10;\" data-id=\"217843\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/217843\/width\/200\/height\/400\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Our groomsmen will receive an engraved&amp;nbsp;flask\/cigar holder and torch lighter.&amp;nbsp; We are having a cigar roller at the wedding, so we thought this would be a cool gift for the guys.&amp;nbsp; We are also giving them engraved credit card\/wallet size bottle openers.&lt;\/p&gt; &lt;p id=\"yui_3_10_0_1_1377484625728_2379\"&gt; &lt;img alt=\"&#10;\" data-id=\"217845\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/217845\/width\/200\/height\/400\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Our friend is officiating our ceremony, so we got him a gift as well--an engraved torch lighter\/bottle opener.&lt;\/p&gt; &lt;p id=\"yui_3_10_0_1_1377484625728_2705\"&gt; &lt;img alt=\"&#10;\" data-id=\"217846\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/217846\/width\/200\/height\/400\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;I wrapped&amp;nbsp;these gifts&amp;nbsp;in kraft bags with homemade tags and tissue in our colors&amp;nbsp;- mint green and coral.&amp;nbsp; The \"LOVE\" on the tag is a tribute to the Love statue in Philadelphia where we got engaged.&amp;nbsp;&lt;\/p&gt; &lt;p id=\"yui_3_10_0_1_1377484625728_3037\"&gt; &lt;img alt=\"&#10;\" data-id=\"217847\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/217847\/width\/200\/height\/400\" \/&gt;&amp;nbsp; &lt;img alt=\"&#10;\" data-id=\"217848\" data-type=\"61\" height=\"136\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/217848\/width\/200\/height\/400\" style=\"width: 234px; height: 194px;\" width=\"200\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; I will post our ring bearer and flower girl gifts as soon as I take photos of them.&lt;\/p&gt;","Attachments":[],"Id":1794626,"PostDate":1377471118,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Here are the bridal party gifts...<\/p> <p> \u00a0<\/p> <p> We\u00a0are\u00a0buying the girls an hour long\u00a0massage at Las Caletas on the morning of the wedding.\u00a0 We are also giving them mint green robes by Love Ophelia and earrings from Etsy to wearing during the wedding.<\/p> <p id=\"yui_3_10_0_1_1377484625728_985\"> <span rel='lightbox'><img class='bbc_img' alt=\"&#10;\" data-id=\"217841\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/217841\/width\/200\/height\/400\" \/><\/span>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"&#10;\" data-id=\"217842\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/217842\/width\/200\/height\/400\" \/><\/span>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"&#10;\" data-id=\"217843\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/217843\/width\/200\/height\/400\" \/><\/span><\/p> <p> \u00a0<\/p> <p> Our groomsmen will receive an engraved\u00a0flask\/cigar holder and torch lighter.\u00a0 We are having a cigar roller at the wedding, so we thought this would be a cool gift for the guys.\u00a0 We are also giving them engraved credit card\/wallet size bottle openers.<\/p> <p id=\"yui_3_10_0_1_1377484625728_2379\"> <span rel='lightbox'><img class='bbc_img' alt=\"&#10;\" data-id=\"217845\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/217845\/width\/200\/height\/400\" \/><\/span><\/p> <p> \u00a0<\/p> <p> Our friend is officiating our ceremony, so we got him a gift as well--an engraved torch lighter\/bottle opener.<\/p> <p id=\"yui_3_10_0_1_1377484625728_2705\"> <span rel='lightbox'><img class='bbc_img' alt=\"&#10;\" data-id=\"217846\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/217846\/width\/200\/height\/400\" \/><\/span><\/p> <p> \u00a0<\/p> <p> \u00a0I wrapped\u00a0these gifts\u00a0in kraft bags with homemade tags and tissue in our colors\u00a0- mint green and coral.\u00a0 The \"LOVE\" on the tag is a tribute to the Love statue in Philadelphia where we got engaged.\u00a0<\/p> <p id=\"yui_3_10_0_1_1377484625728_3037\"> <span rel='lightbox'><img class='bbc_img' alt=\"&#10;\" data-id=\"217847\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/217847\/width\/200\/height\/400\" \/><\/span>\u00a0 <span rel='lightbox'><img class='bbc_img' alt=\"&#10;\" data-id=\"217848\" data-type=\"61\" height=\"136\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/217848\/width\/200\/height\/400\" style=\"width: 234px; height: 194px;\" width=\"200\" \/><\/span><\/p> <p> \u00a0<\/p> <p> I will post our ring bearer and flower girl gifts as soon as I take photos of them.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ldoney1013@aol.com","IpAddress":"70.20.201.223","GroupId":47,"GroupName":"Site Supporter","JoinDate":1328121597,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-250839.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":250,"PhotoType":"custom"},"FormattedName":"LaLa1116","Id":250839,"Name":"LaLa1116","IsOnline":false}}],"Pages":{"TotalItems":75,"TotalPages":8,"CurrentPage":30,"NextPage":40,"PreviousPage":20,"LastPage":70},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
