{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73939,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"57a24dfa9ffd40df55d9a8e19b03f740","RawContent":"&lt;p&gt;I guess that&#039;s all for now...I will post more pictures of everything set-up at the wedding when we get back, so you can see how&amp;nbsp;it&amp;nbsp;all&amp;nbsp;looked!&amp;nbsp; I hope this helped inspire some of you as this forum has for me.&amp;nbsp; Good luck in your planning!! :)&lt;\/p&gt;","Attachments":[],"Id":1813686,"PostDate":1384114626,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I guess that's all for now...I will post more pictures of everything set-up at the wedding when we get back, so you can see how\u00a0it\u00a0all\u00a0looked!\u00a0 I hope this helped inspire some of you as this forum has for me.\u00a0 Good luck in your planning!! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ldoney1013@aol.com","IpAddress":"70.20.201.223","GroupId":47,"GroupName":"Site Supporter","JoinDate":1328121597,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-250839.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":250,"PhotoType":"custom"},"FormattedName":"LaLa1116","Id":250839,"Name":"LaLa1116","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"216.237.226.1","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73939,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e07ca18ac12a4bcbba1592710cd5f876","RawContent":"&lt;p&gt;Great job.&amp;nbsp; you thought of everything!&lt;\/p&gt;","Attachments":[],"Id":1821321,"PostDate":1388568151,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Great job.\u00a0 you thought of everything!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lovelikesaltwedding@yahoo.com","IpAddress":"216.237.226.1","GroupId":40,"GroupName":"Jr. Member","JoinDate":1383766826,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-274874.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"loquaciouspunky","Id":274874,"Name":"loquaciouspunky","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.144.5.68","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73939,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c1a774a202433642930d1258e8232645","RawContent":"&lt;p&gt;ABSOLUTELY LOVE THESE! AMAZING!&lt;\/p&gt;","Attachments":[],"Id":1824725,"PostDate":1389357140,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>ABSOLUTELY LOVE THESE! AMAZING!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kacielking@gmail.com","IpAddress":"24.239.247.54","GroupId":40,"GroupName":"Jr. Member","JoinDate":1379611942,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-273614.png?_r=1408114193","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"kbride2014","Id":273614,"Name":"kbride2014","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.20.201.223","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73939,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4831f4d1b7fb4631653685e713c2c453","RawContent":"&lt;p&gt;Here is a link to our highlight wedding video!&amp;nbsp; Thought this might help you see some of the details better.&amp;nbsp; Enjoy!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/vimeo.com\/83900305&#039;&gt;http:\/\/vimeo.com\/83900305&lt;\/a&gt;&lt;\/p&gt;","Attachments":[],"Id":1825266,"PostDate":1389536197,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Here is a link to our highlight wedding video!\u00a0 Thought this might help you see some of the details better.\u00a0 Enjoy!<\/p>\n<p>\u00a0<\/p>\n<p><a href='http:\/\/vimeo.com\/83900305' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/vimeo.com\/83900305<\/a><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ldoney1013@aol.com","IpAddress":"70.20.201.223","GroupId":47,"GroupName":"Site Supporter","JoinDate":1328121597,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-250839.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":250,"PhotoType":"custom"},"FormattedName":"LaLa1116","Id":250839,"Name":"LaLa1116","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"74.71.156.233","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73939,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cfa547c0cd1374d05271251443fea0fd","RawContent":"[quote name=\"LaLa1116\" post=\"1776195\" timestamp=\"1373293656\"]\nHi!\nI said cricut because I figured more people know what that is...I actually used a silhouette machine (which is very similar).  I designed the template in adobe illustrator and then opened that in the silhouette program.  I drew the shapes based on an invitation I saw on Etsy, (but couldn&#039;t imagine paying $400 for just 25 invitations).  It is an extremely time consuming process and illustrator is not an easy program to use unless you have been trained or have experience with it.  There are many similar papel picado invitations available on Etsy now though if you&#039;re interested in saving yourself the headache.  Good luck! :)[\/quote]Hello, I just wanted to compliment you on all your DIY wedding creations. Me and my fiance wanted to purchase the papel picado invitations, but it came out to be $700 for 100 invites not including RSVPs and envelopes. We attempted to make them with the cricut, but it&#039;s not exactly what we had hoped. I wanted to ask you if it would be possible to send your illustrator file (I currently have the program on my computer) and I can edit and cut the image on our silhouette machine. We have the Cameo cutting machine. I would greatly appreciate your help or advice. Thanks!","Attachments":[],"Id":1839942,"PostDate":1395583540,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>LaLa1116, on 08 July 2013 - 10:27 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Hi!<\/p>\n<p>I said cricut because I figured more people know what that is...I actually used a silhouette machine (which is very similar).\u00a0 I designed the template in adobe illustrator and then opened that in the silhouette program.\u00a0 I drew the shapes based on an invitation I saw on Etsy, (but couldn't imagine paying $400 for just 25 invitations).\u00a0 It is an extremely time consuming process and illustrator is not an easy program to use unless you have been trained or have experience with it.\u00a0 There are many similar papel picado invitations available on Etsy now though\u00a0if you're interested in saving yourself the headache.\u00a0 Good luck! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<\/div>\n<\/div><\/div>\n<p>Hello, I just wanted to compliment you on all your DIY wedding creations. Me and my fiance wanted to purchase the papel picado invitations, but it came out to be $700 for 100 invites not including RSVPs and envelopes. We attempted to make them with the cricut, but it's not exactly what we had hoped. I wanted to ask you if it would be possible to send your illustrator file (I currently have the program on my computer) and I can edit and cut the image on our silhouette machine. We have the Cameo cutting machine. I would greatly appreciate your help or advice. Thanks!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"leila87137@yahoo.com","IpAddress":"24.168.110.107","GroupId":39,"GroupName":"Newbie","JoinDate":1392113100,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"LMbride","Id":276631,"Name":"LMbride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"162.119.64.119","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73939,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"263758d4ebea8f7bc17227a74830b71e","RawContent":"&lt;p&gt;@LaLa1116&amp;nbsp; OMG, your wedding (and video) was just stunning.&amp;nbsp; I totally teared up watching it.&amp;nbsp; Your groom&#039;s speech.&amp;nbsp; *swoon*   All your hard work totally paid off, your wedding was just beautiful.&amp;nbsp; Thanks for posting everything in the blog.&amp;nbsp; It was great to follow along and then see everything come to fruition in the video.&lt;\/p&gt;","Attachments":[],"Id":1841910,"PostDate":1396372595,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@LaLa1116\u00a0 OMG, your wedding (and video) was just stunning.\u00a0 I totally teared up watching it.\u00a0 Your groom's speech.\u00a0 *swoon*\u00a0\u00a0 All your hard work totally paid off, your wedding was just beautiful.\u00a0 Thanks for posting everything in the blog.\u00a0 It was great to follow along and then see everything come to fruition in the video.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kellis_baby@hotmail.com","IpAddress":"108.222.71.55","GroupId":40,"GroupName":"Jr. Member","JoinDate":1386889365,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275607.jpg?_r=1425326341","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"kellisbaby","Id":275607,"Name":"kellisbaby","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.222.63.146","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73939,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4c800a387f072c1dacb720619248bdba","RawContent":"&lt;p&gt;WOw your wedding came together so nicely! You did such an amazing job with all the details! Congratulations! And your wedding video was awesome!&lt;\/p&gt;","Attachments":[],"Id":1842001,"PostDate":1396425072,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>WOw your wedding came together so nicely! You did such an amazing job with all the details! Congratulations! And your wedding video was awesome!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Happily Married!<\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/74669-destination-engagement-photos-dubrovnik-croatia\/?hl=%2Bcroatia+%2Bengagement+%2Bphotos'>http:\/\/www.bestdestinationwedding.com\/topic\/74669-destination-engagement-photos-dubrovnik-croatia\/?hl=%2Bcroatia+%2Bengagement+%2Bphotos<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/76346-carinas-csho-iberostar-laguna-azul-planning-journal-050514\/'>http:\/\/www.bestdestinationwedding.com\/topic\/76346-carinas-csho-iberostar-laguna-azul-planning-journal-050514\/<\/a>","Email":"crins_15@hotmail.com","IpAddress":"24.222.63.146","GroupId":42,"GroupName":"Sr. Member","JoinDate":1351766568,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-261965.jpg?_r=1400781457","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"csho","Id":261965,"Name":"csho","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.231.76.48","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73939,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b8cdf9a423954bef4426357e84ba868f","RawContent":"Wow! Awesome planning thread! Your wedding video was beautiful! Everything came together so nicely...Congrats!","Attachments":[],"Id":1845677,"PostDate":1398201869,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Wow! Awesome planning thread! Your wedding video was beautiful! Everything came together so nicely...Congrats!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div>\u00a0<\/div>\n<div><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78914-meandhim-grand-palladium-bavaro-nov-2015\/'>My Planning Thread<\/a>\u00a0- MeandHim - Grand Palladium Bavaro - Nov 25 2015<\/div>\n<div>\u00a0<\/div>\n<div><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10765;116\/st\/20151125\/e\/Our+Wedding\/k\/461e\/event.png\" alt=\"event.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"markandshavonne@live.com","IpAddress":"70.30.85.211","GroupId":3,"GroupName":"Member","JoinDate":1365777659,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-268499.jpg?_r=1395417550","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"Meandhim","Id":268499,"Name":"Meandhim","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"96.227.248.106","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73939,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f7fb344ff9269678300e870d0c40c55b","RawContent":"&lt;p&gt;Congratulations! Your wedding was absolutely amazing! Everything turned out beautifully and all of your effort in planning was worth it. The details made it your own.&lt;\/p&gt;","Attachments":[],"Id":1846149,"PostDate":1398378537,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congratulations! Your wedding was absolutely amazing! Everything turned out beautifully and all of your effort in planning was worth it. The details made it your own.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mrswithclass@aol.com","IpAddress":"96.227.248.106","GroupId":40,"GroupName":"Jr. Member","JoinDate":1376876103,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272718.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"1BeachBride","Id":272718,"Name":"1BeachBride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"63.119.183.254","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73939,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0f6f714726435d2443c2b26ec6fa6b11","RawContent":"&lt;p&gt;Beautiful wedding....video was awesome!&amp;nbsp; Beautiful couple!&lt;\/p&gt;","Attachments":[],"Id":1847854,"PostDate":1398960884,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Beautiful wedding....video was awesome!\u00a0 Beautiful couple!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"letitia_leaks@verizon.net","IpAddress":"63.119.183.254","GroupId":40,"GroupName":"Jr. Member","JoinDate":1397052122,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277534.jpg?_r=1397086760","PhotoWidth":160,"PhotoHeight":160,"PhotoType":"custom"},"FormattedName":"FutureMrsGlover","Id":277534,"Name":"FutureMrsGlover","IsOnline":false}}],"Pages":{"TotalItems":75,"TotalPages":8,"CurrentPage":60,"NextPage":70,"PreviousPage":50,"LastPage":70},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
