0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":false,"TopicId":73219,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3481eab0e03be6f4165424cc408b15de","RawContent":"&lt;p&gt; great idea&lt;\/p&gt;","Attachments":[],"Id":1738869,"PostDate":1364354667,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> great idea<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"k_fritz87@yahoo.com","IpAddress":"","GroupId":5,"GroupName":"Banned","JoinDate":1361064076,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-266153.jpeg?_r=0","PhotoWidth":100,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"kfritz","Id":266153,"Name":"kfritz","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73219,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5ea690bf02025b6dec538cd9e033e5c0","RawContent":"They&#039;re done!! They look awesome! For $25 you can&#039;t go wrong! We didn&#039;t even have to put the stickers on! One less thing we have to do! :) It&#039;s not so DIY but our original plan didn&#039;t work so well... So , if you want to do these, get the cups from your local dollarama and take them to a local sign\/graphics company and see what they would charge - you&#039;d be surprised! [img]http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/195719\/width\/200\/height\/400[\/img]","Attachments":[],"Id":1739272,"PostDate":1364432943,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                They're done!! They look awesome! For $25 you can't go wrong! We didn't even have to put the stickers on! One less thing we have to do! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> It's not so DIY but our original plan didn't work so well... So , if you want to do these, get the cups from your local dollarama and take them to a local sign\/graphics company and see what they would charge - you'd be surprised! <span rel='lightbox'><img class='bbc_img' src='http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/195719\/width\/200\/height\/400' alt='Posted Image'  \/><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"silla.feliz@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1334795441,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-254217.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"sillafeliz","Id":254217,"Name":"sillafeliz","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73219,"EditedBy":"","EditDate":0,"EditReason":"","D