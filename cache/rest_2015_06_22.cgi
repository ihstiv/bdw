Delete":false,"CanLike":true,"TopicId":715,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5dc41033ad4119a7ebda934b82a840c9","RawContent":"I am flying my photographer in from the US (Leigh Miller); when asking for referrals, I honestly didn&#039;t get any that were local to PV so I don&#039;t know much about any of them.","Attachments":[],"Id":17251,"PostDate":1168915895,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I am flying my photographer in from the US (Leigh Miller); when asking for referrals, I honestly didn't get any that were local to PV so I don't know much about any of them.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<a class='bbc_url' href='http:\/\/bestdestinationwedding.com\/forum\/f77\/anns-annr-las-caletas-dreams-pv-hawaii-review-looooooong-6068\/'>Ann's Caletas Wedding & Hawaii Honeymoon Review<\/a><br \/>\n<a class='bbc_url' href='http:\/\/www.leighmillerphotography.com\/darkroom\/share\/?n=ann_paul'>Our Caletas Wedding Slideshow (by Leigh Miller)<\/a><br \/>\n<a class='bbc_url' href='http:\/\/www.onetruemedia.com\/shared?p=31de360c85cec8376c35a5&skin_id=701&utm_source=otm&utm_medium=image'>Our Caletas Wedding Video<\/a>","Email":"annkherrick@yahoo.com","IpAddress":"76.16.7.43","GroupId":46,"GroupName":"VIP Member","JoinDate":1161392880,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206863.jpg?_r=1429384252","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"LCBride2007","Id":206863,"Name":"LCBride2