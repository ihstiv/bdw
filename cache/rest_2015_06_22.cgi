settings for the reception...","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/global.theknot.com\/tools\/tickers\/tt3874d.aspx\">http:\/\/global.theknot.com\/tools\/tickers\/tt3874d.aspx<\/a><br><br><a data-ipb='nomediaparse' href=\"http:\/\/www.weddingwire.com\/candiceandricky\">http:\/\/www.weddingwire.com\/candiceandricky<\/a><br><br><a data-ipb='nomediaparse' href=\"http:\/\/i71.photobucket.com\/albums\/i154\/MOVINGATLAS\/mericky-cowboystour.jpg\">http:\/\/i71.photobucket.com\/albums\/i1...owboystour.jpg<\/a><span>Candice & Ricky-the Royal, Playa del Carmen 06.05.10<\/span><\/div><\/div>","Email":"candice_17@msn.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1247813764,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-219528.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"candicemarie","Id":219528,"Name":"candicemarie","IsOnline":false}},"Posts":[],"Id":"52308","Title":"maracas w\/Mexico design~wonderful customer service & cheap!!!","LastPostDate":1433013934},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":10,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":433,"MovedTo":null,"MovedOn":0,"FirstPostId":1892822,"Rating":0,"RatingHits":0,"Starter":{"Id":279216,"Name":"eriddell","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279216.jpg?_r=1427247528","PhotoWidth":200,"PhotoHeight":113,"PhotoType":"custom"},"IsOnline":false},"StartDate":1428845574,"LastPoster":{"Id":281283,"Name":"vancouverpetunia","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-28128