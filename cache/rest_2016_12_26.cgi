hotoHeight":164,"PhotoType":"custom"},"IsOnline":false},"StartDate":1422846308,"LastPoster":{"Id":281055,"Name":"snswedding2016","Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-281055.jpg?_r=1455040720","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":8,"Preview":{"Id":1884897,"PostDate":1422846308,"PostContent":"Hello past, present, and future brides! I am having such a difficult time choosing a resort.. I t...","Author":{"Signature":"<p><span style=\"color:#800080;\"><strong><span style=\"font-size:18px;\"><em><span style=\"font-family:'times new roman', times, serif;\">Jessica<\/span><\/em><\/span><\/strong><\/span>","Email":"jessiker05@hotmail.com","IpAddress":"24.222.45.206","GroupId":39,"GroupName":"Newbie","JoinDate":1410543113,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-279800.jpg?_r=1432039880","PhotoWidth":200,"PhotoHeight":164,"PhotoType":"custom"},"FormattedName":"jessiker05","Id":279800,"Name":"jessiker05","IsOnline":false}},"Posts":[],"Id":"78717","Title":"Barcelo Maya Caribe Vs. Grand Palladium Kantenah","LastPostDate":1429762017},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":319,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":33890,"MovedTo":null,"MovedOn":0,"FirstPostId":1860478,"Rating":0,"RatingHits":0,"Starter":{"Id":276456,"Name":"Kerrierf","Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-276456.jpg?_r=1410147109","PhotoWidth":199,"PhotoHeight":300,"PhotoType":"custom"},"IsOnline":false},"StartDate":1405630266,"LastPoster":{"Id":285637,"Name":"LissaChic","Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-285637.jpg?_r=1480032056","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":22,"Preview":{"Id":1860478,"PostDate":1405630266,"PostContent":"Hi everyone! \u00a0 I thought it'd be a good idea to start a thread for the 2015 brides since we seem...","Author":{"Signature":"","Email":"kerrierf@gmail.com","IpAddress":"69.165.209.118","GroupId":39,"GroupName":"Newbie","JoinDate":1391395223,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-276456.jpg?_r=1410147109","PhotoWidth":199,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"Kerrierf","Id":276456,"Name":"Kerrierf","IsOnline":false}},"Posts":[],"Id":"77556","Title":"2015 Grand Palladium Punta Cana Brides","LastPostDate":1466815128},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":2141,"QueuedPosts":0,"DeletedPosts":5,"HasUnreadPosts":false,"HasAttachments":true,"Views":170726,"MovedTo":null,"MovedOn":0,"FirstPostId":428415,"Rating":0,"RatingHits":0,"Starter":{"Id":211216,"Name":"coppergoddess13","Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-211216.gif?_r=0","PhotoWidth":100,"PhotoHeight":81,"PhotoType":"custom"},"IsOnline":false},"StartDate":1219478681,"LastPoster":{"Id":284438,"Name":"Sarah2323","Photo":{"HasPhoto":false,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":2,"Preview":{"Id":428415,"PostDate":1219478681,"PostContent":"I'm getting married at the Grand Palladium resorts in Puerto Aventuras next year, and I'm wonderi...","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/www.weddingcountdown.com\/ticker\/bnucroyi.png\">http:\/\/www.weddingcountdown.com\/ticker\/bnucroyi.png<\/a><\/div><\/div>","Email":"coppergoddess13@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1218875411,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-211216.gif?_r=0","PhotoWidth":100,"PhotoHeight":81,"PhotoType":"custom"},"FormattedName":"coppergoddess13","Id":211216,"Name":"coppergoddess13","IsOnline":false}},"Posts":[],"Id":"22424","Title":"Any Grand Palladium brides?","LastPostDate":1440355881}],"Filters":{"Period":[],"Other":[]}}],"Pages":{"TotalItems":98,"TotalPages":5,"CurrentPage":20,"NextPage":40,"PreviousPage":0,"LastPage":80},"PushNotifications":[{"Key":"messages","Value":1,"Type":"int"}]}
