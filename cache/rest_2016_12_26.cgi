;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>Just Martha<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Thanks for that info, Amy! I didnt see that. Do you happen to have pictures of the wedding locations at Dreams Tulum?<\/div> <\/td> <\/tr> <\/table> <\/div>Martha, <br \/> I do have some pics. If you want, pm me your email and I will send them along to you. <img src='https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i77.photobucket.com\/albums\/j64\/alclubb\/sunsetkiss-1.jpg\">http:\/\/i77.photobucket.com\/albums\/j6...nsetkiss-1.jpg<\/a><br><i>Amy & Aaron<br>May 10, 2008<br>Dreams Tulum, Riviera Maya, Mexico<\/i><\/div><\/div>","Email":"clubba@student.gvsu.edu","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1168242480,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-207037.gif?_r=0","PhotoWidth":75,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"AmyInMI","Id":207037,"Name":"AmyInMI","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":4828,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"50c5659502f7941a083795c678b86b57","RawContent":"Martha, I know dreams cancun includes the mariachi trio in the largest package, I think if you do it standalone it 5 something for 45 minutes.","Attachments":[],"Id":78324,"PostDate":1184822699,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Martha, I know dreams cancun includes the mariachi trio in the largest package, I think if you do it standalone it 5 something for 45 minutes.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jill@...","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1162184340,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-206877.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"*JillD*","Id":206877,"Name":"*JillD*","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":4828,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"647d25ce99149295ff4f1a6eba2b685d","RawContent":"I have worked with so many Mariachi bands in the Riviera Maya that i think that $700 usd. is a great price for a set of 45 minutes (1 hour)!!! \n Here in the Riviera the Mariachi band is much more expensive!! \n If you find one of $700 usd you have just to make sure that they are &amp;quot;good&amp;quot; and that they are at least 7 people in the band otherwise it will be a waste of money!!\n \n Regards,\n Yazmin.&lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/pinkie.gif\" border=\"0\" alt=\"\" title=\"Pinkie\" class=\"inlineimg\" \/&gt;","Attachments":[],"Id":79529,"PostDate":1184966115,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I have worked with so many Mariachi bands in the Riviera Maya that i think that $700 usd. is a great price for a set of 45 minutes (1 hour)!!! <br \/> Here in the Riviera the Mariachi band is much more expensive!! <br \/> If you find one of $700 usd you have just to make sure that they are \"good\" and that they are at least 7 people in the band otherwise it will be a waste of money!!<br \/> <br \/> Regards,<br \/> Yazmin.<span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/pinkie.gif\" border=\"0\" alt=\"\" title=\"Pinkie\" class=\"inlineimg\" \/><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"info@yazmindelamora.com","IpAddress":"189.149.44.143","GroupId":44,"GroupName":"Vendor","JoinDate":1181118910,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-207443.png?_r=0","PhotoWidth":200,"PhotoHeight":195,"PhotoType":"custom"},"FormattedName":"Yazmin De La Mora","Id":207443,"Name":"Yazmin De La Mora","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisi