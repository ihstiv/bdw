o-282128.jpg?_r=1441196917","PhotoWidth":200,"PhotoHeight":203,"PhotoType":"custom"},"FormattedName":"JoannaBanana","Id":282128,"Name":"JoannaBanana","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.15.187","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79202,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5e668384857e657be43ac4f3c58b1c83","RawContent":"&lt;p&gt;@[member=\"JoannaBanana\"] You should!!!! Why the heck not?? The more the merrier!! Does Aug 14th work for you?&lt;\/p&gt;","Attachments":[],"Id":1898977,"PostDate":1434902865,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"282128\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='https:\/\/www.bestdestinationwedding.com\/index.phpuser\/282128-joannabanana\/' title='Member profile'><span itemprop=\"name\">JoannaBanana<\/span><\/a> You should!!!! Why the heck not?? The more the merrier!! Does Aug 14th work for you?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#ff0099;\"><em>I said \"yes\" again to the love of my life at Grand Coral Beach Club, Playa del Carmen, Mexico on our 4th anniversary - October 20, 2015<\/em><\/span><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/'><span style=\"color:#ff0099;\"><em>http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/<\/em><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;484\/st\/20111020\/e\/Our+Wedding\/k\/6168\/event.png\" alt=\"event.png\"><\/a>","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283458999,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"209.171.88.51","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79202,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"7740499f0b86b4d782d2b57315322b49","RawContent":"I have to read back and see the time, but it&#039;s Friday?  I don&#039;t see why not.  I work to 5 in Mississauga.","Attachments":[],"Id":1898978,"PostDate":1434903567,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I have to read back and see the time, but it's Friday?  I don't see why not.  I work to 5 in Mississauga.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>My Planning Thread (Grand Sirenis 05.12.16)<a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/79418-joannabananas-planning-thread-may-12th-2016-grand-sirenis\/\">http:\/\/www.bestdestinationwedding.com\/topic\/79418-joannabananas-planning-thread-may-12th-2016-grand-sirenis\/<\/a><p><br><br><br><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/t\/wSWQNi0\/weight.png\" alt=\"weight.png\"><br><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;484\/st\/20160512\/e\/Our+Wedding\/k\/f153\/event.png\" alt=\"event.png\">","Email":"joanne.aguiar@gmail.com","IpAddress":"99.234.116.105","GroupId":40,"GroupName":"Jr. Member","JoinDate":1424056909,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-282128.jpg?_r=1441196917","PhotoWidth":200,"PhotoHeight":203,"PhotoType":"custom"},"FormattedName":"JoannaBanana","Id":282128,"Name":"JoannaBanana","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.15.187","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79202,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"3914bff67cb44a9d5db4a18c5a05c375","RawContent":"&lt;p&gt;I&#039;m the opposite. I&#039;m til at least 5 (usually a whole lot later!) downtown and then go out to Mississauga. it will give everyone a chance to gab about wedding plans and all kinds of other stuff! And hopefully we&#039;ll have one new bride in the mix and she&#039;ll be able to report back on how things went!!&lt;\/p&gt;","Attachments":[],"Id":1898979,"PostDate":1434904910,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I'm the opposite. I'm til at least 5 (usually a whole lot later!) downtown and then go out to Mississauga. it will give everyone a chance to gab about wedding plans and all kinds of other stuff! And hopefully we'll have one new bride in the mix and she'll be able to report back on how things went!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#ff0099;\"><em>I said \"yes\" again to the love of my life at Grand Coral Beach Club, Playa del Carmen, Mexico on our 4th anniversary - October 20, 2015<\/em><\/span><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/'><span style=\"color:#ff0099;\"><em>http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/<\/em><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;484\/st\/20111020\/e\/Our+Wedding\/k\/6168\/event.png\" alt=\"event.png\"><\/a>","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283458999,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"207.134.141.162","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79202,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"dbe3d8f3e86b9e5cd5ecdd3e3ba4f507","Raw