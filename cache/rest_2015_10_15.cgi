0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":false,"TopicId":73219,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3481eab0e03be6f4165424cc408b15de","RawContent":"&lt;p&gt; great idea&lt;\/p&gt;","Attachments":[],"Id":1738869,"PostDate":1364340267,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> great idea<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"k_fritz87@yahoo.com","IpAddress":"","GroupId":5,"GroupName":"Banned","JoinDate":1361049676,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-266153.jpeg?_r=0","PhotoWidth":100,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"kfritz","Id":266153,"Name":"kfritz","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73219,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5ea690bf02025b6dec538cd9e033e5c0","RawContent":"They&#039;re done!! They look awesome! For $25 you can&#039;t go wrong! We didn&#039;t even have to put the stickers on! One less thing we have to do! :) It&#039;s not so DIY but our original plan didn&#039;t work so well... So , if you want to do these, get the cups from your local dollarama and take them to a local sign\/graphics company and see what they would charge - you&#039;d be surprised! [img]http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/195719\/width\/200\/height\/400[\/img]","Attachments":[],"Id":1739272,"PostDate":1364418543,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                They're done!! They look awesome! For $25 you can't go wrong! We didn't even have to put the stickers on! One less thing we have to do! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> It's not so DIY but our original plan didn't work so well... So , if you want to do these, get the cups from your local dollarama and take them to a local sign\/graphics company and see what they would charge - you'd be surprised! <span rel='lightbox'><img class='bbc_img' src='http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/195719\/width\/200\/height\/400' alt='Posted Image'  \/><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"silla.feliz@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1334781041,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-254217.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"sillafeliz","Id":254217,"Name":"sillafeliz","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73219,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"de981ff31d2ada0d69687b03b4df6a8d","RawContent":"&lt;p&gt; what size are you r stickers that you orderes\n &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1739324,"PostDate":1364422632,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> what size are you r stickers that you orderes<br \/> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"saraworld@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1334854139,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-254253.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"sosodj","Id":254253,"Name":"sosodj","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73219,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2ed14c0d0d8cd83cece7e300321cf5a1","RawContent":"They came out awesome! :D I really want to do this, they look so cute! [quote]\nOriginally Posted by [b]sillafeliz[\/b] \/img\/forum\/go_quote.gif\n \n They&#039;re done!! They look awesome! For $25 you can&#039;t go wrong! We didn&#039;t even have to put the stickers on! One less thing we have to do! :) It&#039;s not so DIY but our original plan didn&#039;t work so well... So , if you want to do these, get the cups from your local dollarama and take them to a local sign\/graphics company and see what they would charge - you&#039;d be surprised!\n \n [img]http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/195719\/width\/200\/height\/400[\/img][\/quote]","Attachments":[],"Id":1739328,"PostDate":1364422789,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> They came out awesome! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/biggrin.png' class='bbc_emoticon' alt=':D' \/> I really want to do this, they look so cute!<\/p> <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>sillafeliz<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> They're done!! They look awesome! For $25 you can't go wrong! We didn't even have to put the stickers on! One less thing we have to do! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> It's not so DIY but our original plan didn't work so well... So , if you want to do these, get the cups from your local dollarama and take them to a local sign\/graphics company and see what they would charge - you'd be surprised!<br \/> <br \/> <span rel='lightbox'><img class='bbc_img' alt=\"\" data-id=\"195719\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/195719\/width\/200\/height\/400\" \/><\/span><\/blockquote>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lyna_89_07@mugglenet.com","IpAddress":"172.8.174.118","GroupId":39,"GroupName":"Newbie","JoinDate":1362343091,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-266841.jpeg?_r=0","PhotoWidth":180,"PhotoHeight":161,"PhotoType":"custom"},"FormattedName":"lyna89","Id":266841,"Name":"lyna89","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73219,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"04b3d5e9d7feced55acc39fba8a46e30","RawContent":"Alright SillaFeliz, spill the beans :)! \u00e2\u20ac\u00a2 How many cups did they do? \u00e2\u20ac\u00a2 What kind of label us this? \u00e2\u20ac\u00a2 Would you mind sharing the name of the sign shop you went to? You guys are awesome!","Attachments":[],"Id":1739398,"PostDate":1364440128,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Alright SillaFeliz, spill the beans <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>! \u00e2\u20ac\u00a2 How many cups did they do? \u00e2\u20ac\u00a2 What kind of label us this? \u00e2\u20ac\u00a2 Would you mind sharing the name of the sign shop you went to? You guys are awesome!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mvee1025@gmail.com","IpAddress":"99.177.132.210","GroupId":40,"GroupName":"Jr. Member","JoinDate":1359850900,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265570.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"mvee1025","Id":265570,"Name":"mvee1025","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73219,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8b9d7bef59c29f6f5016194c8dff7a51","RawContent":"[quote name=\"sillafeliz\"]\nThey&#039;re done!! They look awesome! For $25 you can&#039;t go wrong! We didn&#039;t even have to put the stickers on! One less thing we have to do! :) It&#039;s not so DIY but our original plan didn&#039;t work so well... So , if you want to do these, get the cups from your local dollarama and take them to a local sign\/graphics company and see what they would charge - you&#039;d be surprised! [img]http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/195719\/width\/200\/height\/400[\/img][\/quote] Oh these are gorgeous! Turned out really well! I really want to do cups but don&#039;t seem to have as much choice here in Scotland, anything I seem to find online has crazy shipping fees. I&#039;m going to pinch your idea and check with my local printers , thanks.","Attachments":[],"Id":1739400,"PostDate":1364440593,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <blockquote class='ipsBlockquote' data-author=\"sillafeliz\" url=\"\/t\/85507\/diy&#045;tumblers&#045;with&#045;pics&#045;share&#045;your&#045;designs#post_1888841\"><p>They're done!! They look awesome! For $25 you can't go wrong! We didn't even have to put the stickers on! One less thing we have to do! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> It's not so DIY but our original plan didn't work so well... So , if you want to do these, get the cups from your local dollarama and take them to a local sign\/graphics company and see what they would charge - you'd be surprised! <span rel='lightbox'><img class='bbc_img' src='http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/195719\/width\/200\/height\/400' alt='Posted Image'  \/><\/span><\/p><\/blockquote> Oh these are gorgeous! Turned out really well! I really want to do cups but don't seem to have as much choice here in Scotland, anything I seem to find online has crazy shipping fees. I'm going to pinch your idea and check with my local printers , thanks.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"eunicequigley@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1357655870,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-264073.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"eq123","Id":264073,"Name":"eq123","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73219,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4b45b402d38c8c50f99e41db86238450","RawContent":"[quote]\nOriginally Posted by [b]MRSPWILSON[\/b] \/img\/forum\/go_quote.gif\n \n \n Just ordered some of these!  Thanks![\/quote] \n What size stickers did you order? Those looks like the perfect size! I see they offer any size and I don&#039;t know what size to tell them. Thanks!","Attachments":[],"Id":1739465,"PostDate":1364464766,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>MRSPWILSON<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> <p> Just ordered some of these!\u00a0 Thanks!<\/p> <\/blockquote> <p> What size stickers did you order? Those looks like the perfect size! I see they offer any size and I don't know what size to tell them. Thanks!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"chelsea_catanzarita@yahoo.com","IpAddress":"8.28.150.75","GroupId":47,"GroupName":"Site Supporter","JoinDate":1352901772,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-262370.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":183,"PhotoType":"custom"},"FormattedName":"ChelseaCat802","Id":262370,"Name":"ChelseaCat802","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73219,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ee1c4e5b5862651b224eef4b1c097da0","RawContent":"THESE ARE PERFECT and exactly what I needed!!  Did you test them out and see that they are really waterproof?? they look awesome! [quote]\nOriginally Posted by [b]SamIAm85[\/b] \/img\/forum\/go_quote.gif\n \n \n I ordered waterproof labels from Bridget at Davet Designs. [img]http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/194205\/width\/350\/height\/700[\/img][\/quote]","Attachments":[],"Id":1739490,"PostDate":1364467525,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> THESE ARE PERFECT and exactly what I needed!! \u00a0Did you test them out and see that they are really waterproof?? they look awesome!<\/p> <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>SamIAm85<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> <p> I ordered waterproof labels from Bridget at Davet Designs. <span rel='lightbox'><img class='bbc_img' alt=\" \" data-id=\"194205\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/194205\/width\/350\/height\/700\" \/><\/span><\/p> <\/blockquote>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"latina_jenn@hotmail.com","IpAddress":"66.241.131.24","GroupId":40,"GroupName":"Jr. Member","JoinDate":1359022290,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265001.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":125,"PhotoType":"custom"},"FormattedName":"Jenn963","Id":265001,"Name":"Jenn963","IsOnline":false}}],"Pages":{"TotalItems":107,"TotalPages":11,"CurrentPage":10,"NextPage":20,"PreviousPage":0,"LastPage":100},"PushNotifications":[{