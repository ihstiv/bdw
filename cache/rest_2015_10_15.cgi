4,"PhotoType":"custom"},"FormattedName":"TinkerSofi","Id":265511,"Name":"TinkerSofi","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"184.151.178.164","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":false,"TopicId":78874,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"edbaad643c1710dadaaae2db317f8e3b","RawContent":"The thing is until I get the chance to get out and try something on I&#039;m pretty much open to almost anything. but I&#039;m almost certain I want the keyhole style. unless it looks totally awful!","Attachments":[],"Id":1888632,"PostDate":1425671525,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                The thing is until I get the chance to get out and try something on I'm pretty much open to almost anything. but I'm almost certain I want the keyhole style. unless it looks totally awful!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><em><span style=\"color:rgb(51,153,255);\">I'm lucky enough to\u00a0tell my husband how much I love him and say yes again\u00a0on October 20, 2015 at Grand Coral Beach Club!\u00a0<\/span><\/em>","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"64.231.99.15","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":false,"TopicId":78874,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b39eadd41234ba1d294ce9b38473f948","RawContent":"[quote name=\"calgarybride2015\" post=\"1888547\" timestamp=\"1425610313\"]\nIt&#039;s beautiful. Not sure why you&#039;d think you were too old for it. Just depends if you like showing cleavage? I don&#039;t hehe hence the neckline I chose. You will look gorgeous in it.\n\n\nSent from my iPhone using Tapatalk[\/quote]\nKim - that&#039;s so sweet. Really. But let&#039;s just say I&#039;m waaaaaaaaaay beyond the age of majority and have actually hit &amp;amp;@# something.... lol","Attachments":[],"Id":1888647,"PostDate":1425679230,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>calgarybride2015, on 05 March 2015 - 10:51 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>It's beautiful. Not sure why you'd think you were too old for it. Just depends if you like showing cleavage? I don't hehe hence the neckline I chose. You will look gorgeous in it.<br><br><br>\nSent from my iPhone using Tapatalk<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>Kim - that's so sweet. Really. But let's just say I'm waaaaaaaaaay beyond the age of majority and have actually hit &@# something.... lol<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><em><span style=\"color:rgb(51,153,255);\">I'm lucky enough to\u00a0tell my husband how much I love him and say yes again\u00a0on October 20, 2015 at Grand Coral Beach Club!\u00a0<\/span><\/em>","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"174.117.36.109","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78874,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":true,"PostKey":"368df944e67255ff8d2ebe5e05610549","RawContent":"I love the dress!!!! You are never too old for a dress that makes you feel beautiful! So if it feels right it&#039;s the one...if you are self conscious in it then perhaps try another\n\n\n\nSent from my iPad using Tapatalk","Attachments":[],"Id":1888685,"PostDate":1425758389,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I love the dress!!!! You are never too old for a dress that makes you feel beautiful! So if it feels right it's the one...if you are self conscious in it then perhaps try another<br><br><br>\nSent from my iPad using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div>\u00a0<\/div>\n<div><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78914-meandhim-grand-palladium-bavaro-nov-2015\/'>My Planning Thread<\/a>\u00a0- MeandHim - Grand Palladium Bavaro - Nov 25 2015<\/div>\n<div>\u00a0<\/div>\n<div><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10765;116\/st\/20151125\/e\/Our+Wedding\/k\/461e\/event.png\" alt=\"event.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"markandshavonne@live.com","IpAddress":"70.30.85.211","GroupId":3,"GroupName":"Member","JoinDate":1365777659,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-268499.jpg?_r=1395417550","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"Meandhim","Id":268499,"Name":"Meandhim","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"64.231.99.15","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":false,"TopicId":78874,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9fc1bb1b2f99ac358343c4549fe55cf5","RawContent":"&lt;p&gt;So a question. I&#039;m trying to decide on a veil. Just a short one and the kind that sits at the nape of your neck. I&#039;ve never worn one and I&#039;m kinda thinking.....&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thoughts? I found a really nice second hand one that she&#039;s only asking $30 for.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Who got sunglasses and is willing to recommend the site where they bought them? I want the funky ones for pictures and I only need a few (the black and colour ones).&lt;\/p&gt;","Attachments":[],"Id":1889050,"PostDate":1426109523,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>So a question. I'm trying to decide on a veil. Just a short one and the kind that sits at the nape of your neck. I've never worn one and I'm kinda thinking.....<\/p>\n<p>\u00a0<\/p>\n<p>Thoughts? I found a really nice second hand one that she's only asking $30 for.<\/p>\n<p>\u00a0<\/p>\n<p>Who got sunglasses and is willing to recommend the site where they bought them? I want the funky ones for pictures and I only need a few (the black and colour ones).<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><em><span style=\"color:rgb(51,153,255);\">I'm lucky enough to\u00a0tell my husband how much I love him and say yes again\u00a0on October 20, 2015 at Grand Coral Beach Club!\u00a0<\/span><\/em>","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.72.41.59","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78874,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6c885f8330559f315b93054859464c08","RawContent":"[quote name=\"acw271011\" post=\"1889050\" timestamp=\"1426123923\"]\nSo a question. I&#039;m trying to decide on a veil. Just a short one and the kind that sits at the nape of your neck. I&#039;ve never worn one and I&#039;m kinda thinking.....\n\nThoughts? I found a really nice second hand one that she&#039;s only asking $30 for.\n\nWho got sunglasses and is willing to recommend the site where they bought them? I want the funky ones for pictures and I only need a few (the black and colour ones).[\/quote]I have no suggestions about veils as I didn&#039;t want one and felt weird in it. So not me. Have you had one on in that length? Do\nYou love? If yes I say go for it :) \n\nI got my sunglasses at dollarama for $2 a pair. They came with silly glass case too. They had green orange pink and blue. I saw them recently still at dollarama so must be a year round item. \n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1889051,"PostDate":1426113049,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>acw271011, on 11 March 2015 - 09:32 PM, said:<\/p><div class='blockquote'><div class='quote'><p>So a question. I'm trying to decide on a veil. Just a short one and the kind that sits at the nape of your neck. I've never worn one and I'm kinda thinking.....<br><br>\nThoughts? I found a really nice second hand one that she's only asking $30 for.<br><br>\nWho got sunglasses and is willing to recommend the site where they bought them? I want the funky ones for pictures and I only need a few (the black and colour ones).<\/p><\/div><\/div>\n<br>\nI have no suggestions about veils as I didn't want one and felt weird in it. So not me. Have you had one on in that length? Do<br>\nYou love? If yes I say go for it <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> <br><br>\nI got my sunglasses at dollarama for $2 a pair. They came with silly glass case too. They had green orange pink and blue. I saw them recently still at dollarama so must be a year round item. <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399414202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"64.231.99.15","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":false,"TopicId":78874,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4a380eccb8f47179d8c3676319e02f83","RawContent":"[quote name=\"calgarybride2015\" post=\"1889051\" timestamp=\"1426127449\"]\nI have no suggestions about veils as I didn&#039;t want one and felt weird in it. So not me. Have you had one on in that length? Do\nYou love? If yes I say go for it :)\n\nI got my sunglasses at dollarama for $2 a pair. They came with silly glass case too. They had green orange pink and blue. I saw them recently still at dollarama so must be a year round item.\n\n\nSent from my iPhone using Tapatalk[\/quote]\nI&#039;m hoping next week to take a day off (finally) and go and try styles and see what I like and what I don&#039;t so might try a short veil then. My plan was to do a half up half down so I just don&#039;t know if what I&#039;m thinking will work.\n\nI have two Dollarama stores very close so I&#039;m going to check them out and see if they have the sunglasses here. I only need 8 pairs but I figure since they&#039;re cheap I should get a couple of extras in case they break. How did you find the wear on them?","Attachments":[],"Id":1889055,"PostDate":1426114405,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>calgarybride2015, on 11 March 2015 - 10:30 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>I have no suggestions about veils as I didn't want one and felt weird in it. So not me. Have you had one on in that length? Do<br>\nYou love? If yes I say go for it <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br><br>\nI got my sunglasses at dollarama for $2 a pair. They came with silly glass case too. They had green orange pink and blue. I saw them recently still at dollarama so must be a year round item.<br><br><br>\nSent from my iPhone using Tapatalk<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>I'm hoping next week to take a day off (finally) and go and try styles and see what I like and what I don't so might try a short veil then. My plan was to do a half up half down so I just don't know if what I'm thinking will work.<\/p>\n<p>\u00a0<\/p>\n<p>I have two Dollarama stores very close so I'm going to check them out and see if they have the sunglasses here. I only need 8 pairs but I figure since they're cheap I should get a couple of extras in case they break. How did you find the wear on them?<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><em><span style=\"color:rgb(51,153,255);\">I'm lucky enough to\u00a0tell my husband how much I love him and say yes again\u00a0on October 20, 2015 at Grand Coral Beach Club!\u00a0<\/span><\/em>","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.72.41.59","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78874,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"289a2cdf8688598494017105bcab7a90","RawContent":"[quote name=\"acw271011\" post=\"1889055\" timestamp=\"1426128805\"]\nI&#039;m hoping next week to take a day off (finally) and go and try styles and see what I like and what I don&#039;t so might try a short veil then. My plan was to do a half up half down so I just don&#039;t know if what I&#039;m thinking will work.\n\nI have two Dollarama stores very close so I&#039;m going to check them out and see if they have the sunglasses here. I only need 8 pairs but I figure since they&#039;re cheap I should get a couple of extras in case they break. How did you find the wear on them?[\/quote]I&#039;d suggest going to try them on forsure and maybe do a mock up do the way you plan to have for your vows so you can picture it :)\n\nI never had any break or heard that anyone&#039;s had. We bought some in the summer as well but the kids lost them in lake Okanagon lol. I&#039;d say for $2 and what you plan to use them for they are perfect. \n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1889056,"PostDate":1426116086,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>acw271011, on 11 March 2015 - 10:53 PM, said:<\/p><div class='blockquote'><div class='quote'><p>I'm hoping next week to take a day off (finally) and go and try styles and see what I like and what I don't so might try a short veil then. My plan was to do a half up half down so I just don't know if what I'm thinking will work.<br><br>\nI have two Dollarama stores very close so I'm going to check them out and see if they have the sunglasses here. I only need 8 pairs but I figure since they're cheap I should get a couple of extras in case they break. How did you find the wear on them?<\/p><\/div><\/div>\n<br>\nI'd suggest going to try them on forsure and maybe do a mock up do the way you plan to have for your vows so you can picture it <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br><br>\nI never had any break or heard that anyone's had. We bought some in the summer as well but the kids lost them in lake Okanagon lol. I'd say for $2 and what you plan to use them for they are perfect. <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399414202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}}],"Pages":{"TotalItems":380,"TotalPages":38,"CurrentPage":20,"NextPage":30,"PreviousPage":10,"LastPage":370},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
