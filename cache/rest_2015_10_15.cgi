> URL: /index.php?/REST/Forums/topic/getPosts?topicId=78874&start=90&SessionId=4ae948f5e86529a90963a3bd6aa5978c
> User acw271011 (232000)
Request Time: 0 seconds
{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"208.87.237.180","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":false,"TopicId":78874,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6e03b7c25951f68d4622c01aa8ea5040","RawContent":"&lt;p&gt;Geez this overtime is killing me! So want to get rid of this cold, but it looks like it&#039;s going to be another 60 hour week!!! Aahhhhh! I&#039;m too old for this!!!&lt;\/p&gt;","Attachments":[],"Id":1893984,"PostDate":1429725912,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Geez this overtime is killing me! So want to get rid of this cold, but it looks like it's going to be another 60 hour week!!! Aahhhhh! I'm too old for this!!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><em><span style=\"color:rgb(51,153,255);\">I'm lucky enough to\u00a0tell my husband how much I love him and say yes again\u00a0on October 20, 2015 at Grand Coral Beach Club!\u00a0<\/span><\/em>","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"208.98.196.2","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78874,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"15dca2d91b9ce523550a62367a0bf253","RawContent":"[quote name=\"acw271011\" post=\"1893984\" timestamp=\"1429740312\"]\nGeez this overtime is killing me! So want to get rid of this cold, but it looks like it&#039;s going to be another 60 hour week!!! Aahhhhh! I&#039;m too old for this!!![\/quote]I don&#039;t know how you do it. I&#039;m having a long week and can&#039;t wait for it to be over! hahah \n\nI&#039;ll give you my brother&#039;s recipe for colds: \n- a few shots of jagermeister (enough to warm you up haha)\n- you put on some sweatpants and a sweater\n- you have a nap with as many blankets as you can\n\nHe says it works like a charm every time and he feels so much better when he wakes up hahah.","Attachments":[],"Id":1893992,"PostDate":1429726937,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>acw271011, on 22 April 2015 - 06:05 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Geez this overtime is killing me! So want to get rid of this cold, but it looks like it's going to be another 60 hour week!!! Aahhhhh! I'm too old for this!!!<\/p>\n<\/div>\n<\/div><\/div>\n<p>I don't know how you do it. I'm having a long week and can't wait for it to be over! hahah\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I'll give you my brother's recipe for colds:\u00a0<\/p>\n<p>- a few shots of jagermeister (enough to warm you up haha)<\/p>\n<p>- you put on some sweatpants and a sweater<\/p>\n<p>- you have a nap with as many blankets as you can<\/p>\n<p>\u00a0<\/p>\n<p>He says it works like a charm every time and he feels so much better when he wakes up hahah.\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<br><p><a data-ipb='nomediaparse' href='http:\/\/www.TickerFactory.com\/'><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;31;484\/st\/20150813\/e\/Wedding+time%21+\/dt\/-2\/k\/b92c\/event.png\" alt=\"event.png\"><\/a><\/p>\n<p style=\"text-align:center;\">\u00a0<\/p>\n<p style=\"text-align:center;\">\u00a0","Email":"sblopezb@gmail.com","IpAddress":"172.219.193.22","GroupId":42,"GroupName":"Sr. Member","JoinDate":1359748704,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265511.jpg?_r=1442890536","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"TinkerSofi","Id":265511,"Name":"TinkerSofi","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"208.87.237.180","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":false,"TopicId":78874,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2ff8c9be277b6e1496a5852f4bbfb426","RawContent":"&lt;p&gt;honestly at this point I&#039;m tempted to almost try it!! lol&amp;nbsp; break is over. back to work. I was going cross-eyed with the documents I&#039;m working on. I needed my eyes on something else! Kristy&#039;s pics definitely did the trick!!! (except for the tears.... lol)&lt;\/p&gt;","Attachments":[],"Id":1893993,"PostDate":1429727143,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>honestly at this point I'm tempted to almost try it!! lol\u00a0 break is over. back to work. I was going cross-eyed with the documents I'm working on. I needed my eyes on something else! Kristy's pics definitely did the trick!!! (except for the tears.... lol)<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><em><span style=\"color:rgb(51,153,255);\">I'm lucky enough to\u00a0tell my husband how much I love him and say yes again\u00a0on October 20, 2015 at Grand Coral Beach Club!\u00a0<\/span><\/em>","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.15.187","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":false,"TopicId":78874,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"fd45a97fc5126f73e51bc8c0c204bb67","RawContent":"&lt;p&gt;After 110 hours in two weeks, I finally have the chance to stop in here and see what you ladies are up to.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We had some news yesterday that is a bit concerning but hoping it works itself out. I was back in the ER a few weeks back. Panic mode thinking it was another blood clot in my lungs. Thankfully it wasn&#039;t but it prompted some other tests in two ways. It turns out I have something up with the tendons in my shoulder - calcified something or other so now we&#039;re off to see an orthopedic specialist. Family doc says surgery is usually a last resort.... yeah from your lips to God&#039;s ears! So we&#039;re waiting on that. But the other thing is now an investigation has started for my breathing, which still hasn&#039;t gotten much better from last fall. The thinking is that there may be some residual damage to my lungs from what was a second pulmonary embolism so they&#039;re looking into pulmonary hypertension. I&#039;ve been trying to read what it is and my brain is just mush from all of the overtime I&#039;ve had over the last couple of weeks. The hospital yesterday has moved really fast (surprising) and the first tests are Thursday, the second next Wednesday then the results on the 21st. At this point I&#039;m not even allowing myself to think past the 21st. We&#039;ll deal with whatever we have to then.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;So on that note, I actually got our key card holders started on the weekend. The suggestion from @[member=\"Meandhim\"] to put a card on the outside I think worked out pretty well and I tied it on with our colours of ribbon. I know the card will just get tossed so I didn&#039;t want to be too fussy about it, but the idea from @[member=\"TinkerSofi\"] for photo paper also did the trick. So here they are - a blank and the finished ones. Sorry for the lousy pictures. It&#039;s not something I do well! lol&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;I also got the lanterns for the table at the restaurant from IKEA and I got \"ocean\" scented blue tealights to go inside. Not a big deal but it&#039;s sort of fun to pick up little things even though we still have a long way to go yet.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;u&gt;Resort Update:&lt;\/u&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;So I found a resort that I&#039;m waiting for a reply from our TA about - Platinum Yucatan Princess All Suites Resort. It&#039;s a stay at one and play at 3 part of Grand Sunset and Grand Riviera. The reviews are really good and so are the food reviews plus it&#039;s adults only. A big plus for us. But most importantly it solves our bed issue and we can all get king sized beds! The price point is better than Azul Fives too. So we&#039;ll see what the TA says. I left a message today and hopefully will hear back tomorrow. Right now it&#039;s probably a good idea to wait until after the 21st before we book anything but...... see what happens.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1895480,"PostDate":1430870320,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>After 110 hours in two weeks, I finally have the chance to stop in here and see what you ladies are up to.<\/p>\n<p>\u00a0<\/p>\n<p>We had some news yesterday that is a bit concerning but hoping it works itself out. I was back in the ER a few weeks back. Panic mode thinking it was another blood clot in my lungs. Thankfully it wasn't but it prompted some other tests in two ways. It turns out I have something up with the tendons in my shoulder - calcified something or other so now we're off to see an orthopedic specialist. Family doc says surgery is usually a last resort.... yeah from your lips to God's ears! So we're waiting on that. But the other thing is now an investigation has started for my breathing, which still hasn't gotten much better from last fall. The thinking is that there may be some residual damage to my lungs from what was a second pulmonary embolism so they're looking into pulmonary hypertension. I've been trying to read what it is and my brain is just mush from all of the overtime I've had over the last couple of weeks. The hospital yesterday has moved really fast (surprising) and the first tests are Thursday, the second next Wednesday then the results on the 21st. At this point I'm not even allowing myself to think past the 21st. We'll deal with whatever we have to then.<\/p>\n<p>\u00a0<\/p>\n<p>So on that note, I actually got our key card holders started on the weekend. The suggestion from @<a hovercard-ref=\"member\" hovercard-id=\"268499\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/268499-meandhim\/' title='Member profile'><span itemprop=\"name\">Meandhim<\/span><\/a> to put a card on the outside I think worked out pretty well and I tied it on with our colours of ribbon. I know the card will just get tossed so I didn't want to be too fussy about it, but the idea from @<a hovercard-ref=\"member\" hovercard-id=\"265511\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/265511-tinkersofi\/' title='Member profile'><span itemprop=\"name\">TinkerSofi<\/span><\/a> for photo paper also did the trick. So here they are - a blank and the finished ones. Sorry for the lousy pictures. It's not something I do well! lol<\/p>\n<p><a class='resized_img' rel='lightbox[1895480]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2015\/post-232000-0-70029600-1430884354.jpg\" title=\"IMG_2687.JPG -  104.77KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2015\/post-232000-0-70029600-1430884354.jpg\" class='bbc_img linked-image' alt=\"IMG_2687.JPG\" \/><\/a>\n\n<\/p>\n<p><a class='resized_img' rel='lightbox[1895480]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2015\/post-232000-0-07304500-1430884356.jpg\" title=\"IMG_2693.JPG -  63.8KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2015\/post-232000-0-07304500-1430884356.jpg\" class='bbc_img linked-image' alt=\"IMG_2693.JPG\" \/><\/a>\n\n<\/p>\n<p><a class='resized_img' rel='lightbox[1895480]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2015\/post-232000-0-35815000-1430884357.jpg\" title=\"IMG_2694.JPG -  63.31KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2015\/post-232000-0-35815000-1430884357.jpg\" class='bbc_img linked-image' alt=\"IMG_2694.JPG\" \/><\/a>\n\n<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0I also got the lanterns for the table at the restaurant from IKEA and I got \"ocean\" scented blue tealights to go inside. Not a big deal but it's sort of fun to pick up little things even though we still have a long way to go yet.<\/p>\n<p>\u00a0<\/p>\n<p><u>Resort Update:<\/u><\/p>\n<p>\u00a0<\/p>\n<p>So I found a resort that I'm waiting for a reply from our TA about - Platinum Yucatan Princess All Suites Resort. It's a stay at one and play at 3 part of Grand Sunset and Grand Riviera. The reviews are really good and so are the food reviews plus it's adults only. A big plus for us. But most importantly it solves our bed issue and we can all get king sized beds! The price point is better than Azul Fives too. So we'll see what the TA says. I left a message today and hopefully will hear back tomorrow. Right now it's probably a good idea to wait until after the 21st before we book anything but...... see what happens.<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><em><span style=\"color:rgb(51,153,255);\">I'm lucky enough to\u00a0tell my husband how much I love him and say yes again\u00a0on October 20, 2015 at Grand Coral Beach Club!\u00a0<\/span><\/em>","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.85.127.174","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78874,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9eec456e3a9c2e40c82a6fc22ade6cc1","RawContent":"&lt;p&gt;@[member=\"acw271011\"] -&amp;nbsp;Sending good vibes your way. Glad you are getting the tests done quickly. Waiting can be the worst part.&amp;nbsp; :(&lt;\/p&gt;","Attachments":[],"Id":1895486,"PostDate":1430872116,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"232000\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/232000-acw271011\/' title='Member profile'><span itemprop=\"name\">acw271011<\/span><\/a> -\u00a0Sending good vibes your way. Glad you are getting the tests done quickly. Waiting can be the worst part.\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/sad.png' class='bbc_emoticon' alt=':(' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>- Erin<\/p>\n<p>\u00a0<\/p>\n<p>My planning thread:\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79068-vancouverpetunia-now-sapphire-april-7-2016\/?p=1893268'>http:\/\/www.bestdestinationwedding.com\/topic\/79068-vancouverpetunia-now-sapphire-april-7-2016\/?p=1893268<\/a>","Email":"ekjzwedding@gmail.com","IpAddress":"24.85.127.174","GroupId":40,"GroupName":"Jr. Member","JoinDate":1417435045,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281283.jpg?_r=1428779369","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"vancouverpetunia","Id":281283,"Name":"vancouverpetunia","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"80.42.248.77","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78874,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"703d915f35eea92125b228bbec77c36b","RawContent":"@[member=\"acw271011\"] Wishing you all the best for your tests and results.  You sound like one hell of a fighter so I&#039;m sure it will be fine in the end [emoji256] \n\n\nMaybeoneday\n\n14 \/10\/2015 - R R C, Mexico","Attachments":[],"Id":1895487,"PostDate":1430874235,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"232000\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/232000-acw271011\/' title='Member profile'><span itemprop=\"name\">acw271011<\/span><\/a> Wishing you all the best for your tests and results.  You sound like one hell of a fighter so I'm sure it will be fine in the end [emoji256] <br><br>\nMaybeoneday<br>\n14 \/10\/2015 - R R C, Mexico\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"shelina_nessa@yahoo.co.uk","IpAddress":"149.254.56.238","GroupId":40,"GroupName":"Jr. Member","JoinDate":1421807139,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"maybeoneday","Id":281816,"Name":"maybeoneday","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"174.117.36.109","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78874,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0ef31cde175c5a2004d9b99f334ecf4c","RawContent":"@[member=\"acw271011\"] I&#039;m so sorry to hear you are having more medical problems after all you&#039;ve been through all ready!! I&#039;ll be sending all my good karma your way. \n\n\nThe key holders look awesome! \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1895489,"PostDate":1430895508,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"232000\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/232000-acw271011\/' title='Member profile'><span itemprop=\"name\">acw271011<\/span><\/a> I'm so sorry to hear you are having more medical problems after all you've been through all ready!! I'll be sending all my good karma your way. <br><br>\nThe key holders look awesome! <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div>\u00a0<\/div>\n<div><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78914-meandhim-grand-palladium-bavaro-nov-2015\/'>My Planning Thread<\/a>\u00a0- MeandHim - Grand Palladium Bavaro - Nov 25 2015<\/div>\n<div>\u00a0<\/div>\n<div><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10765;116\/st\/20151125\/e\/Our+Wedding\/k\/461e\/event.png\" alt=\"event.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"markandshavonne@live.com","IpAddress":"70.30.85.211","GroupId":3,"GroupName":"Member","JoinDate":1365777659,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-268499.jpg?_r=1395417550","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"Meandhim","Id":268499,"Name":"Meandhim","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.72.41.59","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78874,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0c5699175b38811de8a213779acc271b","RawContent":"&lt;p&gt;Sorry to hear about what you are going thru! &amp;nbsp;You are a strong lady and I have no doubt, but the process must get so frustrating for you, so hugs!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;The key holders look great, they turned out fantastic!!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;My boss has stayed at the Yucatan Princess, just late last year. &amp;nbsp;If you want her review I can email her today, but I never heard any bad, so I have to assume she had a great time!&lt;\/p&gt;","Attachments":[],"Id":1895497,"PostDate":1430904177,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Sorry to hear about what you are going thru! \u00a0You are a strong lady and I have no doubt, but the process must get so frustrating for you, so hugs!<\/p>\n<p>\u00a0<\/p>\n<p>The key holders look great, they turned out fantastic!!!<\/p>\n<p>\u00a0<\/p>\n<p>My boss has stayed at the Yucatan Princess, just late last year. \u00a0If you want her review I can email her today, but I never heard any bad, so I have to assume she had a great time!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399414202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.15.187","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":false,"TopicId":78874,"EditedBy":"","EditDate":1430943776,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b31cc63d41d78869926da67547a2d7b5","RawContent":"Thanks ladies. Well the fun just never stops. Spent the day in the hospital today. Took a fall in the subway station at 830 this morning and landed on my face. Results are a concussion and broken nose.  What next? To say I&#039;m done is an understatement. Don&#039;t know why I can&#039;t catch a break anywhere. if it&#039;s true that God never gives you more than you can handle then hey to the man upstairs, I&#039;m just about at the end of my rope.","Attachments":[],"Id":1895565,"PostDate":1430935729,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks ladies. Well the fun just never stops. Spent the day in the hospital today. Took a fall in the subway station at 830 this morning and landed on my face. Results are a concussion and broken nose.  What next? To say I'm done is an understatement. Don't know why I can't catch a break anywhere. if it's true that God never gives you more than you can handle then hey to the man upstairs, I'm just about at the end of my rope.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><em><span style=\"color:rgb(51,153,255);\">I'm lucky enough to\u00a0tell my husband how much I love him and say yes again\u00a0on October 20, 2015 at Grand Coral Beach Club!\u00a0<\/span><\/em>","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.85.127.174","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78874,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3d28a06a9948c6e54f7e7b1d5fa3dd7c","RawContent":"What?!? Oh no. I&#039;m so sorry to hear that. [emoji15]\n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1895576,"PostDate":1430945358,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                What?!? Oh no. I'm so sorry to hear that. [emoji15]<br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>- Erin<\/p>\n<p>\u00a0<\/p>\n<p>My planning thread:\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79068-vancouverpetunia-now-sapphire-april-7-2016\/?p=1893268'>http:\/\/www.bestdestinationwedding.com\/topic\/79068-vancouverpetunia-now-sapphire-april-7-2016\/?p=1893268<\/a>","Email":"ekjzwedding@gmail.com","IpAddress":"24.85.127.174","GroupId":40,"GroupName":"Jr. Member","JoinDate":1417435045,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281283.jpg?_r=1428779369","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"vancouverpetunia","Id":281283,"Name":"vancouverpetunia","IsOnline":false}}],"Pages":{"TotalItems":380,"TotalPages":38,"CurrentPage":90,"NextPage":100,"PreviousPage":80,"LastPage":370},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
