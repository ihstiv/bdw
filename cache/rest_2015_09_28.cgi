eBHolders","Id":278146,"Name":"TheBHolders","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"162.231.9.34","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":67485,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c3ddedf98af785e5473d810290b6f136","RawContent":"&lt;p&gt;coral, aqua and gold for d\u00e9cor&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;we are doing coral for bridesmaids,&amp;nbsp; tiffany blue\/aqua for grooms mom.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Our flowers are going to have coral, peach, white and tiffany blue flowers&lt;\/p&gt;","Attachments":[],"Id":1880057,"PostDate":1418163665,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>coral, aqua and gold for d\u00e9cor<\/p>\n<p>\u00a0<\/p>\n<p>we are doing coral for bridesmaids,\u00a0 tiffany blue\/aqua for grooms mom.\u00a0<\/p>\n<p>Our flowers are going to have coral, peach, white and tiffany blue flowers<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mishtb96@aol.com","IpAddress":"162.231.9.34","GroupId":40,"GroupName":"Jr. Member","JoinDate":1383035267,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-274657.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"misbosox","Id":274657,"Name":"misbosox","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"64.53.250.35","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":67485,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1bf8cee9b20f3d4daceab6dde1c8bb0e","RawContent":"&lt;p&gt;Bright Pink, light pink, and orange! &amp;nbsp;I love that destination weddings let you get away with bright, funky color schemes that would be hard to pull off in a church wedding!&lt;\/p&gt;","Attachments":[],"Id":1880068,"PostDate":1418201136,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Bright Pink, light pink, and orange! \u00a0I love that destination weddings let you get away with bright, funky color schemes that would be hard to pull off in a church wedding!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rachelia160@aim.com","IpAddress":"66.61.104.237","GroupId":40,"GroupName":"Jr. Member","JoinDate":1388713897,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275855.jpg?_r=1435853657","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"rachelia160","Id":275855,"Name":"rachelia160","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.162.162.45","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":67485,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fd768d53f69b72ec22f9cb5275662f85","RawContent":"&lt;p&gt;I am leaning towards teal, fuschia and black but I keep changing my mind. There&#039;s too many options&lt;\/p&gt;","Attachments":[],"Id":1880671,"PostDate":1418853207,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I am leaning towards teal, fuschia and black but I keep changing my mind. There's too many options<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"vsschick@gmail.com","IpAddress":"162.208.80.15","GroupId":40,"GroupName":"Jr. Member","JoinDate":1404466310,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"vsschick1234","Id":278832,"Name":"vsschick1234","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"122.15.103.61","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":67485,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6a37fc51887c0bf0c203b939ecc08f6a","RawContent":"&lt;p&gt;Hey ! you &amp;nbsp;can choose a theme based color on the basis of theme like :&amp;nbsp;&lt;strong&gt;Indoor Garden:&amp;nbsp;&lt;\/strong&gt;&lt;span style=\"font-size:16px;\"&gt;This look was basically created for the summer, or for venues with no natural beauty to add some instant freshness to the&amp;nbsp;decor. It was really&amp;nbsp;like bringing the garden indoor, with the walls covered in greens, large green trees with hanging votive candles, trellis over the dinner area covered with greens and hanging chandeliers. It was kind of like walking into a banquet hall, but getting the feeling of being outdoor!&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1892600,"PostDate":1428650587,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hey ! you \u00a0can choose a theme based color on the basis of theme like :\u00a0<strong>Indoor Garden:\u00a0<\/strong><span  style=\"font-size:16px\">This look was basically created for the summer, or for venues with no natural beauty to add some instant freshness to the\u00a0decor. It was really\u00a0like bringing the garden indoor, with the walls covered in greens, large green trees with hanging votive candles, trellis over the dinner area covered with greens and hanging chandeliers. It was kind of like walking into a banquet hall, but getting the feeling of being outdoor!<\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"katherineriverace@gmail.com","IpAddress":"122.15.103.61","GroupId":39,"GroupName":"Newbie","JoinDate":1425082717,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282278.png?_r=1425103909","PhotoWidth":200,"PhotoHeight":242,"PhotoType":"custom"},"FormattedName":"RitvikSehgal","Id":282278,"Name":"RitvikSehgal","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"122.15.103.61","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":67485,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0fb0a003bf40c1d401ee25303cbc7b66","RawContent":"&lt;p&gt;&lt;span style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif;\"&gt;Bright Pink, light pink, and orange! &amp;nbsp;I love that destination weddings let you get away with bright, funky color schemes that would be hard to pull off in a church wedding!&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1901985,"PostDate":1438829383,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><span  style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif\">Bright Pink, light pink, and orange! \u00a0I love that destination weddings let you get away with bright, funky color schemes that would be hard to pull off in a church wedding!<\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rahulthakur01@hotmail.com","IpAddress":"122.15.103.61","GroupId":39,"GroupName":"Newbie","JoinDate":1438818968,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"rahulthakur01","Id":284300,"Name":"rahulthakur01","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"201.116.201.71","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":67485,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f8f27e08eef8d4f8b19986adacccfc16","RawContent":"&lt;p&gt;Hi &amp;nbsp;girls,&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Your wedding color, says a lot about you and your personality: Colors can express a lot of emotion and feelings. Here are a few ideas, that can help you to select the colors to use for your wedding day!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;div&gt;[sharedmedia=gallery:images:81803]&lt;\/div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:81804]&lt;\/div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:81802]&lt;\/div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:81597]&lt;\/div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:81541]&lt;\/div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:79108]&lt;\/div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:44039]&lt;\/div&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Adventure Weddings&lt;\/p&gt;\n&lt;p&gt;Puerto Vallarta&lt;\/p&gt;\n&lt;p&gt;Toll Free: 1.866.731.81.52&lt;\/p&gt;","Attachments":[],"Id":1902371,"PostDate":1439387931,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi \u00a0girls,<\/p>\n<p>\u00a0<\/p>\n<p>Your wedding color, says a lot about you and your personality: Colors can express a lot of emotion and feelings. Here are a few ideas, that can help you to select the colors to use for your wedding day!<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/gallery\/image\/81803-beach-wedding-decoration\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_18083\/sml_gallery_258213_18083_4011181.jpg' class='galattach galimageview sharedmedia_screenshot' title='Beach wedding decoration'  width='200' height='134'  alt='Beach wedding decoration' id='sml_image_view_81803' \/><\/a>\n<br \/><\/div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/gallery\/image\/81804-tropical-colors\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_18083\/sml_gallery_258213_18083_7180955.jpg' class='galattach galimageview sharedmedia_screenshot' title='Tropical colors'  width='200' height='134'  alt='Tropical colors' id='sml_image_view_81804' \/><\/a>\n<br \/><\/div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/gallery\/image\/81802-petals-on-the-aisle\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_18083\/sml_gallery_258213_18083_1090176.jpg' class='galattach galimageview sharedmedia_screenshot' title='Petals on the aisle!'  width='200' height='134'  alt='Petals on the aisle!' id='sml_image_view_81802' \/><\/a>\n<br \/><\/div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/gallery\/image\/81597-mason-jars-for-the-aisle\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17896\/sml_gallery_258213_17896_419409.jpg' class='galattach galimageview sharedmedia_screenshot' title='Mason Jars for the aisle'  width='200' height='134'  alt='Mason Jars for the aisle' id='sml_image_view_81597' \/><\/a>\n<br \/><\/div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/gallery\/image\/81541-drink-wine-and-wish\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_18067\/sml_gallery_258213_18067_293037.jpg' class='galattach galimageview sharedmedia_screenshot' title='Drink wine and wish'  width='200' height='134'  alt='Drink wine and wish' id='sml_image_view_81541' \/><\/a>\n<br \/><\/div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/gallery\/image\/79108-caletas\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17896\/sml_gallery_258213_17896_2057969.jpg' class='galattach galimageview sharedmedia_screenshot' title='caletas'  width='200' height='134'  alt='caletas' id='sml_image_view_79108' \/><\/a>\n<br \/><\/div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/gallery\/image\/44039-no-caption\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_11779\/sml_gallery_59784_11779_1386230453_182332.jpeg' class='galattach galimageview sharedmedia_screenshot' title='No caption'  width='200' height='134'  alt='No caption' id='sml_image_view_44039' \/><\/a>\n<br \/><\/div>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Adventure Weddings<\/p>\n<p>Puerto Vallarta<\/p>\n<p>Toll Free: 1.866.731.81.52<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"dennise@adventureweddingsvallarta.com","IpAddress":"187.146.166.254","GroupId":49,"GroupName":"Insiders","JoinDate":1343040803,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-258213.jpeg?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"LasCaletas","Id":258213,"Name":"LasCaletas","IsOnline":false}}],"Pages":{"TotalItems":378,"TotalPages":38,"CurrentPage":360,"NextPage":370,"PreviousPage":350,"LastPage":370},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}