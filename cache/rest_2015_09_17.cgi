{"Success":true,"Data":[{"Id":11429,"Subject":"Items! ","StartDate":1442097275,"Starter":{"Id":272393,"Name":"DR2015","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272393.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"IsOnline":false},"To":{"Id":284536,"Name":"lorishultz2016","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png?_r=0","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":true},"Preview":{"Id":20502,"Author":{"Id":272393,"Name":"DR2015","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272393.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"IsOnline":false},"Date":1442434542,"Content":"If you send me your email I can send photos!","PostKey":"dabd8ad7b437dc5e625cae5316501fbc","CanDelete":false,"Attachments":[]},"IsRead":false,"IsDeleted":false,"TotalReplies":2,"Notifications":true,"CanReply":true},{"Id":11191,"Subject":"Welcome lorishultz2016 to Best Destination Wedding","StartDate":1440276497,"Starter":{"Id":206696,"Name":"TammyWright","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206696.jpg?_r=1386394555","PhotoWidth":200,"PhotoHeight":135,"PhotoType":"custom"},"IsOnline":false},"To":{"Id":284536,"Name":"lorishultz2016","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png?_r=0","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":true},"Preview":{"Id":20094,"Author":{"Id":206696,"Name":"TammyWright","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206696.jpg?_r=1386394555","PhotoWidth":200,"PhotoHeight":135,"PhotoType":"custom"},"IsOnline":false},"Date":1440276498,"Content":"Hello lorishultz2016,Welcome to BestDestinationWedding.com (BDW). BDW is the Ultimate Resource fo...","PostKey":"92b1a8ba714de0465a641260be00bf84","CanDelete":false,"Attachments":[]},"IsRead":true,"IsDeleted":false,"TotalReplies":0,"Notifications":true,"CanReply":false}],"Pages":{"TotalItems":2,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":1,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
