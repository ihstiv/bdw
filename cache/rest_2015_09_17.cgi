":1231408080,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-213716.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Skygirl","Id":213716,"Name":"Skygirl","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":64344,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fbff2a28b2dd85f9e2406cef341d9e22","RawContent":"&lt;p&gt; Good job! Love that shade of blue. The \"ribbon\" (?) that you had around the boarding passes folder is a very nice touch! Thanks for sharing all the details!&lt;\/p&gt;","Attachments":[],"Id":1543370,"PostDate":1320556969,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Good job! Love that shade of blue. The \"ribbon\" (?) that you had around the boarding passes folder is a very nice touch! Thanks for sharing all the details!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"caroline_diem@hotmail.com","IpAddress":"70.160.34.128","GroupId":40,"GroupName":"Jr. Member","JoinDate":1289147755,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-233772.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"coquine","Id":233772,"Name":"coquine","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":64344,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d9cf6d2938eeb6a55f02bec6aeb41fe9","RawContent":"&lt;p&gt; &lt;span style=\"font-size:14px;\"&gt;Yay Erica!!! They came out AWESOME! I am so glad we solved your printing problem.......Great job!!!&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size:14px;\"&gt;P.S. - Still in awe at how you got FI to chip in, LOL&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1543393,"PostDate":1320590194,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> <span  style=\"font-size:14px\">Yay Erica!!! They came out AWESOME! I am so glad we solved your printing problem.......Great job!!!<\/span><\/p> <p> <span  style=\"font-size:14px\">P.S. - Still in awe at how you got FI to chip in, LOL<\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"coley.selina@gmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1312311069,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-243133.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"custom"},"FormattedName":"anudrm","Id":243133,"Name":"anudrm","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":64344,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"95658314d5a272615d76c9212901f2e5","RawContent":"Thanks, Selina!! (aka my hero lol)","Attachments":[],"Id":1543400,"PostDate":1320592450,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks, Selina!! (aka my hero lol)\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><p><span>Erica & Al - April 3, 2012 - St. Thomas, USVI<\/span><\/p><span><\/span><p><strong><span><em><a data-ipb='nomediaparse' href=\"http:\/\/www.bestdestinationwedding.com\/t\/78715\/aciretas-planning-journal-april-3-2012-cruise-wedding\">Planning Thread<\/a><\/em><\/span><\/strong><\/p><span><\/span><p><a data-ipb='nomediaparse' href=\"http:\/\/www.bestdestinationwedding.com\/t\/79320\/aciretas-wedding-ahr-pics\"><strong><span><em>Wedding & AHR Pics<\/em><\/span><\/strong><\/a><\/p><span><\/span><\/div><\/div>","Email":"ericataffs@gmail.com","IpAddress":"99.11.245.41","GroupId":47,"GroupName":"Site Supporter","JoinDate":1288624566,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-233628.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":197,"PhotoType":"custom"},"FormattedName":"acireta","Id":233628,"Name":"acireta","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":64344,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"96d85f9a5f8416c10c1b7289912dcc25","RawContent":"[quote name=\"coquine\"]\n&lt;p&gt;Good job! Love that shade of blue. The \"ribbon\" (?) that you had around the boarding passes folder is a very nice touch! Thanks for sharing all the details!&lt;\/p&gt;[\/quote] Thanks! It is indeed just satin 1.5\" ribbon. I thought it added a little something while still keeping a simple look.","Attachments":[],"Id":1543401,"PostDate":1320592571,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <blockquote class='ipsBlockquote' data-author=\"coquine\" url=\"\/t\/76612\/my&#045;diy&#045;boarding&#045;pass&#045;invitations&#045;cruise&#045;wedding#post_1692938\"><p><p>Good job! Love that shade of blue. The \"ribbon\" (?) that you had around the boarding passes folder is a very nice touch! Thanks for sharing all the details!<\/p><\/p><\/blockquote> Thanks! It is indeed just satin 1.5\" ribbon. I thought it added a little something while still keeping a simple look.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><p><span>Erica & Al - April 3, 2012 - St. Thomas, USVI<\/span><\/p><span><\/span><p><strong><span><em><a data-ipb='nomediaparse' href=\"http:\/\/www.bestdestinationwedding.com\/t\/78715\/aciretas-planning-journal-april-3-2012-cruise-wedding\">Planning Thread<\/a><\/em><\/span><\/strong><\/p><span><\/span><p><a data-ipb='nomediaparse' href=\"http:\/\/www.bestdestinationwedding.com\/t\/79320\/aciretas-wedding-ahr-pics\"><strong><span><em>Wedding & AHR Pics<\/em><\/span><\/strong><\/a><\/p><span><\/span><\/div><\/div>","Email":"ericataffs@gmail.com","IpAddress":"99.11.245.41","GroupId":47,"GroupName":"Site Supporter","JoinDate":1288624566,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-233628.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":197,"PhotoType":"custom"},"FormattedName":"acireta","Id":233628,"Name":"acireta","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":64344,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5f091a9fe073f18edb0d6aa6b35e8acd","RawContent":"&lt;p&gt; Acieta, thanks so much for sharing. I&#039;m getting super excited about starting to do our invites. I think this may be a bridesmaids&#039; \"get together\" task rather than FI because I got frustrated when he put the labels and postage for the STDs slanted.. lol. Love learning more and more about things we do well and not so much.:-)&lt;\/p&gt;","Attachments":[],"Id":1543408,"PostDate":1320593902,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Acieta, thanks so much for sharing. I'm getting super excited about starting to do our invites. I think this may be a bridesmaids' \"get together\" task rather than FI because I got frustrated when he put the labels and postage for the STDs slanted.. lol. Love learning more and more about things we do well and not so much.:-)<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kateyesis@yahoo.com","IpAddress":"","GroupId":47,"GroupName":"Site Supporter","JoinDate":1312172737,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-243058.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":250,"PhotoType":"custom"},"FormattedName":"kks2012","Id":243058,"Name":"kks2012","IsOnline":false}}],"Id":"64344","Title":"My DIY Boarding Pass Invitations (Cruise Wedding)","LastPostDate":1438625712},"Pages":{"TotalItems":78,"TotalPages":8,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":70},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
