Request Time: 0 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":2,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":855,"MovedTo":null,"MovedOn":0,"FirstPostId":1898384,"Rating":0,"RatingHits":0,"Starter":{"Id":283101,"Name":"fgentillon","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1434021672,"LastPoster":{"Id":276338,"Name":"kellymiller","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":118,"Preview":{"Id":1898417,"PostDate":1434046266,"PostContent":"I recently got married at the Dreams resort and you won't have to worry about a thing! \u00a0 If they...","Author":{"Signature":"","Email":"kelly_miller_@hotmail.com","IpAddress":"99.249.122.85","GroupId":40,"GroupName":"Jr. Member","JoinDate":1390754931,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"kellymiller","Id":276338,"Name":"kellymiller","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"47.23.148.42","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79264,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fd8cbfda0d3619f0f141094eaab09ff1","RawContent":"&lt;p&gt;Hello Ladies!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I&#039;m pretty new to this site and love the information that is passed along and shared!!! Its definitely helping me plan my upcoming wedding at Dreams on April 9, 2016.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;My question is for previous brides and vendors. With using outside vendors, if your photographer\/videographer was staying on site at the Dreams did they still charge you a vendor fee (per person) or was that waived?!? I can understand if the vendor is off site and only there for the day, but other than that, I think it should be waived, no?!? I&#039;m traveling with my wedding planner, photographer and DJ from NYC and this fee is adding significantly!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Any information would greatly help!!&lt;\/p&gt;","Attachments":[],"Id":1898384,"PostDate":1434021672,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello Ladies!<\/p>\n<p>\u00a0<\/p>\n<p>I'm pretty new to this site and love the information that is passed along and shared!!! Its definitely helping me plan my upcoming wedding at Dreams on April 9, 2016.<\/p>\n<p>\u00a0<\/p>\n<p>My question is for previous brides and vendors. With using outside vendors, if your photographer\/videographer was staying on site at the Dreams did they still charge you a vendor fee (per person) or was that waived?!? I can understand if the vendor is off site and only there for the day, but other than that, I think it should be waived, no?!? I'm traveling with my wedding planner, photographer and DJ from NYC and this fee is adding significantly!!<\/p>\n<p>\u00a0<\/p>\n<p>Any information would greatly help!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"fgentillon@gmail.com","IpAddress":"47.23.148.42","GroupId":39,"GroupName":"Newbie","JoinDate":1431602056,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"fgentillon","Id":283101,"Name":"fgentillon","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.249.133.244","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79264,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"267d6467124cf93b4987142f2a934130","RawContent":"&lt;p&gt;I recently got married at the Dreams resort and you won&#039;t have to worry about a thing!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;If they are staying at the resort as a guest you do not have to pay the vendor fee. The fee is only if they are coming for the day of the wedding.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck planning!&lt;\/p&gt;","Attachments":[],"Id":1898417,"PostDate":1434046266,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I recently got married at the Dreams resort and you won't have to worry about a thing!<\/p>\n<p>\u00a0<\/p>\n<p>If they are staying at the resort as a guest you do not have to pay the vendor fee. The fee is only if they are coming for the day of the wedding.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Good luck planning!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kelly_miller_@hotmail.com","IpAddress":"99.249.122.85","GroupId":40,"GroupName":"Jr. Member","JoinDate":1390754931,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"kellymiller","Id":276338,"Name":"kellymiller","IsOnline":false}}],"Id":"79264","Title":"Vendor Fees","LastPostDate":1434046266},"Pages":{"TotalItems":2,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
