mily: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I only have one, my sister, and I'm planing on paying her dress and all accessories. I'll pay for her hair and makeup .. and if I can, a part of her trip...\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mparent_charland@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1343848288,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-258690.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"missroxy","Id":258690,"Name":"missroxy","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62071,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b9132e00a821bf00ec8f663186b70e00","RawContent":"&lt;p&gt; great ideas everyone. we are paying for our bridesmaids and groomsmen accommodations and their outfits. girls also got robes, travel valet bag, jewelry, beach bag, water bottles. guys got personalized cuff links and beer mugs.&lt;\/p&gt;","Attachments":[],"Id":1701465,"PostDate":1357410352,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> great ideas everyone. we are paying for our bridesmaids and groomsmen accommodations and their outfits. girls also got robes, travel valet bag, jewelry, beach bag, water bottles. guys got personalized cuff links and beer mugs.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"nancyan@hotmail.com","IpAddress":"72.93.207.164","GroupId":39,"GroupName":"Newbie","JoinDate":1315229943,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-244919.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"nancya","Id":244919,"Name":"nancya","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62071,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e575c97fd7485e39bc800efc52a6131e","RawContent":"I got my 7 bridesmaids and mom bracelets that were bow\/knot&#039;s....so \"thanks 4 helping us tie the knot\" when we went dress shopping. Now I&#039;m trying to figure out what do do 4 their actual gifts. I want to hand them out at my bridal shower so I don&#039;t have to travel to Jamaica with them all. So I was thinking I wanted to do personalized beach bags, and fill it with things they might need 4 the beach. Just not to sure what to add, as I want to keep cost down as much as possible! Any ideas would b wonderful! Also, what should I get our 6 year old son who is best man?","Attachments":[],"Id":1734732,"PostDate":1363458498,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I got my 7 bridesmaids and mom bracelets that were bow\/knot's....so \"thanks 4 helping us tie the knot\" when we went dress shopping. Now I'm trying to figure out what do do 4 their actual gifts. I want to hand them out at my bridal shower so I don't have to travel to Jamaica with them all. So I was thinking I wanted to do personalized beach bags, and fill it with things they might need 4 the beach. Just not to sure what to add, as I want to keep cost down as much as possible! Any ideas would b wonderful! Also, what should I get our 6 year old son who is best man?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"SHANNONELIZABETH45@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1361213135,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-266262.jpeg?_r=0","PhotoWidth":170,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"SHANNON4","Id":266262,"Name":"SHANNON4","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62071,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6c88830e26131e7e76d4c95f41f8a7db","RawContent":"[quote]\nOriginally Posted by [b]SHANNON4[\/b] \/img\/forum\/go_quote.gif\n \n I got my 7 bridesmaids and mom bracelets that were bow\/knot&#039;s....so \"thanks 4 helping us tie the knot\" when we went dress shopping. Now I&#039;m trying to figure out what do do 4 their actual gifts. I want to hand them out at my bridal shower so I don&#039;t have to travel to Jamaica with them all. So I was thinking I wanted to do personalized beach bags, and fill it with things they might need 4 the beach. Just not to sure what to add, as I want to keep cost down as much as possible! Any ideas would b wonderful! Also, what should I get our 6 year old son who is best man?[\/quote] \n \n I got some nice personalized canvas tote bags on etsy. They came out to about $8 a piece. I&#039;m still trying to decide what to put in there as well. I have 5 bridesmaids. I\"m also looking NOT to spend and arm and a leg with the contents.","Attachments":[],"Id":1735165,"PostDate":1363597041,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>SHANNON4<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> I got my 7 bridesmaids and mom bracelets that were bow\/knot's....so \"thanks 4 helping us tie the knot\" when we went dress shopping. Now I'm trying to figure out what do do 4 their actual gifts. I want to hand them out at my bridal shower so I don't have to travel to Jamaica with them all. So I was thinking I wanted to do personalized beach bags, and fill it with things they might need 4 the beach. Just not to sure what to add, as I want to keep cost down as much as possible! Any ideas would b wonderful! Also, what should I get our 6 year old son who is best man?<\/blockquote> <p> \u00a0<\/p> <p> I got some nice personalized canvas tote bags on etsy. They came out to about $8 a piece. I'm still trying to decide what to put in there as well. I have 5 bridesmaids. I\"m also looking NOT to spend and arm and a leg with the contents.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"vanessa.ariza1@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1348568806,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-260665.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Bride2B0713","Id":260665,"Name":"Bride2B0713","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62071,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c584a119420445a119afaf724b72ecf8","RawContent":"[quote]\nOriginally Posted by [b]SHANNON4[\/b] \/img\/forum\/go_quote.gif\n \n I got my 7 bridesmaids and mom bracelets that were bow\/knot&#039;s....so \"thanks 4 helping us tie the knot\" when we went dress shopping. Now I&#039;m trying to figure out what do do 4 their actual gifts. I want to hand them out at my bridal shower so I don&#039;t have to travel to Jamaica with them all. So I was thinking I wanted to do personalized beach bags, and fill it with things they might need 4 the beach. Just not to sure what to add, as I want to keep cost down as much as possible! Any ideas would b wonderful! Also, what should I get our 6 year old son who is best man?[\/quote] \n \n Are you doing OOT bags? You could always just \"amp up\" ones for them. (The girls I mean) \n Some ideas: pashminas (cheap!), flip flops, bronzer or tanning oil, aloe lip balm, sunscreen... You can find lots in clearance sections and in the dollar stores.","Attachments":[],"Id":1735199,"PostDate":1363599296,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>SHANNON4<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> I got my 7 bridesmaids and mom bracelets that were bow\/knot's....so \"thanks 4 helping us tie the knot\" when we went dress shopping. Now I'm trying to figure out what do do 4 their actual gifts. I want to hand them out at my bridal shower so I don't have to travel to Jamaica with them all. So I was thinking I wanted to do personalized beach bags, and fill it with things they might need 4 the beach. Just not to sure what to add, as I want to keep cost down as much as possible! Any ideas would b wonderful! Also, what should I get our 6 year old son who is best man?<\/blockquote> <p> <br \/> Are you doing OOT bags? You could always just \"amp up\" ones for them. (The girls I mean)<\/p> <p> Some ideas: pashminas (cheap!), flip flops, bronzer or tanning oil, aloe lip balm, sunscreen... You can find lots in clearance sections and in the dollar stores.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"krys85418@gmail.com","IpAddress":"108.181.124.120","GroupId":42,"GroupName":"Sr. Member","JoinDate":1301844912,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-238489.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":113,"PhotoType":"custom"},"FormattedName":"Peach","Id":238489,"Name":"Peach","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62071,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c56f722a1901e4c0e2ff8ebaab6c0b14","RawContent":"&lt;p&gt; I got my girls a mini duffle and inside it was: a beach towel, a personalozed tote bag, a double wall tumbler, a traveling jewelry case (containing their wedding jewelry), a pair of flip flops, lip gloss, a cloth makeup case, as well as everything that will be in the other out of town bags.&amp;nbsp; I couldn&#039;t stop buying and loved every minute of it!&lt;\/p&gt;","Attachments":[],"Id":1737905,"PostDate":1364158519,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I got my girls a mini duffle and inside it was: a beach towel, a personalozed tote bag, a double wall tumbler, a traveling jewelry case (containing their wedding jewelry), a pair of flip flops, lip gloss, a cloth makeup case, as well as everything that will be in the other out of town bags.\u00a0 I couldn't stop buying and loved every minute of it!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"MRSPWILSON@HOTMAIL.COM","IpAddress":"","GroupId":47,"GroupName":"Site Supporter","JoinDate":1333625016,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-253644.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"MRSPWILSON","Id":253644,"Name":"MRSPWILSON","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62071,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cf70cbac3ec9354dbe29d99662513c7c","RawContent":"&lt;p&gt; I am having a hard time deciding what to get my lovely ladies....I only have 140 to spend on each of them.&lt;\/p&gt;","Attachments":[],"Id":1773750,"PostDate":1372509048,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I am having a hard time deciding what to get my lovely ladies....I only have 140 to spend on each of them.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"c8brown@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1372351514,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270998.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"cher8brown","Id":270998,"Name":"cher8brown","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62071,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"245d0b198d2e32e6cb7050fc69f71ba7","RawContent":"&lt;p&gt; If you watch groupon you can get $70 dollars worth of stuff for $17 and then get the big canvas totes personalized for almost nothing it just comes down to what you want to put into them.&amp;nbsp; I am having a hard time with this step...&lt;\/p&gt;","Attachments":[],"Id":1783964,"PostDate":1374907630,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> If you watch groupon you can get $70 dollars worth of stuff for $17 and then get the big canvas totes personalized for almost nothing it just comes down to what you want to put into them.\u00a0 I am having a hard time with this step...<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"philliback1221@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1374457843,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-271777.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"phillips1221","Id":271777,"Name":"phillips1221","IsOnline":false}}],"Pages":{"TotalItems":74,"TotalPages":8,"CurrentPage":40,"NextPage":50,"PreviousPage":30,"LastPage":70},"PushNotifications":[{"Key":"notifications","Value":1,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
