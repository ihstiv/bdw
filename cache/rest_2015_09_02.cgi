each a &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/thepaisleybox.com\/product-category\/bridesmaid\/\"&gt;bridesmaid gift box&lt;\/a&gt; from The Paisley Box. I was also considering personalized clutches from Etsy.&lt;\/p&gt;","Attachments":[],"Id":1802598,"PostDate":1380053054,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I'm getting my girls each a <a href='http:\/\/thepaisleybox.com\/product-category\/bridesmaid\/' class='bbc_url' title='External link' rel='nofollow external'>bridesmaid gift box<\/a> from The Paisley Box. I was also considering personalized clutches from Etsy.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"csulls36@aol.com","IpAddress":"","GroupId":5,"GroupName":"Banned","JoinDate":1380052788,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"caryncarl","Id":273746,"Name":"caryncarl","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62071,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0d7163da23629acecb7febb021f23000","RawContent":"&lt;p&gt;&lt;img alt=\" \" data-id=\"224388\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/224388\/width\/200\/height\/400\" \/&gt;&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;&lt;img alt=\" \" data-id=\"224389\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/224389\/width\/200\/height\/400\" \/&gt;&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;&lt;img alt=\" \" data-id=\"224390\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/224390\/width\/200\/height\/400\" \/&gt;&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;&lt;img alt=\" \" data-id=\"224391\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/224391\/width\/200\/height\/400\" \/&gt;&lt;\/p&gt; &lt;p&gt;Saw these cute pouches on pinterest and found them on amazon on sale so I bought them for my bridesmaids as little gifts and one for myself. &amp;nbsp;Perfect to hold some makeup and money. &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1809026,"PostDate":1382478100,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><span rel='lightbox'><img class='bbc_img' alt=\" \" data-id=\"224388\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/224388\/width\/200\/height\/400\" \/><\/span><\/p> <p>\u00a0<\/p> <p><span rel='lightbox'><img class='bbc_img' alt=\" \" data-id=\"224389\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/224389\/width\/200\/height\/400\" \/><\/span><\/p> <p>\u00a0<\/p> <p><span rel='lightbox'><img class='bbc_img' alt=\" \" data-id=\"224390\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/224390\/width\/200\/height\/400\" \/><\/span><\/p> <p>\u00a0<\/p> <p><span rel='lightbox'><img class='bbc_img' alt=\" \" data-id=\"224391\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/224391\/width\/200\/height\/400\" \/><\/span><\/p> <p>Saw these cute pouches on pinterest and found them on amazon on sale so I bought them for my bridesmaids as little gifts and one for myself. \u00a0Perfect to hold some makeup and money. \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div>\n<p>43 guests plus bride and groom.... <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Engagement Photos - <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/76051-engagement-pictures-by-del-sol-photography-pic-heavy\/#entry1827276'>http:\/\/www.bestdestinationwedding.com\/topic\/76051-engagement-pictures-by-del-sol-photography-pic-heavy\/#entry1827276<\/a><\/p>\n<\/div>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77563-njbride2014-planning-thread-leblanc-spa-resort-91314-pic-heavy\/#entry1860630'>http:\/\/www.bestdestinationwedding.com\/topic\/77563-njbride2014-planning-thread-leblanc-spa-resort-91314-pic-heavy\/#entry1860630<\/a>","Email":"sandyycaza@yahoo.com","IpAddress":"66.246.139.68","GroupId":40,"GroupName":"Jr. Member","JoinDate":1357646061,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-264077.jpg?_r=1415048239","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"NJBride2014","Id":264077,"Name":"NJBride2014","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62071,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c99146a4c454826f42e5203265747052","RawContent":"&lt;p&gt;I also plan on buying their dresses paying for hair and makeup.&lt;\/p&gt;","Attachments":[],"Id":1809027,"PostDate":1382478128,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I also plan on buying their dresses paying for hair and makeup.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div>\n<p>43 guests plus bride and groom.... <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Engagement Photos - <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/76051-engagement-pictures-by-del-sol-photography-pic-heavy\/#entry1827276'>http:\/\/www.bestdestinationwedding.com\/topic\/76051-engagement-pictures-by-del-sol-photography-pic-heavy\/#entry1827276<\/a><\/p>\n<\/div>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77563-njbride2014-planning-thread-leblanc-spa-resort-91314-pic-heavy\/#entry1860630'>http:\/\/www.bestdestinationwedding.com\/topic\/77563-njbride2014-planning-thread-leblanc-spa-resort-91314-pic-heavy\/#entry1860630<\/a>","Email":"sandyycaza@yahoo.com","IpAddress":"66.246.139.68","GroupId":40,"GroupName":"Jr. Member","JoinDate":1357646061,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-264077.jpg?_r=1415048239","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"NJBride2014","Id":264077,"Name":"NJBride2014","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62071,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"27dd96d610f4340bd5a6bac28858d28c","RawContent":"I have seen really cute custom necklaces on Etsy.. with starfish on them and I was thinking a jem the color of their dress...","Attachments":[],"Id":1811555,"PostDate":1383480179,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I have seen really cute custom necklaces on Etsy.. with starfish on them and I was thinking a jem the color of their dress...\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mishtb96@aol.com","IpAddress":"162.231.9.34","GroupId":40,"GroupName":"Jr. Member","JoinDate":1383024467,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-274657.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"misbosox","Id":274657,"Name":"misbosox","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.246.64.107","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62071,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"452c968f37fc2dd4743b6f36d4204f6a","RawContent":"&lt;p&gt;Im still stuck on the gifts for the mothers. Any ideas will be helpful&lt;\/p&gt;","Attachments":[],"Id":1831263,"PostDate":1391288212,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Im still stuck on the gifts for the mothers. Any ideas will be helpful<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"liz_hund@hotmail.com","IpAddress":"108.246.64.107","GroupId":40,"GroupName":"Jr. Member","JoinDate":1377083106,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272798.jpg?_r=1391090044","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"liz24","Id":272798,"Name":"liz24","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.97.112.145","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62071,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"17c374ddbe905c53bde546ffc58636bb","RawContent":"&lt;p&gt;We gave money for thier dresses, got necklaces, braclets, mugs for keeping their drinks cool at the resort, and a few other travel accessories.&lt;\/p&gt;","Attachments":[],"Id":1831539,"PostDate":1391418580,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>We gave money for thier dresses, got necklaces, braclets, mugs for keeping their drinks cool at the resort, and a few other travel accessories.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"meghartman@gmail.com","IpAddress":"75.97.112.145","GroupId":40,"GroupName":"Jr. Member","JoinDate":1374417786,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-271770.jpg?_r=1391556917","PhotoWidth":200,"PhotoHeight":159,"PhotoType":"custom"},"FormattedName":"megan224","Id":271770,"Name":"megan224","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"148.177.65.100","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62071,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"00439179ba6cc0a32ecbef9e5455ff15","RawContent":"&lt;p&gt;Hi Everyone - I bought my bridesmaids a beach bag, filled with a personalized hanger that I made, a pair of shorts and a personazlied tank top to wear the day of the wedding while getting ready.&lt;\/p&gt;","Attachments":[],"Id":1831842,"PostDate":1391514437,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi Everyone - I bought my bridesmaids a beach bag, filled with a personalized hanger that I made, a pair of shorts and a personazlied tank top to wear the day of the wedding while getting ready.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mellie818@hotmail.com","IpAddress":"148.177.1.210","GroupId":39,"GroupName":"Newbie","JoinDate":1362383516,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"none"},"FormattedName":"mellie818","Id":266864,"Name":"mellie818","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"165.155.200.103","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62071,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2bc15ac626bcc15b513d356815f712ec","RawContent":"&lt;p&gt;I am having so much fun figuring out my bridesmaid gifts! I decided early on I want to get them a nice bag they can use to travel, and pack it with fun stuff. I also don&#039;t want to give them anything cheesy or too linked to my wedding, because I want them to really use the stuff again. Here&#039;s what I have so far:&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;1) J Crew canvas weekender bag. I got this on SUPER sale at the J Crew outlet - only $40 each. I figure they can use them as their carry on, or just use them in the future for weekend getaways. I would attach pics of mine but I have no idea how to do that, so here&#039;s the link.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/factory.jcrew.com\/womens-clothing\/bags_accessories\/bags\/PRDOVR~A3639\/99103345746\/ENE~1+2+218+22+4294967294+216+205~~~0~15~all~mode+matchallany~~~~~weekender\/A3639.jsp?isSaleItem=false&amp;amp;isFromSearch=true&#039;&gt;http:\/\/factory.jcrew.com\/womens-clothing\/bags_accessories\/bags\/PRDOVR~A3639\/99103345746\/ENE~1+2+218+22+4294967294+216+205~~~0~15~all~mode+matchallany~~~~~weekender\/A3639.jsp?isSaleItem=false&amp;amp;isFromSearch=true&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;2) Mini make up bag from Bath &amp;amp; Body Works. I love that these are so bright and fun! They could even work as clutches. I got one in each color.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bathandbodyworks.com\/product\/index.jsp?productId=30547326&amp;amp;cm_vc=200&#039;&gt;http:\/\/www.bathandbodyworks.com\/product\/index.jsp?productId=30547326&amp;amp;cm_vc=200&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;3) Stuff to go in the mini make up bags&lt;\/p&gt;\n&lt;p&gt;-- Pure Paradise mini lotion and hand sanitizer, also from BBW&lt;\/p&gt;\n&lt;p&gt;-- mini Stila make up pallete from Nordstrom Rack&lt;\/p&gt;\n&lt;p&gt;-- CO Bigelow lip treatments - 1 Mentha lip tint, 1 My favorite lip balm. I love love love these and they were on sale!&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;4) Other stuff to go in the J Crew bags&lt;\/p&gt;\n&lt;p&gt;-- Havaina flip flops from Nordstrom Rack&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;-- travel pillow\/iPad holder from Bed Bath &amp;amp; Beyond&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;So far, believe it or not, I&#039;ve only spent $90 per bag! I want to spend about $120 - $150 each, so I&#039;m trying to figure out what else to add. I&#039;m considering either a passport holder, like this adorbs one from Kate Spade, or necklaces, like Dogeared or the Kate Spade initial necklace. I also could use the extra $ to pay for their hair or makeup, but I don&#039;t know how I feel about that. It&#039;s definitely less fun than buying more presents, but maybe more practical.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;What does everyone think?? I&#039;m so eager for feedback, but the people I&#039;d normally ask are the girls I&#039;m buying for! Help!&lt;\/p&gt;","Attachments":[],"Id":1838807,"PostDate":1395128068,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I am having so much fun figuring out my bridesmaid gifts! I decided early on I want to get them a nice bag they can use to travel, and pack it with fun stuff. I also don't want to give them anything cheesy or too linked to my wedding, because I want them to really use the stuff again. Here's what I have so far:<\/p>\n<p>\u00a0<\/p>\n<p>1) J Crew canvas weekender bag. I got this on SUPER sale at the J Crew outlet - only $40 each. I figure they can use them as their carry on, or just use them in the future for weekend getaways. I would attach pics of mine but I have no idea how to do that, so here's the link.\u00a0<\/p>\n<p><a href='http:\/\/factory.jcrew.com\/womens-clothing\/bags_accessories\/bags\/PRDOVR~A3639\/99103345746\/ENE~1+2+218+22+4294967294+216+205~~~0~15~all~mode+matchallany~~~~~weekender\/A3639.jsp?isSaleItem=false&isFromSearch=true' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/factory.jcrew...FromSearch=true<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>2) Mini make up bag from Bath & Body Works. I love that these are so bright and fun! They could even work as clutches. I got one in each color.\u00a0<\/p>\n<p><a href='http:\/\/www.bathandbodyworks.com\/product\/index.jsp?productId=30547326&cm_vc=200' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.bathandbo...47326&cm_vc=200<\/a><\/p>\n<p>\u00a0<\/p>\n<p>3) Stuff to go in the mini make up bags<\/p>\n<p>-- Pure Paradise mini lotion and hand sanitizer, also from BBW<\/p>\n<p>-- mini Stila make up pallete from Nordstrom Rack<\/p>\n<p>-- CO Bigelow lip treatments - 1 Mentha lip tint, 1 My favorite lip balm. I love love love these and they were on sale!\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>4) Other stuff to go in the J Crew bags<\/p>\n<p>-- Havaina flip flops from Nordstrom Rack\u00a0<\/p>\n<p>-- travel pillow\/iPad holder from Bed Bath & Beyond<\/p>\n<p>\u00a0<\/p>\n<p>So far, believe it or not, I've only spent $90 per bag! I want to spend about $120 - $150 each, so I'm trying to figure out what else to add. I'm considering either a passport holder, like this adorbs one from Kate Spade, or necklaces, like Dogeared or the Kate Spade initial necklace. I also could use the extra $ to pay for their hair or makeup, but I don't know how I feel about that. It's definitely less fun than buying more presents, but maybe more practical.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>What does everyone think?? I'm so eager for feedback, but the people I'd normally ask are the girls I'm buying for! Help!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jamie.m.damico@gmail.com","IpAddress":"173.54.93.32","GroupId":39,"GroupName":"Newbie","JoinDate":1371062009,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270539.jpeg?_r=0","PhotoWidth":100,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"jd0922","Id":270539,"Name":"jd0922","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.153.117.2","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62071,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c20222753a5358f3595b061969e96f7f","RawContent":"&lt;p&gt;awesome&lt;\/p&gt;","Attachments":[],"Id":1839046,"PostDate":1395161996,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>awesome<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"curltop475@aol.com","IpAddress":"68.39.65.38","GroupId":40,"GroupName":"Jr. Member","JoinDate":1376373205,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272533.jpeg?_r=0","PhotoWidth":89,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Traci Felton","Id":272533,"Name":"Traci Felton","IsOnline":false}}],"Pages":{"TotalItems":74,"TotalPages":8,"CurrentPage":60,"NextPage":70,"PreviousPage":50,"LastPage":70},"PushNotifications":[{"Key":"notifications","Value":1,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
