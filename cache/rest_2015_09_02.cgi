{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":28,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":14856,"MovedTo":null,"MovedOn":0,"FirstPostId":1831107,"Rating":0,"RatingHits":0,"Starter":{"Id":271556,"Name":"jnellerose","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-271556.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"StartDate":1391273351,"LastPoster":{"Id":206696,"Name":"TammyWright","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206696.jpg?_r=1386394555","PhotoWidth":200,"PhotoHeight":135,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":118,"Preview":{"Id":1866473,"PostDate":1408047541,"PostContent":"I have sent the General Manager this thread so he can keep up with the issues. \u00a0 You should also...","Author":{"Signature":"<p><span style=\"font-family:arial, helvetica, sans-serif;\">Founder and Owner of BestDestinationWedding.com \u00a0\/ \u00a0<\/span><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78931-bride-and-groom-fly-free-20152016\/'><strong><span style=\"font-family:arial, helvetica, sans-serif;\">Bride & Groom Fly FREE Promotion<\/span><\/strong><\/a><\/p>\n<p>\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><strong><a data-ipb='nomediaparse' href='http:\/\/wrighttravelagency.com\/inquiry\/'><span style=\"color:#008080;\">Looking for a travel agency that specializes in Destination Weddings<\/span><\/a><\/strong><span style=\"color:#008080;\"><strong>?<\/strong> \u00a0We are an award winning travel agency and you can <\/span><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style=\"color:#008080;\">read our reviews\u00a0here.<\/span><\/a><\/strong><\/span><br>\n\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"color:#008080;\"><strong>Awards and recognition:\u00a0<\/strong><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Palace Resorts PRO Platinum Agency (Top Award) \u00a0 \u00a0 | \u00a0 \u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">AMResorts Master Agent & Top Agency \u00a0<\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator | <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/68050-karisma-hotels-givc-and-gi-wedding-consultants-wright-travel-agency\/'><strong>Wright Travel & Karisma GIVC Benefits<\/strong><\/a><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Travel Impressions Best of the Best Globe Winner \u00a0 \u00a0| \u00a0 \u00a0\u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Apple Vacations Golden Apple Winner \u00a0<\/span><\/span><br><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/gallery_206696_17572_8409.jpg\" alt=\"gallery_206696_17572_8409.jpg\"> \u00a0 \u00a0<img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/sml_gallery_206696_17572_1003.jpg\" alt=\"sml_gallery_206696_17572_1003.jpg\"><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"font-size:14px;\"><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/t\/921\/vendor-business-membership-fees-rules-updated-6-18-2010'>Vendor rules are HERE! Please read!<\/a>\u00a0\u00a0<\/strong><\/span><\/span><\/span><strong><span style=\"color:#b22222;\">If you are a vendor and looking to advertise your business,<\/span>\u00a0please email\u00a0<a data-ipb='nomediaparse' href='mailto:ads@bestdestinationwedding.com?subject=Advertising%20on%20BestDestinationWedding.com'>ads@bestdestinationwedding.com<\/a>.<\/strong>","Email":"admin@bestdestinationwedding.com","IpAddress":"71.202.225.11","GroupId":4,"GroupName":"Administrators","JoinDate":1137206220,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206696.jpg?_r=1386394555","PhotoWidth":200,"PhotoHeight":135,"PhotoType":"custom"},"FormattedName":"TammyWright","Id":206696,"Name":"TammyWright","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"198.228.200.149","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76214,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ada0fbbae7ebe451278844c8181a6e50","RawContent":"Hi all,\n\nI have recently booked my wedding at Dreams Los Cabos for 10-12-14.  Unfortunately, we are having an extremely hard time getting in contact with the WC there.\n\nInitially, we were working with Maricela who was amazing and quick at responding.  Then she left, and we were redirected to Magda.  When we went to Cabo to do a site visit, we stayed at Dreams and had a horrible first impression of Magda.  She did not get in contact with us while we were there until our 2nd or 3rd day at the resort, even though we requested to meet with her on our first day there.  We looked beyond that, and still went with Dreams - but when trying to get our contract done with her, she was very unresponsive - making up excuses and saying that her computer broke and that she is the only WC at the resort.\n\nNow we have been reassigned to someone by the name of Angel.  He\/she started off great by contacting us in early jan to introduce himself - &amp;amp; that&#039;s as far as it goes.  We haven&#039;t heard from him\/her yet, and actually we made an \"appointment\" for a phone call with him\/her for today and have been waiting for the call.  Almost 2 hours later, we are still waiting...\n\n\nJust wondering if anyone else is experiencing these issues and was wondering if anyone has any suggestions on how to proceed.  Does anyone have any Dreams los cabos managers contact info that they can forward along?  I&#039;m beginning to get stressed that we made the wrong decision in choosing dreams.\n\n\nthank you!\n\nJanelle","Attachments":[],"Id":1831107,"PostDate":1391273351,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi all,<br>\nI have recently booked my wedding at Dreams Los Cabos for 10-12-14.  Unfortunately, we are having an extremely hard time getting in contact with the WC there.<br>\nInitially, we were working with Maricela who was amazing and quick at responding.  Then she left, and we were redirected to Magda.  When we went to Cabo to do a site visit, we stayed at Dreams and had a horrible first impression of Magda.  She did not get in contact with us while we were there until our 2nd or 3rd day at the resort, even though we requested to meet with her on our first day there.  We looked beyond that, and still went with Dreams - but when trying to get our contract done with her, she was very unresponsive - making up excuses and saying that her computer broke and that she is the only WC at the resort.<br>\nNow we have been reassigned to someone by the name of Angel.  He\/she started off great by contacting us in early jan to introduce himself - & that's as far as it goes.  We haven't heard from him\/her yet, and actually we made an \"appointment\" for a phone call with him\/her for today and have been waiting for the call.  Almost 2 hours later, we are still waiting...<br><br>\nJust wondering if anyone else is experiencing these issues and was wondering if anyone has any suggestions on how to proceed.  Does anyone have any Dreams los cabos managers contact info that they can forward along?  I'm beginning to get stressed that we made the wrong decision in choosing dreams.<br><br>\nthank you!<br>\nJanelle\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"janelle.gonzales@gmail.com","IpAddress":"198.228.201.149","GroupId":39,"GroupName":"Newbie","JoinDate":1373893579,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-271556.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"jnellerose","Id":271556,"Name":"jnellerose","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.202.225.11","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76214,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"25354c722bbcfeeed35af8ff28b3453c","RawContent":"&lt;p&gt;Are you working with a travel agent? &amp;nbsp;If so, you should have them expedite the response from the WC. &amp;nbsp;We have great relationships with the resorts that we sell the most of and when these issues come up, we can usually get a response a little faster for our clients.&lt;\/p&gt;","Attachments":[],"Id":1831700,"PostDate":1391478307,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Are you working with a travel agent? \u00a0If so, you should have them expedite the response from the WC. \u00a0We have great relationships with the resorts that we sell the most of and when these issues come up, we can usually get a response a little faster for our clients.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-family:arial, helvetica, sans-serif;\">Founder and Owner of BestDestinationWedding.com \u00a0\/ \u00a0<\/span><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78931-bride-and-groom-fly-free-20152016\/'><strong><span style=\"font-family:arial, helvetica, sans-serif;\">Bride & Groom Fly FREE Promotion<\/span><\/strong><\/a><\/p>\n<p>\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><strong><a data-ipb='nomediaparse' href='http:\/\/wrighttravelagency.com\/inquiry\/'><span style=\"color:#008080;\">Looking for a travel agency that specializes in Destination Weddings<\/span><\/a><\/strong><span style=\"color:#008080;\"><strong>?<\/strong> \u00a0We are an award winning travel agency and you can <\/span><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style=\"color:#008080;\">read our reviews\u00a0here.<\/span><\/a><\/strong><\/span><br>\n\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"color:#008080;\"><strong>Awards and recognition:\u00a0<\/strong><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Palace Resorts PRO Platinum Agency (Top Award) \u00a0 \u00a0 | \u00a0 \u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">AMResorts Master Agent & Top Agency \u00a0<\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator | <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/68050-karisma-hotels-givc-and-gi-wedding-consultants-wright-travel-agency\/'><strong>Wright Travel & Karisma GIVC Benefits<\/strong><\/a><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Travel Impressions Best of the Best Globe Winner \u00a0 \u00a0| \u00a0 \u00a0\u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Apple Vacations Golden Apple Winner \u00a0<\/span><\/span><br><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/gallery_206696_17572_8409.jpg\" alt=\"gallery_206696_17572_8409.jpg\"> \u00a0 \u00a0<img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/sml_gallery_206696_17572_1003.jpg\" alt=\"sml_gallery_206696_17572_1003.jpg\"><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"font-size:14px;\"><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/t\/921\/vendor-business-membership-fees-rules-updated-6-18-2010'>Vendor rules are HERE! Please read!<\/a>\u00a0\u00a0<\/strong><\/span><\/span><\/span><strong><span style=\"color:#b22222;\">If you are a vendor and looking to advertise your business,<\/span>\u00a0please email\u00a0<a data-ipb='nomediaparse' href='mailto:ads@bestdestinationwedding.com?subject=Advertising%20on%20BestDestinationWedding.com'>ads@bestdestinationwedding.com<\/a>.<\/strong>","Email":"admin@bestdestinationwedding.com","IpAddress":"71.202.225.11","GroupId":4,"GroupName":"Administrators","JoinDate":1137206220,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206696.jpg?_r=1386394555","PhotoWidth":200,"PhotoHeight":135,"PhotoType":"custom"},"FormattedName":"TammyWright","Id":206696,"Name":"TammyWright","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"198.228.200.43","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76214,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6dab45f9b70abd25f018ab788e3f539a","RawContent":"Thanks Tammy.  I am working with Teresa Stauring, who has already been notified and has begun to try to pacify the situation with the people at Dreams.  She has been great at assisting in these situations, but I have not heard anything back from the WC at Dreams as of yet.  This has truly left a sour taste in my mouth.\n\nThank you for your reply.  I hope the situation resolves sooner than later.","Attachments":[],"Id":1831746,"PostDate":1391511056,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks Tammy.  I am working with Teresa Stauring, who has already been notified and has begun to try to pacify the situation with the people at Dreams.  She has been great at assisting in these situations, but I have not heard anything back from the WC at Dreams as of yet.  This has truly left a sour taste in my mouth.<br>\nThank you for your reply.  I hope the situation resolves sooner than later.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"janelle.gonzales@gmail.com","IpAddress":"198.228.201.149","GroupId":39,"GroupName":"Newbie","JoinDate":1373893579,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-271556.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"jnellerose","Id":271556,"Name":"jnellerose","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.202.225.11","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76214,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cd52334070fc6fd96958ecfc76586a64","RawContent":"&lt;p&gt;Teresa knows the WC and management so with her involved I am sure it will get resolved quickly.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I know a few of their longtime WCs (mariana, yarai, yesica) left so they are struggling to train new people.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;That being said, I got married at Dreams Los Cabos and my WC quite right before my wedding and a new WC filled in and I was freaking out because I thought I would have to start new, they would not know what I wanted, etc. but the new WC (mariana) ended up doing a fantastic job. &amp;nbsp;They do know what they are doing, just slow on response.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Also, for October you have plenty of time. &amp;nbsp;are there any questions that I might be able to help with?&lt;\/p&gt;","Attachments":[],"Id":1831773,"PostDate":1391515753,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Teresa knows the WC and management so with her involved I am sure it will get resolved quickly.<\/p>\n<p>\u00a0<\/p>\n<p>I know a few of their longtime WCs (mariana, yarai, yesica) left so they are struggling to train new people.<\/p>\n<p>\u00a0<\/p>\n<p>That being said, I got married at Dreams Los Cabos and my WC quite right before my wedding and a new WC filled in and I was freaking out because I thought I would have to start new, they would not know what I wanted, etc. but the new WC (mariana) ended up doing a fantastic job. \u00a0They do know what they are doing, just slow on response.<\/p>\n<p>\u00a0<\/p>\n<p>Also, for October you have plenty of time. \u00a0are there any questions that I might be able to help with?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-family:arial, helvetica, sans-serif;\">Founder and Owner of BestDestinationWedding.com \u00a0\/ \u00a0<\/span><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78931-bride-and-groom-fly-free-20152016\/'><strong><span style=\"font-family:arial, helvetica, sans-serif;\">Bride & Groom Fly FREE Promotion<\/span><\/strong><\/a><\/p>\n<p>\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><strong><a data-ipb='nomediaparse' href='http:\/\/wrighttravelagency.com\/inquiry\/'><span style=\"color:#008080;\">Looking for a travel agency that specializes in Destination Weddings<\/span><\/a><\/strong><span style=\"color:#008080;\"><strong>?<\/strong> \u00a0We are an award winning travel agency and you can <\/span><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style=\"color:#008080;\">read our reviews\u00a0here.<\/span><\/a><\/strong><\/span><br>\n\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"color:#008080;\"><strong>Awards and recognition:\u00a0<\/strong><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Palace Resorts PRO Platinum Agency (Top Award) \u00a0 \u00a0 | \u00a0 \u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">AMResorts Master Agent & Top Agency \u00a0<\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator | <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/68050-karisma-hotels-givc-and-gi-wedding-consultants-wright-travel-agency\/'><strong>Wright Travel & Karisma GIVC Benefits<\/strong><\/a><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Travel Impressions Best of the Best Globe Winner \u00a0 \u00a0| \u00a0 \u00a0\u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Apple Vacations Golden Apple Winner \u00a0<\/span><\/span><br><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/gallery_206696_17572_8409.jpg\" alt=\"gallery_206696_17572_8409.jpg\"> \u00a0 \u00a0<img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/sml_gallery_206696_17572_1003.jpg\" alt=\"sml_gallery_206696_17572_1003.jpg\"><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"font-size:14px;\"><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/t\/921\/vendor-business-membership-fees-rules-updated-6-18-2010'>Vendor rules are HERE! Please read!<\/a>\u00a0\u00a0<\/strong><\/span><\/span><\/span><strong><span style=\"color:#b22222;\">If you are a vendor and looking to advertise your business,<\/span>\u00a0please email\u00a0<a data-ipb='nomediaparse' href='mailto:ads@bestdestinationwedding.com?subject=Advertising%20on%20BestDestinationWedding.com'>ads@bestdestinationwedding.com<\/a>.<\/strong>","Email":"admin@bestdestinationwedding.com","IpAddress":"71.202.225.11","GroupId":4,"GroupName":"Administrators","JoinDate":1137206220,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206696.jpg?_r=1386394555","PhotoWidth":200,"PhotoHeight":135,"PhotoType":"custom"},"FormattedName":"TammyWright","Id":206696,"Name":"TammyWright","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"143.104.241.66","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76214,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0c6038ca7f3f43001b8db6e2d2f91c9d","RawContent":"Well.. I realize we have time, since our wedding isn&#039;t until October.  But we had a few things to discuss with the WC.  for starters, we need to set the venue for our rehearsal dinner.  we also need to discuss our ceremony, which is supposed to be at the gazebo.  We are expecting 80 guests and it seems the gazebo area may be too tight for 80 people.  Also, I know the photographers from the past have since left and that a new group has joined Dreams.  I&#039;m trying to figure out if we need to hire a separate photographer or if we will just end up paying to keep the photographers included in the package longer.  We also would like to proceed with hiring a DJ, florist, and hair and make up artists, but none of these things can be done until I get a chance to touch base with a WC.  \n\nBasically, we have a lot of unanswered questions, and it&#039;s just bad business on their end to not even address our concerns.  I understand that we have time before these things need to get done and that there are weddings going on that they need to focus their time\/energy on, but I think we deserve to be able to have at least one conversation with someone, being that we&#039;ve been booked for 2 months and cannot get a response out of anyone.  \n\nI like to read the forum posts and have faith that my wedding will turn out just fine.. but I guess I expected more from dreams.  They just seem so uninterested in having our business, which is far from what I can say about other resorts that we were considering.","Attachments":[],"Id":1831781,"PostDate":1391516421,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Well.. I realize we have time, since our wedding isn't until October.  But we had a few things to discuss with the WC.  for starters, we need to set the venue for our rehearsal dinner.  we also need to discuss our ceremony, which is supposed to be at the gazebo.  We are expecting 80 guests and it seems the gazebo area may be too tight for 80 people.  Also, I know the photographers from the past have since left and that a new group has joined Dreams.  I'm trying to figure out if we need to hire a separate photographer or if we will just end up paying to keep the photographers included in the package longer.  We also would like to proceed with hiring a DJ, florist, and hair and make up artists, but none of these things can be done until I get a chance to touch base with a WC.  <br>\nBasically, we have a lot of unanswered questions, and it's just bad business on their end to not even address our concerns.  I understand that we have time before these things need to get done and that there are weddings going on that they need to focus their time\/energy on, but I think we deserve to be able to have at least one conversation with someone, being that we've been booked for 2 months and cannot get a response out of anyone.  <br>\nI like to read the forum posts and have faith that my wedding will turn out just fine.. but I guess I expected more from dreams.  They just seem so uninterested in having our business, which is far from what I can say about other resorts that we were considering.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"janelle.gonzales@gmail.com","IpAddress":"198.228.201.149","GroupId":39,"GroupName":"Newbie","JoinDate":1373893579,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-271556.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"jnellerose","Id":271556,"Name":"jnellerose","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.202.225.11","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76214,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5e390915b3e1bc4f75c438a8b42bf016","RawContent":"&lt;p&gt;@jnellerose: have you heard from the resort? &amp;nbsp;I sent this thread to the Director of Sales who runs the wedding department and she is very concerned. &amp;nbsp;We are trying to schedule a time to discuss for all of the brides.&lt;\/p&gt;","Attachments":[],"Id":1832805,"PostDate":1391946881,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@jnellerose: have you heard from the resort? \u00a0I sent this thread to the Director of Sales who runs the wedding department and she is very concerned. \u00a0We are trying to schedule a time to discuss for all of the brides.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-family:arial, helvetica, sans-serif;\">Founder and Owner of BestDestinationWedding.com \u00a0\/ \u00a0<\/span><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78931-bride-and-groom-fly-free-20152016\/'><strong><span style=\"font-family:arial, helvetica, sans-serif;\">Bride & Groom Fly FREE Promotion<\/span><\/strong><\/a><\/p>\n<p>\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><strong><a data-ipb='nomediaparse' href='http:\/\/wrighttravelagency.com\/inquiry\/'><span style=\"color:#008080;\">Looking for a travel agency that specializes in Destination Weddings<\/span><\/a><\/strong><span style=\"color:#008080;\"><strong>?<\/strong> \u00a0We are an award winning travel agency and you can <\/span><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style=\"color:#008080;\">read our reviews\u00a0here.<\/span><\/a><\/strong><\/span><br>\n\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"color:#008080;\"><strong>Awards and recognition:\u00a0<\/strong><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Palace Resorts PRO Platinum Agency (Top Award) \u00a0 \u00a0 | \u00a0 \u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">AMResorts Master Agent & Top Agency \u00a0<\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator | <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/68050-karisma-hotels-givc-and-gi-wedding-consultants-wright-travel-agency\/'><strong>Wright Travel & Karisma GIVC Benefits<\/strong><\/a><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Travel Impressions Best of the Best Globe Winner \u00a0 \u00a0| \u00a0 \u00a0\u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Apple Vacations Golden Apple Winner \u00a0<\/span><\/span><br><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/gallery_206696_17572_8409.jpg\" alt=\"gallery_206696_17572_8409.jpg\"> \u00a0 \u00a0<img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/sml_gallery_206696_17572_1003.jpg\" alt=\"sml_gallery_206696_17572_1003.jpg\"><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"font-size:14px;\"><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/t\/921\/vendor-business-membership-fees-rules-updated-6-18-2010'>Vendor rules are HERE! Please read!<\/a>\u00a0\u00a0<\/strong><\/span><\/span><\/span><strong><span style=\"color:#b22222;\">If you are a vendor and looking to advertise your business,<\/span>\u00a0please email\u00a0<a data-ipb='nomediaparse' href='mailto:ads@bestdestinationwedding.com?subject=Advertising%20on%20BestDestinationWedding.com'>ads@bestdestinationwedding.com<\/a>.<\/strong>","Email":"admin@bestdestinationwedding.com","IpAddress":"71.202.225.11","GroupId":4,"GroupName":"Administrators","JoinDate":1137206220,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206696.jpg?_r=1386394555","PhotoWidth":200,"PhotoHeight":135,"PhotoType":"custom"},"FormattedName":"TammyWright","Id":206696,"Name":"TammyWright","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"142.255.74.85","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76214,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1f7ac35ef58820ef52f2ac24ae25d65c","RawContent":"hi Tammy,\n\nthanks for letting me know.  Teresa actually spoke to them for me, and the director of sales followed through and called me.  she was great to speak to, and I was able to voice my frustrations a little to her.  and afterwards, my WC Angel contacted me, and I was able to speak to him about a few of the wedding details.  But i still get the feeling that I&#039;m just one bride out of many, and they could care less about how I feel or what I need to get done.  Angel promised better communication, but almost a week later, I still have yet to hear back from him on some of the important details I asked him to look into.\n\nI guess I need to learn to just let it happen in due time, but it&#039;s hard when I have things I need to get done as well and can&#039;t because I can&#039;t even get information from the WC!","Attachments":[],"Id":1832877,"PostDate":1391980524,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                hi Tammy,<br>\nthanks for letting me know.  Teresa actually spoke to them for me, and the director of sales followed through and called me.  she was great to speak to, and I was able to voice my frustrations a little to her.  and afterwards, my WC Angel contacted me, and I was able to speak to him about a few of the wedding details.  But i still get the feeling that I'm just one bride out of many, and they could care less about how I feel or what I need to get done.  Angel promised better communication, but almost a week later, I still have yet to hear back from him on some of the important details I asked him to look into.<br>\nI guess I need to learn to just let it happen in due time, but it's hard when I have things I need to get done as well and can't because I can't even get information from the WC!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"janelle.gonzales@gmail.com","IpAddress":"198.228.201.149","GroupId":39,"GroupName":"Newbie","JoinDate":1373893579,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-271556.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"jnellerose","Id":271556,"Name":"jnellerose","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.173.74.138","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76214,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8b49f39f55e1501fdda62a1a02d62137","RawContent":"&lt;p&gt;I&#039;m getting married at Dreams May 23rd. I have had a heck of a time contacting Magda as well.&amp;nbsp; Back in November she said November was a very busy time for them.&amp;nbsp; It still takes about 3 weeks for a response.&amp;nbsp; As of Friday they switched me to Marcela.&amp;nbsp; I&#039;m hoping the closer and closer we get we can actually start confirming d\u00e9cor.&amp;nbsp; Oscar, the manager of the hair salon is wonderful at responding.&amp;nbsp; Gets back within an hour or so.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1833035,"PostDate":1392053662,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I'm getting married at Dreams May 23rd. I have had a heck of a time contacting Magda as well.\u00a0 Back in November she said November was a very busy time for them.\u00a0 It still takes about 3 weeks for a response.\u00a0 As of Friday they switched me to Marcela.\u00a0 I'm hoping the closer and closer we get we can actually start confirming d\u00e9cor.\u00a0 Oscar, the manager of the hair salon is wonderful at responding.\u00a0 Gets back within an hour or so.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tina_mahrer@yahoo.com","IpAddress":"24.173.74.138","GroupId":39,"GroupName":"Newbie","JoinDate":1384346314,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275017.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"cmahrer","Id":275017,"Name":"cmahrer","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"198.228.200.169","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76214,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9ac2084a96356e3ad0a61253dcac9a6b","RawContent":"thanks for the reply. it&#039;s somewhat comforting to know that I&#039;m not the only one experiencing these problems contacting them. good luck with the wedding plans.. hopefully since your wedding is right around the corner, they will start paying more attention to you.","Attachments":[],"Id":1833037,"PostDate":1392054290,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                thanks for the reply. it's somewhat comforting to know that I'm not the only one experiencing these problems contacting them. good luck with the wedding plans.. hopefully since your wedding is right around the corner, they will start paying more attention to you.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"janelle.gonzales@gmail.com","IpAddress":"198.228.201.149","GroupId":39,"GroupName":"Newbie","JoinDate":1373893579,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-271556.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"jnellerose","Id":271556,"Name":"jnellerose","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.173.74.138","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76214,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bbdfb2f20c87a493bc45e63ac771daee","RawContent":"&lt;p&gt;I will let you know how it goes! Have you heard anything about getting blood drawn at the resort?&lt;\/p&gt;\n&lt;p&gt;I know it&#039;s required but just wanted to know if you have heard or seen any reviews on it.&lt;\/p&gt;","Attachments":[],"Id":1833116,"PostDate":1392112953,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I will let you know how it goes! Have you heard anything about getting blood drawn at the resort?<\/p>\n<p>I know it's required but just wanted to know if you have heard or seen any reviews on it.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tina_mahrer@yahoo.com","IpAddress":"24.173.74.138","GroupId":39,"GroupName":"Newbie","JoinDate":1384346314,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275017.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"cmahrer","Id":275017,"Name":"cmahrer","IsOnline":false}}],"Id":"76214","Title":"Help! Trouble Contacting Wc At Dreams Los Cabos","LastPostDate":1408047541},"Pages":{"TotalItems":28,"TotalPages":3,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":20},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
