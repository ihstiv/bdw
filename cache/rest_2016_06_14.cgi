":"custom"},"FormattedName":"vancouverpetunia","Id":281283,"Name":"vancouverpetunia","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"158.106.64.94","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80088,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"f8e28c2540d180228c4007e738bc9cc9","RawContent":"&lt;p&gt;@[member=\"vancouverpetunia\"] &amp;nbsp;Oh my gosh I can&#039;t believe you&#039;re selling these! Wouldn&#039;t you be able to wear them again? They&#039;re gorgeous!! If they were my size I&#039;d wear them for work! lol&lt;\/p&gt;","Attachments":[],"Id":1913785,"PostDate":1463485372,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"281283\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281283-vancouverpetunia\/' title='Member profile'><span itemprop=\"name\">vancouverpetunia<\/span><\/a> \u00a0Oh my gosh I can't believe you're selling these! Wouldn't you be able to wear them again? They're gorgeous!! If they were my size I'd wear them for work! lol<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#ff0099;\"><em>I said \"yes\" again to the love of my life at Grand Coral Beach Club, Playa del Carmen, Mexico on our 4th anniversary - October 20, 2015<\/em><\/span><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/'><span style=\"color:#ff0099;\"><em>http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/<\/em><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"199.196.6.100","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80088,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"7da16f252f501190ecbae22080306c10","RawContent":"&lt;p&gt;@[member=\"acw271011\"] I did love them and they are very pretty, but work?!? I just don&#039;t see it LOL. But I have been thinking of dying them if I can&#039;t sell them.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1913805,"PostDate":1463500099,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"232000\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/232000-acw271011\/' title='Member profile'><span itemprop=\"name\">acw271011<\/span><\/a> I did love them and they are very pretty, but work?!? I just don't see it LOL. But I have been thinking of dying them if I can't sell them.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>- Erin<\/p>\n<p>\u00a0<\/p>\n<p>My planning thread:\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79068-vancouverpetunia-now-sapphire-april-7-2016\/?p=1893268'>http:\/\/www.bestdestinationwedding.com\/topic\/79068-vancouverpetunia-now-sapphire-april-7-2016\/?p=1893268<\/a><\/p>\n<p>\u00a0<\/p>\n<p>My Now Sapphire review:\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/5487-now-sapphire-riviera-cancun\/'>http:\/\/www.bestdestinationwedding.com\/reviews\/r\/5487-now-sapphire-riviera-cancun\/<\/a>","Email":"ekjzwedding@gmail.com","IpAddress":"24.85.127.174","GroupId":3,"GroupName":"Member","JoinDate":1417435045,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281283.jpg?_r=1428779369","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"vancouverpetunia","Id":281283,"Name":"vancouverpetunia","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"158.106.72.234","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80088,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"bbc919f8a3f94d864a560898e7d09ec2","RawContent":"I work in a law firm so I could absolutely wear them for work and I&#039;m a total shoe fiend so..... like I said, if they were my size....\n\n\nWe had fantastic weather in BC and Washington last week so it was a great visit. Then we had to come back here.... lol\n\n\nSent from my SGH-I337M using Tapatalk","Attachments":[],"Id":1913807,"PostDate":1463502416,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I work in a law firm so I could absolutely wear them for work and I'm a total shoe fiend so..... like I said, if they were my size....<br><br>\nWe had fantastic weather in BC and Washington last week so it was a great visit. Then we had to come back here.... lol<br><br>\nSent from my SGH-I337M using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#ff0099;\"><em>I said \"yes\" again to the love of my life at Grand Coral Beach Club, Playa del Carmen, Mexico on our 4th anniversary - October 20, 2015<\/em><\/span><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/'><span style=\"color:#ff0099;\"><em>http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/<\/em><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}}],"Pages":{"TotalItems":4,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}