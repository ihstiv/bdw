{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":7,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":358,"MovedTo":null,"MovedOn":0,"FirstPostId":1899512,"Rating":0,"RatingHits":0,"Starter":{"Id":283749,"Name":"Sarahkey32","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-283749.jpg?_r=1435718249","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"StartDate":1435596398,"LastPoster":{"Id":278581,"Name":"beckys98","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1899644,"PostDate":1435779385,"PostContent":"We did not do invitations. In fact, we did an electronic save the date via paperless post and dir...","Author":{"Signature":"","Email":"rebecca.shaffer@gmail.com","IpAddress":"159.53.174.144","GroupId":40,"GroupName":"Jr. Member","JoinDate":1403101687,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"beckys98","Id":278581,"Name":"beckys98","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"166.137.244.49","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79330,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6242c6e6faf506a2ba95d9cb1cfbae0d","RawContent":"Hi all, new to the forum but looking for a little help from other women who are going through this process too! We are planning our wedding in 6\/16 in Punta Cana and I&#039;m really stuck on invitations. We are booking through a travel agency and having our guests do the same, so we will be getting a wedding website through the agency. Do I need to send out save the dates and formal invitations when they really only need the date and the website?? In my head I think I can get away with a save the date type invitation with our website on it and since everyone will be booking far in advance the traditional invitation being sent out 8-10 weeks before the wedding seems useless to me. What has everyone else done?! Thanks!!!","Attachments":[],"Id":1899512,"PostDate":1435596398,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi all, new to the forum but looking for a little help from other women who are going through this process too! We are planning our wedding in 6\/16 in Punta Cana and I'm really stuck on invitations. We are booking through a travel agency and having our guests do the same, so we will be getting a wedding website through the agency. Do I need to send out save the dates and formal invitations when they really only need the date and the website?? In my head I think I can get away with a save the date type invitation with our website on it and since everyone will be booking far in advance the traditional invitation being sent out 8-10 weeks before the wedding seems useless to me. What has everyone else done?! Thanks!!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"chiodo4766@gmail.com","IpAddress":"166.137.244.49","GroupId":39,"GroupName":"Newbie","JoinDate":1435595556,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-283749.jpg?_r=1435718249","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Sarahkey32","Id":283749,"Name":"Sarahkey32","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.146.146.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79330,"EditedBy":"<strong>Edited by calgarybride2015, 29 June 2015 - 05:04 PM.<\/strong>","EditDate":1435597481,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"69fefcf6335dfd852b109131a0a4d07a","RawContent":"Welcome and congrats on your wedding. \n\n\nWe also did a wedding website. To spread the news we did an invitation but not a STD. We sent our invites out mid May for our January wedding.  They were boarding passes and fairly basic in info as they were directed to the website on the invite itself. \n\n\nHere is a picture. \n\n\nSome brides do STD, some invites, some\n\nBoth, some do everything electronically. Anything goes :)\n\n\nHope that helps some. \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1899513,"PostDate":1435597419,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Welcome and congrats on your wedding. <br><br>\nWe also did a wedding website. To spread the news we did an invitation but not a STD. We sent our invites out mid May for our January wedding.  They were boarding passes and fairly basic in info as they were directed to the website on the invite itself. <br><br>\nHere is a picture. <a class='resized_img' rel='lightbox[1899513]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_06_2015\/post-277873-14356117972.jpg\" title=\"ImageUploadedByTapatalk1435611793.918202.jpg - Size: 224.45KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_06_2015\/post-277873-14356117972.jpg\" class='bbc_img linked-image' alt=\"ImageUploadedByTapatalk1435611793.918202.jpg\" \/><\/a>\n\n<br><br>\nSome brides do STD, some invites, some<br>\nBoth, some do everything electronically. Anything goes <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br><br>\nHope that helps some. <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399414202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.161.70.215","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79330,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"dc9e487f1bef932544a50398d181c635","RawContent":"I&#039;ll second what @[member=\"calgarybride2015\"] said. There don&#039;t seem to be any hard and fast rules for destination weddings other than trying to give everyone the info as far in advance as possible. Some brides will do STDs, others will do electronic invites, still others will do save the dates and invites as well. Your budget will probably dictate a lot of what you do or don&#039;t do as well as the size of your group. Obviously if you have a very small group communication is much easier than a large group of 100. \n\n\nGood luck and happy planning!","Attachments":[],"Id":1899519,"PostDate":1435610221,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I'll second what @<a hovercard-ref=\"member\" hovercard-id=\"277873\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/277873-calgarybride2015\/' title='Member profile'><span itemprop=\"name\">calgarybride2015<\/span><\/a> said. There don't seem to be any hard and fast rules for destination weddings other than trying to give everyone the info as far in advance as possible. Some brides will do STDs, others will do electronic invites, still others will do save the dates and invites as well. Your budget will probably dictate a lot of what you do or don't do as well as the size of your group. Obviously if you have a very small group communication is much easier than a large group of 100. <br><br>\nGood luck and happy planning!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.85.127.174","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79330,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"ec77da53a37044c6c78b77d1de6956b5","RawContent":"@[member=\"acw271011\"] Good point about budget and size of group. We did email STDs about 1 year out and I think we will do mailed invitations about 6 months out. Seems a bit silly in a way to do the invitations but it&#039;s one traditional thing I really like (I love stationery and paper products). We also have a few older relatives who don&#039;t have email so I think they would appreciate it. But everyone&#039;s different and I don&#039;t think there&#039;s a \"proper\" way to do it. \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1899531,"PostDate":1435623680,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"232000\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/232000-acw271011\/' title='Member profile'><span itemprop=\"name\">acw271011<\/span><\/a> Good point about budget and size of group. We did email STDs about 1 year out and I think we will do mailed invitations about 6 months out. Seems a bit silly in a way to do the invitations but it's one traditional thing I really like (I love stationery and paper products). We also have a few older relatives who don't have email so I think they would appreciate it. But everyone's different and I don't think there's a \"proper\" way to do it. <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>- Erin<\/p>\n<p>\u00a0<\/p>\n<p>My planning thread:\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79068-vancouverpetunia-now-sapphire-april-7-2016\/?p=1893268'>http:\/\/www.bestdestinationwedding.com\/topic\/79068-vancouverpetunia-now-sapphire-april-7-2016\/?p=1893268<\/a>","Email":"ekjzwedding@gmail.com","IpAddress":"24.85.127.174","GroupId":40,"GroupName":"Jr. Member","JoinDate":1417435045,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281283.jpg?_r=1428779369","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"vancouverpetunia","Id":281283,"Name":"vancouverpetunia","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"207.134.141.162","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79330,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9e71a28407c355784cefe50166e6fdb6","RawContent":"&lt;p&gt;I sent save the dates via email and one page boarding pass invitations shortly after. &amp;nbsp;Both had a link to the wedding website where we update often.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We got a vistaprint groupon ($70 worth of product for $27) and were able to get all the invitations with envelopes and even order envelope stickers. &amp;nbsp;Although some people had put down their deposits shortly after the save the dates went out, we still sent the invites because they were inexpensive, felt a bit more formal (and real haha) and the older generation appreciated getting a paper invite.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;There&#039;s pictures of my STDs and Invites in my profile gallery.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1899538,"PostDate":1435656630,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I sent save the dates via email and one page boarding pass invitations shortly after. \u00a0Both had a link to the wedding website where we update often.<\/p>\n<p>\u00a0<\/p>\n<p>We got a vistaprint groupon ($70 worth of product for $27) and were able to get all the invitations with envelopes and even order envelope stickers. \u00a0Although some people had put down their deposits shortly after the save the dates went out, we still sent the invites because they were inexpensive, felt a bit more formal (and real haha) and the older generation appreciated getting a paper invite.<\/p>\n<p>\u00a0<\/p>\n<p>There's pictures of my STDs and Invites in my profile gallery.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"deannaproteau@hotmail.com","IpAddress":"207.134.141.162","GroupId":39,"GroupName":"Newbie","JoinDate":1421428169,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281751.jpg?_r=1435939613","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"deecol","Id":281751,"Name":"deecol","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.114.26.29","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79330,"EditedBy":"<strong>Edited by Moments That Matter, 01 July 2015 - 06:07 PM.<\/strong>","EditDate":1435774044,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"770dff8874ae011b398963c5d197511b","RawContent":"&lt;p&gt;Welcome to our forum community, Sarahkey32 and Congrats on your Punta Cana wedding next year!!! as you&#039;ve already seen, there&#039;s lot of great advice, ideas and support from everyone here that sure to help with your planning decisions :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Wishing you happy research, and all the best with your plans - cheers!!! team MTM:)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;....here are some magical wedding \"moments that matter\" from our &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.10150695320839487.414941.18683524486&amp;amp;type=3&#039;&gt;Cover Photo Album &lt;\/a&gt;to inspire you further......enjoy :)&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xaf1\/t31.0-8\/10466993_10152470886239487_2370077874343987137_o.jpg\" alt=\"10466993_10152470886239487_2370077874343\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xft1\/t31.0-8\/10532891_10152537577179487_8316082035582089196_o.jpg\" alt=\"10532891_10152537577179487_8316082035582\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xap1\/t31.0-8\/10257602_10152444384029487_9172712922710255052_o.jpg\" alt=\"10257602_10152444384029487_9172712922710\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xpf1\/t31.0-8\/10264266_10152377393459487_387743739374526349_o.jpg\" alt=\"10264266_10152377393459487_3877437393745\"&gt;&lt;\/p&gt;","Attachments":[],"Id":1899640,"PostDate":1435773928,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Welcome to our forum community, Sarahkey32 and Congrats on your Punta Cana wedding next year!!! as you've already seen, there's lot of great advice, ideas and support from everyone here that sure to help with your planning decisions <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Wishing you happy research, and all the best with your plans - cheers!!! team MTM:)<\/p>\n<p>\u00a0<\/p>\n<p>....here are some magical wedding \"moments that matter\" from our <a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10150695320839487.414941.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>Cover Photo Album <\/a>to inspire you further......enjoy <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xaf1\/t31.0-8\/10466993_10152470886239487_2370077874343987137_o.jpg\" alt=\"10466993_10152470886239487_2370077874343\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xft1\/t31.0-8\/10532891_10152537577179487_8316082035582089196_o.jpg\" alt=\"10532891_10152537577179487_8316082035582\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xap1\/t31.0-8\/10257602_10152444384029487_9172712922710255052_o.jpg\" alt=\"10257602_10152444384029487_9172712922710\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xpf1\/t31.0-8\/10264266_10152377393459487_387743739374526349_o.jpg\" alt=\"10264266_10152377393459487_3877437393745\"><\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280196260,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"159.53.78.142","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79330,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"79bc6719ee142c56d0c3664a78926b08","RawContent":"We did not do invitations. In fact, we did an electronic save the date via paperless post and directed to our website and that was it! We told people not to wait for a mailed invitation so they weren&#039;t expecting it - because we needed them to put their deposits down WELL before we would have sent out the invitation. Like you, we couldn&#039;t see the value in spending the money. The money we saved we put toward providing transportation to an excursion while we were in Jamaica.\n\nWe aren&#039;t a very traditional couple though and all of our guests had internet access so it fit us! No one said a word about it to us so I assume people were a-ok with it! We had 66 guests at our wedding a few weeks ago so I don&#039;t think it hurt our attendance :)\n[quote name=\"Sarahkey32\" post=\"1899512\" timestamp=\"1435610798\"]\nHi all, new to the forum but looking for a little help from other women who are going through this process too! We are planning our wedding in 6\/16 in Punta Cana and I&#039;m really stuck on invitations. We are booking through a travel agency and having our guests do the same, so we will be getting a wedding website through the agency. Do I need to send out save the dates and formal invitations when they really only need the date and the website?? In my head I think I can get away with a save the date type invitation with our website on it and since everyone will be booking far in advance the traditional invitation being sent out 8-10 weeks before the wedding seems useless to me. What has everyone else done?! Thanks!!![\/quote]","Attachments":[],"Id":1899644,"PostDate":1435779385,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>We did not do invitations. In fact, we did an electronic save the date via paperless post and directed to our website and that was it! We told people not to wait for a mailed invitation so they weren't expecting it - because we needed them to put their deposits down WELL before we would have sent out the invitation. Like you, we couldn't see the value in spending the money. The money we saved we put toward providing transportation to an excursion while we were in Jamaica.<\/p>\n<p>\u00a0<\/p>\n<p>We aren't a very traditional couple though and all of our guests had internet access so it fit us! No one said a word about it to us so I assume people were a-ok with it! We had 66 guests at our wedding a few weeks ago so I don't think it hurt our attendance <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Sarahkey32, on 29 June 2015 - 04:46 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Hi all, new to the forum but looking for a little help from other women who are going through this process too! We are planning our wedding in 6\/16 in Punta Cana and I'm really stuck on invitations. We are booking through a travel agency and having our guests do the same, so we will be getting a wedding website through the agency. Do I need to send out save the dates and formal invitations when they really only need the date and the website?? In my head I think I can get away with a save the date type invitation with our website on it and since everyone will be booking far in advance the traditional invitation being sent out 8-10 weeks before the wedding seems useless to me. What has everyone else done?! Thanks!!!<\/p>\n<\/div>\n<\/div><\/div>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rebecca.shaffer@gmail.com","IpAddress":"159.53.174.144","GroupId":40,"GroupName":"Jr. Member","JoinDate":1403101687,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"beckys98","Id":278581,"Name":"beckys98","IsOnline":false}}],"Id":"79330","Title":"Invitations!","LastPostDate":1435779385},"Pages":{"TotalItems":7,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
