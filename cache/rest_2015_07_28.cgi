{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":8,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":123,"MovedTo":null,"MovedOn":0,"FirstPostId":1901189,"Rating":0,"RatingHits":0,"Starter":{"Id":284060,"Name":"Chris126","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1437924400,"LastPoster":{"Id":284060,"Name":"Chris126","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1901189,"PostDate":1437924400,"PostContent":"Hi I need help with a destination!! Looking for the best resort for my kids (14,12,11,9&8). Looki...","Author":{"Signature":"","Email":"chrisleotta126@yahoo.com","IpAddress":"73.150.69.53","GroupId":39,"GroupName":"Newbie","JoinDate":1437466439,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Chris126","Id":284060,"Name":"Chris126","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.208.70.132","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79435,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"67315c29122d08df4c4fc4a8d9dcb74a","RawContent":"Hi I need help with a destination!! Looking for the best resort for my kids (14,12,11,9&amp;amp;8). Looking at Beaches Negril, Moon palace cancun or Hard Rock resort. Has anyone been to any of these resorts with their kids? I want to have our wedding someplace the kids will enjoy too.","Attachments":[],"Id":1901189,"PostDate":1437924400,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi I need help with a destination!! Looking for the best resort for my kids (14,12,11,9&8). Looking at Beaches Negril, Moon palace cancun or Hard Rock resort. Has anyone been to any of these resorts with their kids? I want to have our wedding someplace the kids will enjoy too.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"chrisleotta126@yahoo.com","IpAddress":"73.150.69.53","GroupId":39,"GroupName":"Newbie","JoinDate":1437466439,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Chris126","Id":284060,"Name":"Chris126","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.15.187","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79435,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e6f82f3e3ce4a3ecd37404b50f01f905","RawContent":"&lt;p&gt;Of the top of my head, and this is without any experience with any of those resorts, but I&#039;ve heard for kids that hard rock can get pretty fun just because of the noise and party atmosphere. Moon Palace is huge and definitely family oriented from what the ladies here have posted. I know nothing about Beaches resorts.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I would definitely advise getting a travel agent and consulting them for input. They&#039;re the experts as far as what would work for you and work with your budget too. That can also be a big factor.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck!&lt;\/p&gt;","Attachments":[],"Id":1901206,"PostDate":1437955657,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Of the top of my head, and this is without any experience with any of those resorts, but I've heard for kids that hard rock can get pretty fun just because of the noise and party atmosphere. Moon Palace is huge and definitely family oriented from what the ladies here have posted. I know nothing about Beaches resorts.<\/p>\n<p>\u00a0<\/p>\n<p>I would definitely advise getting a travel agent and consulting them for input. They're the experts as far as what would work for you and work with your budget too. That can also be a big factor.<\/p>\n<p>\u00a0<\/p>\n<p>Good luck!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"73.150.69.53","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79435,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3f46edbb9b039bd3da0c58321ea17a24","RawContent":"Thanks :)\n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1901207,"PostDate":1437955711,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"chrisleotta126@yahoo.com","IpAddress":"73.150.69.53","GroupId":39,"GroupName":"Newbie","JoinDate":1437466439,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Chris126","Id":284060,"Name":"Chris126","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.187.229.252","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79435,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"a5e27ac0c26a3348c9883721fbe39b9c","RawContent":"&lt;p&gt;Hi Chris, I have been to all of these resorts and also worked with wedding groups at each one.&lt;\/p&gt;\n&lt;p&gt;In general, for big variety of things to do, and activities for every age group I would recommend as top choices either Moon Palace, (great teen club, and also has the Flo Rider surf machine that kids love), or Hard Rock which has such a fun and upbeat atmosphere that there is always lots going on.. the kids can even have Studio time and make their own recording!&lt;\/p&gt;\n&lt;p&gt;Both of these are great choices, and for you as the wedding couple they both offer great benefits in terms of complimentary events, and comp nights for you.&lt;\/p&gt;\n&lt;p&gt;Let us at Wright Travel know if we can answer questions, or check pricing for you!&lt;\/p&gt;\n&lt;p&gt;Happy planning!&lt;\/p&gt;","Attachments":[],"Id":1901238,"PostDate":1437994223,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi Chris, I have been to all of these resorts and also worked with wedding groups at each one.<\/p>\n<p>In general, for big variety of things to do, and activities for every age group I would recommend as top choices either Moon Palace, (great teen club, and also has the Flo Rider surf machine that kids love), or Hard Rock which has such a fun and upbeat atmosphere that there is always lots going on.. the kids can even have Studio time and make their own recording!<\/p>\n<p>Both of these are great choices, and for you as the wedding couple they both offer great benefits in terms of complimentary events, and comp nights for you.<\/p>\n<p>Let us at Wright Travel know if we can answer questions, or check pricing for you!<\/p>\n<p>Happy planning!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><a class='bbc_url' href='http:\/\/wrighttravelagency.com\/inquiry\/'><span style='color: rgb(0,128,128)'>Looking for a travel agency that specializes in Destination Weddings<\/span><\/a><span style='color: rgb(0,128,128)'>? We are an award winning travel agency and you can read our reviews <\/span><a class='bbc_url' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style='color: rgb(0,128,128)'><strong class='bbc'>HERE.<\/strong><\/span><\/a><\/span><\/span><br \/>\n<br \/>\n<span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'><strong class='bbc'>Awards and recognition: <\/strong><\/span><\/span><\/span><\/span><br \/>\n<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'>Palace Resorts Top PRO Agency <\/span><\/span><\/span><\/span><br \/>\n<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'>Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator <\/span><\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>AMResorts Master Agent & Top Agency<\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>Travel Impressions Best of the Best Globe Winner<\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>Apple Vacations Golden Apple Winner<\/span><\/span><\/span>","Email":"wendyhicks1@sbcglobal.net","IpAddress":"99.187.229.252","GroupId":49,"GroupName":"Insiders","JoinDate":1238019840,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-216154.jpg?_r=1419958783","PhotoWidth":200,"PhotoHeight":250,"PhotoType":"custom"},"FormattedName":"TA Wendy","Id":216154,"Name":"TA Wendy","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"170.74.55.82","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79435,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"b297d25109cec575f4a6a03abee3b822","RawContent":"&lt;p&gt;We&#039;re a family of 7 (kids 20, 20, 16, 14, 12) also and after much researching we reserved the Moon Palace.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I liked that the resort was a little higher quality than other all-inclusives and that they had private ceremony locations.&lt;\/p&gt;\n&lt;p&gt;I also looked at the Hard-Rock but it was too much like a spring break resort. I&#039;m sure it&#039;s fun but i ddnt want to equate my wedding with spring break! Maybe 15 years ago, yes but now not so much!&lt;\/p&gt;\n&lt;p&gt;Good luck in your search!&lt;\/p&gt;","Attachments":[],"Id":1901245,"PostDate":1437998476,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>We're a family of 7 (kids 20, 20, 16, 14, 12) also and after much researching we reserved the Moon Palace.\u00a0<\/p>\n<p>I liked that the resort was a little higher quality than other all-inclusives and that they had private ceremony locations.<\/p>\n<p>I also looked at the Hard-Rock but it was too much like a spring break resort. I'm sure it's fun but i ddnt want to equate my wedding with spring break! Maybe 15 years ago, yes but now not so much!<\/p>\n<p>Good luck in your search!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ruth.craig.wedding@gmail.com","IpAddress":"24.184.35.89","GroupId":39,"GroupName":"Newbie","JoinDate":1425935501,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282373.jpg?_r=1425955850","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"RJE","Id":282373,"Name":"RJE","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"73.150.69.53","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79435,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ea8bf20bf3cffc4c64af043c8e25adaa","RawContent":"Thank u!!","Attachments":[],"Id":1901247,"PostDate":1437999472,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thank u!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"chrisleotta126@yahoo.com","IpAddress":"73.150.69.53","GroupId":39,"GroupName":"Newbie","JoinDate":1437466439,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Chris126","Id":284060,"Name":"Chris126","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"159.53.110.141","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79435,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"e5d75f389d92118c556c28aa5f90d93b","RawContent":"&lt;p&gt;I had a travel agent try to get us to book Beaches. It is certainly family friendly, but for us it would have catered TOO much to the kids. We only had a handful of kids coming so we wanted entertainment for them, but we didn&#039;t want dancing Sesame Street characters running around either ;)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We settled on a family friendly resort that had a kids club and kids water park and it was perfect.&lt;\/p&gt;","Attachments":[],"Id":1901280,"PostDate":1438021412,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I had a travel agent try to get us to book Beaches. It is certainly family friendly, but for us it would have catered TOO much to the kids. We only had a handful of kids coming so we wanted entertainment for them, but we didn't want dancing Sesame Street characters running around either <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/><\/p>\n<p>\u00a0<\/p>\n<p>We settled on a family friendly resort that had a kids club and kids water park and it was perfect.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rebecca.shaffer@gmail.com","IpAddress":"159.53.174.144","GroupId":40,"GroupName":"Jr. Member","JoinDate":1403101687,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"beckys98","Id":278581,"Name":"beckys98","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"73.150.69.53","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79435,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cd4f78dc9703c7f11ce280215d1870d9","RawContent":"@[member=\"beckys98\"] what resort did u go with?","Attachments":[],"Id":1901292,"PostDate":1438033017,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"278581\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/278581-beckys98\/' title='Member profile'><span itemprop=\"name\">beckys98<\/span><\/a> what resort did u go with?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"chrisleotta126@yahoo.com","IpAddress":"73.150.69.53","GroupId":39,"GroupName":"Newbie","JoinDate":1437466439,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Chris126","Id":284060,"Name":"Chris126","IsOnline":false}}],"Id":"79435","Title":"Family Of 7","LastPostDate":1438033017},"Pages":{"TotalItems":8,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
