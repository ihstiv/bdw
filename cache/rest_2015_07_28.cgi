{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":15,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":700,"MovedTo":null,"MovedOn":0,"FirstPostId":1891985,"Rating":0,"RatingHits":0,"Starter":{"Id":282649,"Name":"youngandinlove","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1428322173,"LastPoster":{"Id":230711,"Name":"Moments That Matter","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1891985,"PostDate":1428322173,"PostContent":"Hello everyone! \u00a0 My name is Cassidy, new bride to be THIS YEAR!  We are not doing a big wedding...","Author":{"Signature":"","Email":"cassidymichaels233@gmail.com","IpAddress":"190.241.252.27","GroupId":39,"GroupName":"Newbie","JoinDate":1428321137,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"youngandinlove","Id":282649,"Name":"youngandinlove","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"190.241.252.27","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79025,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"764e5f72e161e623a438dc82fa5ebeec","RawContent":"&lt;p&gt;Hello everyone!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;My name is Cassidy, new bride to be THIS YEAR! :D We are not doing a big wedding at all, eloping really. We are doing this in Costa&amp;nbsp; Rica. Has anyone done anything like this recently?&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I am here to get some ideas and hopefully some information. Thank you! :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;All the best,&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Cassidy :P&lt;\/p&gt;","Attachments":[],"Id":1891985,"PostDate":1428322173,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello everyone!<\/p>\n<p>\u00a0<\/p>\n<p>My name is Cassidy, new bride to be THIS YEAR! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/biggrin.png' class='bbc_emoticon' alt=':D' \/> We are not doing a big wedding at all, eloping really. We are doing this in Costa\u00a0 Rica. Has anyone done anything like this recently?<\/p>\n<p>\u00a0<\/p>\n<p>I am here to get some ideas and hopefully some information. Thank you! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>All the best,<\/p>\n<p>\u00a0<\/p>\n<p>Cassidy <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/tongue.png' class='bbc_emoticon' alt=':P' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cassidymichaels233@gmail.com","IpAddress":"190.241.252.27","GroupId":39,"GroupName":"Newbie","JoinDate":1428321137,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"youngandinlove","Id":282649,"Name":"youngandinlove","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"187.135.252.182","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79025,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"56699e7ba88a62ea3d2711979eebe88e","RawContent":"&lt;p&gt;Congrats on your upcoming elopement in Costa Rica this year, Cassidy!!! how exciting, for sure :) you&#039;ll find lots of great info, ideas, advice and support from all the resources in the forum - to help with your questions.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Linc shot a wonderfully FUN wedding with just the bride &amp;amp; groom that you can see here: &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.10151009302034487.443366.18683524486&amp;amp;type=3&#039;&gt;La Blanc Wedding Album&lt;\/a&gt;, with a excerpts shown here:&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord.xx.fbcdn.net\/hphotos-xaf1\/t31.0-8\/169611_10151009320999487_1579582819_o.jpg\" alt=\"169611_10151009320999487_1579582819_o.jp\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord.xx.fbcdn.net\/hphotos-xfp1\/t31.0-8\/336385_10151009318069487_772061084_o.jpg\" alt=\"336385_10151009318069487_772061084_o.jpg\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Wishing you happy research, and all the best with your plans - cheers!!! team MTM :)&lt;\/p&gt;","Attachments":[],"Id":1891989,"PostDate":1428324677,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congrats on your upcoming elopement in Costa Rica this year, Cassidy!!! how exciting, for sure <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> you'll find lots of great info, ideas, advice and support from all the resources in the forum - to help with your questions.<\/p>\n<p>\u00a0<\/p>\n<p>Linc shot a wonderfully FUN wedding with just the bride & groom that you can see here: <a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10151009302034487.443366.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>La Blanc Wedding Album<\/a>, with a excerpts shown here:\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord.xx.fbcdn.net\/hphotos-xaf1\/t31.0-8\/169611_10151009320999487_1579582819_o.jpg\" alt=\"169611_10151009320999487_1579582819_o.jp\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord.xx.fbcdn.net\/hphotos-xfp1\/t31.0-8\/336385_10151009318069487_772061084_o.jpg\" alt=\"336385_10151009318069487_772061084_o.jpg\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>Wishing you happy research, and all the best with your plans - cheers!!! team MTM <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280196260,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"190.241.252.27","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79025,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"d4675989014a95550cbd6cb3e48cefc4","RawContent":"&lt;p&gt;Thanks for that Moments that Matter!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;What wonderful photos! I hope that Costa Rica is as beautiful as it is in my dreams. I have been to Cancun and enjoyed it, the beaches were so nice :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Trying to soak in all the information on this website, I do not know why I never thought to look into a wedding forum before now, this is so helpful reading about everryone&#039;s experiences.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I am less than a month away! :)&lt;\/p&gt;","Attachments":[],"Id":1891990,"PostDate":1428325363,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Thanks for that Moments that Matter!<\/p>\n<p>\u00a0<\/p>\n<p>What wonderful photos! I hope that Costa Rica is as beautiful as it is in my dreams. I have been to Cancun and enjoyed it, the beaches were so nice <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Trying to soak in all the information on this website, I do not know why I never thought to look into a wedding forum before now, this is so helpful reading about everryone's experiences.<\/p>\n<p>\u00a0<\/p>\n<p>I am less than a month away! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cassidymichaels233@gmail.com","IpAddress":"190.241.252.27","GroupId":39,"GroupName":"Newbie","JoinDate":1428321137,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"youngandinlove","Id":282649,"Name":"youngandinlove","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.241.131.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79025,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"3768b10770e1813305deb074d4a49e5c","RawContent":"&lt;p&gt;Congrats and Welcome :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;This site always has great ideas regardless of where you are getting married\/how many atendees you will have. We can all relate and share ideas :)&lt;\/p&gt;","Attachments":[],"Id":1892003,"PostDate":1428332094,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congrats and Welcome <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>This site always has great ideas regardless of where you are getting married\/how many atendees you will have. We can all relate and share ideas <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;1\/st\/20151215\/e\/Our+Wedding\/k\/ec4b\/event.png\" alt=\"event.png\"><\/a><br><br><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":42,"GroupName":"Sr. Member","JoinDate":1419423414,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1436293677","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"190.241.252.27","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79025,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"1f3ae04fb79b844df124bd1ae5a3ba33","RawContent":"&lt;p&gt;Thank you perianjay! I love the site so far :)&lt;\/p&gt;","Attachments":[],"Id":1892019,"PostDate":1428334375,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Thank you perianjay! I love the site so far <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cassidymichaels233@gmail.com","IpAddress":"190.241.252.27","GroupId":39,"GroupName":"Newbie","JoinDate":1428321137,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"youngandinlove","Id":282649,"Name":"youngandinlove","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"64.231.97.33","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79025,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"b42a871cba5735fe442a97813c315854","RawContent":"&lt;p&gt;Congrats and welcome to the site! Costa Rica is next on our list to visit and is one of the 3 we&#039;re looking at to retire to!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Wow - you&#039;re date is really close! Which resort have you picked? Is it just the two of you, or do you have anyone going with you? You&#039;ve definitely come to the right place as far as ideas and tips and suggestions. And the ladies here are more than willing to share. Have you looked through the different reviews that are available? There are resorts and vendors both so might be worth a look.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;The other thing you can do is just key in Costa Rica in the search bar and you should get several different things comes up that might be worth reading.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck and happy planning!!&lt;\/p&gt;","Attachments":[],"Id":1892086,"PostDate":1428357216,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congrats and welcome to the site! Costa Rica is next on our list to visit and is one of the 3 we're looking at to retire to!<\/p>\n<p>\u00a0<\/p>\n<p>Wow - you're date is really close! Which resort have you picked? Is it just the two of you, or do you have anyone going with you? You've definitely come to the right place as far as ideas and tips and suggestions. And the ladies here are more than willing to share. Have you looked through the different reviews that are available? There are resorts and vendors both so might be worth a look.<\/p>\n<p>\u00a0<\/p>\n<p>The other thing you can do is just key in Costa Rica in the search bar and you should get several different things comes up that might be worth reading.<\/p>\n<p>\u00a0<\/p>\n<p>Good luck and happy planning!!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.51.43.112","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79025,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"899dc0fd3e7d664cfa57a4596f3fe28d","RawContent":"&lt;p&gt;Haven&#039;t been to Costa Rica before but I&#039;ve heard nothing but wonderful things. And honestly, elopements are just so romantic and beautiful!!! Hope your experience is EVERYTHING&amp;nbsp; ;)&amp;nbsp; :P&lt;\/p&gt;","Attachments":[],"Id":1892091,"PostDate":1428358238,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Haven't been to Costa Rica before but I've heard nothing but wonderful things. And honestly, elopements are just so romantic and beautiful!!! Hope your experience is EVERYTHING\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/>\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/tongue.png' class='bbc_emoticon' alt=':P' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-size:18px;\"><span style=\"font-family:georgia;\"><strong>MARIESAM SANCHEZ PHOTOGRAPHY<\/strong><\/span><\/span><br>\nWEBSITE: <a  class=\"bbc_url\" href=\"http:\/\/www.mariesamsanchez.com\">www.mariesamsanchez.com<\/a><br>\nBLOG: <a  class=\"bbc_url\" href=\"http:\/\/www.mariesamsanchezblog.com\">www.mariesamsanchez.com<\/a><a data-ipb='nomediaparse' href='http:\/\/www.mariesamsanchez.com\/blog'>\/blog<\/a><br>\nCONTACT ME: <a  class=\"bbc_email\" href=\"mailto:mariesam.sanchez@gmail.com?subject=BDW%20Inquiry\" title=\"E-mail Link\">mariesam.sanchez@gmail.com<\/a><br><br><img src=\"http:\/\/i287.photobucket.com\/albums\/ll150\/msam007562\/063cb5c8-dbda-4822-87fe-ba3c0ebcdb7f.jpg\" alt=\"063cb5c8-dbda-4822-87fe-ba3c0ebcdb7f.jpg\">","Email":"mariesam.sanchez@gmail.com","IpAddress":"74.100.61.37","GroupId":38,"GroupName":"Moderators","JoinDate":1285939945,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232833.jpg?_r=1422091823","PhotoWidth":200,"PhotoHeight":220,"PhotoType":"custom"},"FormattedName":"MarieSamSanchezPhoto","Id":232833,"Name":"MarieSamSanchezPhoto","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"190.241.252.27","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79025,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"145f0a3f4173520f7029802c6c8bb30c","RawContent":"&lt;p&gt;It is coming very quickly ACW271011! I am giddy :D&amp;nbsp; We actually have I think almost everything in place. We chose a boutique travel planner in Costa Rica that also does wedding planning. It seemed like the best choice not having to get too many parties involved, keep it simple was my goal and they made it simple. The prices were great, we are getting the wedding day and 10 day honeymoon for about $5000. Our planner Catalina has been wonderful!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We were originally planning on a more traditional wedding but after looking at venues, pricing catering, photographers, reception, we were in the neighborhood of $15,000 and that did not even incude the honymoon!!! The more we planned the higher the price was and it just got to be too much stress and money. We will get together with friends and family to celebrate when we return. In the end we decided that our wedding was just about our love and I think this is the best way for us to do it.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;So here is our plan:&lt;\/p&gt;\n&lt;p&gt;The first days of the trip are on the Pacific Coast. We asked for all inclusive and we settled on a place called the Flamingo Beach Resort. After we unwind for 2 days the wedding day happens. This is simple, just an officiant &amp;amp; photographer. It will be a sunset beach wedding. We have a private candlelight dinner chefs table that night on the beach. After our big day (and 2 more days at the beach relaxing) we start to explore the country visiting Arenal, Monteverde, and then leaving through Liberia airpot. We like to be adventurous so we are going to do some canopy ziplines, some rafting, and hiking.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I will share photos after we return.&lt;\/p&gt;","Attachments":[],"Id":1892150,"PostDate":1428408362,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>It is coming very quickly ACW271011! I am giddy <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/biggrin.png' class='bbc_emoticon' alt=':D' \/>\u00a0 We actually have I think almost everything in place. We chose a boutique travel planner in Costa Rica that also does wedding planning. It seemed like the best choice not having to get too many parties involved, keep it simple was my goal and they made it simple. The prices were great, we are getting the wedding day and 10 day honeymoon for about $5000. Our planner Catalina has been wonderful!<\/p>\n<p>\u00a0<\/p>\n<p>We were originally planning on a more traditional wedding but after looking at venues, pricing catering, photographers, reception, we were in the neighborhood of $15,000 and that did not even incude the honymoon!!! The more we planned the higher the price was and it just got to be too much stress and money. We will get together with friends and family to celebrate when we return. In the end we decided that our wedding was just about our love and I think this is the best way for us to do it.<\/p>\n<p>\u00a0<\/p>\n<p>So here is our plan:<\/p>\n<p>The first days of the trip are on the Pacific Coast. We asked for all inclusive and we settled on a place called the Flamingo Beach Resort. After we unwind for 2 days the wedding day happens. This is simple, just an officiant & photographer. It will be a sunset beach wedding. We have a private candlelight dinner chefs table that night on the beach. After our big day (and 2 more days at the beach relaxing) we start to explore the country visiting Arenal, Monteverde, and then leaving through Liberia airpot. We like to be adventurous so we are going to do some canopy ziplines, some rafting, and hiking.<\/p>\n<p>\u00a0<\/p>\n<p>I will share photos after we return.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cassidymichaels233@gmail.com","IpAddress":"190.241.252.27","GroupId":39,"GroupName":"Newbie","JoinDate":1428321137,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"youngandinlove","Id":282649,"Name":"youngandinlove","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"208.87.237.180","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79025,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"7850aeb1df492c08feaa837a93919c42","RawContent":"&lt;p&gt;Oh that sounds so romantic! And totally fun!! We got married just the two of us in Jamaica almost 4 years ago. No people for different reasons but it was still exactly what you said - about our love, and we very nearly lost sight of that. Or rather I did. Hubby reminded me. We&#039;re renewing or vows in Mexico for our anniversary in October and 4 people have already changed their plans, so now it&#039;s just 4 of us, which is totally fine. We&#039;ve dealt with some big stuff since we got married and this will be our first time actually being able to \"celebrate\" our wedding anniversary! I can&#039;t wait!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I&#039;m so excited to visit Costa Rica for the first time, which we&#039;re planning for January of next year, likely in the Guanacaste area. Couple of resorts we&#039;ve looked at but we need it to be sort of a \"jump off\" point to go looking at towns and places to live. We&#039;d like to buy before we actually retire and while the prices are still reasonable.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Absolutely please post pictures and a review when you get back!! I know the ladies here love to see the reviews and photos, and I definitely want to see the area where you were!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;All the best!!&lt;\/p&gt;","Attachments":[],"Id":1892165,"PostDate":1428410230,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Oh that sounds so romantic! And totally fun!! We got married just the two of us in Jamaica almost 4 years ago. No people for different reasons but it was still exactly what you said - about our love, and we very nearly lost sight of that. Or rather I did. Hubby reminded me. We're renewing or vows in Mexico for our anniversary in October and 4 people have already changed their plans, so now it's just 4 of us, which is totally fine. We've dealt with some big stuff since we got married and this will be our first time actually being able to \"celebrate\" our wedding anniversary! I can't wait!<\/p>\n<p>\u00a0<\/p>\n<p>I'm so excited to visit Costa Rica for the first time, which we're planning for January of next year, likely in the Guanacaste area. Couple of resorts we've looked at but we need it to be sort of a \"jump off\" point to go looking at towns and places to live. We'd like to buy before we actually retire and while the prices are still reasonable.<\/p>\n<p>\u00a0<\/p>\n<p>Absolutely please post pictures and a review when you get back!! I know the ladies here love to see the reviews and photos, and I definitely want to see the area where you were!!<\/p>\n<p>\u00a0<\/p>\n<p>All the best!!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"187.135.252.182","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79025,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"884a9d1fa9b13377fde20b01d60060a8","RawContent":"&lt;p&gt;Sounds Amazing, and thx for the accolades youngandinlove!!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I hope you get to see the red lava rivers flowing down Mt Arenal visible on a clear day! Really looking forward to seeing the photos - Congrats and happy travels!!! team MTM :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord.xx.fbcdn.net\/hphotos-ash2\/t31.0-8\/622676_10151192651314487_1337090103_o.jpg\" alt=\"622676_10151192651314487_1337090103_o.jp\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord.xx.fbcdn.net\/hphotos-xaf1\/v\/t1.0-9\/487016_10151247158359487_2044526128_n.jpg?oh=b41f565b45cd590878b00cb41b4de6ce&amp;amp;oe=55A7BABB\" alt=\"487016_10151247158359487_2044526128_n.jp\"&gt;&lt;\/p&gt;","Attachments":[],"Id":1892166,"PostDate":1428410326,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Sounds Amazing, and thx for the accolades youngandinlove!!!<\/p>\n<p>\u00a0<\/p>\n<p>I hope you get to see the red lava rivers flowing down Mt Arenal visible on a clear day! Really looking forward to seeing the photos - Congrats and happy travels!!! team MTM <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord.xx.fbcdn.net\/hphotos-ash2\/t31.0-8\/622676_10151192651314487_1337090103_o.jpg\" alt=\"622676_10151192651314487_1337090103_o.jp\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord.xx.fbcdn.net\/hphotos-xaf1\/v\/t1.0-9\/487016_10151247158359487_2044526128_n.jpg?oh=b41f565b45cd590878b00cb41b4de6ce&oe=55A7BABB\" alt=\"487016_10151247158359487_2044526128_n.jp\"><\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280196260,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}}],"Id":"79025","Title":"Love This Site!","LastPostDate":1437483044},"Pages":{"TotalItems":15,"TotalPages":2,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
