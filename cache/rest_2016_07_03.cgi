\/www.bestdestinationwedding.com\/topic\/79153-diadiamonds-planning-thread-iberostar-varadero-cuba-sept242015\/<\/a><\/div>\n<div>\u00a0<\/div>\n<div>\u00a0<\/div>\n","Email":"fadia.daniel@gmail.com","IpAddress":"76.64.81.211","GroupId":40,"GroupName":"Jr. Member","JoinDate":1392649643,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276748.jpg?_r=1445822927","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"diadiamond","Id":276748,"Name":"diadiamond","IsOnline":false}},"Posts":[],"Id":"78040","Title":"Pressure To Have Ath","LastPostDate":1430571551},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":209,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":8353,"MovedTo":null,"MovedOn":0,"FirstPostId":1860205,"Rating":0,"RatingHits":0,"Starter":{"Id":277264,"Name":"kcole123","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277264.jpg?_r=1429937323","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"StartDate":1405528919,"LastPoster":{"Id":265511,"Name":"TinkerSofi","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265511.jpg?_r=1442890536","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":60,"Preview":{"Id":1860205,"PostDate":1405528919,"PostContent":"Hi there girls, Well it feels like my idea of a destination \"cost effective\" wedding has gone dow...","Author":{"Signature":"<p style=\"text-align:center;\"><strong>Kristy and Nathan<\/strong><\/p>\n<p style=\"text-align:center;\"><strong>Melia Caribe Tropical <\/strong><\/p>\n<p style=\"text-align:center;\"><strong>April 17, 2015<\/strong>","Email":"colek_64@hotmail.com","IpAddress":"199.180.174.8","GroupId":3,"GroupName":"Member","JoinDate":1395332214,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277264.jpg?_r=1429937323","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"kcole123","Id":277264,"Name":"kcole123","IsOnline":false}},"Posts":[],"Id":"77545","Title":"Anyone Else Overwhelmed With Cost?","LastPostDate":1410823541}],"Filters":{"Period":[],"Other":[]}}],"Pages":{"TotalItems":128,"TotalPages":7,"CurrentPage":0,"NextPage":20,"PreviousPage":-1,"LastPage":120},"PushNotifications":[]}
