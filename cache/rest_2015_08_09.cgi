elete":false,"CanLike":true,"TopicId":73031,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d3ed1ec0e247f2b42ec04423c7dc1cfe","RawContent":"&lt;p&gt;Can I please a copy as well? &lt;a data-ipb=&#039;nomediaparse&#039; href=\"mailto:candymunn@gmail.com\"&gt;candymunn@gmail.com&lt;\/a&gt; Thnx!!!!&lt;\/p&gt;","Attachments":[],"Id":1811815,"PostDate":1383592242,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Can I please a copy as well? <a href='mailto:candymunn@gmail.com' class='bbc_url' title='External link' rel='nofollow external'>candymunn@gmail.com<\/a> Thnx!!!!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"candymunn@gmail.com","IpAddress":"24.21.63.184","GroupId":39,"GroupName":"Newbie","JoinDate":1383147267,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-274702.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"crmunn","Id":274702,"Name":"crmunn","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73031,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2a7bdd2af4fd3e6bcfde5bf2825c5ab4","RawContent":"&lt;p&gt;If anyone could email the Jellyfish price list to me I would appreciate it! &lt;a data-ipb=&#039;nomediaparse&#039; href=\"mailto:Carrie.Jean77@gmail.com\"&gt;Carrie.Jean77@gmail.com&lt;\/a&gt;. Thank you!&lt;\/p&gt;","Attachments":[],"Id":1813662,"PostDate":1384105179,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>If anyone could email the Jellyfish price list to me I would appreciate it! <a href='mailto:Carrie.Jean77@gmail.com' class='bbc_url' title='External link' rel='nofollow external'>Carrie.Jean77@gmail.com<\/a>. Thank you!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"carrie.jen77@gmil.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1379702427,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-273633.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":85,"PhotoType":"custom"},"FormattedName":"Carrie1977","Id":273633,"Name":"Carrie1977","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73031,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"69df1c72cac0c1541909df61a2eae449","RawContent":"Hey everyone! I&#039;m really interested in the jellyfish it is so beautiful and unique! I e-mailed Mayte a few times but no reply it makes me hesitant right off the bat :\/ could any of you ladies send me the prices list we are looking at about 20 guests . Much appreciated!! Nickzaccardi44@yahoo.com","Attachments":[],"Id":1815743,"PostDate":1384859522,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hey everyone! I'm really interested in the jellyfish it is so beautiful and unique! I e-mailed Mayte a few times but no reply it makes me hesitant right off the bat :\/ could any of you ladies send me the prices list we are looking at about 20 guests . Much appreciated!! Nickzaccardi44@yahoo.com\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"nickzaccardi44@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1384859055,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275169.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"jamiezaccardi1","Id":275169,"Name":"jamiezaccardi1","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73031,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"928b5099ba2d9d60612a3e880603d312","RawContent":"&lt;p&gt;Hey ladies!&amp;nbsp; I agree about cost adding up and also stressing out - although it is MUCH cheaper than getting married at home.&amp;nbsp; Can anyone explain the open bar packages to me?&amp;nbsp; Mayte sent a list with $22 \"pax per hour\" - doing the math that would cost over $100 per person for a night of open bar... which is more expensive than open bars here at hom!&amp;nbsp; Am I missing something?&lt;\/p&gt;","Attachments":[],"Id":1816059,"PostDate":1384957859,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hey ladies!\u00a0 I agree about cost adding up and also stressing out - although it is MUCH cheaper than getting married at home.\u00a0 Can anyone explain the open bar packages to me?\u00a0 Mayte sent a list with $22 \"pax per hour\" - doing the math that would cost over $100 per person for a night of open bar... which is more expensive than open bars here at hom!\u00a0 Am I missing something?<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ashley.jacquelyn@gmail.com","IpAddress":"70.192.7.55","GroupId":39,"GroupName":"Newbie","JoinDate":1350996195,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"custom"},"FormattedName":"ashleyjacquelyn","Id":261683,"Name":"ashleyjacquelyn","IsOnline":false}}],"Pages":{"TotalItems":99,"TotalPages":10,"CurrentPage":50,"NextPage":60,"PreviousPage":40,"LastPage":90},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
