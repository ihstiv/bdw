Request Time: 0 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":21,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":2430,"MovedTo":null,"MovedOn":0,"FirstPostId":1859131,"Rating":0,"RatingHits":0,"Starter":{"Id":276164,"Name":"shelikespink","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276164.jpg?_r=1401826611","PhotoWidth":200,"PhotoHeight":240,"PhotoType":"custom"},"IsOnline":false},"StartDate":1405113966,"LastPoster":{"Id":277873,"Name":"calgarybride2015","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":true},"PollState":"0","LastVote":0,"ForumId":67,"Preview":{"Id":1893426,"PostDate":1429218200,"PostContent":"@calgarybride2015 Who was the photographer you used with Adventure Photo, in case we end up going...","Author":{"Signature":"<p>- Erin<\/p>\n<p>\u00a0<\/p>\n<p>My planning thread:\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79068-vancouverpetunia-now-sapphire-april-7-2016\/?p=1893268'>http:\/\/www.bestdestinationwedding.com\/topic\/79068-vancouverpetunia-now-sapphire-april-7-2016\/?p=1893268<\/a>","Email":"ekjzwedding@gmail.com","IpAddress":"24.85.127.174","GroupId":40,"GroupName":"Jr. Member","JoinDate":1417435045,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281283.jpg?_r=1428779369","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"vancouverpetunia","Id":281283,"Name":"vancouverpetunia","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.234.23.105","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77507,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"73fc280fda6f3e171f7534d81324fbf9","RawContent":"&lt;p&gt;Hi everyone,\n\n\nI&#039;m trying to make a budget and I am wondering the approx cost of wedding photography in Cancun for 6-8 hours.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I am doing engagement photos here at home and the photographers have given me a quote for my destination wedding, but it&#039;s pretty high, plus I would need to cover their flight\/hotel. It would be great to get an idea of what to expect!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thanks!&lt;\/p&gt;","Attachments":[],"Id":1859131,"PostDate":1405113966,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi everyone,<br><br>\nI'm trying to make a budget and I am wondering the approx cost of wedding photography in Cancun for 6-8 hours.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I am doing engagement photos here at home and the photographers have given me a quote for my destination wedding, but it's pretty high, plus I would need to cover their flight\/hotel. It would be great to get an idea of what to expect!<\/p>\n<p>\u00a0<\/p>\n<p>Thanks!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"shaleenalisa@gmail.com","IpAddress":"99.245.202.85","GroupId":39,"GroupName":"Newbie","JoinDate":1389982703,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276164.jpg?_r=1401826611","PhotoWidth":200,"PhotoHeight":240,"PhotoType":"custom"},"FormattedName":"shelikespink","Id":276164,"Name":"shelikespink","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.72.195.234","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77507,"EditedBy":"<strong>Edited by kmk2016, 11 July 2014 - 09:56 PM.<\/strong>","EditDate":1405115793,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"dd384a69c2fd6da5701b36a63626fdc2","RawContent":"Depending on what style you are looking for, and the quality of the work it&#039;s a pretty broad spectrum. $1000-$5000.... You are best to read some reviews and email for quotes to a few photographers you are interested in. It&#039;s the only way to get a true sense since there are simply too many variables. \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1859141,"PostDate":1405115747,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Depending on what style you are looking for, and the quality of the work it's a pretty broad spectrum. $1000-$5000.... You are best to read some reviews and email for quotes to a few photographers you are interested in. It's the only way to get a true sense since there are simply too many variables. <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kmkwedding2016@gmail.com","IpAddress":"70.72.195.234","GroupId":38,"GroupName":"Moderators","JoinDate":1390242208,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"kmk2016","Id":276231,"Name":"kmk2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.14.134","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77507,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"07a4aa41575950c59d4d462b779ed424","RawContent":"&lt;p&gt;And on top of that, they all work different numbers of hours for the prices they charge. So for the amount of time you want - 6 to 8 hours - you&#039;re probably going to be looking at the higher end of the price range that @[member=\"kmk2016\"] mentioned. Definitely start looking through the photographers and emailing them for what their price structure is. keep in mind as well that they can book up quickly so be sure to give yourself lots of time.&lt;\/p&gt;","Attachments":[],"Id":1859150,"PostDate":1405120109,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>And on top of that, they all work different numbers of hours for the prices they charge. So for the amount of time you want - 6 to 8 hours - you're probably going to be looking at the higher end of the price range that @<a hovercard-ref=\"member\" hovercard-id=\"276231\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/276231-kmk2016\/' title='Member profile'><span itemprop=\"name\">kmk2016<\/span><\/a> mentioned. Definitely start looking through the photographers and emailing them for what their price structure is. keep in mind as well that they can book up quickly so be sure to give yourself lots of time.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"187.153.58.176","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77507,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"e1535eb6c7a4ba07e22457cfb521b494","RawContent":"&lt;p&gt;&lt;strong&gt;Dear Shelikespink:&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Yes It depends how many photos do you want and the style of session. But, If you let me to give you some information about us, we have different packages and prices that offered, and If you compare the prices VS service quality and product quality, you&#039;ll see that we are the best choice, let me inform you that this statement is not only our opinion, the Conde Nast Brides Magazine -&lt;span style=\"color:rgb(85,85,85);font-family:&#039;Helvetica Neue&#039;, Helvetica, Arial, sans-serif;font-size:15px;\"&gt;the UK\u2019s leading Brides magazine from the publisher of&amp;nbsp;&lt;\/span&gt;&lt;strong&gt;GLAMOUR&lt;\/strong&gt;&lt;span style=\"color:rgb(85,85,85);font-family:&#039;Helvetica Neue&#039;, Helvetica, Arial, sans-serif;font-size:15px;\"&gt;&amp;nbsp;and&amp;nbsp;&lt;\/span&gt;&lt;strong&gt;VOGUE&lt;\/strong&gt;&lt;span style=\"color:rgb(85,85,85);font-family:&#039;Helvetica Neue&#039;, Helvetica, Arial, sans-serif;font-size:15px;\"&gt;&amp;nbsp;has&amp;nbsp;&lt;\/span&gt;&lt;strong&gt;profiled Pixan Photography&lt;\/strong&gt;&lt;span style=\"color:rgb(85,85,85);font-family:&#039;Helvetica Neue&#039;, Helvetica, Arial, sans-serif;font-size:15px;\"&gt;&amp;nbsp;as&amp;nbsp;&lt;\/span&gt;&lt;strong&gt;one of only 20 International Photography studios from across the World&lt;\/strong&gt;&lt;span style=\"color:rgb(85,85,85);font-family:&#039;Helvetica Neue&#039;, Helvetica, Arial, sans-serif;font-size:15px;\"&gt;&amp;nbsp;and&amp;nbsp;&lt;\/span&gt;&lt;strong&gt;the exclusive photography studio that is based in Mexico&lt;\/strong&gt;&lt;span style=\"color:rgb(85,85,85);font-family:&#039;Helvetica Neue&#039;, Helvetica, Arial, sans-serif;font-size:15px;\"&gt;.&amp;nbsp;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"color:rgb(85,85,85);font-family:&#039;Helvetica Neue&#039;, Helvetica, Arial, sans-serif;font-size:15px;\"&gt;So if you are looking for something \"special, romantic, contemporary and with a lot of fun\" please let us to show our proposal. In the links below that, you can see more information about packages &amp;amp; prices.&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;strong&gt;&lt;span style=\"color:#282828;\"&gt;&lt;span style=\"font-family:&#039;trebuchet ms&#039;, sans-serif;\"&gt;&lt;span style=\"font-size:10.5pt;\"&gt;Wedding Welcome Guides&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"color:#282828;\"&gt;&lt;span style=\"font-family:&#039;trebuchet ms&#039;, sans-serif;\"&gt;&lt;span style=\"font-size:10.5pt;\"&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/mad.ly\/cabe64&#039; title=\"External link\"&gt;&lt;span style=\"color:#0f72da;\"&gt;Wedding Photography Welcome Guide - Pixan Photography&lt;\/span&gt;&lt;\/a&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;strong&gt;&lt;span style=\"color:#282828;\"&gt;&lt;span style=\"font-family:&#039;trebuchet ms&#039;, sans-serif;\"&gt;&lt;span style=\"font-size:10.5pt;\"&gt;Riviera Maya Trash The Dress Adventure Welcome guides - great for honeymooners&amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"color:#282828;\"&gt;&lt;span style=\"font-family:&#039;trebuchet ms&#039;, sans-serif;\"&gt;&lt;span style=\"font-size:10.5pt;\"&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/mad.ly\/3112b4&#039; title=\"External link\"&gt;&lt;span style=\"color:#0f72da;\"&gt;Riviera Maya Trash The Dress Photo Shoot Adventure - Welcome Guide - Pixan Photography&lt;\/span&gt;&lt;\/a&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"color:#282828;\"&gt;&lt;span style=\"font-family:&#039;trebuchet ms&#039;, sans-serif;\"&gt;&lt;span style=\"font-size:10.5pt;\"&gt;We can provide you a personalized attention through email. If you want to need that, please contact us, my email is:&amp;nbsp;&lt;em&gt;ariadna.gdessavre@pixanphoto.com&amp;nbsp;&lt;\/em&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"color:#282828;\"&gt;&lt;span style=\"font-family:&#039;trebuchet ms&#039;, sans-serif;\"&gt;&lt;span style=\"font-size:10.5pt;\"&gt;I&#039;m very glad to know about your feelings and expectations in the best special day of your life!!!&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;strong&gt;&lt;span style=\"color:#282828;\"&gt;&lt;span style=\"font-family:&#039;trebuchet ms&#039;, sans-serif;\"&gt;&lt;span style=\"font-size:10.5pt;\"&gt;Website: www.pixanphoto.com&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;strong&gt;&lt;span style=\"color:#282828;\"&gt;&lt;span style=\"font-family:&#039;trebuchet ms&#039;, sans-serif;\"&gt;&lt;span style=\"font-size:10.5pt;\"&gt;Fanpage on Facebook:&amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;strong&gt;&lt;span style=\"color:#282828;\"&gt;&lt;span style=\"font-family:arial, sans-serif;\"&gt;&lt;span style=\"font-size:10.5pt;\"&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/pixanphoto&#039; title=\"External link\"&gt;&lt;span style=\"color:#0f72da;\"&gt;https:\/\/www.facebook.com\/pixanphoto&lt;\/span&gt;&lt;\/a&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Warmest Regards ;)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"color:#282828;\"&gt;&lt;span style=\"font-family:&#039;trebuchet ms&#039;, sans-serif;\"&gt;&lt;span style=\"font-size:10.5pt;\"&gt;Ariadna.&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1877715,"PostDate":1415113631,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><strong>Dear Shelikespink:<\/strong><\/p>\n<p>\u00a0<\/p>\n<p>Yes It depends how many photos do you want and the style of session. But, If you let me to give you some information about us, we have different packages and prices that offered, and If you compare the prices VS service quality and product quality, you'll see that we are the best choice, let me inform you that this statement is not only our opinion, the Conde Nast Brides Magazine -<span  style=\"color:rgb(85,85,85);font-family:'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:15px;\">the UK\u2019s leading Brides magazine from the publisher of\u00a0<\/span><strong>GLAMOUR<\/strong><span  style=\"color:rgb(85,85,85);font-family:'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:15px;\">\u00a0and\u00a0<\/span><strong>VOGUE<\/strong><span  style=\"color:rgb(85,85,85);font-family:'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:15px;\">\u00a0has\u00a0<\/span><strong>profiled Pixan Photography<\/strong><span  style=\"color:rgb(85,85,85);font-family:'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:15px;\">\u00a0as\u00a0<\/span><strong>one of only 20 International Photography studios from across the World<\/strong><span  style=\"color:rgb(85,85,85);font-family:'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:15px;\">\u00a0and\u00a0<\/span><strong>the exclusive photography studio that is based in Mexico<\/strong><span  style=\"color:rgb(85,85,85);font-family:'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:15px;\">.\u00a0<\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"color:rgb(85,85,85);font-family:'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:15px;\">So if you are looking for something \"special, romantic, contemporary and with a lot of fun\" please let us to show our proposal. In the links below that, you can see more information about packages & prices.<\/span><\/p>\n<p>\u00a0<\/p>\n<p><strong><span  style=\"color:#282828\"><span  style=\"font-family:'trebuchet ms', sans-serif;\"><span  style=\"font-size:10.5pt\">Wedding Welcome Guides<\/span><\/span><\/span><\/strong><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"color:#282828\"><span  style=\"font-family:'trebuchet ms', sans-serif;\"><span  style=\"font-size:10.5pt\"><a href='http:\/\/mad.ly\/cabe64' class='bbc_url' title='External link' rel='nofollow external'><span  style=\"color:#0f72da\">Wedding Photography Welcome Guide - Pixan Photography<\/span><\/a><\/span><\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><strong><span  style=\"color:#282828\"><span  style=\"font-family:'trebuchet ms', sans-serif;\"><span  style=\"font-size:10.5pt\">Riviera Maya Trash The Dress Adventure Welcome guides - great for honeymooners\u00a0<\/span><\/span><\/span><\/strong><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"color:#282828\"><span  style=\"font-family:'trebuchet ms', sans-serif;\"><span  style=\"font-size:10.5pt\"><a href='http:\/\/mad.ly\/3112b4' class='bbc_url' title='External link' rel='nofollow external'><span  style=\"color:#0f72da\">Riviera Maya Trash The Dress Photo Shoot Adventure - Welcome Guide - Pixan Photography<\/span><\/a><\/span><\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"color:#282828\"><span  style=\"font-family:'trebuchet ms', sans-serif;\"><span  style=\"font-size:10.5pt\">We can provide you a personalized attention through email. If you want to need that, please contact us, my email is:\u00a0<em>ariadna.gdessavre@pixanphoto.com\u00a0<\/em><\/span><\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"color:#282828\"><span  style=\"font-family:'trebuchet ms', sans-serif;\"><span  style=\"font-size:10.5pt\">I'm very glad to know about your feelings and expectations in the best special day of your life!!!<\/span><\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<p><strong><span  style=\"color:#282828\"><span  style=\"font-family:'trebuchet ms', sans-serif;\"><span  style=\"font-size:10.5pt\">Website: www.pixanphoto.com<\/span><\/span><\/span><\/strong><\/p>\n<p><strong><span  style=\"color:#282828\"><span  style=\"font-family:'trebuchet ms', sans-serif;\"><span  style=\"font-size:10.5pt\">Fanpage on Facebook:\u00a0<\/span><\/span><\/span><\/strong><strong><span  s