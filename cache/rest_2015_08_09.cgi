;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                My wedding date is confirmed for may 14 2014 =] the ceremony will be at 5:00 at the fountain. I am so excited!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"amberk90@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1372755645,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-271117.jpeg?_r=0","PhotoWidth":180,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"amberk90","Id":271117,"Name":"amberk90","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"dd7a410a5d70b5270bbba286566a2585","RawContent":"&lt;p&gt; I was thinking of doing the same thing, as far as picking the moments package and adding what I need to that. Some things in those other packages are nice, but I don&#039;t need them.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1786639,"PostDate":1375456845,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I was thinking of doing the same thing, as far as picking the moments package and adding what I need to that. Some things in those other packages are nice, but I don't need them.\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jsconner1983@yahoo.com","IpAddress":"67.173.180.132","GroupId":40,"GroupName":"Jr. Member","JoinDate":1362999807,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-267190.jpeg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Jahanee Conner","Id":267190,"Name":"Jahanee Conner","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"57a4e3b9345543f56a8d6f8bb5199003","RawContent":"&lt;p&gt; amberk90 congrats!!! I have the fountain ceremony too at 4pm August 30 next yr! How exciting! What are you planning on doing for the reception in terms of location?!&lt;\/p&gt;","Attachments":[],"Id":1786662,"PostDate":1375461375,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> amberk90 congrats!!! I have the fountain ceremony too at 4pm August 30 next yr! How exciting! What are you planning on doing for the reception in terms of location?!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"drenna@gmail.com","IpAddress":"67.167.198.72","GroupId":47,"GroupName":"Site Supporter","JoinDate":1371509064,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270677.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":124,"PhotoType":"custom"},"FormattedName":"duchovny0901","Id":270677,"Name":"duchovny0901","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c0819e2e5d09d46176793c7c74cfe041","RawContent":"Thank you and congrats as well! We are planning a poolside reception with the buffet dinner and the resort dj. What are your plans?","Attachments":[],"Id":1786667,"PostDate":1375461971,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thank you and congrats as well! We are planning a poolside reception with the buffet dinner and the resort dj. What are your plans?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"amberk90@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1372755645,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-271117.jpeg?_r=0","PhotoWidth":180,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"amberk90","Id":271117,"Name":"amberk90","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"beba6778f95019fb0c5c5a42cf0f8e80","RawContent":"&lt;p&gt; How much is the outside vendor DJ fee? I know some people have booked DJ Mannia for next year and I wanted to know if the $500 vendor fee for the photographer applied to the DJ as well. I think someone mentioned $150 before....Thanks guys.&lt;\/p&gt;","Attachments":[],"Id":1786676,"PostDate":1375463526,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> How much is the outside vendor DJ fee? I know some people have booked DJ Mannia for next year and I wanted to know if the $500 vendor fee for the photographer applied to the DJ as well. I think someone mentioned $150 before....Thanks guys.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"drenna@gmail.com","IpAddress":"67.167.198.72","GroupId":47,"GroupName":"Site Supporter","JoinDate":1371509064,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270677.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":124,"PhotoType":"custom"},"FormattedName":"duchovny0901","Id":270677,"Name":"duchovny0901","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"203a390e60b68f5df2ab079a405478ea","RawContent":"&lt;p&gt; Thanks! We are planning either a ballroom or Eclipse Nightclub reception with buffet dinner and DJ Mannia. It looks like we are having closer to 70 people so that limits us on