2212.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"bethlorentz","Id":272212,"Name":"bethlorentz","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"42d0511265a7d5c2f15a7320558ddaaf","RawContent":"&lt;p&gt; @KatyaNova &amp;nbsp;Are you available 6\/6\/14? &amp;nbsp;If so, what are your rates to do \"get ready, ceremony, cocktail hour, 1 hour of reception\" (feel free to PM me those) &amp;nbsp;Thanks!!!&lt;\/p&gt;","Attachments":[],"Id":1787033,"PostDate":1375620353,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> @KatyaNova \u00a0Are you available 6\/6\/14? \u00a0If so, what are your rates to do \"get ready, ceremony, cocktail hour, 1 hour of reception\" (feel free to PM me those) \u00a0Thanks!!!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"bethlorentz@gmail.com","IpAddress":"97.88.29.129","GroupId":39,"GroupName":"Newbie","JoinDate":1375536915,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272212.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"bethlorentz","Id":272212,"Name":"bethlorentz","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"da0976bc266cad94c5bcfd146b150f3a","RawContent":"@ bethlorentz Congrats on your upcoming wedding! What a big group! I&#039;m just curious about your reception location choices; where are you planning to have dinner and dancing? I am expecting roughly the same amount of guests and am debating about having the reception in the Ballroom; there&#039;s not too many options with such a large group! I&#039;m trying to avoid paying the $5k fee to rent out a restaurant....","Attachments":[],"Id":1787304,"PostDate":1375703724,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @ bethlorentz Congrats on your upcoming wedding! What a big group! I'm just curious about your reception location choices; where are you planning to have dinner and dancing? I am expecting roughly the same amount of guests and am debating about having the reception in the Ballroom; there's not too many options with such a large group! I'm trying to avoid paying the $5k fee to rent out a restaurant....\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"drenna@gmail.com","IpAddress":"67.167.198.72","GroupId":47,"GroupName":"Site Supporter","JoinDate":1371509064,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270677.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":124,"PhotoType":"custom"},"FormattedName":"duchovny0901","Id":270677,"Name":"duchovny0901","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3cf377096f6dd8095f09369e832bdc18","RawContent":"&lt;p&gt; @duchovny0901 Congrats to you too! &amp;nbsp;I have NO CLUE where I am going to do my dinner and dancing! &amp;nbsp;Any suggestions? &amp;nbsp;I will absolutely not be renting a restaurant though (not in the budget.) &amp;nbsp;What have you seen other big groups do? &amp;nbsp;I would love to be outside, but I just haven&#039;t really looked at the options yet. &amp;nbsp;What are you doing for photography, dj, ceremony, etc.?&lt;\/p&gt;","Attachments":[],"Id":1787381,"PostDate":1375712706,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> @duchovny0901 Congrats to you too! \u00a0I have NO CLUE where I am going to do my dinner and dancing! \u00a0Any suggestions? \u00a0I will absolutely not be renting a restaurant though (not in the budget.) \u00a0What have you seen other big groups do? \u00a0I would love to be outside, but I just haven't really looked at the options yet. \u00a0What are you doing for photography, dj, ceremony, etc.?<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"bethlorentz@gmail.com","IpAddress":"97.88.29.129","GroupId":39,"GroupName":"Newbie","JoinDate":1375536915,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272212.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"bethlorentz","Id":272212,"Name":"bethlorentz","IsOnline":false}}],"Pages":{"TotalItems":460,"TotalPages":46,"CurrentPage":130,"NextPage":140,"PreviousPage":120,"LastPage":450},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
