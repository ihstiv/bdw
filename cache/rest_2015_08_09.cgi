8c9e221b","RawContent":"&lt;p&gt; Would love to have a copy of the breakdown of the prices. Please email them to ksnifong@hotmail.com Thanks!&lt;\/p&gt;","Attachments":[],"Id":1789909,"PostDate":1376176707,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Would love to have a copy of the breakdown of the prices. Please email them to ksnifong@hotmail.com Thanks!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ksnifong@hotmail.com","IpAddress":"24.217.145.109","GroupId":39,"GroupName":"Newbie","JoinDate":1376176547,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272449.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"ksnbjs14","Id":272449,"Name":"ksnbjs14","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73031,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f33a5a2907fd354af36b65563ad17883","RawContent":"I would love a copy as well. I&#039;m currently considering having my reception at Jellyfish too. My email is d.christopher03@gmail.com","Attachments":[],"Id":1798521,"PostDate":1378673799,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I would love a copy as well. I'm currently considering having my reception at Jellyfish too. My email is d.christopher03@gmail.com\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"d.christopher03@gmail.com","IpAddress":"99.244.148.226","GroupId":39,"GroupName":"Newbie","JoinDate":1378673557,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"custom"},"FormattedName":"msdeandrac","Id":273315,"Name":"msdeandrac","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73031,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"533b2a2e7178b24df06b327c3a83c182","RawContent":"&lt;p&gt;Hi!&lt;\/p&gt; &lt;p&gt;i can&#039;t seem to open these attachments could you kindly email them to me? monica.azad@gmail.com. I would really appreciate it!&lt;\/p&gt;","Attachments":[],"Id":1798605,"PostDate":1378718348,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi!<\/p> <p>i can't seem to open these attachments could you kindly email them to me? monica.azad@gmail.com. I would really appreciate it!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sadafak86@gmail.com","IpAddress":"135.23.176.66","GroupId":39,"GroupName":"Newbie","JoinDate":1378641576,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-273295.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"sadafak","Id":273295,"Name":"sadafak","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73031,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7f9fc0e8b918100a0282069b5f00402e","RawContent":"&lt;p&gt;I&#039;m interested in the list as well if someone could please send it to me &lt;a data-ipb=&#039;nomediaparse&#039; href=\"mailto:Jbrooke.wwooddell@gmail.com\"&gt;Jbrooke.wwooddell@gmail.com&lt;\/a&gt;&amp;nbsp;I&#039;d greatly appreciate that. I have messaged Mayte as well, but as I have read it takes time for her response and I do not want to take a date w\/out having an idea on the cost.&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;Thanks!&lt;\/p&gt;","Attachments":[],"Id":1798753,"PostDate":1378744188,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I'm interested in the list as well if someone could please send it to me <a href='mailto:Jbrooke.wwooddell@gmail.com' class='bbc_url' title='External link' rel='nofollow external'>Jbrooke.wwooddell@gmail.com<\/a>\u00a0I'd greatly appreciate that. I have messaged Mayte as well, but as I have read it takes time for her response and I do not want to take a date w\/out having an idea on the cost.<\/p> <p>\u00a0<\/p> <p>Thanks!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jbrooke.wooddell@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1378743829,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-273336.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":85,"PhotoType":"custom"},"FormattedName":"jeabeeW","Id":273336,"Name":"jeabeeW","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73031,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6d05aec9ff20aac25ea2e29ac94ba56f","RawContent":"&lt;p&gt;Hi All! I&#039;m new as well and messaged Mayte recently for wedding info. I have done a&amp;nbsp;TON of research on this site as well as others regarding Jellyfish. Each list prices from different years. Could someone please send me the most recent price list? I&#039;d greatly appreciate it! jbrooke.wooddell@gmail.com&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;I also want opinions on&amp;nbsp;photographer cost. I have a great photographer from home whom I&#039;m willing to fly out.  Her cost is $1600 + flight and room. She has done a photo shoot with us before. We have mutual friends so she somewhat knows our personalities. We would have her form the entire wedding day, + the pay prior at the resort. I thinks this is a GREAT deal but the fianc\u00a9 is questioning if we can find cheaper in PC. I love Katya Nova&#039;s work $2800 (starting) but this is for two photographers I think (her&amp;amp; her hubby). Total cost is relatively the same so here is the issue...&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;-1 photographer vs. 2&lt;\/p&gt; &lt;p&gt;-2photgrathers for 1 day vs. 1 photographer for a few days&lt;\/p&gt; &lt;p&gt;-More pics during the wedding vs. more candid&#039;s over the course of the trip.&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;what would you all do???&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;We are also considering adding a videographer. Any suggestions of good\/affordable work? I want the trailer style. Also, I have not reached out to Kayta, if any of you have used her &amp;amp; Rob, plz give me some insight on what is included in the $2800.&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;Last thing, If JF is booked, I&#039;m looking at Huracan Caf\u00a9 as an option. Anyone look into that venue? I have seen pic from one wedding. Sry sooooo many questions. :)&lt;\/p&gt;","Attachments":[],"Id":1799156,"PostDate":1378863182,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi All! I'm new as well and messaged Mayte recently for wedding info. I have done a\u00a0TON of research on this site as well as others regarding Jellyfish. Each list prices from different years. Could someone please send me the most recent price list? I'd greatly appreciate it! jbrooke.wooddell@gmail.com<\/p> <p>\u00a0<\/p> <p>I also want opinions on\u00a0photographer cost. I have a great photographer from home whom I'm willing to fly out.\u00a0\u00a0Her cost is $1600 + flight and room. She has done a photo shoot with us before. We have mutual friends so she somewhat knows our personalities. We would have her form the entire wedding day, + the pay prior at the resort. I thinks this is a GREAT deal but the fianc\u00a9 is questioning if we can find cheaper in PC. I love Katya Nova's work $2800 (starting) but this is for two photographers I think (her& her hubby). Total cost is relatively the same so here is the issue...<\/p> <p>\u00a0<\/p> <p>-1 photographer vs. 2<\/p> <p>-2photgrathers for 1 day vs. 1 photographer for a few days<\/p> <p>-More pics during the wedding vs. more candid's over the course of the trip.<\/p> <p>\u00a0<\/p> <p>what would you all do???<\/p> <p>\u00a0<\/p> <p>We are also considering adding a videographer. Any suggestions of good\/affordable work? I want the trailer style. Also, I have not reached out to Kayta, if any of you have used her & Rob, plz give me some insight on what is included in the $2800.<\/p> <p>\u00a0<\/p> <p>Last thing, If JF is booked, I'm looking at Huracan Caf\u00a9 as an option. Anyone look into that venue? I have seen pic from one wedding. Sry sooooo many questions. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jbrooke.wooddell@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1378743829,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-273336.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":85,"PhotoType":"custom"},"FormattedName":"jeabeeW","Id":273336,"Name":"jeabeeW","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73031,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3fec3f21ffa81880e8f7e130f3adab8e","RawContent":"&lt;div class=\"quote-container\"&gt;Quote: &lt;div class=\"quote-block\"&gt;Originally Posted by &lt;strong&gt;jeabeeW&lt;\/strong&gt;&amp;nbsp;&lt;img alt=\"View Post\" src=\"\/img\/forum\/go_quote.gif\" \/&gt;\n &amp;nbsp; &lt;p&gt;Hi All! I&#039;m new as well and messaged Mayte recently for wedding info. I have done a&amp;nbsp;TON of research on this site as well as others regarding Jellyfish. Each list prices from different years. Could someone please send me the most recent price list? I&#039;d greatly appreciate it! jbrooke.wooddell@gmail.com&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;I also want opinions on&amp;nbsp;photographer cost. I have a great photographer from home whom I&#039;m willing to fly out.  Her cost is $1600 + flight and room. She has done a photo shoot with us before. We have mutual friends so she somewhat knows our personalities. We would have her form the entire wedding day, + the pay prior at the resort. I thinks this is a GREAT deal but the fianc\u00a9 is questioning if we can find cheaper in PC. I love Katya Nova&#039;s work $2800 (starting) but this is for two photographers I think (her&amp;amp; her hubby). Total cost is relatively the same so here is the issue...&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;-1 photographer vs. 2&lt;\/p&gt; &lt;p&gt;-2photgrathers for 1 day vs. 1 photographer for a few days&lt;\/p&gt; &lt;p&gt;-More pics during the wedding vs. more candid&#039;s over the course of the trip.&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;what would you all do???&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;We are also considering adding a videographer. Any suggestions of good\/affordable work? I want the trailer style. Also, I have not reached out to Kayta, if any of you have used her &amp;amp; Rob, plz give me some insight on what is included in the $2800.&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;Last thing, If JF is booked, I&#039;m looking at Huracan Caf\u00a9 as an option. Anyone look into that venue? I have seen pic from one wedding. Sry sooooo many questions. :)&lt;\/p&gt; &lt;\/div&gt; &lt;\/div&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;I&#039;ve booked a photographer in the DR. 2 photographers for the whole day for around $1500. http:\/\/weddingphotographypuntacana.wordpress.com\/&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;I met with them in June and I LOVE their energy and their work. They also know a lot about Huracan and Jellyfish so they can steer you in the right direction. I&#039;ll email you the information that I have for Jellyfish. I was there in June. GREAT place. Also, Mayte is dealing with a death in her family at the moment so she may take a while to reply to emails. She is truly amazing and takes each wedding very seriously so don&#039;t worry... she&#039;ll be in touch.&lt;\/p&gt;","Attachments":[],"Id":1799215,"PostDate":1378899173,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div class=\"quote-container\">Quote: <div class=\"quote-block\">Originally Posted by <strong>jeabeeW<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> \u00a0 <p>Hi All! I'm new as well and messaged Mayte recently for wedding info. I have done a\u00a0TON of research on this site as well as others regarding Jellyfish. Each list prices from different years. Could someone please send me the most recent price list? I'd greatly appreciate it! jbrooke.wooddell@gmail.com<\/p> <p>\u00a0<\/p> <p>I also want opinions on\u00a0photographer cost. I have a great photographer from home whom I'm willing to fly out.\u00a0\u00a0Her cost is $1600 + flight and room. She has done a photo shoot with us before. We have mutual friends so she somewhat knows our personalities. We would have her form the entire wedding day, + the pay prior at the resort. I thinks this is a GREAT deal but the fianc\u00a9 is questioning if we can find cheaper in PC. I love Katya Nova's work $2800 (starting) but this is for two photographers I think (her& her hubby). Total cost is relatively the same so here is the issue...<\/p> <p>\u00a0<\/p> <p>-1 photographer vs. 2<\/p> <p>-2photgrathers for 1 day vs. 1 photographer for a few days<\/p> <p>-More pics during the wedding vs. more candid's over the course of the trip.<\/p> <p>\u00a0<\/p> <p>what would you all do???<\/p> <p>\u00a0<\/p> <p>We are also considering adding a videographer. Any suggestions of good\/affordable work? I want the trailer style. Also, I have not reached out to Kayta, if any of you have used her & Rob, plz give me some insight on what is included in the $2800.<\/p> <p>\u00a0<\/p> <p>Last thing, If JF is booked, I'm looking at Huracan Caf\u00a9 as an option. Anyone look into that venue? I have seen pic from one wedding. Sry sooooo many questions. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p> <\/div> <\/div> <p>\u00a0<\/p> <p>\u00a0<\/p> <p>I've booked a photographer in the DR. 2 photographers for the whole day for around $1500. <a href='http:\/\/weddingphotographypuntacana.wordpress.com\/' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/weddingphotog....wordpress.com\/<\/a><\/p> <p>\u00a0<\/p> <p>I met with them in June and I LOVE their energy and their work. They also know a lot about Huracan and Jellyfish so they can steer you in the right direction. I'll email you the information that I have for Jellyfish. I was there in June. GREAT place. Also, Mayte is dealing with a death in her family at the moment so she may take a while to reply to emails. She is truly amazing and takes each wedding very seriously so don't worry... she'll be in touch.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"asha_sips@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1362148036,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-266756.jpeg?_r=0","PhotoWidth":180,"PhotoHeight":239,"PhotoType":"custom"},"FormattedName":"Asha","Id":266756,"Name":"Asha","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73031,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a80710f11d422e7b53e6d4c0106f4ce4","RawContent":"&lt;div class=\"quote-container\"&gt;Quote: &lt;div class=\"quote-block\"&gt;Originally Posted by &lt;strong&gt;jeabeeW&lt;\/strong&gt;&amp;nbsp;&lt;img alt=\"View Post\" src=\"\/img\/forum\/go_quote.gif\" \/&gt;\n &amp;nbsp; &lt;p&gt;Hi All! I&#039;m new as well and messaged Mayte recently for wedding info. I have done a&amp;nbsp;TON of research on this site as well as others regarding Jellyfish. Each list prices from different years. Could someone please send me the most recent price list? I&#039;d greatly appreciate it! jbrooke.wooddell@gmail.com&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;I also want opinions on&amp;nbsp;photographer cost. I have a great photographer from home whom I&#039;m willing to fly out.  Her cost is $1600 + flight and room. She has done a photo shoot with us before. We have mutual friends so she somewhat knows our personalities. We would have her form the entire wedding day, + the pay prior at the resort. I thinks this is a GREAT deal but the fianc\u00a9 is questioning if we can find cheaper in PC. I love Katya Nova&#039;s work $2800 (starting) but this is for two photographers I think (her&amp;amp; her hubby). Total cost is relatively the same so here is the issue...&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;-1 photographer vs. 2&lt;\/p&gt; &lt;p&gt;-2photgrathers for 1 day vs. 1 photographer for a few days&lt;\/p&gt; &lt;p&gt;-More pics during the wedding vs. more candid&#039;s over the course of the trip.&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;what would you all do???&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;We are also considering adding a videographer. Any suggestions of good\/affordable work? I want the trailer style. Also, I have not reached out to Kayta, if any of you have used her &amp;amp; Rob, plz give me some insight on what is included in the $2800.&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;Last thing, If JF is booked, I&#039;m looking at Huracan Caf\u00a9 as an option. Anyone look into that venue? I have seen pic from one wedding. Sry sooooo many questions. :)&lt;\/p&gt; &lt;\/div&gt; &lt;\/div&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;As far as photographer goes, I came across Asia Pimentel here on this forum. Her prices are VERY affordable and I really like her work. She has a facebook page if you want to look her up there or her website asiapimentel.com She is also a team of two and they provide videography if you would like. That is what we are doing plus a trash the dress the next day. Look her up and see what you think&amp;nbsp;&lt;\/p&gt; &lt;p&gt;&lt;img alt=\":mswink:\" src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/msnwink.gif\" \/&gt;&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;I&#039;m not too sure on Huracan. We&#039;re having our wedding on a Thursday at Jellyfish so luckily I didn&#039;t have to worry about the date being taken.&lt;\/p&gt;","Attachments":[],"Id":1800105,"PostDate":1379190991,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div class=\"quote-container\">Quote: <div class=\"quote-block\">Originally Posted by <strong>jeabeeW<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> \u00a0 <p>Hi All! I'm new as well and messaged Mayte recently for wedding info. I have done a\u00a0TON of research on this site as well as others regarding Jellyfish. Each list prices from different years. Could someone please send me the most recent price list? I'd greatly appreciate it! jbrooke.wooddell@gmail.com<\/p> <p>\u00a0<\/p> <p>I also want opinions on\u00a0photographer cost. I have a great photographer from home whom I'm willing to fly out.\u00a0\u00a0Her cost is $1600 + flight and room. She has done a photo shoot with us before. We have mutual friends so she somewhat knows our personalities. We would have her form the entire wedding day, + the pay prior at the resort. I thinks this is a GREAT deal but the fianc\u00a9 is questioning if we can find cheaper in PC. I love Katya Nova's work $2800 (starting) but this is for two photographers I think (her& her hubby). Total cost is relatively the same so here is the issue...<\/p> <p>\u00a0<\/p> <p>-1 photographer vs. 2<\/p> <p>-2photgrathers for 1 day vs. 1 photographer for a few days<\/p> <p>-More pics during the wedding vs. more candid's over the course of the trip.<\/p> <p>\u00a0<\/p> <p>what would you all do???<\/p> <p>\u00a0<\/p> <p>We are also considering adding a videographer. Any suggestions of good\/affordable work? I want the trailer style. Also, I have not reached out to Kayta, if any of you have used her & Rob, plz give me some insight on what is included in the $2800.<\/p> <p>\u00a0<\/p> <p>Last thing, If JF is booked, I'm looking at Huracan Caf\u00a9 as an option. Anyone look into that venue? I have seen pic from one wedding. Sry sooooo many questions. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p> <\/div> <\/div> <p>\u00a0<\/p> <p>As far as photographer goes, I came across Asia Pimentel here on this forum. Her prices are VERY affordable and I really like her work. She has a facebook page if you want to look her up there or her website asiapimentel.com She is also a team of two and they provide videography if you would like. That is what we are doing plus a trash the dress the next day. Look her up and see what you think\u00a0<\/p> <p><span rel='lightbox'><img class='bbc_img' alt=\":mswink:\" src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/msnwink.gif\" \/><\/span><\/p> <p>\u00a0<\/p> <p>I'm not too sure on Huracan. We're having our wedding on a Thursday at Jellyfish so luckily I didn't have to worry about the date being taken.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"madeline152003@yahoo.com","IpAddress":"71.100.18.37","GroupId":40,"GroupName":"Jr. Member","JoinDate":1351202964,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-261785.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Mady28","Id":261785,"Name":"Mady28","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73031,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a05916b9c581363610ed37f7daf4465d","RawContent":"&lt;div class=\"quote-container\"&gt;Quote: &lt;div class=\"quote-block\"&gt;Originally Posted by &lt;strong&gt;cmingalone&lt;\/strong&gt;&amp;nbsp;&lt;img alt=\"View Post\" src=\"\/img\/forum\/go_quote.gif\" \/&gt;\n &amp;nbsp; &lt;p&gt;Here you go-hope this helps!&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;span huddler_attributes=\"{&amp;quot;plugin&amp;quot;:&amp;quot;attachment&amp;quot;,&amp;quot;params&amp;quot;:{&amp;quot;id&amp;quot;:&amp;quot;13848&amp;quot;,&amp;quot;name&amp;quot;:&amp;quot;Appetizers list- Jellyfish.doc&amp;quot;,&amp;quot;description&amp;quot;:&amp;quot;&amp;quot;,&amp;quot;size&amp;quot;:&amp;quot;21&amp;quot;,&amp;quot;type&amp;quot;:&amp;quot;doc&amp;quot;}}\" huddler_plugin=\"attachment\"&gt;&amp;nbsp;&lt;\/span&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;span huddler_attributes=\"{&amp;quot;plugin&amp;quot;:&amp;quot;attachment&amp;quot;,&amp;quot;params&amp;quot;:{&amp;quot;id&amp;quot;:&amp;quot;13849&amp;quot;,&amp;quot;name&amp;quot;:&amp;quot;Open Bar- Jellyfish.xls&amp;quot;,&amp;quot;description&amp;quot;:&amp;quot;&amp;quot;,&amp;quot;size&amp;quot;:&amp;quot;11&amp;quot;,&amp;quot;type&amp;quot;:&amp;quot;xls&amp;quot;}}\" huddler_plugin=\"attachment\"&gt;&amp;nbsp;&lt;\/span&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;span huddler_attributes=\"{&amp;quot;plugin&amp;quot;:&amp;quot;attachment&amp;quot;,&amp;quot;params&amp;quot;:{&amp;quot;id&amp;quot;:&amp;quot;13850&amp;quot;,&amp;quot;name&amp;quot;:&amp;quot;Menu- Jellyfish.xls&amp;quot;,&amp;quot;description&amp;quot;:&amp;quot;&amp;quot;,&amp;quot;size&amp;quot;:&amp;quot;24&amp;quot;,&amp;quot;type&amp;quot;:&amp;quot;xls&amp;quot;}}\" huddler_plugin=\"attachment\"&gt;&amp;nbsp;&lt;\/span&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;span huddler_attributes=\"{&amp;quot;plugin&amp;quot;:&amp;quot;attachment&amp;quot;,&amp;quot;params&amp;quot;:{&amp;quot;id&amp;quot;:&amp;quot;13851&amp;quot;,&amp;quot;name&amp;quot;:&amp;quot;Wedding Services- Jellyfish.doc&amp;quot;,&amp;quot;description&amp;quot;:&amp;quot;&amp;quot;,&amp;quot;size&amp;quot;:&amp;quot;30&amp;quot;,&amp;quot;type&amp;quot;:&amp;quot;doc&amp;quot;}}\" huddler_plugin=\"attachment\"&gt;&amp;nbsp;&lt;\/span&gt;&lt;\/div&gt; &lt;\/div&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;Hello :)\n Do you mind emailing me the appetizer price list? I have all the other menu and price lists I guess she forgot to attach it when she emailed me.&amp;nbsp;&lt;\/p&gt; &lt;p&gt;I would really appreciate it!&lt;\/p&gt; &lt;p&gt;monica.azad@gmail.com&lt;\/p&gt;","Attachments":[],"Id":1803081,"PostDate":1380241616,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div class=\"quote-container\">Quote: <div class=\"quote-block\">Originally Posted by <strong>cmingalone<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> \u00a0 <p>Here you go-hope this helps!<\/p> <p>\u00a0<\/p> <span huddler_attributes=\"{\"plugin\":\"attachment\",\"params\":{\"id\":\"13848\",\"name\":\"Appetizers list- Jellyfish.doc\",\"description\":\"\",\"size\":\"21\",\"type\":\"doc\"}}\" huddler_plugin=\"attachment\">\u00a0<\/span> <p>\u00a0<\/p> <p>\u00a0<\/p> <p>\u00a0<\/p> <span huddler_attributes=\"{\"plugin\":\"attachment\",\"params\":{\"id\":\"13849\",\"name\":\"Open Bar- Jellyfish.xls\",\"description\":\"\",\"size\":\"11\",\"type\":\"xls\"}}\" huddler_plugin=\"attachment\">\u00a0<\/span> <p>\u00a0<\/p> <p>\u00a0<\/p> <p>\u00a0<\/p> <span huddler_attributes=\"{\"plugin\":\"attachment\",\"params\":{\"id\":\"13850\",\"name\":\"Menu- Jellyfish.xls\",\"description\":\"\",\"size\":\"24\",\"type\":\"xls\"}}\" huddler_plugin=\"attachment\">\u00a0<\/span> <p>\u00a0<\/p> <p>\u00a0<\/p> <p>\u00a0<\/p> <span huddler_attributes=\"{\"plugin\":\"attachment\",\"params\":{\"id\":\"13851\",\"name\":\"Wedding Services- Jellyfish.doc\",\"description\":\"\",\"size\":\"30\",\"type\":\"doc\"}}\" huddler_plugin=\"attachment\">\u00a0<\/span><\/div> <\/div> <p>\u00a0<\/p> <p>Hello <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br \/> Do you mind emailing me the appetizer price list? I have all the other menu and price lists I guess she forgot to attach it when she emailed me.\u00a0<\/p> <p>I would really appreciate it!<\/p> <p>monica.azad@gmail.com<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sadafak86@gmail.com","IpAddress":"135.23.176.66","GroupId":39,"GroupName":"Newbie","JoinDate":1378641576,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-273295.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"sadafak","Id":273295,"Name":"sadafak","IsOnline":false}}],"Pages":{"TotalItems":99,"TotalPages":10,"CurrentPage":40,"NextPage":50,"PreviousPage":30,"LastPage":90},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
