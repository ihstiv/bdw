{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":5,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":135,"MovedTo":null,"MovedOn":0,"FirstPostId":1901500,"Rating":0,"RatingHits":0,"Starter":{"Id":282051,"Name":"Soon2bmzbrooks","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1438203445,"LastPoster":{"Id":273789,"Name":"cora4600","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-273789.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":115,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":23,"Preview":{"Id":1901500,"PostDate":1438203445,"PostContent":"I'm looking to hire a DJ for my wedding and reception in Montego Bay. I'm thinking that outside D...","Author":{"Signature":"","Email":"soon2bmzbrooks@gmail.com","IpAddress":"66.87.82.62","GroupId":39,"GroupName":"Newbie","JoinDate":1423516300,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Soon2bmzbrooks","Id":282051,"Name":"Soon2bmzbrooks","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"73.172.239.210","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79443,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7d9c1518eb834acfeb498ad80adf97b8","RawContent":"I&#039;m looking to hire a DJ for my wedding and reception in Montego Bay. I&#039;m thinking that outside DJs might save me some money.  Help please. Any recommendations or suggestions??","Attachments":[],"Id":1901500,"PostDate":1438203445,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I'm looking to hire a DJ for my wedding and reception in Montego Bay. I'm thinking that outside DJs might save me some money.  Help please. Any recommendations or suggestions??\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"soon2bmzbrooks@gmail.com","IpAddress":"66.87.82.62","GroupId":39,"GroupName":"Newbie","JoinDate":1423516300,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Soon2bmzbrooks","Id":282051,"Name":"Soon2bmzbrooks","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"159.53.174.144","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79443,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7148ce77a11a875ef2dabd9ac926168e","RawContent":"&lt;p&gt;Hi @[member=\"Soon2bmzbrooks\"] - I got married last month and we used \"DJ Dutch\" AKA Sheldon at &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/jamaicaweddingdj.com\/&#039;&gt;http:\/\/jamaicaweddingdj.com\/&lt;\/a&gt;They are the preferred DJ for our resort and the price was I think $190 per hour. The resort was going to charge us $150 per hour to rent the sound system (to play an iPod) so it was a no brainer to just do the DJ. Sheldon was really great and we had several conversations with him prior to arrival in Jamaica. During our reception he checked in with us several times to make sure we were okay and happy with everything - which was more than our wedding coordinators did! &lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;They offer other services like tent rentals and lighting as well. But I would definitely recommend them for DJ services!&lt;\/p&gt;","Attachments":[],"Id":1901521,"PostDate":1438207666,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi @<a hovercard-ref=\"member\" hovercard-id=\"282051\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/282051-soon2bmzbrooks\/' title='Member profile'><span itemprop=\"name\">Soon2bmzbrooks<\/span><\/a> - I got married last month and we used \"DJ Dutch\" AKA Sheldon at <a href='http:\/\/jamaicaweddingdj.com\/' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/jamaicaweddingdj.com\/<\/a>They are the preferred DJ for our resort and the price was I think $190 per hour. The resort was going to charge us $150 per hour to rent the sound system (to play an iPod) so it was a no brainer to just do the DJ. Sheldon was really great and we had several conversations with him prior to arrival in Jamaica. During our reception he checked in with us several times to make sure we were okay and happy with everything - which was more than our wedding coordinators did! <\/p>\n<p>\u00a0<\/p>\n<p>They offer other services like tent rentals and lighting as well. But I would definitely recommend them for DJ services!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rebecca.shaffer@gmail.com","IpAddress":"159.53.174.144","GroupId":40,"GroupName":"Jr. Member","JoinDate":1403119687,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"beckys98","Id":278581,"Name":"beckys98","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.196.44.37","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79443,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"67375fb2c432fb44c055165b4d40b0ae","RawContent":"Your wedding is a few days before mine! I heard about Kevan Stewart on this site. Many brides raved that his prices were good and he kept the party going. I&#039;ve seen his pricing and think it&#039;s very fair compared to the resort vendors. I got a quote through his website:  &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/jamaicaweddingdj.com&#039;&gt;http:\/\/jamaicaweddingdj.com&lt;\/a&gt;\n\n\nGood luck!","Attachments":[],"Id":1901528,"PostDate":1438211966,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Your wedding is a few days before mine! I heard about Kevan Stewart on this site. Many brides raved that his prices were good and he kept the party going. I've seen his pricing and think it's very fair compared to the resort vendors. I got a quote through his website:  <a href='http:\/\/jamaicaweddingdj.com' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/jamaicaweddingdj.com<\/a><br><br>\nGood luck!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sandra_co8@icloud.com","IpAddress":"50.162.188.193","GroupId":39,"GroupName":"Newbie","JoinDate":1421710870,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Sandraco8","Id":281796,"Name":"Sandraco8","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"159.53.46.143","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79443,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5369cefbd985200e33db32c67cc03654","RawContent":"@[member=\"Soon2bmzbrooks\"] This is the same company! Sheldon is Kevan&#039;s associate!\n[quote name=\"Sandraco8\" post=\"1901528\" timestamp=\"1438208366\"]\nYour wedding is a few days before mine! I heard about Kevan Stewart on this site. Many brides raved that his prices were good and he kept the party going. I&#039;ve seen his pricing and think it&#039;s very fair compared to the resort vendors. I got a quote through his website: [url=\"http:\/\/jamaicaweddingdj.com\"]http:\/\/jamaicaweddingdj.com[\/url]\n\nGood luck![\/quote]","Attachments":[],"Id":1901533,"PostDate":1438214603,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"282051\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/282051-soon2bmzbrooks\/' title='Member profile'><span itemprop=\"name\">Soon2bmzbrooks<\/span><\/a> This is the same company! Sheldon is Kevan's associate!<\/p>\n<p>\u00a0<\/p>\n<p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Sandraco8, on 29 July 2015 - 03:19 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Your wedding is a few days before mine! I heard about Kevan Stewart on this site. Many brides raved that his prices were good and he kept the party going. I've seen his pricing and think it's very fair compared to the resort vendors. I got a quote through his website: <a href='http:\/\/jamaicaweddingdj.com' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/jamaicaweddingdj.com<\/a><br><br>\nGood luck!<\/p>\n<\/div>\n<\/div><\/div>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rebecca.shaffer@gmail.com","IpAddress":"159.53.174.144","GroupId":40,"GroupName":"Jr. Member","JoinDate":1403119687,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"beckys98","Id":278581,"Name":"beckys98","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"205.173.217.10","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79443,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7d25c9e8d24c16294aaec663dd517226","RawContent":"&lt;p&gt;DJ Blu was hands down the BEST wedding DJ I have ever experienced, and I&#039;m talking State weddings or destination weddings. I would highly recommend him.&lt;\/p&gt;","Attachments":[],"Id":1902091,"PostDate":1438970601,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>DJ Blu was hands down the BEST wedding DJ I have ever experienced, and I'm talking State weddings or destination weddings. I would highly recommend him.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cora4600@yahoo.com","IpAddress":"205.173.217.10","GroupId":39,"GroupName":"Newbie","JoinDate":1380213689,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-273789.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":115,"PhotoType":"custom"},"FormattedName":"cora4600","Id":273789,"Name":"cora4600","IsOnline":false}}],"Id":"79443","Title":"Dj Montego Bay Jamaica","LastPostDate":1438970601},"Pages":{"TotalItems":5,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
