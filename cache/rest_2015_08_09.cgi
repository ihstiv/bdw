{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":3,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":121,"MovedTo":null,"MovedOn":0,"FirstPostId":1901895,"Rating":0,"RatingHits":0,"Starter":{"Id":284292,"Name":"STBMrsPowell","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1438783673,"LastPoster":{"Id":230711,"Name":"Moments That Matter","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1901895,"PostDate":1438783673,"PostContent":"Hi all! \u00a0 My fianc\u00e9 and I are planning to wed in Jamaica in June 2016.\u00a0 Currently, we are conside...","Author":{"Signature":"","Email":"shay_tt03@hotmail.com","IpAddress":"152.132.9.140","GroupId":39,"GroupName":"Newbie","JoinDate":1438782799,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"STBMrsPowell","Id":284292,"Name":"STBMrsPowell","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"152.132.9.140","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79469,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"59822eb0dd2f237586b78a5216c79d79","RawContent":"&lt;p&gt;Hi all!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;My fianc\u00e9 and I are planning to wed in Jamaica in June 2016.&amp;nbsp; Currently, we are considering the Royalton White Sands for our location.&amp;nbsp; This resort was recommended by the travel agency we&#039;re using and I&#039;ve looked at numerous reviews and am still unsure about making this the spot for our nuptials.&amp;nbsp; Any feedback, positive or negative, is greatly appreciated.&amp;nbsp; One specific question I have is has anyone had the fireworks during their ceremony?&amp;nbsp; Also, I would love to be directed to actual real photos of the venue spots.&amp;nbsp; Was the process for planning easy and how customizable (detailed) were the decorations?&amp;nbsp; Thanks in advance.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Signed&lt;\/p&gt;\n&lt;p&gt;Soon2BeMrsPowell&lt;\/p&gt;","Attachments":[],"Id":1901895,"PostDate":1438783673,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi all!<\/p>\n<p>\u00a0<\/p>\n<p>My fianc\u00e9 and I are planning to wed in Jamaica in June 2016.\u00a0 Currently, we are considering the Royalton White Sands for our location.\u00a0 This resort was recommended by the travel agency we're using and I've looked at numerous reviews and am still unsure about making this the spot for our nuptials.\u00a0 Any feedback, positive or negative, is greatly appreciated.\u00a0 One specific question I have is has anyone had the fireworks during their ceremony?\u00a0 Also, I would love to be directed to actual real photos of the venue spots.\u00a0 Was the process for planning easy and how customizable (detailed) were the decorations?\u00a0 Thanks in advance.<\/p>\n<p>\u00a0<\/p>\n<p>Signed<\/p>\n<p>Soon2BeMrsPowell<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"shay_tt03@hotmail.com","IpAddress":"152.132.9.140","GroupId":39,"GroupName":"Newbie","JoinDate":1438782799,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"STBMrsPowell","Id":284292,"Name":"STBMrsPowell","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"208.87.237.201","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79469,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bb75e37dc3111963c36af86bd38f9c4f","RawContent":"&lt;p&gt;Hi and congrats on your upcoming destination wedding! There is a thread here specific to Royalton White Sands that would be very useful and I know they&#039;ve posted photos. It&#039;s a pretty new resort and I remember the thread was a bit slow in getting started but now I think there have been a couple of brides that have been there. I can&#039;t do links right now but if you just do a search up top the forum should come up for you to go through. As well definitely go through the resort and vendor review parts of the site to see what past brides have said about their experience.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Happy planning!&lt;\/p&gt;","Attachments":[],"Id":1901921,"PostDate":1438794926,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi and congrats on your upcoming destination wedding! There is a thread here specific to Royalton White Sands that would be very useful and I know they've posted photos. It's a pretty new resort and I remember the thread was a bit slow in getting started but now I think there have been a couple of brides that have been there. I can't do links right now but if you just do a search up top the forum should come up for you to go through. As well definitely go through the resort and vendor review parts of the site to see what past brides have said about their experience.<\/p>\n<p>\u00a0<\/p>\n<p>Happy planning!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283458999,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"208.114.165.129","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79469,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"da0da3893033a5efcc69a03e5420d95e","RawContent":"&lt;p&gt;Hi STBMrsPowell, welcome to our forum community and Congrats on your Jamaican wedding next June!!! You&#039;ve come to the right place for lots of great info, advice suggestions and support from all the resources here, so well done on getting a great start already :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Hope you find all the answers you&#039;re looking for to help with your planning decisions - cheers!!! team MTM :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;....here are some magical beach wedding moments that matter for even more inspiration - enjoy :) ....from our &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xpt1\/t31.0-8\/11845102_10153513729759487_3729843888491343933_o.jpg&#039;&gt;Cover Photo Album: &lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xpt1\/t31.0-8\/11845102_10153513729759487_3729843888491343933_o.jpg\" alt=\"11845102_10153513729759487_3729843888491\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xpf1\/v\/t1.0-9\/11012987_10153448644369487_1341147305681527827_n.jpg?oh=66e97c84e882419253e049d475726a96&amp;amp;oe=563FAAE9\" alt=\"11012987_10153448644369487_1341147305681\"&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xta1\/t31.0-8\/10608633_10152626440284487_6175377033029663791_o.jpg\" alt=\"10608633_10152626440284487_6175377033029\"&gt;&lt;\/p&gt;","Attachments":[],"Id":1902134,"PostDate":1438997874,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi STBMrsPowell, welcome to our forum community and Congrats on your Jamaican wedding next June!!! You've come to the right place for lots of great info, advice suggestions and support from all the resources here, so well done on getting a great start already <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Hope you find all the answers you're looking for to help with your planning decisions - cheers!!! team MTM <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>....here are some magical beach wedding moments that matter for even more inspiration - enjoy <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> ....from our <a href='https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xpt1\/t31.0-8\/11845102_10153513729759487_3729843888491343933_o.jpg' class='bbc_url' title='External link' rel='nofollow external'>Cover Photo Album: <\/a><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xpt1\/t31.0-8\/11845102_10153513729759487_3729843888491343933_o.jpg\" alt=\"11845102_10153513729759487_3729843888491\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xpf1\/v\/t1.0-9\/11012987_10153448644369487_1341147305681527827_n.jpg?oh=66e97c84e882419253e049d475726a96&oe=563FAAE9\" alt=\"11012987_10153448644369487_1341147305681\"><\/span><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xta1\/t31.0-8\/10608633_10152626440284487_6175377033029663791_o.jpg\" alt=\"10608633_10152626440284487_6175377033029\"><\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280210660,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}}],"Id":"79469","Title":"Wedding Reviews On The Royalton White Sands","LastPostDate":1438997874},"Pages":{"TotalItems":3,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
