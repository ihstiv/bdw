"&lt;p&gt; April 2014 Now Larimar wedding date set :-)&lt;\/p&gt;","Attachments":[],"Id":1757513,"PostDate":1368508055,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> April 2014 Now Larimar wedding date set :-)<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"amyevans_5@hotmail.com","IpAddress":"84.93.51.41","GroupId":39,"GroupName":"Newbie","JoinDate":1367311845,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-269144.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"AMYEVANS","Id":269144,"Name":"AMYEVANS","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bb13682008add6467979abfa879e206e","RawContent":"&lt;p&gt; &lt;span style=\"color:#800080;\"&gt;Hi everyone, Congratulation to all the Brides!&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"color:#800080;\"&gt;My Fiance and I are 98% sure we would like to have our Destination Wedding at No Larimar Punta Cana.&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"color:#800080;\"&gt;His cousin just got married on April 27th, 2013 at the Now Saphire in Mexico and they couldn&#039;t say enough wonderful things about everything.&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"color:#800080;\"&gt;We are planning on getting married on May 3rd, 2014!!! I am sooo excited!!!&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1757849,"PostDate":1368571738,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> <span  style=\"color:#800080\">Hi everyone, Congratulation to all the Brides!<\/span><\/p> <p> <span  style=\"color:#800080\">My Fiance and I are 98% sure we would like to have our Destination Wedding at No Larimar Punta Cana.<\/span><\/p> <p> <span  style=\"color:#800080\">His cousin just got married on April 27th, 2013 at the Now Saphire in Mexico and they couldn't say enough wonderful things about everything.<\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"color:#800080\">We are planning on getting married on May 3rd, 2014!!! I am sooo excited!!!<\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mary_mac0203@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1368571281,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-269591.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Marbear0503","Id":269591,"Name":"Marbear0503","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"23e36cf42d0f22ffa09fbafd9c309a2e","RawContent":"Congrats amy! Im on the 9th of april, what about you?","Attachments":[],"Id":1758190,"PostDate":1368635384,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Congrats amy! Im on the 9th of april, what about you?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mjouellette0@hotmail.com","IpAddress":"174.118.194.63","GroupId":39,"GroupName":"Newbie","JoinDate":1361221826,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-266253.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"MJ Ouellette","Id":266253,"Name":"MJ Ouellette","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f0919b8c284b013ab7a3f821c3a48569","RawContent":"mine is set for the 8th - seems so far away but I know it&#039;ll come round quick :-)) congrats MJ x","Attachments":[],"Id":1758211,"PostDate":1368641163,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                mine is set for the 8th - seems so far away but I know it'll come round quick :-)) congrats MJ x\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"amyevans_5@hotmail.com","IpAddress":"84.93.51.41","GroupId":39,"GroupName":"Newbie","JoinDate":1367311845,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-269144.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"AMYEVANS","Id":269144,"Name":"AMYEVANS","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7ea1f2b3541196aa8727872063ea1e15","RawContent":"just got confirmation through April 8th at 2pm! did you realise you have to pay extra for a gazebo. - for some reason I thought that would be included :-\/","Attachments":[],"Id":1763733,"PostDate":1370245292,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                just got confirmation through April 8th at 2pm! did you realise you have to pay extra for a gazebo. - for some reason I thought that would be included :-\/\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"amyevans_5@hotmail.com","IpAddress":"84.93.51.41","GroupId":39,"GroupName":"Newbie","JoinDate":1367311845,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-269144.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"AMYEVANS","Id":269144,"Name":"AMYEVANS","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2172d08a96d8f36aeaaad3acb5efd9a7","RawContent":"I think we will get married at the main fountain, its 1500$ extra automatically and includes the gazebo!! but we are not 100% just yet!! A destination wedding can get quite expensive, more then i anticipated!!","Attachments":[],"Id":1763853,"PostDate":1370263481,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I think we will get married at the main fountain, its 1500$ extra automatically and includes the gazebo!! but we are not 100% just yet!! A destination wedding can get quite expensive, more then i anticipated!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mjouellette0@hotmail.com","IpAddress":"174.118.194.63","GroupId":39,"GroupName":"Newbie","JoinDate":1361221826,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-266253.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"MJ Ouellette","Id":266253,"Name":"MJ Ouellette","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"dfa17b80abee9bd6a94696d95f0f9af1","RawContent":"&lt;p&gt; Congrats Amy, I was under the impression the gazebo was included in the Divine package. what package did you book? and does anyone have any idea how much fabric one would need for a chair sash, and would I have to bring enough for the ceremony and reception or will they move them for you?&lt;\/p&gt;","Attachments":[],"Id":1763854,"PostDate":1370263635,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Congrats Amy, I was under the impression the gazebo was included in the Divine package. what package did you book? and does anyone have any idea how much fabric one would need for a chair sash, and would I have to bring enough for the ceremony and reception or will they move them for you?<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"amanda.kemp@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1365690404,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-268451.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"amanda15012014","Id":268451,"Name":"amanda15012014","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c25820472a083a3a91ba20daeec5e4f1","RawContent":"&lt;p&gt; I have the eternity package - so thats probably why its not included... might be worth me just upgrading to divine then i think x&lt;\/p&gt;","Attachments":[],"Id":1764154,"PostDate":1370326493,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I have the eternity package - so thats probably why its not included... might be worth me just upgrading to divine then i think x<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"amyevans_5@hotmail.com","IpAddress":"84.93.51.41","GroupId":39,"GroupName":"Newbie","JoinDate":1367311845,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-269144.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"AMYEVANS","Id":269144,"Name":"AMYEVANS","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"b7f644268237e57784d4c961b184644c","RawContent":"&lt;p&gt; Hi again Amy...do you have Facebook? My wedding albums are public on FB so you can view them...I have a ton on there you can view....NOt all of them but about 400 +&lt;\/p&gt;","Attachments":[],"Id":1764715,"PostDate":1370438763,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hi again Amy...do you have Facebook? My wedding albums are public on FB so you can view them...I have a ton on there you can view....NOt all of them but about 400 +<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"opa1papi@aol.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1354825217,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-263022.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Paolalindsay","Id":263022,"Name":"Paolalindsay","IsOnline":false}}],"Pages":{"TotalItems":460,"TotalPages":46,"CurrentPage":30,"NextPage":40,"PreviousPage":20,"LastPage":450},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
