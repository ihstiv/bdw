4.217","GroupId":39,"GroupName":"Newbie","JoinDate":1423558366,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Cablelove11","Id":282063,"Name":"Cablelove11","IsOnline":false}},"Posts":[],"Id":"78776","Title":"Mom Not On Board","LastPostDate":1423750036},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":10,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":1162,"MovedTo":null,"MovedOn":0,"FirstPostId":1884059,"Rating":0,"RatingHits":0,"Starter":{"Id":278186,"Name":"helenk","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278186.jpg?_r=1417419505","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"IsOnline":false},"StartDate":1422187043,"LastPoster":{"Id":282063,"Name":"Cablelove11","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":13,"Preview":{"Id":1884059,"PostDate":1422187043,"PostContent":"So I am really starting to worry about costs......the past year I have been the only one working...","Author":{"Signature":"","Email":"hkorkovilis@gmail.com","IpAddress":"162.238.70.23","GroupId":40,"GroupName":"Jr. Member","JoinDate":1401609292,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278186.jpg?_r=1417419505","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"helenk","Id":278186,"Name":"helenk","IsOnline":false}},"Posts":[],"Id":"78677","Title":"Freaking Out About Costs!","LastPostDate":1423