{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":2,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":178,"MovedTo":null,"MovedOn":0,"FirstPostId":1914218,"Rating":0,"RatingHits":0,"Starter":{"Id":285764,"Name":"tpenner","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-285764.jpg?_r=1451960071","PhotoWidth":200,"PhotoHeight":122,"PhotoType":"custom"},"IsOnline":false},"StartDate":1465255938,"LastPoster":{"Id":232000,"Name":"acw271011","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":98,"Preview":{"Id":1914218,"PostDate":1465255938,"PostContent":"I have a brand new with tags ivory wedding gown.  It is Sophia Tolli \"Jillian\".  Absolutely stunn...","Author":{"Signature":"","Email":"tpenner@ualberta.ca","IpAddress":"68.150.177.36","GroupId":3,"GroupName":"Member","JoinDate":1451942069,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-285764.jpg?_r=1451960071","PhotoWidth":200,"PhotoHeight":122,"PhotoType":"custom"},"FormattedName":"tpenner","Id":285764,"Name":"tpenner","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.151.82.249","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80124,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5f9f4ca4119de5588503cf16f7b0ab0e","RawContent":"I have a brand new with tags ivory wedding gown.  It is Sophia Tolli \"Jillian\".  Absolutely stunning fit and flare gown that flatters many shapes and sizes.\n\n\nThe store where I bought this convinced me to buy bigger than I needed to be safe and now I need major alterations.  I have since found this dress in a smaller size that works which is why I&#039;m selling get this one.  \n\n\nPaid 1875 Canadian and looking to get 1600. Located in Edmonton, AB.  Willing to split the cost of shipping\n\n&lt;img src=\"http:\/\/uploads.tapatalk-cdn.com\/20160607\/b6a4cf5ecbc5360519a98d55c36bf7bc.jpg\" alt=\"b6a4cf5ecbc5360519a98d55c36bf7bc.jpg\"&gt;\n\n\nSent from my SM-G930W8 using Tapatalk","Attachments":[],"Id":1914218,"PostDate":1465255938,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I have a brand new with tags ivory wedding gown.  It is Sophia Tolli \"Jillian\".  Absolutely stunning fit and flare gown that flatters many shapes and sizes.<br><br>\nThe store where I bought this convinced me to buy bigger than I needed to be safe and now I need major alterations.  I have since found this dress in a smaller size that works which is why I'm selling get this one.  <br><br>\nPaid 1875 Canadian and looking to get 1600. Located in Edmonton, AB.  Willing to split the cost of shipping<br><br><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/uploads.tapatalk-cdn.com\/20160607\/b6a4cf5ecbc5360519a98d55c36bf7bc.jpg\" alt=\"b6a4cf5ecbc5360519a98d55c36bf7bc.jpg\"><\/span><br><br>\nSent from my SM-G930W8 using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tpenner@ualberta.ca","IpAddress":"68.150.177.36","GroupId":3,"GroupName":"Member","JoinDate":1451942069,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-285764.jpg?_r=1451960071","PhotoWidth":200,"PhotoHeight":122,"PhotoType":"custom"},"FormattedName":"tpenner","Id":285764,"Name":"tpenner","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"158.106.64.94","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80124,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b4bffce240dca06728f12d7813510bec","RawContent":"&lt;p&gt;Very pretty! Good luck with the sale!&lt;\/p&gt;","Attachments":[],"Id":1914231,"PostDate":1465301858,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Very pretty! Good luck with the sale!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#ff0099;\"><em>I said \"yes\" again to the love of my life at Grand Coral Beach Club, Playa del Carmen, Mexico on our 4th anniversary - October 20, 2015<\/em><\/span><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/'><span style=\"color:#ff0099;\"><em>http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/<\/em><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283440999,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}}],"Id":"80124","Title":"Sophia Tolli \"jillian\" Size 20","LastPostDate":1465301858},"Pages":{"TotalItems":2,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
