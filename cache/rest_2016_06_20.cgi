{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":1,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":347,"MovedTo":null,"MovedOn":0,"FirstPostId":1913666,"Rating":0,"RatingHits":0,"Starter":{"Id":281283,"Name":"vancouverpetunia","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281283.jpg?_r=1428779369","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"StartDate":1463009497,"LastPoster":{"Id":281283,"Name":"vancouverpetunia","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281283.jpg?_r=1428779369","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":98,"Preview":{"Id":1913666,"PostDate":1463009497,"PostContent":"Never worn, not altered, size 14 short beaded wedding dress from David's Bridal. Fits 8-12 street...","Author":{"Signature":"<p>- Erin<\/p>\n<p>\u00a0<\/p>\n<p>My planning thread:\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79068-vancouverpetunia-now-sapphire-april-7-2016\/?p=1893268'>http:\/\/www.bestdestinationwedding.com\/topic\/79068-vancouverpetunia-now-sapphire-april-7-2016\/?p=1893268<\/a><\/p>\n<p>\u00a0<\/p>\n<p>My Now Sapphire review:\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/5487-now-sapphire-riviera-cancun\/'>http:\/\/www.bestdestinationwedding.com\/reviews\/r\/5487-now-sapphire-riviera-cancun\/<\/a>","Email":"ekjzwedding@gmail.com","IpAddress":"24.85.127.174","GroupId":3,"GroupName":"Member","JoinDate":1417431445,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281283.jpg?_r=1428779369","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"vancouverpetunia","Id":281283,"Name":"vancouverpetunia","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.85.127.174","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80087,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"858ed07ecd4d58f78f3fef0b6f8a137f","RawContent":"&lt;p&gt;&lt;span style=\"color:rgb(29,33,41);font-family:helvetica, arial, sans-serif;\"&gt;Never worn, not altered, size 14 short beaded wedding dress from David&#039;s Bridal. Fits 8-12 street size, possibly with alterations for smaller sizes. Stretchy\/forgiving &amp;amp; comfortable.&amp;nbsp;&lt;\/span&gt;&lt;span style=\"color:rgb(29,33,41);font-family:helvetica, arial, sans-serif;\"&gt;Perfect for reception, Vegas wedding, engagement party, black &amp;amp; white cocktail party, etc.&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"color:rgb(29,33,41);font-family:helvetica, arial, sans-serif;\"&gt;Original price $323 CAD online (see screenshot), paid $180 CAD + tax (tags still on). Asking $100 CAD.&amp;nbsp;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span&gt;I&#039;m in Vancouver, BC, Canada. If you are local we can arrange to meet for you to try it on. Buyer pays shipping if required.&amp;nbsp;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1913666,"PostDate":1463009497,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><span  style=\"color:rgb(29,33,41);font-family:helvetica, arial, sans-serif\">Never worn, not altered, size 14 short beaded wedding dress from David's Bridal. Fits 8-12 street size, possibly with alterations for smaller sizes. Stretchy\/forgiving & comfortable.\u00a0<\/span><span  style=\"color:rgb(29,33,41);font-family:helvetica, arial, sans-serif\">Perfect for reception, Vegas wedding, engagement party, black & white cocktail party, etc.<\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"color:rgb(29,33,41);font-family:helvetica, arial, sans-serif\">Original price $323 CAD online (see screenshot), paid $180 CAD + tax (tags still on). Asking $100 CAD.\u00a0<\/span><\/p>\n<p>\u00a0<\/p>\n<p><span>I'm in Vancouver, BC, Canada. If you are local we can arrange to meet for you to try it on. Buyer pays shipping if required.\u00a0<\/span><\/p>\n<p>\u00a0<\/p>\n<p><a class='resized_img' rel='lightbox[1913666]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2016\/post-281283-0-89885600-1463027324.png\" title=\"IMG_1313.PNG - Size: 329.58KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2016\/post-281283-0-89885600-1463027324.png\" class='bbc_img linked-image' alt=\"IMG_1313.PNG\" \/><\/a>\n\n<\/p>\n<p>\u00a0<\/p>\n<p><a class='resized_img' rel='lightbox[1913666]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2016\/post-281283-0-71834500-1463027316.png\" title=\"IMG_1314.PNG - Size: 317.71KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2016\/post-281283-0-71834500-1463027316.png\" class='bbc_img linked-image' alt=\"IMG_1314.PNG\" \/><\/a>\n\n<\/p>\n<p>\u00a0<\/p>\n<p><a class='resized_img' rel='lightbox[1913666]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2016\/post-281283-0-96897700-1463027307.png\" title=\"IMG_1359.PNG - Size: 212.79KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2016\/post-281283-0-96897700-1463027307.png\" class='bbc_img linked-image' alt=\"IMG_1359.PNG\" \/><\/a>\n\n<\/p>\n<p>\u00a0<\/p>\n<p><a class='resized_img' rel='lightbox[1913666]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2016\/post-281283-0-26823500-1463027413.jpg\" title=\"FullSizeRender (13).jpg - Size: 51.74KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2016\/post-281283-0-26823500-1463027413.jpg\" class='bbc_img linked-image' alt=\"FullSizeRender (13).jpg\" \/><\/a>\n\n<\/p>\n<p>\u00a0<\/p>\n<p><a class='resized_img' rel='lightbox[1913666]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2016\/post-281283-0-54054300-1463027327.png\" title=\"IMG_1309.PNG - Size: 104.75KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2016\/post-281283-0-54054300-1463027327.png\" class='bbc_img linked-image' alt=\"IMG_1309.PNG\" \/><\/a>\n\n<\/p>\n<p>\u00a0<\/p>\n<p><a class='resized_img' rel='lightbox[1913666]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2016\/post-281283-0-18125900-1463027392.jpg\" title=\"IMG_2909.JPG - Size: 63.68KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2016\/post-281283-0-18125900-1463027392.jpg\" class='bbc_img linked-image' alt=\"IMG_2909.JPG\" \/><\/a>\n\n<\/p>\n<p>\u00a0<\/p>\n<p><a class='resized_img' rel='lightbox[1913666]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2016\/post-281283-0-72518600-1463027359.jpg\" title=\"IMG_2912.JPG - Size: 54.44KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2016\/post-281283-0-72518600-1463027359.jpg\" class='bbc_img linked-image' alt=\"IMG_2912.JPG\" \/><\/a>\n\n<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>- Erin<\/p>\n<p>\u00a0<\/p>\n<p>My planning thread:\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79068-vancouverpetunia-now-sapphire-april-7-2016\/?p=1893268'>http:\/\/www.bestdestinationwedding.com\/topic\/79068-vancouverpetunia-now-sapphire-april-7-2016\/?p=1893268<\/a><\/p>\n<p>\u00a0<\/p>\n<p>My Now Sapphire review:\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/5487-now-sapphire-riviera-cancun\/'>http:\/\/www.bestdestinationwedding.com\/reviews\/r\/5487-now-sapphire-riviera-cancun\/<\/a>","Email":"ekjzwedding@gmail.com","IpAddress":"24.85.127.174","GroupId":3,"GroupName":"Member","JoinDate":1417431445,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281283.jpg?_r=1428779369","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"vancouverpetunia","Id":281283,"Name":"vancouverpetunia","IsOnline":false}}],"Id":"80087","Title":"Short, White Wedding\/cocktail Dress Size 14 (Fits 8-12Ish)","LastPostDate":1463009497},"Pages":{"TotalItems":1,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
