rl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"LADYJUSTICE","Id":276017,"Name":"LADYJUSTICE","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.26.161.246","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78687,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"8b8c01ea6bd3287a9e82a194de95a93a","RawContent":"@LADYJUSTICE- congratulations! We haven&#039;t gotten married yet. Our date is in April 2016. What are your plans so far?","Attachments":[],"Id":1900725,"PostDate":1437322796,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @LADYJUSTICE- congratulations! We haven't gotten married yet. Our date is in April 2016. What are your plans so far?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lm_sprowl@hotmail.com","IpAddress":"75.26.164.62","GroupId":39,"GroupName":"Newbie","JoinDate":1418275431,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"cruisebride2016","Id":281378,"Name":"cruisebride2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.100.237.180","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78687,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"eaf2021ad6d7ba29d997928a3a1f1288","RawContent":"@[member=\"cruisebride2016\"]....... We are getting married at a port. I have hired a planner in St Thomas. \n\nI&#039;m planning something immediately after the wedding while on the beach. .\n\nRight now I&#039;m trying to figure out what to do after the ceremony on the ship because I still want to dance party etc....\n\nWhat are your plans?","Attachments":[],"Id":1902175,"PostDate":1439091737,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"281378\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281378-cruisebride2016\/' title='Member profile'><span itemprop=\"name\">cruisebride2016<\/span><\/a>....... We are getting married at a port. I have hired a planner in St Thomas. <br>\nI'm planning something immediately after the wedding while on the beach. .<br>\nRight now I'm trying to figure out what to do after the ceremony on the ship because I still want to dance party etc....<br>\nWhat are your plans? \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"atwater7@yahoo.com","IpAddress":"98.240.19.233","GroupId":39,"GroupName":"Newbie","JoinDate":1389481919,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"LADYJUSTICE","Id":276017,"Name":"LADYJUSTICE","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"104.129.194.128","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78687,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"12e8f0ff9eaccace02405431fbd0f654","RawContent":"@LADYJUSTICE1 We are also using our own planner in Jamaica, instead of going through the cruise line.  We splurged by getting the Royal Suite during the cruise, so we are planning to have our \"reception\" in our room once we get back on the ship. We will have toasts\/speeches, cake, first dance, etc. at that time. Only negative for this is that it would be very expensive to have a bar in the room because it would be private. We will probably have everyone bring 2 bottles of champagne\/wine (allowed by the cruise) and have them bring the bottles to the room for the group to share.\n\n\nOur final reservation date is not until November,  so we have to wait until then to find out what group points we have earned. I&#039;m hoping to get a free specialty dinner, but not sure if that will be possible. We might be able to earn a free cocktail hour, but we will wait and see. \n\n\nWe will get credit for at least 1 \"free\" guest and possibly 2 based on the one free per 16. Are you using a travel agent to book the cruise? How many guests are you expecting?","Attachments":[],"Id":1902192,"PostDate":1439163811,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @LADYJUSTICE1 We are also using our own planner in Jamaica, instead of going through the cruise line.  We splurged by getting the Royal Suite during the cruise, so we are planning to have our \"reception\" in our room once we get back on the ship. We will have toasts\/speeches, cake, first dance, etc. at that time. Only negative for this is that it would be very expensive to have a bar in the room because it would be private. We will probably have everyone bring 2 bottles of champagne\/wine (allowed by the cruise) and have them bring the bottles to the room for the group to share.<br><br>\nOur final reservation date is not until November,  so we have to wait until then to find out what group points we have earned. I'm hoping to get a free specialty dinner, but not sure if that will be possible. We might be able to earn a free cocktail hour, but we will wait and see. <br><br>\nWe will get credit for at least 1 \"free\" guest and possibly 2 based on the one free per 16. Are you using a travel agent to book the cruise? How many guests are you expecting?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lm_sprowl@hotmail.com","IpAddress":"75.26.164.62","GroupId":39,"GroupName":"Newbie","JoinDate":1418275431,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"cruisebride2016","Id":281378,"Name":"cruisebride2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"172.94.90.30","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78687,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f90fa9ae7213298422adc2e8b0ed1c23","RawContent":"&lt;p&gt;Best wishes to both of you! Congratulations!&lt;\/p&gt;","Attachments":[],"Id":1908059,"PostDate":1449126265,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Best wishes to both of you! Congratulations!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><a data-ipb='nomediaparse' href='http:\/\/www.prettywighair.com\/human-hair-wigs.html'>Human hair wigs<\/a>","Email":"zf3012010@gmail.com","IpAddress":"103.16.26.206","GroupId":39,"GroupName":"Newbie","JoinDate":1448350412,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"SimonLiu","Id":285421,"Name":"SimonLiu","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"45.74.41.76","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78687,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a826de06d049e46cf97479119ba7be8a","RawContent":"&lt;p&gt;&lt;span style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif;\"&gt;@LADYJUSTICE- congratulations! We haven&#039;t gotten married yet. Our date is in April 2016. What are your plans so far?&amp;nbsp;&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1908433,"PostDate":1450332568,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    fo