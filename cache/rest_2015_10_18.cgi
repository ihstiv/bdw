{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":26,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":6266,"MovedTo":null,"MovedOn":0,"FirstPostId":1339714,"Rating":0,"RatingHits":0,"Starter":{"Id":229614,"Name":"jszy10","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-229614.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"StartDate":1289786757,"LastPoster":{"Id":281613,"Name":"SchroederWedding2015","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281613.jpg?_r=1420497791","PhotoWidth":80,"PhotoHeight":45,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":74,"Preview":{"Id":1339714,"PostDate":1289786757,"PostContent":"Hey ladies!!\u00a0 For the LIFE of me I cannot seem to find\u00a0the template I wanted\u00a0for my Maraca favor...","Author":{"Signature":"","Email":"jszy10@hotmail.com","IpAddress":"204.13.205.130","GroupId":42,"GroupName":"Sr. Member","JoinDate":1277677752,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-229614.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"jszy10","Id":229614,"Name":"jszy10","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":58089,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1ceb702bf414f426af9dc2acf925264b","RawContent":"&lt;p&gt; Hey ladies!!&amp;nbsp; For the LIFE of me I cannot seem to find&amp;nbsp;the template I wanted&amp;nbsp;for my Maraca favors!&amp;nbsp; I know that I saw them on the forum that had a tag stating something along the lines of &amp;quot;A mexican tradition...&amp;quot; and explained how you should shake them for the bride and groom to kiss!?!&amp;nbsp; The only one I could find after an hour of searching was the basic &amp;quot;Shake for&amp;nbsp;Kiss&amp;quot;.&amp;nbsp; Anyone know what I&#039;m looking for!?!?!&amp;nbsp; Even if someone can remind me what the saying is, I can make them myself!&amp;nbsp; :o) Help Please!!&lt;\/p&gt;","Attachments":[],"Id":1339714,"PostDate":1289786757,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hey ladies!!\u00a0 For the LIFE of me I cannot seem to find\u00a0the template I wanted\u00a0for my Maraca favors!\u00a0 I know that I saw them on the forum that had a tag stating something along the lines of \"A mexican tradition...\" and explained how you should shake them for the bride and groom to kiss!?!\u00a0 The only one I could find after an hour of searching was the basic \"Shake for\u00a0Kiss\".\u00a0 Anyone know what I'm looking for!?!?!\u00a0 Even if someone can remind me what the saying is, I can make them myself!\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/ohmy.png' class='bbc_emoticon' alt=':o' \/>) Help Please!!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jszy10@hotmail.com","IpAddress":"204.13.205.130","GroupId":42,"GroupName":"Sr. Member","JoinDate":1277677752,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-229614.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"jszy10","Id":229614,"Name":"jszy10","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":58089,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"70236ff4fb61bb7357309a006df5fdcb","RawContent":"[quote]\nOriginally Posted by [b]jszy10[\/b] \/img\/forum\/go_quote.gif\n \n \n Hey ladies!!  For the LIFE of me I cannot seem to find the template I wanted for my Maraca favors!  I know that I saw them on the forum that had a tag stating something along the lines of \"A mexican tradition...\" and explained how you should shake them for the bride and groom to kiss!?!  The only one I could find after an hour of searching was the basic \"Shake for Kiss\".  Anyone know what I&#039;m looking for!?!?!  Even if someone can remind me what the saying is, I can make them myself!  :o) Help Please!![\/quote] \n I know which one your talking about but I can&#039;t think of it. I do have: instead of tapping on your glass, stand and shake with all your might, to see the groom kiss his bride tonight  or shake this and the bride and groom will kiss","Attachments":[],"Id":1339725,"PostDate":1289787818,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <br \/> <br \/> <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>jszy10<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" style=\"border: 0px solid;\" \/><\/span><br \/> <br \/> <p> Hey ladies!!\u00a0 For the LIFE of me I cannot seem to find\u00a0the template I wanted\u00a0for my Maraca favors!\u00a0 I know that I saw them on the forum that had a tag stating something along the lines of \"A mexican tradition...\" and explained how you should shake them for the bride and groom to kiss!?!\u00a0 The only one I could find after an hour of searching was the basic \"Shake for\u00a0Kiss\".\u00a0 Anyone know what I'm looking for!?!?!\u00a0 Even if someone can remind me what the saying is, I can make them myself!\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/ohmy.png' class='bbc_emoticon' alt=':o' \/>) Help Please!!<\/p> <\/blockquote> <p> I know which one your talking about but I can't think of it. I do have: instead of tapping on your glass, stand and shake with all your might, to see the groom kiss his bride tonight\u00a0 or shake this and the bride and groom will kiss<br \/> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/img.weddingcountdown.com\/ticker\/ocuour7.png\">http:\/\/img.weddingcountdown.com\/ticker\/ocuour7.png<\/a><\/div><\/div>","Email":"michelle.dugan@live.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1277873105,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-229722.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"chell44","Id":229722,"Name":"chell44","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":58089,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f042940749a0db275ed281e6ef239557","RawContent":"&lt;div class=\"quote-container\"&gt; &lt;div class=\"quote-block\"&gt; &lt;p&gt; I know which one your talking about but I can&#039;t think of it. I do have: instead of tapping on your glass, stand and shake with all your might, to see the groom kiss his bride tonight&amp;nbsp; or shake this and the bride and groom will kiss\n &amp;nbsp;&lt;\/p&gt; &lt;\/div&gt; &lt;\/div&gt; &lt;p&gt; \n Oooh I think the &amp;quot;stand and shake with all your might, to see the groom kiss his bride tonight&amp;quot; is part of it!  I can definitely at least use that! I swear there was an intro to that about a mexican tradition..!?!&lt;\/p&gt;","Attachments":[],"Id":1339734,"PostDate":1289788692,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div class=\"quote-container\"> <div class=\"quote-block\"> <p> I know which one your talking about but I can't think of it. I do have: instead of tapping on your glass, stand and shake with all your might, to see the groom kiss his bride tonight\u00a0 or shake this and the bride and groom will kiss<br \/> \u00a0<\/p> <\/div> <\/div> <p> <br \/> Oooh I think the \"stand and shake with all your might, to see the groom kiss his bride tonight\" is part of it!\u00a0\u00a0I can definitely at least use that! I swear there was an intro to that about a mexican tradition..!?!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jszy10@hotmail.com","IpAddress":"204.13.205.130","GroupId":42,"GroupName":"Sr. Member","JoinDate":1277677752,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-229614.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"jszy10","Id":229614,"Name":"jszy10","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":58089,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"bcea4c258bd43b003f9299610a588359","RawContent":"&lt;p&gt; that last line helped me find it!!&amp;nbsp; Thanks so much!!!&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;quot;Instead of tapping on your glass,&lt;\/p&gt; &lt;p&gt; here&#039;s a system with Mexican class..&lt;\/p&gt; &lt;p&gt; Stand and shake with all your might,&lt;\/p&gt; &lt;p&gt; to see the groom kiss his bride tonight!&amp;quot;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Borrowed from a fellow BDW bride:&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"101.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/206963\/width\/1000\/height\/500\" \/&gt;&lt;\/p&gt;","Attachments":[],"Id":1339741,"PostDate":1289789288,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> that last line helped me find it!!\u00a0 Thanks so much!!!<\/p> <p> \u00a0<\/p> <p> \"Instead of tapping on your glass,<\/p> <p> here's a system with Mexican class..<\/p> <p> Stand and shake with all your might,<\/p> <p> to see the groom kiss his bride tonight!\"<\/p> <p> \u00a0<\/p> <p> Borrowed from a fellow BDW bride:<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"101.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/206963\/width\/1000\/height\/500\" \/><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jszy10@hotmail.com","IpAddress":"204.13.205.130","GroupId":42,"GroupName":"Sr. Member","JoinDate":1277677752,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-229614.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"jszy10","Id":229614,"Name":"jszy10","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":58089,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9e95221bc96753aa9b5f1c5580e94b46","RawContent":"&lt;p&gt; glad you found it!&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1339771,"PostDate":1289793154,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> glad you found it!\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/img.weddingcountdown.com\/ticker\/ocuour7.png\">http:\/\/img.weddingcountdown.com\/ticker\/o