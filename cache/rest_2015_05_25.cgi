{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":4,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":264,"MovedTo":null,"MovedOn":0,"FirstPostId":1891360,"Rating":0,"RatingHits":0,"Starter":{"Id":282446,"Name":"ssoliman422","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1427765764,"LastPoster":{"Id":278395,"Name":"JenniferH114","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278395.jpg?_r=1421871115","PhotoWidth":200,"PhotoHeight":285,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":22,"Preview":{"Id":1891360,"PostDate":1427765764,"PostContent":"Hello Ladies, \u00a0 My fiance and I are trying to decide which hotel to choose for our wedding. We've...","Author":{"Signature":"","Email":"ssoliman422@gmail.com","IpAddress":"72.69.195.21","GroupId":39,"GroupName":"Newbie","JoinDate":1426641662,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"ssoliman422","Id":282446,"Name":"ssoliman422","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"72.69.195.21","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79005,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2fbfa5c7c7a94464cafffed67397eb9b","RawContent":"&lt;p&gt;Hello Ladies,&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;My fiance and I are trying to decide which hotel to choose for our wedding. We&#039;ve been looking through the forum but we haven&#039;t found anything recent about Majestic Colonial resort. Can anyone help? We need a chapel and these are the only two hotels we found with chapels.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Also, we read that both hotel demand a fee to have an outside photographer... is there any way we can get out of that? it just seems ridiculous to pay to have our own.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;thank you and happy planning,&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;Sarah&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1891360,"PostDate":1427765764,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello Ladies,<\/p>\n<p>\u00a0<\/p>\n<p>My fiance and I are trying to decide which hotel to choose for our wedding. We've been looking through the forum but we haven't found anything recent about Majestic Colonial resort. Can anyone help? We need a chapel and these are the only two hotels we found with chapels.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Also, we read that both hotel demand a fee to have an outside photographer... is there any way we can get out of that? it just seems ridiculous to pay to have our own.<\/p>\n<p>\u00a0<\/p>\n<p>thank you and happy planning,<\/p>\n<p>\u00a0Sarah\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ssoliman422@gmail.com","IpAddress":"72.69.195.21","GroupId":39,"GroupName":"Newbie","JoinDate":1426641662,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"ssoliman422","Id":282446,"Name":"ssoliman422","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.72.41.59","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79005,"EditedBy":"<strong>Edited by calgarybride2015, 30 March 2015 - 05:45 PM.<\/strong>","EditDate":1427766331,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f80f8b9ece92416e6cfea9aae2202c3c","RawContent":"Hi Sarah. \n\n\nSorry I don&#039;t have any experience with either resort. Our resort had a chapel though - Grand Sirenis Riviera Maya or Mayan Beach. \n\n\nMost if not all resorts have an outside vendor fee for everything not just photography. Sometimes you can get away with it if you booked them a hotel room For 1-3 nights or if they are your guest and staying with you for the week. \n\n\nGood luck.  \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1891361,"PostDate":1427766299,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi Sarah. <br><br>\nSorry I don't have any experience with either resort. Our resort had a chapel though - Grand Sirenis Riviera Maya or Mayan Beach. <br><br>\nMost if not all resorts have an outside vendor fee for everything not just photography. Sometimes you can get away with it if you booked them a hotel room For 1-3 nights or if they are your guest and staying with you for the week. <br><br>\nGood luck.  <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399432202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.155.94.124","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79005,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3265860e4cf626266887f7cc496eca21","RawContent":"&lt;p&gt;I have been to Majestic colonial on vacation, not for a wedding, but I really like the hotel. Their beach is gorgeous! The food was great and so was the service.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I can&#039;t speak for Barcelo Bavaro.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Calgarybride is right, most hotels will charge an outside vendor fee, unless you go with an offsite reception venue. Some hotels will offer that if you get a few nights at the hotel for the photographer they won&#039;t charge that fee. As far as Majestic Colonial goes, if their approved photographers are the guys who go around the beach taking photos I strongly suggest you get your own outside photographer. They&#039;re not terrible, they&#039;re ok for a few pictures on the beach, but they&#039;re not exactly professional wedding photos.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck! Hopefully you can get some info on Barcelo :)&lt;\/p&gt;","Attachments":[],"Id":1891362,"PostDate":1427769070,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I have been to Majestic colonial on vacation, not for a wedding, but I really like the hotel. Their beach is gorgeous! The food was great and so was the service.<\/p>\n<p>\u00a0<\/p>\n<p>I can't speak for Barcelo Bavaro.<\/p>\n<p>\u00a0<\/p>\n<p>Calgarybride is right, most hotels will charge an outside vendor fee, unless you go with an offsite reception venue. Some hotels will offer that if you get a few nights at the hotel for the photographer they won't charge that fee. As far as Majestic Colonial goes, if their approved photographers are the guys who go around the beach taking photos I strongly suggest you get your own outside photographer. They're not terrible, they're ok for a few pictures on the beach, but they're not exactly professional wedding photos.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Good luck! Hopefully you can get some info on Barcelo <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<br><p><a data-ipb='nomediaparse' href='http:\/\/www.TickerFactory.com\/'><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;31;484\/st\/20150813\/e\/Wedding+time%21+\/dt\/-2\/k\/b92c\/event.png\" alt=\"event.png\"><\/a><\/p>\n<p style=\"text-align:center;\">\u00a0<\/p>\n<p style=\"text-align:center;\">\u00a0","Email":"sblopezb@gmail.com","IpAddress":"172.219.193.22","GroupId":42,"GroupName":"Sr. Member","JoinDate":1359766704,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265511.jpg?_r=1427386564","PhotoWidth":200,"PhotoHeight":153,"PhotoType":"custom"},"FormattedName":"TinkerSofi","Id":265511,"Name":"TinkerSofi","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"107.77.87.22","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79005,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3e1efb5993fd919d2a0a801febe246db","RawContent":"I stayed at the Majestic Elegance (Elegance Club) last year. The grounds were very nice. The food was decent but hit or miss. One night we accidentally ate on the Colonial side bc we were so turned around and the food at the Mexican restaurant was horrendous!! We talked about how bad it was the rest of the trip. If you can, stay on the Elegance side bc it&#039;s a step up so you get access to both resorts, but technically the Colonial side does not get access to the Elegance side. The Elegance Club was definitely worth it, too, but it&#039;s adults only.","Attachments":[],"Id":1891377,"PostDate":1427776170,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I stayed at the Majestic Elegance (Elegance Club) last year. The grounds were very nice. The food was decent but hit or miss. One night we accidentally ate on the Colonial side bc we were so turned around and the food at the Mexican restaurant was horrendous!! We talked about how bad it was the rest of the trip. If you can, stay on the Elegance side bc it's a step up so you get access to both resorts, but technically the Colonial side does not get access to the Elegance side. The Elegance Club was definitely worth it, too, but it's adults only.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jhowe114@gmail.com","IpAddress":"38.98.131.98","GroupId":40,"GroupName":"Jr. Member","JoinDate":1402429989,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278395.jpg?_r=1421871115","PhotoWidth":200,"PhotoHeight":285,"PhotoType":"custom"},"FormattedName":"JenniferH114","Id":278395,"Name":"JenniferH114","IsOnline":false}}],"Id":"79005","Title":"Majestic Colonial Or Barcelo Bavaro?","LastPostDate":1427776170},"Pages":{"TotalItems":4,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
