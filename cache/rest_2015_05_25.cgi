     }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                here's another thread about this, just for more input<br \/> <a href='http:\/\/bestdestinationwedding.com\/forum\/t11096' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/bestdestinati...om\/forum\/t11096<\/a><br \/> <br \/> also keep in mind the reason why you are having a hard time making any of them work is that all the software and programs and wedding planning books are made for traditional weddings not DW's.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<strong>Christine + Will (married 7\/20\/07) + Ainsleigh (born 6\/25\/08) + Nolan (born 11\/9\/10) + Delaney (born 12\/31\/13) = One Very Happy Family!<\/strong>","Email":"christine@dc-hulls.com","IpAddress":"167.154.70.240","GroupId":46,"GroupName":"VIP Member","JoinDate":1165985580,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206965.gif?_r=0","PhotoWidth":100,"PhotoHeight":67,"PhotoType":"custom"},"FormattedName":"Christine","Id":206965,"Name":"Christine","IsOnline":false}}],"Id":"12263","Title":"Wedding Planning Software","LastPostDate":1432195421},"Pages":{"TotalItems":15,"TotalPages":2,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
