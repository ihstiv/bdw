nning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;1\/st\/20151215\/e\/Our+Wedding\/k\/ec4b\/event.png\" alt=\"event.png\"><\/a><br><br><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":3,"GroupName":"Member","JoinDate":1419441414,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1428347017","PhotoWidth":169,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"158.82.202.5","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79150,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"79e1120e98f6163ef478e5cc9e015681","RawContent":"&lt;p&gt;I live downtown near Bathurst and Bloor, and I work near Bloor and Yonge.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I&#039;m still wavering on whether I want to try it on, lol. I&#039;m afraid that I will love it and then not be able to decide what dress to choose (I&#039;m the most indecisive person on the planet). I was hoping you were going to say the dress was white since I would have preferred the ivory and that would have made the decision for me :P  &lt;\/p&gt;","Attachments":[],"Id":1895438,"PostDate":1430860894,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I live downtown near Bathurst and Bloor, and I work near Bloor and Yonge.<\/p>\n<p>\u00a0<\/p>\n<p>I'm still wavering on whether I want to try it on, lol. I'm afraid that I will love it and then not be able to decide what dress to choose (I'm the most indecisive person on the planet). I was hoping you were going to say the dress was white since I would have preferred the ivory and that would have made the decision for me <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/tongue.png' class='bbc_emoticon' alt=':P' \/>\u00a0\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div>\u00a0<\/div>\n<div>\u00a0<\/div>\n<div><a class='bbc_url' href='http:\/\/www.TickerFactory.com\/'><\/div>\n<div><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;6\/st\/20160409\/e\/our+Wedding+Day\/k\/a16a\/event.png\" alt=\"event.png\"><\/div>\n<div><\/a><\/div>\n<div>\u00a0<\/div>\n","Email":"krystalball@gmail.com","IpAddress":"158.82.202.5","GroupId":39,"GroupName":"Newbie","JoinDate":1421867763,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281820.jpg?_r=1429976010","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"facebook"},"FormattedName":"krystalball","Id":281820,"Name":"krystalball","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.53.17.19","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79150,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0b21ea7f0215624477346576e23dc98c","RawContent":"&lt;p&gt;@[member=\"krystalball\"] haha! Nope.. the dress is ivory. Just out of curiosity, what dress did you buy