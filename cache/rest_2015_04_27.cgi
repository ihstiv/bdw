ess":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62152,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"828d7d99eaec8917c534019fcb61e9ed","RawContent":"Cnicole51911, \n \n Do you have facebook?\n \n   [quote]\nOriginally Posted by [b]Cnicole51911[\/b] \/img\/forum\/go_quote.gif\n \n \n Your pictures are beautiful!! Can you post a few more?[\/quote]","Attachments":[],"Id":1600761,"PostDate":1333047452,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Cnicole51911,<\/p> <p> \u00a0<\/p> <p> Do you have facebook?<br \/> <br \/> \u00a0<\/p> <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>Cnicole51911<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> <p> Your pictures are beautiful!! Can you post a few more?<\/p> <\/blockquote> <br \/> <br \/> <p> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ladybug1280@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1284746058,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232417.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"AmyG","Id":232417,"Name":"AmyG","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62152,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a56bbd1ac5cfa157d3053ee1ec8fdfee","RawContent":"&lt;p&gt; Wow!! Beautiful. Beautiful. Beautiful. And I love your flowers ~ did you get them through the resort or did you have an outside florist??&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1600848,"PostDate":1333055605,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Wow!! Beautiful. Beautiful. Beautiful. And I love your flowers ~ did you get them through the resort or did you have an outside florist??\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><p style=\"text-align:center;\"><span>~Now Sapphire Riviera Cancun~<\/span><\/p><span><\/span><p style=\"text-align:center;\"><span>4.27.13<\/span><\/p><span><\/span><p style=\"text-align:center;\"><span>54 Booked + The Bride & Groom!<\/span><\/p><span><\/span><\/div><\/div>","Email":"grassif@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1319096283,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-246906.jpeg?_r=0","PhotoWidth":173,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"LTLFAITHY","Id":246906,"Name":"LTLFAITHY","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62152,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"78385c04d90ec5d72e30b96b96f668db","RawContent":"Hi Amy, I was wondering if you could give us a timeline of events... What Time was reception, cocktail hour? Dinner? DJ? I think we are looking at 5 ceremony 6 cocktail hour 7 reception starts with dinner being served shortly their after. Cake and toast at 8:30 and DJ starts then. Thank you, Ryan","Attachments":[],"Id":1600952,"PostDate":1333072361,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi Amy, I was wondering if you could give us a timeline of events... What Time was reception, cocktail hour? Dinner? DJ? I think we are looking at 5 ceremony 6 cocktail hour 7 reception starts with dinner being served shortly their after. Cake and toast at 8:30 and DJ starts then. Thank you, Ryan\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ryan@panthersgrad.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1307990680,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-241083.jpg?_r=1388290366","PhotoWidth":200,"PhotoHeight":255,"PhotoType":"custom"},"FormattedName":"RFinger","Id":241083,"Name":"RFinger","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62152,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7937a6ccce1dcd579bd6fee805df0073","RawContent":"&lt;p&gt; Just received the wedding planning form to return. Does anyone know if I have to fill out the pages with the witnesses, etc right now? Or just the first page with the deposit?&lt;\/p&gt;","Attachments":[],"Id":1601005,"PostDate":1333077985,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Just received the wedding planning form to return. Does anyone know if I have to fill out the pages with the witnesses, etc right now? Or just the first page with the deposit?<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tpsmithslp@gmail.com","IpAddress":"168.216.83.100","GroupId":40,"GroupName":"Jr. Member","JoinDate":1331500985,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-252586.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"TauruSmith","Id":252586,"Name":"TauruSmith","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62152,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e94d25e936170a27cd59465d52e1edd6","RawContent":"Hi everyone, we are back! The resort is wonderful, all of our guests loved it and some plan to return (as do we). In fact we wished we had stayed longer than a week. The wedding was fantastic and there were only a few minor hiccups but certainly nothing that really mattered to me. Amy, your photos look great! Who did them? We have to wait about 6 weeks for ours, and though I know it will be worth it I want them now!!!","Attachments":[],"Id":1601089,"PostDate":1333118412,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi everyone, we are back! The resort is wonderful, all of our guests loved it and some plan to return (as do we). In fact we wished we had stayed longer than a week. The wedding was fantastic and there were only a few minor hiccups but certainly nothing that really mattered to me. Amy, your photos look great! Who did them? We have to wait about 6 weeks for ours, and though I know it will be worth it I want them now!!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"writetojodi@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1299617006,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-237569.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":146,"PhotoType":"custom"},"FormattedName":"joda","Id":237569,"Name":"joda","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62152,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9b5e9d1850c8007681e555958343fe83","RawContent":"Thanks LTLFAITHY!   \n I used the resort florist for the bridal bouquet and then I brought the bridesmaids calla lillies from home (I bought them at a wholesale flower place and my mom put them together).  They are actually silk but they are a higher quality so they looked and felt so real.\n \n   [quote]\nOriginally Posted by [b]LTLFAITHY[\/b] \/img\/forum\/go_quote.gif\n \n \n Wow!! Beautiful. Beautiful. Beautiful. And I love your flowers ~ did you get them through the resort or did you have an outside florist??[\/quote]","Attachments":[],"Id":1601100,"PostDate":1333120594,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Thanks LTLFAITHY!\u00a0\u00a0<\/p> <p> I used the resort florist for the bridal bouquet and then I brought the bridesmaids calla lillies from home (I bought them at a wholesale flower place and my mom put them together).\u00a0 They are actually silk but they are a higher quality so they looked and felt so real.<br \/> <br \/> \u00a0<\/p> <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>LTLFAITHY<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> <p> Wow!! Beautiful. Beautiful. Beautiful. And I love your flowers ~ did you get them through the resort or did you have an outside florist??\u00a0<\/p> <\/blockquote> <br \/> <br \/> <p> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ladybug1280@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1284746058,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232417.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"AmyG","Id":232417,"Name":"AmyG","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62152,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a536f069292d9a82c5acebcf57ba3de9","RawContent":"RFinger, \n That is the exact timeline I used.... \n \n 5:00pm - ceremony (used sound system w\/ ipod) \n 6:00pm - cocktail hour (used sound system w\/ ipod) \n 7:00pm - dinner (dj started during dinner with lighter dinner music and then came on with dance music at 8:00pm) \n 7:45pm - toasts \n 8:00pm - dancing \n 8:30pm - cut the cake \n dancing...dancing...dancing \n \n For some reason our ceremony got delayed by approx. 15 - 20 minutes due to a miscommunication on where the guests and groomsmen were to meet.  I highly recommend that you have your guetss meet up at least 30 minutes prior to the event because the wedding coordinator will want to seat them at the same time and if they are late it will hold things up.  Because we were delayed, we lost some dasylight for more photo opportunities...but of course I was happy with all the photos I received so it didn&#039;t bother me too much.\n \n   [quote]\nOriginally Posted by [b]RFinger[\/b] \/img\/forum\/go_quote.gif\n \n Hi Amy,\n I was wondering if you could give us a timeline of events...\n What Time was reception, cocktail hour? Dinner? DJ?\n I think we are looking at 5 ceremony 6 cocktail hour 7 reception starts with dinner being served shortly their after. Cake and toast at 8:30 and DJ starts then.\n Thank you,\n Ryan[\/quote]","Attachments":[],"Id":1601102,"PostDate":1333120928,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> RFinger,<\/p> <p> That is the exact timeline I used....<\/p> <p> \u00a0<\/p> <p> 5:00pm - ceremony (used sound system w\/ ipod)<\/p> <p> 6:00pm - cocktail hour (used sound system w\/ ipod)<\/p> <p> 7:00pm - dinner (dj started during dinner with lighter dinner music and then came on with dance music at 8:00pm)<\/p> <p> 7:45pm - toasts<\/p> <p> 8:00pm - dancing<\/p> <p> 8:30pm - cut the cake<\/p> <p> dancing...dancing...dancing<\/p> <p> \u00a0<\/p> <p> For some reason our ceremony got delayed by approx. 15 - 20 minutes due to a miscommunication on where the guests and groomsmen were to meet.\u00a0 I highly recommend that you have your guetss meet up at least 30 minutes prior to the event because the wedding coordinator will want to seat them at the same time and if they are late it will hold things up.\u00a0 Because we were delayed, we lost some dasylight for more photo opportunities...but of course I was happy with all the photos I received so it didn't bother me too much.<br \/> <br \/> \u00a0<\/p> <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>RFinger<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> Hi Amy,<br \/> I was wondering if you could give us a timeline of events...<br \/> What Time was reception, cocktail hour? Dinner? DJ?<br \/> I think we are looking at 5 ceremony 6 cocktail hour 7 reception starts with dinner being served shortly their after. Cake and toast at 8:30 and DJ starts then.<br \/> Thank you,<br \/> Ryan<\/blockquote> <br \/> <br \/> <p> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ladybug1280@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1284746058,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232417.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"AmyG","Id":232417,"Name":"AmyG","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62152,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c38067d295c33696461a5939aa4305bd","RawContent":"Hi joda, \n \n I&#039;m so happy you had fun....we all had a blast!!! \n \n I wonder if we had the some &#039;hiccups&#039;.... :- \/ \n \n I used the resort photographer.  Before we left the resort we were able to pick up our cd with 240 photos, a photo book w\/ 80 pics, my video dvd from the videographer and they have an online slideshow too.  What photographer did you use?  Oh man I don&#039;t know if I would be able to wait...but you know it will be worth it.  :-) \n We looked at the photos and dvd as soon as we got them in the hotel room, lol.\n \n   [quote]\nOriginally Posted by [b]joda[\/b] \/img\/forum\/go_quote.gif\n \n Hi everyone, we are back! The resort is wonderful, all of our guests loved it and some plan to return (as do we). In fact we wished we had stayed longer than a week. The wedding was fantastic and there were only a few minor hiccups but certainly nothing that really mattered to me.\n Amy, your photos look great! Who did them? We have to wait about 6 weeks for ours, and though I know it will be worth it I want them now!!![\/quote]","Attachments":[],"Id":1601104,"PostDate":1333121140,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hi joda,<\/p> <p> \u00a0<\/p> <p> I'm so happy you had fun....we all had a blast!!!<\/p> <p> \u00a0<\/p> <p> I wonder if we had the some 'hiccups'.... :- \/<\/p> <p> \u00a0<\/p> <p> I used the resort photographer.\u00a0 Before we left the resort we were able to pick up our cd with 240 photos, a photo book w\/ 80 pics, my video dvd from the videographer and they have an online slideshow too.\u00a0 What photographer did you use?\u00a0 Oh man I don't know if I would be able to wait...but you know it will be worth it.\u00a0 :-)<\/p> <p> We looked at the photos and dvd as soon as we got them in the hotel room, lol.<br \/> <br \/> \u00a0<\/p> <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>joda<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> Hi everyone, we are back! The resort is wonderful, all of our guests loved it and some plan to return (as do we). In fact we wished we had stayed longer than a week. The wedding was fantastic and there were only a few minor hiccups but certainly nothing that really mattered to me.<br \/> Amy, your photos look great! Who did them? We have to wait about 6 weeks for ours, and though I know it will be worth it I want them now!!!<\/blockquote> <br \/> <br \/> <p> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ladybug1280@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1284746058,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232417.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"AmyG","Id":232417,"Name":"AmyG","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62152,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"70b4efaf4687346e3337d6f52251bdb1","RawContent":"&lt;p&gt; Hi All,&amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; I am completely new to this site, and just wanted to thank all of you for you posts! I have been reading through them all over the last few days.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; I just booked my Wedding at the Now Sapphire Resort for February 14, 2013 (seems so far away).&amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; My one big question would be, ANY SUGGESTIONS WOULD BE GREATLY APPRECIATED!!!! - would you suggest to book room directly through the resort or use the assistance of a travel agent??? I have never used a travel agent before and i am hearing that they can arrange payment plans for some of my quests? Is that a real thing??&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Thanks Ladies!!!!&lt;\/p&gt;","Attachments":[],"Id":1601111,"PostDate":1333121702,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hi All,\u00a0<\/p> <p> \u00a0<\/p> <p> I am completely new to this site, and just wanted to thank all of you for you posts! I have been reading through them all over the last few days.<\/p> <p> \u00a0<\/p> <p> I just booked my Wedding at the Now Sapphire Resort for February 14, 2013 (seems so far away).\u00a0<\/p> <p> \u00a0<\/p> <p> My one big question would be, ANY SUGGESTIONS WOULD BE GREATLY APPRECIATED!!!! - would you suggest to book room directly through the resort or use the assistance of a travel agent??? I have never used a travel agent before and i am hearing that they can arrange payment plans for some of my quests? Is that a real thing??<\/p> <p> \u00a0<\/p> <p> Thanks Ladies!!!!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"JenniferLeitch17@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1333120533,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-253378.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"JenniferL","Id":253378,"Name":"JenniferL","IsOnline":false}}],"Pages":{"TotalItems":2541,"TotalPages":255,"CurrentPage":310,"NextPage":320,"PreviousPage":300,"LastPage":2540},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
