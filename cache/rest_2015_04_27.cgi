ilies\/cheesy.gif\" \/><\/span><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"magirl21@yahoo.com","IpAddress":"71.184.150.231","GroupId":40,"GroupName":"Jr. Member","JoinDate":1276800205,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-229273.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"magirl","Id":229273,"Name":"magirl","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62152,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8b0e4edbeb5a61ef1ce61064bdfe3558","RawContent":"&lt;p&gt; I&#039;m about to hit my 6 Month Countdown....I guess I should get back to planning.&amp;nbsp; I have tried to take a little break.   &lt;span alt=\"???\" id=\"yui_3_4_0_10_1315928379093_14\" rel=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/huh.gif\"&gt;&lt;img height=\"16\" id=\"yui_3_4_0_10_1315928379093_13\" src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/huh.gif\" width=\"16\" \/&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; magirl...Congrats on getting on your shoes!!&amp;nbsp; :-)&lt;\/p&gt;","Attachments":[],"Id":1519119,"PostDate":1315932177,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I'm about to hit my 6 Month Countdown....I guess I should get back to planning.\u00a0 I have tried to take a little break.\u00a0\u00a0 <span alt=\"???\" id=\"yui_3_4_0_10_1315928379093_14\" rel=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/huh.gif\"><span rel='lightbox'><img class='bbc_img' height=\"16\" id=\"yui_3_4_0_10_1315928379093_13\" src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/huh.gif\" width=\"16\" \/><\/span><\/span><\/p> <p> \u00a0<\/p> <p> magirl...Congrats on getting on your shoes!!\u00a0 :-)<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ladybug1280@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1284746058,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232417.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"AmyG","Id":232417,"Name":"AmyG","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62152,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"92063071d791927c849a3eeef667b7e3","RawContent":"&lt;p&gt; Super cute shoes!&lt;\/p&gt;","Attachments":[],"Id":1519629,"PostDate":1316021877,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Super cute shoes!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tayleaha@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1315421025,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-245009.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"almostmarried","Id":245009,"Name":"almostmarried","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62152,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f7cfaa80727b6754bb978680b6377816","RawContent":"&lt;p&gt; They have various resort photographers. We were lucky and got an amazingggg photographer. His name is Jhankarlo and he did our photos there which we loved and eventually used as our engagement photos. He&#039;s in our package, upon request, but also we&#039;re contracting him on the side for our ttd at the cenotes for another $900. Which includes entry to the cenotes, all photos on CD, and I believe it&#039;s 4 hours. Just alone at the cenotes he says the entry is $200.&lt;\/p&gt; &lt;p&gt; \n This is his flicker acct:&amp;nbsp;http:\/\/www.flickr.com\/photos\/jhankarloamaro\/&lt;\/p&gt; &lt;p&gt; His FB:&amp;nbsp;http:\/\/www.facebook.com\/Jhankarloamaro?ref=ts&lt;\/p&gt; &lt;p&gt; Email:&amp;nbsp;jhankarloxp@hotmail.com&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; He&#039;s great and we lovedddd working with him!&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Here&#039;s our pics:&amp;nbsp;http:\/\/web.mac.com\/vallarta_adventures\/SlideshowsNOSRC\/SOUSA\/&lt;\/p&gt;","Attachments":[],"Id":1521483,"PostDate":1316396874,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> They have various resort photographers. We were lucky and got an amazingggg photographer. His name is Jhankarlo and he did our photos there which we loved and eventually used as our engagement photos. He's in our package, upon request, but also we're contracting him on the side for our ttd at the cenotes for another $900. Which includes entry to the cenotes, all photos on CD, and I believe it's 4 hours. Just alone at the cenotes he says the entry is $200.<\/p> <p> <br \/> This is his flicker acct:\u00a0<a href='http:\/\/www.flickr.com\/photos\/jhankarloamaro\/' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.flickr.co...jhankarloamaro\/<\/a><\/p> <p> His FB:\u00a0<a href='http:\/\/www.facebook.com\/Jhankarloamaro?ref=ts' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.facebook....rloamaro?ref=ts<\/a><\/p> <p> Email:\u00a0jhankarloxp@hotmail.com<\/p> <p> \u00a0<\/p> <p> He's great and we lovedddd working with him!<\/p> <p> \u00a0<\/p> <p> Here's our pics:\u00a0<a href='http:\/\/web.mac.com\/vallarta_adventures\/SlideshowsNOSRC\/SOUSA\/' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/web.mac.com\/v...owsNOSRC\/SOUSA\/<\/a><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"janice.miriam@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1276570100,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-229169.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"babestaaa","Id":229169,"Name":"babestaaa","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62152,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8f5c845458f3124bc5788e64887c2acc","RawContent":"&lt;p&gt; I gotta vent about Anel :( She sent me a confirmation email but messed up my areas. She put reception for beach terrace and I specified beach, private area. She messed up on ceremony too. I&#039;m getting nervous with her and considering hiring Yazmin just to relieve some stress now that Sandra is gone.&lt;\/p&gt;","Attachments":[],"Id":1521484,"PostDate":1316396960,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I gotta vent about Anel <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/sad.png' class='bbc_emoticon' alt=':(' \/> She sent me a confirmation email but messed up my areas. She put reception for beach terrace and I specified beach, private area. She messed up on ceremony too. I'm getting nervous with her and considering hiring Yazmin just to relieve some stress now that Sandra is gone.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"janice.miriam@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1276570100,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-229169.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"babestaaa","Id":229169,"Name":"babestaaa","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62152,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"986be78f6010fe440c577906e2ff3486","RawContent":"Interesting, she emailed me last night to confirm the correct locations. Maybe she reads BDW lol [quote]\nOriginally Posted by [b]babestaaa[\/b] \/img\/forum\/go_quote.gif\n \n \n I gotta vent about Anel :( She sent me a confirmation email but messed up my areas. She put reception for beach terrace and I specified beach, private area. She messed up on ceremony too. I&#039;m getting nervous with her and considering hiring Yazmin just to relieve some stress now that Sandra is gone.[\/quote]","Attachments":[],"Id":1521603,"PostDate":1316441459,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> <br \/> Interesting, she emailed me last night to confirm the correct locations. Maybe she reads BDW lol<\/p> <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>babestaaa<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" style=\"border: 0px solid;\" \/><\/span><br \/> <br \/> <p> I gotta vent about Anel <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/sad.png' class='bbc_emoticon' alt=':(' \/> She sent me a confirmation email but messed up my areas. She put reception for beach terrace and I specified beach, private area. She messed up on ceremony too. I'm getting nervous with her and considering hiring Yazmin just to relieve some stress now that Sandra is gone.<\/p> <\/blockquote> <br \/> <br \/> <p> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"janice.miriam@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1276570100,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-229169.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"babestaaa","Id":229169,"Name":"babestaaa","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62152,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b663f22e58d4c8069b4520868e24b5b1","RawContent":"Does he usually work at Dreams Riviera?   \n We&#039;re considering using the resort photographers, but I want to see some wedding samples from the actual photographer who will be shooting our wedding. \n [quote]\nOriginally Posted by [b]babestaaa[\/b] \/img\/forum\/go_quote.gif\n \n \n They have various resort photographers. We were lucky and got an amazingggg photographer. His name is Jhankarlo and he did our photos there which we loved and eventually used as our engagement photos. He&#039;s in our package, upon request, but also we&#039;re contracting him on the side for our ttd at the cenotes for another $900. Which includes entry to the cenotes, all photos on CD, and I believe it&#039;s 4 hours. Just alone at the cenotes he says the entry is $200. \n \n This is his flicker acct: [url=\"http:\/\/www.flickr.com\/photos\/jhankarloamaro\/\"]http:\/\/www.flickr.com\/photos\/jhankarloamaro\/[\/url] \n His FB: [url=\"http:\/\/www.facebook.com\/Jhankarloamaro?ref=ts\"]http:\/\/www.facebook.com\/Jhankarloamaro?ref=ts[\/url] \n Email: jhankarloxp@hotmail.com \n \n He&#039;s great and we lovedddd working with him! \n \n Here&#039;s our pics: [url=\"http:\/\/web.mac.com\/vallarta_adventures\/SlideshowsNOSRC\/SOUSA\/\"]http:\/\/web.mac.com\/vallarta_adventures\/SlideshowsNOSRC\/SOUSA\/[\/url][\/quote]","Attachments":[],"Id":1521659,"PostDate":1316452408,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> <br \/> Does he usually work at Dreams Riviera? \u00a0<\/p> <p> We're considering using the resort photographers, but I want to see some wedding samples from the actual photographer who will be shooting our wedding.<\/p> <p> \u00a0<\/p> <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>babestaaa<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" style=\"border: 0px solid;\" \/><\/span><br \/> <br \/> <p> They have various resort photographers. We were lucky and got an amazingggg photographer. His name is Jhankarlo and he did our photos there which we loved and eventually used as our engagement photos. He's in our package, upon request, but also we're contracting him on the side for our ttd at the cenotes for another $900. Which includes entry to the cenotes, all photos on CD, and I believe it's 4 hours. Just alone at the cenotes he says the entry is $200.<\/p> <p> <br \/> This is his flicker acct:\u00a0<a href='http:\/\/www.flickr.com\/photos\/jhankarloamaro\/' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.flickr.co...jhankarloamaro\/<\/a><\/p> <p> His FB:\u00a0<a href='http:\/\/www.facebook.com\/Jhankarloamaro?ref=ts' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.facebook....rloamaro?ref=ts<\/a><\/p> <p> Email:\u00a0jhankarloxp@hotmail.com<\/p> <p> \u00a0<\/p> <p> He's great and we lovedddd working with him!<\/p> <p> \u00a0<\/p> <p> Here's our pics:\u00a0<a href='http:\/\/web.mac.com\/vallarta_adventures\/SlideshowsNOSRC\/SOUSA\/' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/web.mac.com\/v...owsNOSRC\/SOUSA\/<\/a><\/p> <\/blockquote> <br \/> <br \/> <p> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lianeetodd@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1305064173,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-239838.JPG?_r=0","PhotoWidth":200,"PhotoHeight":220,"PhotoType":"custom"},"FormattedName":"lianee","Id":239838,"Name":"lianee","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62152,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"925a90b2e020c4682a57ede933694770","RawContent":"I know he is part of Adventure Photos? not sure the name exactly. But he has done weddings for Dreams, Secrets, Mayakoba..&amp;amp; the Now. I&#039;m sure you can email him and request it. [quote]\nOriginally Posted by [b]lianee[\/b] \/img\/forum\/go_quote.gif\n \n \n \n Does he usually work at Dreams Riviera?   \n We&#039;re considering using the resort photographers, but I want to see some wedding samples from the actual photographer who will be shooting our wedding. \n \n \n \n[\/quote]","Attachments":[],"Id":1522924,"PostDate":1316655806,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> <br \/> I know he is part of Adventure Photos? not sure the name exactly. But he has done weddings for Dreams, Secrets, Mayakoba..& the Now. I'm sure you can email him and request it.<\/p> <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>lianee<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" style=\"border: 0px solid;\" \/><\/span><br \/> <br \/> <p> <br \/> Does he usually work at Dreams Riviera? \u00a0<\/p> <p> We're considering using the resort photographers, but I want to see some wedding samples from the actual photographer who will be shooting our wedding.<\/p> <p> \u00a0<\/p> <br \/> <br \/> <p> \u00a0<\/p> <\/blockquote> <br \/> <br \/> <p> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"janice.miriam@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1276570100,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-229169.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"babestaaa","Id":229169,"Name":"babestaaa","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62152,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"958d84f7b471bcedf83620a8d4fb86a3","RawContent":"&lt;p&gt; I heard back from Adventure Photos at Now Sapphire (i.e., the resort&#039;s photographer).&amp;nbsp; They said that they only designate the specific photographer a few days before the wedding, so they couldn&#039;t send me any specific sample work.&amp;nbsp; They said that when you arrive at the resort, you can visit the gallery to see the work of each photographer.&amp;nbsp; I don&#039;t find this to be a particularly reassuring process.&amp;nbsp; I&#039;d like to have an idea of what the pictures could look like BEFORE I decide to book the photographer.&amp;nbsp; So I guess I&#039;m back to considering an outside photographer.&amp;nbsp; Does anyone know for certain - does the resort charge you $300 to bring in a photographer on the wedding day?&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Also, I have the price list for wedding packages from Adventure Photos, in case anyone wants it.&lt;\/p&gt;","Attachments":[],"Id":1523738,"PostDate":1316792310,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I heard back from Adventure Photos at Now Sapphire (i.e., the resort's photographer).\u00a0 They said that they only designate the specific photographer a few days before the wedding, so they couldn't send me any specific sample work.\u00a0 They said that when you arrive at the resort, you can visit the gallery to see the work of each photographer.\u00a0 I don't find this to be a particularly reassuring process.\u00a0 I'd like to have an idea of what the pictures could look like BEFORE I decide to book the photographer.\u00a0 So I guess I'm back to considering an outside photographer.\u00a0 Does anyone know for certain - does the resort charge you $300 to bring in a photographer on the wedding day?<\/p> <p> \u00a0<\/p> <p> Also, I have the price list for wedding packages from Adventure Photos, in case anyone wants it.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lianeetodd@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1305064173,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-239838.JPG?_r=0","PhotoWidth":200,"PhotoHeight":220,"PhotoType":"custom"},"FormattedName":"lianee","Id":239838,"Name":"lianee","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62152,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"02c148e10bdfac5d8094708176747ed4","RawContent":"Hi Lianee, \n \n I have heard back from the NOW as I am in the process of hiring Yazmin to deal with them directly. They are starting to aggrivate me as Anel told me I wouldn&#039;t be able to hire outside vendors, which idk who she is to tell me that since with Sandra it is fine and I don&#039;t see that anywhere on the contract so I am awaiting a response. I specified that I wanted Jhankarlo, unfortunately the coordinator or head hancho from Adventure Photos told me he is no longer with the company, so guess what. We&#039;re back to also looking for someone. This is sincere crap. I am beyondddd upset! Not to mention, for additional ppl past our divine package, its $105+service.. That is un-be-lieve-able! I am in absolute shock. I am beyond stressed right now.\n   [quote]\nOriginally Posted by [b]lianee[\/b] \/img\/forum\/go_quote.gif\n \n \n I heard back from Adventure Photos at Now Sapphire (i.e., the resort&#039;s photographer).  They said that they only designate the specific photographer a few days before the wedding, so they couldn&#039;t send me any specific sample work.  They said that when you arrive at the resort, you can visit the gallery to see the work of each photographer.  I don&#039;t find this to be a particularly reassuring process.  I&#039;d like to have an idea of what the pictures could look like BEFORE I decide to book the photographer.  So I guess I&#039;m back to considering an outside photographer.  Does anyone know for certain - does the resort charge you $300 to bring in a photographer on the wedding day? \n \n Also, I have the price list for wedding packages from Adventure Photos, in case anyone wants it.[\/quote]","Attachments":[],"Id":1523791,"PostDate":1316797753,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hi Lianee,<\/p> <p> \u00a0<\/p> <p> I have heard back from the NOW as I am in the process of hiring Yazmin to deal with them directly. They are starting to aggrivate me as Anel told me I wouldn't be able to hire outside vendors, which idk who she is to tell me that since with Sandra it is fine and I don't see that anywhere on the contract so I am awaiting a response. I specified that I wanted Jhankarlo, unfortunately the coordinator or head hancho from Adventure Photos told me he is no longer with the company, so guess what. We're back to also looking for someone. This is sincere crap. I am beyondddd upset! Not to mention, for additional ppl past our divine package, its $105+service.. That is un-be-lieve-able! I am in absolute shock. I am beyond stressed right now.<br \/> \u00a0<\/p> <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>lianee<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" style=\"border: 0px solid;\" \/><\/span><br \/> <br \/> <p> I heard back from Adventure Photos at Now Sapphire (i.e., the resort's photographer).\u00a0 They said that they only designate the specific photographer a few days before the wedding, so they couldn't send me any specific sample work.\u00a0 They said that when you arrive at the resort, you can visit the gallery to see the work of each photographer.\u00a0 I don't find this to be a particularly reassuring process.\u00a0 I'd like to have an idea of what the pictures could look like BEFORE I decide to book the photographer.\u00a0 So I guess I'm back to considering an outside photographer.\u00a0 Does anyone know for certain - does the resort charge you $300 to bring in a photographer on the wedding day?<\/p> <p> \u00a0<\/p> <p> Also, I have the price list for wedding packages from Adventure Photos, in case anyone wants it.<\/p> <\/blockquote> <br \/> <br \/> <p> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"janice.miriam@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1276570100,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-229169.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"babestaaa","Id":229169,"Name":"babestaaa","IsOnline":false}}],"Pages":{"TotalItems":2541,"TotalPages":255,"CurrentPage":60,"NextPage":70,"PreviousPage":50,"LastPage":2540},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
