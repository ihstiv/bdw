d>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> We just sent in the wedding request form last night. Hoping Now Sapphire has May 18, 2013 open for us! I can't wait to start planning!!!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tpsmithslp@gmail.com","IpAddress":"168.216.83.100","GroupId":40,"GroupName":"Jr. Member","JoinDate":1331500985,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-252586.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"TauruSmith","Id":252586,"Name":"TauruSmith","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62152,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0c3ff9b5a9605d4ceca3c33cb77408d1","RawContent":"[quote]\nOriginally Posted by [b]AmyG[\/b] \/img\/forum\/go_quote.gif\n \n \n \n Hey all, \n \n I&#039;ve been back for a few days now but I have not had any time to write a review or post pics....here are a few pics for now but I plan to write a full review and my planning thread.  Please feel free to ask me any questions about the resort!!  I Loved it!! \n \n [img]http:\/\/www.bestdestinationwedding.com\/image\/id\/777255\/width\/467\/height\/700[\/img][\/quote] \n YOUR PICTURES ARE BEAUTIFUL!! \n \n Can you post a few more? I will be getting married May 19, 2012, and I have never even been to this resort!","Attachments":[],"Id":1600719,"PostDate":1333042145,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <br \/> <br \/> <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>AmyG<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> <p> \u00a0<\/p> <p> Hey all,<\/p> <p> \u00a0<\/p> <p> I've been back for\u00a0a few days now\u00a0but I have not had any time to write a review or post pics....here are a few pics for now but I plan to write a full review and my planning thread.\u00a0 Please feel free to ask me any questions about the resort!!\u00a0 I Loved it!!<\/p> <p> \u00a0<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"1.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/777255\/width\/467\/height\/700\" \/><\/span><\/p> <\/blockquote> <p> YOUR PICTURES ARE BEAUTIFUL!!<\/p> <p> \u00a0<\/p> <p> Can you post a few more? I will be getting married May 19, 2012, and I have never even been to this resort!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"johnsoncnicole@gmail.com","IpAddress":"","GroupId":47,"GroupName":"Site Supporter","JoinDate":1302373856,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-238683.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"Cnicole51911","Id":238683,"Name":"Cnicole51911","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"I