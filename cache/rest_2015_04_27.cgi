{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":22,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":1096,"MovedTo":null,"MovedOn":0,"FirstPostId":1842206,"Rating":0,"RatingHits":0,"Starter":{"Id":268499,"Name":"Meandhim","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-268499.jpg?_r=1395417550","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"StartDate":1396535446,"LastPoster":{"Id":280665,"Name":"JennyZ","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280665.jpg?_r=1413805399","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":60,"Preview":{"Id":1842206,"PostDate":1396535446,"PostContent":"So I'm trying to make an all inclusive budget... I'm having my wedding at an All Inclusive Resort...","Author":{"Signature":"<div>\u00a0<\/div>\n<div><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78914-meandhim-grand-palladium-bavaro-nov-2015\/'>My Planning Thread<\/a>\u00a0- MeandHim - Grand Palladium Bavaro - Nov 25 2015<\/div>\n<div>\u00a0<\/div>\n<div><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10765;116\/st\/20151125\/e\/Our+Wedding\/k\/461e\/event.png\" alt=\"event.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"markandshavonne@live.com","IpAddress":"70.30.85.211","GroupId":40,"GroupName":"Jr. Member","JoinDate":1365795659,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-268499.jpg?_r=1395417550","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"Meandhim","Id":268499,"Name":"Meandhim","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"207.219.69.246","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76758,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"4489dcc07847a507f612aba52526fb81","RawContent":"So I&#039;m trying to make an all inclusive budget... I&#039;m having my wedding at an All Inclusive Resort in Punta Cana and I&#039;m trying to figure how much cash I will need to bring for wedding tips and who do I tip? And when?\n\n\nI know I will tip the WC, DJ, Photographer, and Bartender... But how much? And as for the wait staff do I tip them each individually? Or as a group? \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1842206,"PostDate":1396535446,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                So I'm trying to make an all inclusive budget... I'm having my wedding at an All Inclusive Resort in Punta Cana and I'm trying to figure how much cash I will need to bring for wedding tips and who do I tip? And when?<br><br>\nI know I will tip the WC, DJ, Photographer, and Bartender... But how much? And as for the wait staff do I tip them each individually? Or as a group? <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div>\u00a0<\/div>\n<div><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78914-meandhim-grand-palladium-bavaro-nov-2015\/'>My Planning Thread<\/a>\u00a0- MeandHim - Grand Palladium Bavaro - Nov 25 2015<\/div>\n<div>\u00a0<\/div>\n<div><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10765;116\/st\/20151125\/e\/Our+Wedding\/k\/461e\/event.png\" alt=\"event.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"markandshavonne@live.com","IpAddress":"70.30.85.211","GroupId":40,"GroupName":"Jr. Member","JoinDate":1365795659,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-268499.jpg?_r=1395417550","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"Meandhim","Id":268499,"Name":"Meandhim","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.231.161.191","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76758,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8494fd1a6051269c188e93caedfe07be","RawContent":"Help!","Attachments":[],"Id":1843852,"PostDate":1397217890,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Help!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div>\u00a0<\/div>\n<div><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78914-meandhim-grand-palladium-bavaro-nov-2015\/'>My Planning Thread<\/a>\u00a0- MeandHim - Grand Palladium Bavaro - Nov 25 2015<\/div>\n<div>\u00a0<\/div>\n<div><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10765;116\/st\/20151125\/e\/Our+Wedding\/k\/461e\/event.png\" alt=\"event.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"markandshavonne@live.com","IpAddress":"70.30.85.211","GroupId":40,"GroupName":"Jr. Member","JoinDate":1365795659,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-268499.jpg?_r=1395417550","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"Meandhim","Id":268499,"Name":"Meandhim","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"97.91.185.236","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76758,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"d09265a668f1b5c58063f35d470793ad","RawContent":"&lt;div&gt;I found this post:&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;\n&lt;div style=\"font-size:12px;\"&gt;\n&lt;p&gt;Here girls I did some research on destination weddings and here was the best result&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;ul&gt;&lt;li&gt;You do not need to tip your florist unless he\/she does something spectacular or really out-of-the-floral-realm for you. If he tracks down the filling for your goody bags, or she blows your mind with something you weren&#039;t expecting, by all means, feel free to tip the florist. But it isn&#039;t something you need to build into your budget.&lt;\/li&gt;\n&lt;li&gt;You don\u00e2\u20ac\u2122t need to tip your caterer, but you will need to tip the servers and bartenders. If you don&#039;t have a wedding planner to guide you, ask the caterer what&#039;s appropriate per person.&lt;\/li&gt;\n&lt;li&gt;Don&#039;t tip the photographer. If you adored her, order more prints!&lt;\/li&gt;\n&lt;li&gt;Don&#039;t tip the wedding cake baker.&lt;\/li&gt;\n&lt;li&gt;Don&#039;t tip a band, unless they stay extra time and don&#039;t bill you for it.&lt;\/li&gt;\n&lt;li&gt;Tip a DJ if hes really, really good. $50 is more than enough.&lt;\/li&gt;\n&lt;li&gt;If you&#039;re staying in a small hotel and you&#039;ve taken over the whole place for your wedding, be sure to tip the hotel manager\/concierge who has helped you with everything. You should also tip the breakfast or housekeeping staff, but you don&#039;t need to do it individually. Give a tip to the person in charge of that staff and ask them to split it with the people who worked during your wedding.&lt;\/li&gt;\n&lt;li&gt;If you&#039;re staying at a villa or private property with a house manager or caretaker, tip if you&#039;re having the reception on the property and the person is being very helpful. Remember, the property owners made money on you. The caretaker or property manager is on salary and had to put up with you because it&#039;s part of his job. If they do a great job, acknowledge it. If you have daily maid service, it&#039;s appropriate to leave a tip of $2-$5 per day in your room. If you have a 5-bedroom house, you should tip $10 per day at the end of your stay if they did a good job.&lt;\/li&gt;\n&lt;li&gt;Do not tip your wedding officiant.&lt;\/li&gt;\n&lt;li&gt;Do not tip your rental equipment delivery guys as you paid a delivery fee already.&lt;\/li&gt;\n&lt;li&gt;Finally, do tip your wedding planner. As self-serving as this may sound, I get asked this question a lot so I&#039;m going to tackle it openly and honestly.&lt;\/li&gt;\n&lt;\/ul&gt;&lt;p&gt;If you have a good wedding planner who is charging you a reasonable fee and isn&#039;t marking up your services, you should tip her at the end of your wedding if you are happy with her services. When deciding how much to tip, think about how much her total fee was, and think about how much money she saved you (there will be items that stick out when you think about it), and how challenging you may have been as a client. If you know you drove her nuts or were very demanding (and she was nice about it), compensate her for the extra time and effort she had to put in to your big day. Tip between 15 and 20 percent of her wedding fee. To some extend it&#039;s like a restaurant, if you were satisfied, go 15 percent. If you were thrilled and she did a great job for you, go 20 percent or more. If you felt like she dropped the ball, give her 10 percent, or don&#039;t tip her at all. A tip is supposed to be a gratuity for a job well done, whether it&#039;s a waitress, a hairdresser or a wedding planner.&lt;\/p&gt;\n&lt;p&gt;The exception to the rule is the wedding planner who asks for a tip. That is just so gauche. Sometimes I&#039;ll make a joke about it to my clients when they&#039;re really super impressed with something I&#039;ve done. When they&#039;re telling me how great I am or how much money I&#039;ve saved them, I&#039;ll make some joke like remember that when it&#039;s time to tip me,\u00e2\u20ac or something like that. But I&#039;ve never ever told a bride up front that a tip was required, or asked a bride for a gratuity after the wedding. Some brides are just thoughtful. I&#039;ve received lovely thank-you gifts and even sweeter notes \u00e2\u20ac\u201d and those can be very rewarding as well.&lt;\/p&gt;\n&lt;p&gt;If you don&#039;t use a wedding planner and a banquet manager or someone else from the hotel steps into that role for your wedding, be prepared to tip her at the end of the event as long as everything has gone smoothly. She is your de facto wedding planner and you should thank her for executing that role well. It doesn&#039;t need to be as much as you would tip a wedding planner, but a token to let her know her work was appreciated is more than appropriate.&lt;\/p&gt;\n&lt;p&gt;So when your wedding planner gives you the list of tips you&#039;ll need for your wedding a few weeks before the big day, take a moment to think about whether you&#039;ll want to have some extra on hand to tip your planner too, assuming she delivers all that she promised on your wedding day. If in the end she doesn&#039;t deserve it, spend it on a spa day on your honeymoon.&lt;\/p&gt;\n&lt;\/div&gt;\n&lt;\/div&gt;\n&lt;p&gt;Sorry, this was supposed to be in my previous post: Credit goes to&amp;nbsp;@[member=\"Sllefebvr\"]&lt;\/p&gt;","Attachments":[],"Id":1844818,"PostDate":1397692642,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div>I found this post:<\/div>\n<div>\u00a0<\/div>\n<div>\u00a0<\/div>\n<div>\n<div  style=\"font-size:12px\">\n<p>Here girls I did some research on destination weddings and here was the best result<\/p>\n<p>\u00a0<\/p>\n<ul><li>You do not need to tip your florist unless he\/she does something spectacular or really out-of-the-floral-realm for you. If he tracks down the filling for your goody bags, or she blows your mind with something you weren't expecting, by all means, feel free to tip the florist. But it isn't something you need to build into your budget.<\/li>\n<li>You don\u00e2\u20ac\u2122t need to tip your caterer, but you will need to tip the servers and bartenders. If you don't have a wedding planner to guide you, ask the caterer what's appropriate per person.<\/li>\n<li>Don't tip the photographer. If you adored her, order more prints!<\/li>\n<li>Don't tip the wedding cake baker.<\/li>\n<li>Don't tip a band, unless they stay extra time and don't bill you for it.<\/li>\n<li>Tip a DJ if hes really, really good. $50 is more than enough.<\/li>\n<li>If you're staying in a small hotel and you've taken over the whole place for your wedding, be sure to tip the hotel manager\/concierge who has helped you with everything. You should also tip the breakfast or housekeeping staff, but you don't need to do it individually. Give a tip to the person in charge of that staff and ask them to split it with the people who worked during your wedding.<\/li>\n<li>If you're staying at a villa or private property with a house manager or caretaker, tip if you're having the reception on the property and the person is being very helpful. Remember, the property owners made money on you. The caretaker or property manager is on salary and had to put up with you because it's part of his job. If they do a great job, acknowledge it. If you have daily maid service, it's appropriate to leave a tip of $2-$5 per day in your room. If you have a 5-bedroom house, you should tip $10 per day at the end of your stay if they did a good job.<\/li>\n<li>Do not tip your wedding officiant.<\/li>\n<li>Do not tip your rental equipment delivery guys as you paid a delivery fee already.<\/li>\n<li>Finally, do tip your wedding planner. As self-serving as this may sound, I get asked this question a lot so I'm going to tackle it openly and honestly.<\/li>\n<\/ul><p>If you have a good wedding planner who is charging you a reasonable fee and isn't marking up your services, you should tip her at the end of your wedding if you are happy with her services. When deciding how much to tip, think about how much her total fee was, and think about how much money she saved you (there will be items that stick out when you think about it), and how challenging you may have been as a client. If you know you drove her nuts or were very demanding (and she was nice about it), compensate her for the extra time and effort she had to put in to your big day. Tip between 15 and 20 percent of her wedding fee. To some extend it's like a restaurant, if you were satisfied, go 15 percent. If you were thrilled and she did a great job for you, go 20 percent or more. If you felt like she dropped the ball, give her 10 percent, or don't tip her at all. A tip is supposed to be a gratuity for a job well done, whether it's a waitress, a hairdresser or a wedding planner.<\/p>\n<p>The exception to the rule is the wedding planner who asks for a tip. That is just so gauche. Sometimes I'll make a joke about it to my clients when they're really super impressed with something I've done. When they're telling me how great I am or how much money I've saved them, I'll make some joke like remember that when it's time to tip me,\u00e2\u20ac or something like that. But I've never ever told a bride up front that a tip was required, or asked a bride for a gratuity after the wedding. Some brides are just thoughtful. I've received lovely thank-you gifts and even sweeter notes \u00e2\u20ac\u201d and those can be very rewarding as well.<\/p>\n<p>If you don't use a wedding planner and a banquet manager or someone else from the hotel steps into that role for your wedding, be prepared to tip her at the end of the event as long as everything has gone smoothly. She is your de facto wedding planner and you should thank her for executing that role well. It doesn't need to be as much as you would tip a wedding planner, but a token to let her know her work was appreciated is more than appropriate.<\/p>\n<p>So when your wedding planner gives you the list of tips you'll need for your wedding a few weeks before the big day, take a moment to think about whether you'll want to have some extra on hand to tip your planner too, assuming she delivers all that she promised on your wedding day. If in the end she doesn't deserve it, spend it on a spa day on your honeymoon.<\/p>\n<\/div>\n<\/div><br \/><p>Sorry, this was supposed to be in my previous post: Credit goes to\u00a0@<a hovercard-ref=\"member\" hovercard-id=\"237131\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/237131-sllefebvr\/' title='Member profile'><span itemprop=\"name\">Sllefebvr<\/span><\/a><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-size:14px;\"><span style=\"font-family:arial, helvetica, sans-serif;\"><strong><span style=\"color:#ff6666;\">I love him & he loves me, we'll be married by the sea.<\/span><\/strong><\/span><\/span><br>\n\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77696-our-dw-dreams-riviera-cancun-17-apr-2015\/'>Planning\u00a0Journal<\/a>\u00a0& <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/blog\/86-my-destination-wedding-blog\/'>Blog<\/a><\/p>\n<p>\u00a0","Email":"tricia.d.davis@gmail.com","IpAddress":"97.91.185.236","GroupId":3,"GroupName":"Member","JoinDate":1396284119,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277418.jpg?_r=1429976005","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"pddcmc","Id":277418,"Name":"pddcmc","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"98.229.104.230","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76758,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7c5830d19575982e98164df3ae55a524","RawContent":"&lt;p&gt;This is good info!&lt;\/p&gt;","Attachments":[],"Id":1845016,"PostDate":1397784819,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>This is good info!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"malyna@gmail.com","IpAddress":"71.235.105.205","GroupId":40,"GroupName":"Jr. Member","JoinDate":1397443622,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277580.jpg?_r=1397779480","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"malyna","Id":277580,"Name":"malyna","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.231.76.48","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76758,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"74e5110f22d731183ac4452a3491d363","RawContent":"Thanks this is very helpful!\n\n\n\nSent from my iPad using Tapatalk","Attachments":[],"Id":1845467,"PostDate":1398134368,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks this is very helpful!<br><br><br>\nSent from my iPad using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div>\u00a0<\/div>\n<div><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78914-meandhim-grand-palladium-bavaro-nov-2015\/'>My Planning Thread<\/a>\u00a0- MeandHim - Grand Palladium Bavaro - Nov 25 2015<\/div>\n<div>\u00a0<\/div>\n<div><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10765;116\/st\/20151125\/e\/Our+Wedding\/k\/461e\/event.png\" alt=\"event.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"markandshavonne@live.com","IpAddress":"70.30.85.211","GroupId":40,"GroupName":"Jr. Member","JoinDate":1365795659,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-268499.jpg?_r=1395417550","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"Meandhim","Id":268499,"Name":"Meandhim","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.226.112.144","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76758,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"808b3069799ded1af3486b877a96af90","RawContent":"&lt;p&gt;I think it&#039;s hard to have firm, hard rules about tipping because it&#039;s so personal and everyone has different experiences. My FI and I generally tip very well, but we also don&#039;t hesitate to tip 0% if the service sucks and we&#039;ll often speak to a manager as well (I never got the point of the 10% \"bad\" tip). I think we&#039;re going to come in prepared to tip, then base the actual tip on performance&lt;\/p&gt;","Attachments":[],"Id":1845512,"PostDate":1398177959,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I think it's hard to have firm, hard rules about tipping because it's so personal and everyone has different experiences. My FI and I generally tip very well, but we also don't hesitate to tip 0% if the service sucks and we'll often speak to a manager as well (I never got the point of the 10% \"bad\" tip). I think we're going to come in prepared to tip, then base the actual tip on performance<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Married December 19, 2014 at Beach Palace Resort in Cancun, Mexico<\/p>\n<p>\u00a0<\/p>\n<p>My Planning Thread - <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/'>http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>My Wedding Review<\/p>\n<p>Part 1 - <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881197'>http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881197<\/a><\/p>\n<p>Part 2 - <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881590'>http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881590<\/a><\/p>\n<p>Part 3 - <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881861'>http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881861<\/a><\/p>\n<p>\u00a0","Email":"lilyluu83@gmail.com","IpAddress":"174.119.162.30","GroupId":3,"GroupName":"Member","JoinDate":1395612948,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277296.jpg?_r=1421643766","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"tygrrlily","Id":277296,"Name":"tygrrlily","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.36.235.231","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76758,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"739d656dd6b3d90e1f93ed23696eef6d","RawContent":"&lt;p&gt;Really helpful....I hadn&#039;t thought about the tips! Putting this on my things to remember list.&lt;\/p&gt;","Attachments":[],"Id":1847720,"PostDate":1398910485,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Really helpful....I hadn't thought about the tips! Putting this on my things to remember list.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"letitia_leaks@verizon.net","IpAddress":"63.119.183.254","GroupId":40,"GroupName":"Jr. Member","JoinDate":1397070122,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277534.jpg?_r=1397086760","PhotoWidth":160,"PhotoHeight":160,"PhotoType":"custom"},"FormattedName":"FutureMrsGlover","Id":277534,"Name":"FutureMrsGlover","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"12.185.204.194","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76758,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7a1da7d81a3bf61cae69a912c5222c86","RawContent":"&lt;p&gt;Great info!&lt;\/p&gt;","Attachments":[],"Id":1850475,"PostDate":1400176162,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Great info!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"heather.pfannes@gmail.com","IpAddress":"12.185.204.194","GroupId":39,"GroupName":"Newbie","JoinDate":1400165757,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277973.jpg?_r=1406503683","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"FutureMrsGrabs","Id":277973,"Name":"FutureMrsGrabs","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"63.247.185.226","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76758,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"49bd6a12aefa82593e1d4e033f59b570","RawContent":"&lt;p&gt;awesome information!&lt;\/p&gt;","Attachments":[],"Id":1850492,"PostDate":1400181206,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>awesome information!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sugeidylora@gmail.com","IpAddress":"63.247.185.226","GroupId":39,"GroupName":"Newbie","JoinDate":1381028171,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"none"},"FormattedName":"Sugui","Id":274027,"Name":"Sugui","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"69.117.93.162","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76758,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a90d2630b66af2c840ca0f1737a7c693","RawContent":"Very helpful! Thanks","Attachments":[],"Id":1860938,"PostDate":1405791943,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Very helpful! Thanks\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"bseasebey@yahoo.com","IpAddress":"69.117.93.162","GroupId":40,"GroupName":"Jr. Member","JoinDate":1402065568,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"SuchALady777","Id":278273,"Name":"SuchALady777","IsOnline":false}}],"Id":"76758","Title":"Budgeting For Tips... How Much?","LastPostDate":1429837125},"Pages":{"TotalItems":22,"TotalPages":3,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":20},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
