{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62152,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8d4afae70ac91dc6b57113ee20ee3162","RawContent":"Vanessa, glad to hear everything went well. Can&#039;t wait to see pics! RFinger, your wedding will be awesome and you will have a great time too!","Attachments":[],"Id":1611052,"PostDate":1335281277,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Vanessa, glad to hear everything went well. Can't wait to see pics! RFinger, your wedding will be awesome and you will have a great time too!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"writetojodi@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1299617006,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-237569.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":146,"PhotoType":"custom"},"FormattedName":"joda","Id":237569,"Name":"joda","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62152,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"12f50b8b18ce89cd48912e04dced9a77","RawContent":"HeatherViolet, \n \n Thank you!  I actually got those palm tree leaves at a wholesale floral company in Philadelphia.  I am not sure where else they carry them at but if I ever find out I will let you know.  :-) \n \n [quote]\nOriginally Posted by [b]HeatherViolet[\/b] \/img\/forum\/go_quote.gif\n \n \n Amy- \n those cute colored palm tree things you had for the table.  Where did you find those?  ADORABLE!!!! \n \n \n[\/quote] \n \n \n \n Vanessa56, \n \n CONGRATS!!!!!   I can&#039;t wait to hear how it went and to see pics!!!  Welcome Home!   :-) \n \n -Amy \n [quote]\nOriginally Posted by [b]Vanessa56[\/b] \/img\/forum\/go_quote.gif\n \n \n Hi Everyone.  \n \n Just wanted to let you know that we had our wedding this past Saturday.  Everything was absolutely beautiful.  I willl post more information and pictures later, but just wanted to stop in and let you know that you do not have anything to worry about.  Anel is absolutely wonderful!!!![\/quote]","Attachments":[],"Id":1611380,"PostDate":1335321559,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> HeatherViolet,<\/p> <p> \u00a0<\/p> <p> Thank you!\u00a0 I actually got those palm tree leaves at a wholesale floral company in Philadelphia.\u00a0 I am not sure where else they carry them at but if I ever find out I will let you know.\u00a0 :-)<\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>HeatherViolet<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> <p> Amy-<\/p> <p> those cute colored palm tree things you had for the table.\u00a0 Where did you find those?\u00a0 ADORABLE!!!!<\/p> <p> \u00a0<\/p> <p> <br \/> \u00a0<\/p> <\/blockquote> <p> \u00a0<\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <p> Vanessa56,<\/p> <p> \u00a0<\/p> <p> CONGRATS!!!!!\u00a0\u00a0 I can't wait to hear how it went and to see pics!!!\u00a0 Welcome Home!\u00a0\u00a0 :-)<\/p> <p> \u00a0<\/p> <p> -Amy<\/p> <p> \u00a0<\/p> <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>Vanessa56<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> <p> Hi Everyone.\u00a0<\/p> <p> \u00a0<\/p> <p> Just wanted to let you know that we had our wedding this past Saturday. \u00a0Everything was absolutely beautiful. \u00a0I willl post more information and pictures later, but just wanted to stop in and let you know that you do not have anything to worry about. \u00a0Anel is absolutely wonderful!!!!<\/p> <\/blockquote> <p> \u00a0<\/p> <p> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ladybug1280@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1284746058,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232417.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"AmyG","Id":232417,"Name":"AmyG","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62152,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b9fc06bc3f64cfb7553d782856a017d1","RawContent":"&lt;p&gt; Hi! Can anyone comment on the nightlife at resort? Thanks!!&amp;nbsp;&lt;img id=\"yui_3_4_1_2_1335490365366_166\" src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheesy.gif\" \/&gt;&lt;\/p&gt;","Attachments":[],"Id":1612446,"PostDate":1335494007,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hi! Can anyone comment on the nightlife at resort? Thanks!!\u00a0<span rel='lightbox'><img class='bbc_img' id=\"yui_3_4_1_2_1335490365366_166\" src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheesy.gif\" \/><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lauren.rapkin@gmail.com","IpAddress":"100.2.22.205","GroupId":39,"GroupName":"Newbie","JoinDate":1330637303,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-252152.jpg?_r=1397073315","PhotoWidth":200,"PhotoHeight":193,"PhotoType":"custom"},"FormattedName":"LaurenR","Id":252152,"Name":"LaurenR","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62152,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7809fc6dfed935360942c5cc153022cc","RawContent":"[quote]\nOriginally Posted by [b]LaurenR[\/b] \/img\/forum\/go_quote.gif\n \n \n Hi! Can anyone comment on the nightlife at resort? Thanks!! [img]http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheesy.gif[\/img][\/quote] \n \n My cousin has been asking me this as well... I don&#039;t know yet but could let you know on May 3","Attachments":[],"Id":1612587,"PostDate":1335537803,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> \u00a0<\/p> <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>LaurenR<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> <p> Hi! Can anyone comment on the nightlife at resort? Thanks!!\u00a0<span rel='lightbox'><img class='bbc_img' id=\"yui_3_4_1_2_1335490365366_166\" src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheesy.gif\" \/><\/span><\/p> <\/blockquote> <p> \u00a0<\/p> <p> My cousin has been asking me this as well... I don't know yet but could let you know on May 3<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ryan@panthersgrad.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1307990680,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-241083.jpg?_r=1388290366","PhotoWidth":200,"PhotoHeight":255,"PhotoType":"custom"},"FormattedName":"RFinger","Id":241083,"Name":"RFinger","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62152,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5a286c8dfc9baf4fe13d619b7a837aed","RawContent":"Hi LaurenR, \n \n The Lobby Bar and the Night Club are open until 1:00am.  The club is pretty small but does play fun dance music so it was always a good time....especially on our wedding night!  The Lobby Bar had a band playing in it almost every night as well and people could dance and socialize so that was also very fun!  My group seemed to have a great time hanging out at both of them and even out by the pool where we sort of created our own little parties poolside. \n On some nights of the week the resort hosts different events like Caribbean Night where they have shows and special buffets, but they go on at about 8:00pm and don&#039;t last that long.  They even have vendors come in selling some cool stuff. \n \n No one in my group left the resort to explore other night life options, but I did hear of tours that went into Cancun to clubs and bars that may be worth checking out if you&#039;re into that. \n \n :-) \n [quote]\nOriginally Posted by [b]LaurenR[\/b] \/img\/forum\/go_quote.gif\n \n \n Hi! Can anyone comment on the nightlife at resort? Thanks!! [img]http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheesy.gif[\/img][\/quote]","Attachments":[],"Id":1612644,"PostDate":1335541938,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hi LaurenR,<\/p> <p> \u00a0<\/p> <p> The Lobby Bar and the Night Club are open\u00a0until 1:00am.\u00a0 The club is pretty small but does play fun dance music so it was always a good time....especially on our wedding night!\u00a0 The Lobby Bar had a band playing in it almost every night as well and people could dance and socialize so that was also very fun!\u00a0 My group\u00a0seemed to have a\u00a0great time\u00a0hanging out at both of them and even out by the pool\u00a0where we\u00a0sort of created our own little parties poolside.<\/p> <p> On some nights of the week the resort hosts different events like Caribbean Night where they have shows and special buffets, but they go on at about 8:00pm and don't last that long.\u00a0 They even have vendors come in selling some cool stuff.<\/p> <p> \u00a0<\/p> <p> No one in my group left the resort to explore other night life options, but I did hear of tours that went into Cancun to clubs and bars that may be worth checking out if you're into that.<\/p> <p> \u00a0<\/p> <p> :-)<\/p> <p> \u00a0<\/p> <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>LaurenR<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> <p> Hi! Can anyone comment on the nightlife at resort? Thanks!!\u00a0<span rel='lightbox'><img class='bbc_img' id=\"yui_3_4_1_2_1335490365366_166\" src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheesy.gif\" \/><\/span><\/p> <\/blockquote> <p> \u00a0<\/p> <p> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ladybug1280@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1284746058,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232417.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"AmyG","Id":232417,"Name":"AmyG","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62152,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d410595588dd038cede76fb801e44e2a","RawContent":"[quote name=\"AmyG\"]\n&lt;p&gt; Hi LaurenR,&lt;\/p&gt;&lt;p&gt; &amp;nbsp;&lt;\/p&gt;&lt;p&gt; The Lobby Bar and the Night Club are open&amp;nbsp;until 1&#58;00am.&amp;nbsp; The club is pretty small but does play fun dance music so it was always a good time....especially on our wedding night!&amp;nbsp; The Lobby Bar had a band playing in it almost every night as well and people could dance and socialize so that was also very fun!&amp;nbsp; My group&amp;nbsp;seemed to have a&amp;nbsp;great time&amp;nbsp;hanging out at both of them and even out by the pool&amp;nbsp;where we&amp;nbsp;sort of created our own little parties poolside.&lt;\/p&gt;&lt;p&gt; On some nights of the week the resort hosts different events like Caribbean Night where they have shows and special buffets, but they go on at about 8&#58;00pm and don&#039;t last that long.&amp;nbsp; They even have vendors come in selling some cool stuff.&lt;\/p&gt;&lt;p&gt; &amp;nbsp;&lt;\/p&gt;&lt;p&gt; No one in my group left the resort to explore other night life options, but I did hear of tours that went into Cancun to clubs and bars that may be worth checking out if you&#039;re into that.&lt;\/p&gt;&lt;p&gt; &amp;nbsp;&lt;\/p&gt;&lt;p&gt; &#58;-)&lt;\/p&gt;&lt;p&gt; &amp;nbsp;&lt;\/p&gt;&lt;div class=\"quote-container\"&gt; &lt;span&gt;Quote&#58;&lt;\/span&gt; &lt;div class=\"quote-block\"&gt; Originally Posted by &lt;strong&gt;LaurenR&lt;\/strong&gt;&amp;nbsp;&lt;img alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/&gt;\n \n &lt;p&gt; Hi! Can anyone comment on the nightlife at resort? Thanks!!&amp;nbsp;&lt;img id=\"yui_3_4_1_2_1335490365366_166\" src=\"http&#58;\/\/files.bestdestinationwedding.com\/images\/smilies\/cheesy.gif\" \/&gt;&lt;\/p&gt; &lt;\/div&gt;&lt;\/div&gt;&lt;p&gt; &amp;nbsp;&lt;\/p&gt;&lt;p&gt; &amp;nbsp;&lt;\/p&gt;[\/quote] Exactly what Amy said. For our group, most who like to have a good time but aren&#039;t huge party-ers it was enough, but it is more of a chill \"night life\". No one in our group went in to the clubs, but you definitely could if you really wanted a night or two to really party.","Attachments":[],"Id":1612661,"PostDate":1335542864,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <blockquote class='ipsBlockquote' data-author=\"AmyG\" url=\"\/t\/74418\/now&#045;sapphire&#045;weddings&#045;formerly&#045;paradisus&#045;riviera\/380#post_1762212\"><p><p> Hi LaurenR,<\/p><p> \u00a0<\/p><p> The Lobby Bar and the Night Club are open\u00a0until 1&#58;00am.\u00a0 The club is pretty small but does play fun dance music so it was always a good time....especially on our wedding night!\u00a0 The Lobby Bar had a band playing in it almost every night as well and people could dance and socialize so that was also very fun!\u00a0 My group\u00a0seemed to have a\u00a0great time\u00a0hanging out at both of them and even out by the pool\u00a0where we\u00a0sort of created our own little parties poolside.<\/p><p> On some nights of the week the resort hosts different events like Caribbean Night where they have shows and special buffets, but they go on at about 8&#58;00pm and don't last that long.\u00a0 They even have vendors come in selling some cool stuff.<\/p><p> \u00a0<\/p><p> No one in my group left the resort to explore other night life options, but I did hear of tours that went into Cancun to clubs and bars that may be worth checking out if you're into that.<\/p><p> \u00a0<\/p><p> &#58;-)<\/p><p> \u00a0<\/p><div class=\"quote-container\"> <span>Quote&#58;<\/span> <div class=\"quote-block\"> Originally Posted by <strong>LaurenR<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/>\n <br \/>\n <p> Hi! Can anyone comment on the nightlife at resort? Thanks!!\u00a0<span rel='lightbox'><img class='bbc_img' id=\"yui_3_4_1_2_1335490365366_166\" src=\"http&#58;\/\/files.bestdestinationwedding.com\/images\/smilies\/cheesy.gif\" \/><\/span><\/p> <\/div><\/div><p> \u00a0<\/p><p> \u00a0<\/p><\/p><\/blockquote> Exactly what Amy said. For our group, most who like to have a good time but aren't huge party-ers it was enough, but it is more of a chill \"night life\". No one in our group went in to the clubs, but you definitely could if you really wanted a night or two to really party.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"writetojodi@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1299617006,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-237569.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":146,"PhotoType":"custom"},"FormattedName":"joda","Id":237569,"Name":"joda","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62152,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"63fc5fff210e1877e7bd8bce0f9cc2f3","RawContent":"&lt;p&gt; Amy G,&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; I just booked my wedding for April 2013. We were looking at the Gazebos but cant seem to find any good pictures of them. The only one that tends to pop up are pictures of the one in the pool. Can you please tell me if the gazebos are good enough for a wedding. i believe the one we like is surrounded by water, it might possibly even have a chess board in it?? Any suggestions on the best most private ceremony site?&lt;\/p&gt; &lt;p&gt; Any suggestions or pics are appreciated&lt;\/p&gt;","Attachments":[],"Id":1613558,"PostDate":1335747501,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Amy G,<\/p> <p> \u00a0<\/p> <p> I just booked my wedding for April 2013. We were looking at the Gazebos but cant seem to find any good pictures of them. The only one that tends to pop up are pictures of the one in the pool. Can you please tell me if the gazebos are good enough for a wedding. i believe the one we like is surrounded by water, it might possibly even have a chess board in it?? Any suggestions on the best most private ceremony site?<\/p> <p> Any suggestions or pics are appreciated<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"a_fleetwood6@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1333251668,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-253433.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Noxx","Id":253433,"Name":"Noxx","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62152,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e1807583ea3fe9168ca5096b2981b63d","RawContent":"[quote]\nOriginally Posted by [b]Noxx[\/b] \/img\/forum\/go_quote.gif\n \n \n Amy G, \n \n I just booked my wedding for April 2013. We were looking at the Gazebos but cant seem to find any good pictures of them. The only one that tends to pop up are pictures of the one in the pool. Can you please tell me if the gazebos are good enough for a wedding. i believe the one we like is surrounded by water, it might possibly even have a chess board in it?? Any suggestions on the best most private ceremony site? \n Any suggestions or pics are appreciated[\/quote] \n \n \n Hi Noxx, \n \n I am not Amy, but I will answer anyway! Our wedding was booked (and took place) on the Tequila Beach. But we went around with Ramon to discuss a plan if there happened to be rain. One of the backups in case of rain was the gazebo you are talking about, which does normally have large chess pieces on it. I will attach a picture, although it&#039;s not very good, to try and give you an idea of where it is located. In the front you will see the pool gazebo, and behind that another dome. That is the \"chess gazebo\". So if you are in the gazebo, to the left you have the lobby bar, to the right where they hold the event nights, and right in front the pool. He said they have a blind thing that they pull down to try and block as many people as possible from the lobby bar area, but it is still completely open pool side, which I really didn&#039;t like. Especially as if people gather there, they will all be behind you in your pictures! Unless they block them, but I don&#039;t see how they would do that, because that is the only way to get around on that side of the pool. He also said they would turn off the pool\/lobby music during the ceremony, but you would still have all the shouting, etc from the pool. \n \n [img]http:\/\/www.bestdestinationwedding.com\/image\/id\/813262\/width\/550\/height\/400[\/img] \n \n The other option we were given was actually really private, but you won&#039;t have the beach feel at all, and I guess it may not work depending on how many people you have at your wedding. But we were discussing the ball room in case of rain (which is MASSIVE) and right outside of the room you have an open space that has a bunch of trees on one side, and then a big wooden lattice \"wall\" in front. The other side is open, to the hallway, but hardly anyone ever walks there, so it would be really private. And it was actually quite pretty, so it was definitely what I was going to use if there was rain. I don&#039;t have any pictures of it, but you could probably get Ramon or Anel to send you one. Or maybe you could rope RFinger into taking one for you [img]http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheesy.gif[\/img] \n \n For me, I wanted to be married on the beach, that&#039;s why we picked a destination wedding in Mexico. The location is not totally private, but there were really not that many onlookers, and anyone who was walking along the beach was directed up and around us so as not to get in pictures. And I was told this before I got married, and didn&#039;t believe it, but I really didn&#039;t notice the other people while the ceremony was going on, so to me it was no problem! I am a very private person, but it really was no big deal. \n \n Anyway, that&#039;s two cents, hopefully it helps you a bit. \n \n Anyway, my two cents.","Attachments":[],"Id":1613567,"PostDate":1335749369,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> \u00a0<\/p> <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>Noxx<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> <p> Amy G,<\/p> <p> \u00a0<\/p> <p> I just booked my wedding for April 2013. We were looking at the Gazebos but cant seem to find any good pictures of them. The only one that tends to pop up are pictures of the one in the pool. Can you please tell me if the gazebos are good enough for a wedding. i believe the one we like is surrounded by water, it might possibly even have a chess board in it?? Any suggestions on the best most private ceremony site?<\/p> <p> Any suggestions or pics are appreciated<\/p> <\/blockquote> <p> \u00a0<\/p> <p> <br \/> Hi Noxx,<\/p> <p> \u00a0<\/p> <p> I am not Amy, but I will answer anyway! Our wedding was booked (and took place) on the Tequila Beach. But we went around with Ramon to discuss a plan if there happened to be rain. One of the backups in case of rain was the gazebo you are talking about, which does normally have large chess pieces on it. I will attach a picture, although it's not very good, to try and give you an idea of where it is located. In the front you will see the pool gazebo, and behind that another dome. That is the \"chess gazebo\". So if you are in the gazebo, to the left you have the lobby bar, to the right where they hold the event nights, and right in front the pool. He said they have a blind thing that they pull down to try and block as many people as possible from the lobby bar area, but it is still completely open pool side, which I really didn't like. Especially as if people gather there, they will all be behind you in your pictures! Unless they block them, but I don't see how they would do that, because that is the only way to get around on that side of the pool. He also said they would turn off the pool\/lobby music during the ceremony, but you would still have all the shouting, etc from the pool.<\/p> <p> \u00a0<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"http:\/\/im1.shutterfly.com\/media\/47a2da08b3127cceffaeb2e58f7500000010O00AYtW7Nu4ZN2IPbz4C\/cC\/f%3D0\/ps%3D50\/r%3D0\/rx%3D550\/ry%3D400\/\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/813262\/width\/550\/height\/400\" \/><\/span><\/p> <p> \u00a0<\/p> <p> The other option we were given was actually really private, but you won't have the beach feel at all, and I guess it may not work depending on how many people you have at your wedding. But we were discussing the ball room in case of rain (which is MASSIVE) and right outside of the room you have an open space that has a bunch of trees on one side, and then a big wooden lattice \"wall\" in front. The other side is open, to the hallway, but hardly anyone ever walks there, so it would be really private. And it was actually quite pretty, so it was definitely what I was going to use if there was rain. I don't have any pictures of it, but you could probably get Ramon or Anel to send you one. Or maybe you could rope RFinger into taking one for you <span alt=\":D\" rel=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheesy.gif\"><span rel='lightbox'><img class='bbc_img' id=\"yui_3_4_1_2_1335744847221_365\" src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheesy.gif\" \/><\/span><\/span><\/p> <p> \u00a0<\/p> <p> For me, I wanted to be married on the beach, that's why we picked a destination wedding in Mexico. The location is not totally private, but there were really not that many onlookers, and anyone who was walking along the beach was directed up and around us so as not to get in pictures. And I was told this before I got married, and didn't believe it, but I really didn't notice the other people while the ceremony was going on, so to me it was no problem! I am a very private person, but it really was no big deal.<\/p> <p> \u00a0<\/p> <p> Anyway, that's two cents, hopefully it helps you a bit.<\/p> <p> \u00a0<\/p> <p> Anyway, my two cents.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"writetojodi@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1299617006,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-237569.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":146,"PhotoType":"custom"},"FormattedName":"joda","Id":237569,"Name":"joda","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62152,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"15602206744d8d997277c000c9be08de","RawContent":"&lt;p&gt; Ooops, sorry for the typo at the end!&lt;\/p&gt;","Attachments":[],"Id":1613568,"PostDate":1335749428,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Ooops, sorry for the typo at the end!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"writetojodi@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1299617006,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-237569.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":146,"PhotoType":"custom"},"FormattedName":"joda","Id":237569,"Name":"joda","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62152,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8daaddf63647ff3e3af1eb3c379d06d2","RawContent":"&lt;p&gt; I am getting a global data plan added to my phone so I probably could take a picture and post.&lt;\/p&gt;","Attachments":[],"Id":1613705,"PostDate":1335799478,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I am getting a global data plan added to my phone so I probably could take a picture and post.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ryan@panthersgrad.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1307990680,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-241083.jpg?_r=1388290366","PhotoWidth":200,"PhotoHeight":255,"PhotoType":"custom"},"FormattedName":"RFinger","Id":241083,"Name":"RFinger","IsOnline":false}}],"Pages":{"TotalItems":2541,"TotalPages":255,"CurrentPage":380,"NextPage":390,"PreviousPage":370,"LastPage":2540},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
