{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":168,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":true,"Views":8285,"MovedTo":null,"MovedOn":0,"FirstPostId":1815672,"Rating":0,"RatingHits":0,"Starter":{"Id":275084,"Name":"WesnKris","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275084.jpg?_r=1386562444","PhotoWidth":160,"PhotoHeight":160,"PhotoType":"custom"},"IsOnline":false},"StartDate":1384828256,"LastPoster":{"Id":278674,"Name":"jennifernoel1","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278674.jpg?_r=1405114043","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":95,"Preview":{"Id":1815672,"PostDate":1384828256,"PostContent":"This is a place for up to date information can be shared and we can give each other support and a...","Author":{"Signature":"<p>~WesnKris<\/p>\n<p> <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wub.png' class='bbc_emoticon' alt=':wub:' \/>\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wub.png' class='bbc_emoticon' alt=':wub:' \/>\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wub.png' class='bbc_emoticon' alt=':wub:' \/>","Email":"wesnkristogether@gmail.com","IpAddress":"69.179.161.30","GroupId":39,"GroupName":"Newbie","JoinDate":1384549710,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275084.jpg?_r=1386562444","PhotoWidth":160,"PhotoHeight":160,"PhotoType":"custom"},"FormattedName":"WesnKris","Id":275084,"Name":"WesnKris","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75612,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"847929f7e97c6e2b6ed1e862eb9ee28f","RawContent":"&lt;p&gt;This is a place for up to date information can be shared and we can give each other support and advice!!! I am getting married on 4\/25\/15!!&lt;\/p&gt;","Attachments":[],"Id":1815672,"PostDate":1384828256,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>This is a place for up to date information can be shared and we can give each other support and advice!!! I am getting married on 4\/25\/15!!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>~WesnKris<\/p>\n<p> <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wub.png' class='bbc_emoticon' alt=':wub:' \/>\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wub.png' class='bbc_emoticon' alt=':wub:' \/>\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wub.png' class='bbc_emoticon' alt=':wub:' \/>","Email":"wesnkristogether@gmail.com","IpAddress":"69.179.161.30","GroupId":39,"GroupName":"Newbie","JoinDate":1384549710,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275084.jpg?_r=1386562444","PhotoWidth":160,"PhotoHeight":160,"PhotoType":"custom"},"FormattedName":"WesnKris","Id":275084,"Name":"WesnKris","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"216.9.107.21","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75612,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6cdc1c5af12a8ba4f41fbcc487ce7b99","RawContent":"&lt;p&gt;Hi @[member=\"WesnKris\"] Im hoping to get married in the Rose hall area on 04\/24\/15. We are currently looking at the aqueduct for our venue, but are not sure about our reception. Have you done a site tour of the Iberostar hotels? Also, do you have a wedding planner or will you doing all of the planning? I don&#039;t know where to begin :)Thanks so much for your help!&lt;\/p&gt;","Attachments":[],"Id":1826375,"PostDate":1389824271,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi @<a hovercard-ref=\"member\" hovercard-id=\"275084\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/275084-wesnkris\/' title='Member profile'><span itemprop=\"name\">WesnKris<\/span><\/a> Im hoping to get married in the Rose hall area on 04\/24\/15. We are currently looking at the aqueduct for our venue, but are not sure about our reception. Have you done a site tour of the Iberostar hotels? Also, do you have a wedding planner or will you doing all of the planning? I don't know where to begin :)Thanks so much for your help!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"shauna.phillipskelly@gmail.com","IpAddress":"205.241.31.2","GroupId":47,"GroupName":"Site Supporter","JoinDate":1389749225,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"skelly0386","Id":276089,"Name":"skelly0386","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.36.235.231","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75612,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"77611dbbd70b250585af52679f085838","RawContent":"&lt;p&gt;@[member=\"skelly0386\"]...I did a site visit to Iberostar Grand and Rose Hall.&amp;nbsp; Very nice accommodations.&amp;nbsp;My issue was I like the wedding location Rose Hall and the reception location at Grand....however, you can&#039;t switch up.&amp;nbsp; You have to do both the ceremony and the reception at the same hotel.&amp;nbsp; So I am now looking at Secrets and Royalton White Sands because based on the pics I like there ceremony and reception locations better.&amp;nbsp; I am going on another site visit June 6th so I will post pictures.&lt;\/p&gt;","Attachments":[],"Id":1847908,"PostDate":1398993930,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"276089\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/276089-skelly0386\/' title='Member profile'><span itemprop=\"name\">skelly0386<\/span><\/a>...I did a site visit to Iberostar Grand and Rose Hall.\u00a0 Very nice accommodations.\u00a0My issue was I like the wedding location Rose Hall and the reception location at Grand....however, you can't switch up.\u00a0 You have to do both the ceremony and the reception at the same hotel.\u00a0 So I am now looking at Secrets and Royalton White Sands because based on the pics I like there ceremony and reception locations better.\u00a0 I am going on another site visit June 6th so I will post pictures.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"letitia_leaks@verizon.net","IpAddress":"63.119.183.254","GroupId":40,"GroupName":"Jr. Member","JoinDate":1397066522,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277534.jpg?_r=1397086760","PhotoWidth":160,"PhotoHeight":160,"PhotoType":"custom"},"FormattedName":"FutureMrsGlover","Id":277534,"Name":"FutureMrsGlover","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"205.241.31.2","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75612,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"3303fb2fbbc8eb98f2afec7678caf2de","RawContent":"&lt;p&gt;Thank &amp;nbsp;you @[member=\"FutureMrsGlover\"]! We will be having our wedding at the aqueduct and reception at the Iberostar Grand. We went on a site tour of the Grand and I did not like their ceremony options, so we decided to just have our reception at the port maria restaurant and wedding offsite. We put down the deposit and everything seems to be falling in place. Good luck with your June 6th visit :)&lt;\/p&gt;","Attachments":[],"Id":1852264,"PostDate":1401221693,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Thank \u00a0you @<a hovercard-ref=\"member\" hovercard-id=\"277534\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277534-futuremrsglover\/' title='Member profile'><span itemprop=\"name\">FutureMrsGlover<\/span><\/a>! We will be having our wedding at the aqueduct and reception at the Iberostar Grand. We went on a site tour of the Grand and I did not like their ceremony options, so we decided to just have our reception at the port maria restaurant and wedding offsite. We put down the deposit and everything seems to be falling in place. Good luck with your June 6th visit <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"shauna.phillipskelly@gmail.com","IpAddress":"205.241.31.2","GroupId":47,"GroupName":"Site Supporter","JoinDate":1389749225,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"skelly0386","Id":276089,"Name":"skelly0386","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"162.238.70.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75612,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"f66433c619df647b29d93ec3d24dc402","RawContent":"Hey everyone! My fianc\u00e9e and I have booked our wedding at the Suites for October 24th, 2015! I am so excited! \n\nSo far I am looking into outside photographers as the resort photographers prices are outrageous for what you get. I have received my save the dates and will be mailing those out next week! I haven&#039;t decided on details like ceremony location or reception yet bc it all depends on our final guest count. We really want a beach reception but I&#039;ve heard stories of being too windy etc so I am sort of skeptical on that.","Attachments":[],"Id":1853494,"PostDate":1401794094,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hey everyone! My fianc\u00e9e and I have booked our wedding at the Suites for October 24th, 2015! I am so excited! <br>\nSo far I am looking into outside photographers as the resort photographers prices are outrageous for what you get. I have received my save the dates and will be mailing those out next week! I haven't decided on details like ceremony location or reception yet bc it all depends on our final guest count. We really want a beach reception but I've heard stories of being too windy etc so I am sort of skeptical on that. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"hkorkovilis@gmail.com","IpAddress":"162.238.70.23","GroupId":40,"GroupName":"Jr. Member","JoinDate":1401627292,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278186.jpg?_r=1417419505","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"helenk","Id":278186,"Name":"helenk","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"162.238.70.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75612,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ad776d6856354664b569f7ebccade3d7","RawContent":"How is everyone on the planning process? I had my invitation saved online but I guess it&#039;s gone now :( I searched through hundreds of invites on the site I had it saved from but no luck :( I&#039;ve chosen a new invitation though, will probably be mailing those out at the beginning of the year. I&#039;ve been thinking about decor and things but haven&#039;t made any final decisions. I&#039;m also waiting to go dress shopping so I can go with my mom back home in Boston. Since we decided to not have a bridal party, I&#039;m finding it hard to pick a color theme! I really love coral and teal so I may try to find a few things in those colors to add to the ceremony decor. I&#039;ve seen some brides with colored sashes they brought for the chairs and little starfish attached. Anyone know where I can find those? They&#039;re so cute. \n\n\n\nSent from my iPad using Tapatalk","Attachments":[],"Id":1858630,"PostDate":1404843053,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                How is everyone on the planning process? I had my invitation saved online but I guess it's gone now <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/sad.png' class='bbc_emoticon' alt=':(' \/> I searched through hundreds of invites on the site I had it saved from but no luck <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/sad.png' class='bbc_emoticon' alt=':(' \/> I've chosen a new invitation though, will probably be mailing those out at the beginning of the year. I've been thinking about decor and things but haven't made any final decisions. I'm also waiting to go dress shopping so I can go with my mom back home in Boston. Since we decided to not have a bridal party, I'm finding it hard to pick a color theme! I really love coral and teal so I may try to find a few things in those colors to add to the ceremony decor. I've seen some brides with colored sashes they brought for the chairs and little starfish attached. Anyone know where I can find those? They're so cute. <br><br><br>\nSent from my iPad using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"hkorkovilis@gmail.com","IpAddress":"162.238.70.23","GroupId":40,"GroupName":"Jr. Member","JoinDate":1401627292,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278186.jpg?_r=1417419505","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"helenk","Id":278186,"Name":"helenk","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"208.91.164.254","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75612,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"3b3e9d7ecc23d6f494516222d879ff11","RawContent":"&lt;p&gt;@[member=\"helenk\"] its so funny. You&#039;re the one with the date lol&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I choose that date and had to change to the day before because it was booked. I never imagined that it would be book so early.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;You can get sashes from tablecloth factory. They usually have anywhere for 20-35%off. The stars you can get from micahels, oriental trading, i dont know if you live near a bealls outlet, hobby lobby.&lt;\/p&gt;","Attachments":[],"Id":1859105,"PostDate":1405114656,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"278186\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/278186-helenk\/' title='Member profile'><span itemprop=\"name\">helenk<\/span><\/a> its so funny. You're the one with the date lol<\/p>\n<p>\u00a0<\/p>\n<p>I choose that date and had to change to the day before because it was booked. I never imagined that it would be book so early.<\/p>\n<p>\u00a0<\/p>\n<p>You can get sashes from tablecloth factory. They usually have anywhere for 20-35%off. The stars you can get from micahels, oriental trading, i dont know if you live near a bealls outlet, hobby lobby.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"noeljennifer1@yahoo.com","IpAddress":"12.52.150.2","GroupId":40,"GroupName":"Jr. Member","JoinDate":1403618319,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278674.jpg?_r=1405114043","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"jennifernoel1","Id":278674,"Name":"jennifernoel1","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.87.120.29","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75612,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"df8a7dfdcec9169b3a42dece3dfeafbf","RawContent":"@[member=\"jennifernoel1\"] wait so you&#039;re getting married at the suites on October 23 2015??? So fun! That&#039;s exciting we&#039;ll be there at the same time! Yes I&#039;m def gonna check out michaels and those online places! \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1859108,"PostDate":1405115831,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"278674\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/278674-jennifernoel1\/' title='Member profile'><span itemprop=\"name\">jennifernoel1<\/span><\/a> wait so you're getting married at the suites on October 23 2015??? So fun! That's exciting we'll be there at the same time! Yes I'm def gonna check out michaels and those online places! <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"hkorkovilis@gmail.com","IpAddress":"162.238.70.23","GroupId":40,"GroupName":"Jr. Member","JoinDate":1401627292,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278186.jpg?_r=1417419505","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"helenk","Id":278186,"Name":"helenk","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.231.156.214","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75612,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"09fb3e109f367da1eefebcd879af0bfd","RawContent":"@[member=\"helenk\"] yep will be there at the same time. \n\n\nI&#039;m using allinclusiveoutlet.com as my agent 3nights @$540 pp w\/$50 deposit and $178 for each addl night. \n\n\nThis includes transportation to and from the airport\/hotel.  I haven&#039;t signed a contract just because I&#039;m trying too see If there are any lower agents out there \n@[member=\"helenk\"] ,\n\n\nYea there photographers don&#039;t provide quality pictures so stay away. We took some from them when we went on vaca and let&#039;s just say that my Nikon took better pics. \n\n\nI&#039;m think I&#039;m going to bring my own from florida","Attachments":[],"Id":1859120,"PostDate":1405125834,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"278186\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/278186-helenk\/' title='Member profile'><span itemprop=\"name\">helenk<\/span><\/a> yep will be there at the same time. <br><br>\nI'm using allinclusiveoutlet.com as my agent 3nights @$540 pp w\/$50 deposit and $178 for each addl night. <br><br>\nThis includes transportation to and from the airport\/hotel.  I haven't signed a contract just because I'm trying too see If there are any lower agents out there <br \/>@<a hovercard-ref=\"member\" hovercard-id=\"278186\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/278186-helenk\/' title='Member profile'><span itemprop=\"name\">helenk<\/span><\/a> ,<br><br>\nYea there photographers don't provide quality pictures so stay away. We took some from them when we went on vaca and let's just say that my Nikon took better pics. <br><br>\nI'm think I'm going to bring my own from florida \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"noeljennifer1@yahoo.com","IpAddress":"12.52.150.2","GroupId":40,"GroupName":"Jr. Member","JoinDate":1403618319,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278674.jpg?_r=1405114043","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"jennifernoel1","Id":278674,"Name":"jennifernoel1","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"162.238.70.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75612,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cb3980354d51614589f8edbbc925064c","RawContent":"I&#039;m using a travel agent\/wedding coordinator through modern destination weddings. It&#039;s a free service, you only pay a $100 deposit, which goes towards your travel expenses. They help you coordinate with the resort, sort of like a middle man and are going to be helping with booking the travel at the lowest rates available for us and our guests and also with booking our honeymoon. The rates for flights aren&#039;t up yet so I don&#039;t have any quotes. When I was deciding on resorts I went onto Cheapcaribbean.com to get pricing ideas for that time of year and it had said about $950 pp for 3 nights (fri-mon) including flights from boston\/NY (majority of our guests will be flying out from those cities). \n\n\n\nSent from my iPhone using Tapatalk\n@[member=\"jennifernoel1\"] We booked an outside photographer based in Jamaica. I read bad reviews on digipix and their prices were too pricey for what you get. \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1859122,"PostDate":1405126064,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I'm using a travel agent\/wedding coordinator through modern destination weddings. It's a free service, you only pay a $100 deposit, which goes towards your travel expenses. They help you coordinate with the resort, sort of like a middle man and are going to be helping with booking the travel at the lowest rates available for us and our guests and also with booking our honeymoon. The rates for flights aren't up yet so I don't have any quotes. When I was deciding on resorts I went onto Cheapcaribbean.com to get pricing ideas for that time of year and it had said about $950 pp for 3 nights (fri-mon) including flights from boston\/NY (majority of our guests will be flying out from those cities). <br><br><br>\nSent from my iPhone using Tapatalk<br \/>@<a hovercard-ref=\"member\" hovercard-id=\"278674\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/278674-jennifernoel1\/' title='Member profile'><span itemprop=\"name\">jennifernoel1<\/span><\/a> We booked an outside photographer based in Jamaica. I read bad reviews on digipix and their prices were too pricey for what you get. <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"hkorkovilis@gmail.com","IpAddress":"162.238.70.23","GroupId":40,"GroupName":"Jr. Member","JoinDate":1401627292,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278186.jpg?_r=1417419505","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"helenk","Id":278186,"Name":"helenk","IsOnline":false}}],"Id":"75612","Title":"2015 Iberostar Rose Hall Suite Bride","LastPostDate":1435026478},"Pages":{"TotalItems":168,"TotalPages":17,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":160},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
