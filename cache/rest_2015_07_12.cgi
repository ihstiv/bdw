 everyone! \u00a0After months of lurking on here (and a few random posts) I'm officially ready to st...","Author":{"Signature":"<p>My planning thread: \u00a0\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79284-leighcs-planning-thread-april-9-2016\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79284-leighcs-planning-thread-april-9-2016\/<\/a>","Email":"lcampbe8@gmail.com","IpAddress":"66.250.56.118","GroupId":39,"GroupName":"Newbie","JoinDate":1424802262,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"LeighC","Id":282234,"Name":"LeighC","IsOnline":false}},"Posts":[],"Id":"79284","Title":"Leighc's Planning Thread--April 9, 2016","LastPostDate":1436488203},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":33,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":1343,"MovedTo":null,"MovedOn":0,"FirstPostId":1898197,"Rating":0,"RatingHits":0,"Starter":{"Id":275855,"Name":"rachelia160","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275855.jpg?_r=1435853657","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"StartDate":1433863682,"LastPoster":{"Id":275855,"Name":"rachelia160","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275855.jpg?_r=1435853657","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":60,"Preview":{"Id":1898197,"PostDate":1433863682,"PostContent":"I'm actually answering the question in my topic instead of asking it! \u00a0 My FI (still calling him...","Author":{"Signature":"","E