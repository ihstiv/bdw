{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":331,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":14898,"MovedTo":null,"MovedOn":0,"FirstPostId":195110,"Rating":0,"RatingHits":0,"Starter":{"Id":207506,"Name":"Spazz","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"none"},"IsOnline":false},"StartDate":1202950662,"LastPoster":{"Id":265511,"Name":"TinkerSofi","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265511.jpg?_r=1427386564","PhotoWidth":200,"PhotoHeight":153,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":39,"Preview":{"Id":1896046,"PostDate":1431441115,"PostContent":"Make sure you're applying the wax in the direction of the hair and removing it against the hair...","Author":{"Signature":"<br><p><a data-ipb='nomediaparse' href='http:\/\/www.TickerFactory.com\/'><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;31;484\/st\/20150813\/e\/Wedding+time%21+\/dt\/-2\/k\/b92c\/event.png\" alt=\"event.png\"><\/a><\/p>\n<p style=\"text-align:center;\">\u00a0<\/p>\n<p style=\"text-align:center;\">\u00a0","Email":"sblopezb@gmail.com","IpAddress":"172.219.193.22","GroupId":42,"GroupName":"Sr. Member","JoinDate":1359745104,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265511.jpg?_r=1427386564","PhotoWidth":200,"PhotoHeight":153,"PhotoType":"custom"},"FormattedName":"TinkerSofi","Id":265511,"Name":"TinkerSofi","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":11375,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"d61f600e7168d7e3ed0ab90c3f70765b","RawContent":"Ok, this is probably going to sound really naive because I am 28 years old, but... I have never had a bikini wax. I want to get one for the BD pics and for Jamaica. Can someone tell me how I prepare for this, any suggestions where to go, what to wear and how much it hurts (lol!)? \n \n (I searched for a thread about this but couldn&#039;t find one. If there already is one, someone please direct me!).","Attachments":[],"Id":195110,"PostDate":1202950662,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Ok, this is probably going to sound really naive because I am 28 years old, but... I have never had a bikini wax. I want to get one for the BD pics and for Jamaica. Can someone tell me how I prepare for this, any suggestions where to go, what to wear and how much it hurts (lol!)? <br \/> <br \/> (I searched for a thread about this but couldn't find one. If there already is one, someone please direct me!).\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lizz10179@yahoo.com","IpAddress":"96.227.248.79","GroupId":46,"GroupName":"VIP Member","JoinDate":1183260060,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"none"},"FormattedName":"Spazz","Id":207506,"Name":"Spazz","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":11375,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4baaf2f2263f4024dcb0735429202a40","RawContent":"it sure as hell hurt me! they say to take painkillers before hand to help with the pain, but that didn&#039;t work so well for me. maybe i didn&#039;t take enough.\n \n i just wore regular clothes. i suggest wearing underwear you don&#039;t care about because you&#039;ll probably get wax residue on it.","Attachments":[],"Id":195115,"PostDate":1202951037,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                it sure as hell hurt me! they say to take painkillers before hand to help with the pain, but that didn't work so well for me. maybe i didn't take enough.<br \/> <br \/> i just wore regular clothes. i suggest wearing underwear you don't care about because you'll probably get wax residue on it.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ocasiojessica@aol.com","IpAddress":"72.82.169.76","GroupId":46,"GroupName":"VIP Member","JoinDate":1174584420,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207276.gif?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Jessica","Id":207276,"Name":"Jessica","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":11375,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f848052619c9fe1b5fe9051ab593930b","RawContent":"I&#039;m not going to lie Lizz, It hurts more than I can ever put into words. Well, for me at least. I always take 2 Advils an hour before to help reduce inflammation and reddness. I know this is bad, but a vicodin or 2 is helpful too...only if you have someone to drive you home.","Attachments":[],"Id":195117,"PostDate":1202951133,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I'm not going to lie Lizz, It hurts more than I can ever put into words. Well, for me at least. I always take 2 Advils an hour before to help reduce inflammation and reddness. I know this is bad, but a vicodin or 2 is helpful too...only if you have someone to drive you home.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i113.photobucket.com\/albums\/n239\/lantonio1978\/JohnLeiasWeddingpropics406-1.jpg?t=1248795804\">http:\/\/i113.photobucket.com\/albums\/n...g?t=1248795804<\/a><span>Dreams Los CabosOctober 25, 2008<\/span><strong><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f128\/leias-planning-thread-30817\/\">Leia's Planning Thread<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f77\/leias-dreams-los-cabos-review-31458\/\">Leia's Dreams Los Cabos Review<\/a><\/strong><strong><a data-ipb='nomediaparse' href=\"http:\/\/www.juancarlostapia.com\/s\/dreams\/2008\/october\/leia2\/index.html\">Our Wedding Slideshow<\/a><\/strong><strong><a data-ipb='nomediaparse' href=\"http:\/\/www.juancarlostapia.com\/s\/dreams\/2008\/october\/leia\/index.html\">Our Engagement Slideshow<\/a><\/strong><strong><a data-ipb='nomediaparse' href=\"http:\/\/www.youtube.com\/watch?v=gelvkrySKaw\">Our Wedding Video<\/a><\/strong><strong><a data-ipb='nomediaparse' href=\"http:\/\/www.youtube.com\/watch?v=ycwSTNzJJ6c\">Our Wedding Slideshow...on youtube<\/a><\/strong><\/div><\/div>","Email":"Lantonio@rnmail.net","IpAddress":"","GroupId":46,"GroupName":"VIP Member","JoinDate":1189819860,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207736.gif?_r=0","PhotoWidth":75,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Leia78","Id":207736,"Name":"Leia78","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":11375,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"335181e44dd16813ec046c0fae73ac9b","RawContent":"You aren&#039;t naive Lizz, I&#039;ve never done it either. Don&#039;t know that I ever will if I need drugs to get through it...haha Good luck!","Attachments":[],"Id":195121,"PostDate":1202951261,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                You aren't naive Lizz, I've never done it either. Don't know that I ever will if I need drugs to get through it...haha Good luck!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mrsjamyjones@gmail.com","IpAddress":"162.201.254.135","GroupId":38,"GroupName":"Moderators","JoinDate":1168253040,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207039.jpeg?_r=0","PhotoWidth":1000,"PhotoHeight":667,"PhotoType":"custom"},"FormattedName":"starchild","Id":207039,"Name":"starchild","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":11375,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"9da563e4725d5041713e4ab96a4adfdc","RawContent":"liz, i get bikini waxes pretty regularly, dont stress its not that bad. definitely wear underwear that have soft edges, and that you are not terribly worried about destroying in case you get any wax residue on them. although your technician should be good enough that they dont leave wax behind. i think a regular bikini wax costs $40 where i go, and a brazilian is $80. you actually should not take painkillers beforehand, my wax girl says it can make you bleed more because it thins your blood. afterwards, they generally put some talc powder over the area or some lotion. you will want to keep lotioning there for a few days to reduce friction with your underwear because the skin will be slightly irritated for a day or so. i am not going to tell you it wont hurt -- it definitely will. oh! also, it is totally normal if during it you start to sweat. dont ask me why it happens but my girl says its totally normal and most people do sweat during and just a bit afterwards. they will give you some little paper panties that really look more like a strip of fabric with an elastic band to hold it up.\n \n the first time i went i was so nervous. but now that my girl has seen my cooter a buncha times, we can talk about the weather or whatever. i would definitely recommend going to someone that is recommended to you by a friend. a good wax person is crucial to your experience being somewhat enjoyable...well you know what i mean, as enjoyable as a bikini wax CAN be! haha","Attachments":[],"Id":195123,"PostDate":1202951565,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                liz, i get bikini waxes pretty regularly, dont stress its not that bad. definitely wear underwear that have soft edges, and that you are not terribly worried about destroying in case you get any wax residue on them. although your technician should be good enough that they dont leave wax behind. i think a regular bikini wax costs $40 where i go, and a brazilian is $80. you actually should not take painkillers beforehand, my wax girl says it can make you bleed more because it thins your blood. afterwards, they generally put some talc powder over the area or some lotion. you will want to keep lotioning there for a few days to reduce friction with your underwear because the skin will be slightly irritated for a day or so. i am not going to tell you it wont hurt -- it definitely will. oh! also, it is totally normal if during it you start to sweat. dont ask me why it happens but my girl says its totally normal and most people do sweat during and just a bit afterwards. they will give you some little paper panties that really look more like a strip of fabric with an elastic band to hold it up.<br \/> <br \/> the first time i went i was so nervous. but now that my girl has seen my cooter a buncha times, we can talk about the weather or whatever. i would definitely recommend going to someone that is recommended to you by a friend. a good wax person is crucial to your experience being somewhat enjoyable...well you know what i mean, as enjoyable as a bikini wax CAN be! haha\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mwall.hernandez@gmail.com","IpAddress":"208.179.124.226","GroupId":46,"GroupName":"VIP Member","JoinDate":1192196100,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207843.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Maura","Id":207843,"Name":"Maura","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":11375,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d1ce7f96b376ca9dcf7f1d0d134f3156","RawContent":"oh and wear soft sweatpants, DO NOT wear jeans or you will be so sorry afterwards!\n \n BTW, i also get my underarms done and its really nowhere near as bad as the bikini line. if you are feeling brave, try it out. i can go like 3 weeks without having to shave my armpits :) haha","Attachments":[],"Id":195125,"PostDate":1202951688,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                oh and wear soft sweatpants, DO NOT wear jeans or you will be so sorry afterwards!<br \/> <br \/> BTW, i also get my underarms done and its really nowhere near as bad as the bikini line. if you are feeling brave, try it out. i can go like 3 weeks without having to shave my armpits <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> haha\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mwall.hernandez@gmail.com","IpAddress":"208.179.124.226","GroupId":46,"GroupName":"VIP Member","JoinDate":1192196100,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207843.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Maura","Id":207843,"Name":"Maura","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":11375,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a48aa9a77b47b3303ee1de1e0fbf413a","RawContent":"I love them! They are painful, especially the first and second one...after that the pain isn&#039;t as bad.\n \n I always take an advil before I go too. \n \n Usually they give you these little paper undies. You really can&#039;t be too modest since the lady pretty much sees your yahoo. Sometimes I have had people put numbing stuff and it helps a little. \n \n In all honesty I think the pain is worth it!","Attachments":[],"Id":195133,"PostDate":1202952090,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I love them! They are painful, especially the first and second one...after that the pain isn't as bad.<br \/> <br \/> I always take an advil before I go too. <br \/> <br \/> Usually they give you these little paper undies. You really can't be too modest since the lady pretty much sees your yahoo. Sometimes I have had people put numbing stuff and it helps a little. <br \/> <br \/> In all honesty I think the pain is worth it!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"yari2566@mac.com","IpAddress":"173.60.223.125","GroupId":46,"GroupName":"VIP Member","JoinDate":1188368280,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207684.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"Yari","Id":207684,"Name":"Yari","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":11375,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"068dba3c13fd5cbe5703dd625570b3dc","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;Yari&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;I love them! \n In all honesty I think the pain is worth it!&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;I wouldn&#039;t say I love them &lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/embarrassed.gif\" border=\"0\" alt=\"\" title=\"Embarrassed\" class=\"inlineimg\" \/&gt;, but it sure does make you look pretty down there. Oh, and your man will go nuts...what women do to be beautiful....","Attachments":[],"Id":195141,"PostDate":1202952298,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>Yari<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">I love them! <br \/> In all honesty I think the pain is worth it!<\/div> <\/td> <\/tr> <\/table> <\/div>I wouldn't say I love them <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/embarrassed.gif\" border=\"0\" alt=\"\" title=\"Embarrassed\" class=\"inlineimg\" \/><\/span>, but it sure does make you look pretty down there. Oh, and your man will go nuts...what women do to be beautiful....\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i113.photobucket.com\/albums\/n239\/lantonio1978\/JohnLeiasWeddingpropics406-1.jpg?t=1248795804\">http:\/\/i113.photobucket.com\/albums\/n...g?t=1248795804<\/a><span>Dreams Los CabosOctober 25, 2008<\/span><strong><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f128\/leias-planning-thread-30817\/\">Leia's Planning Thread<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f77\/leias-dreams-los-cabos-review-31458\/\">Leia's Dreams Los Cabos Review<\/a><\/strong><strong><a data-ipb='nomediaparse' href=\"http:\/\/www.juancarlostapia.com\/s\/dreams\/2008\/october\/leia2\/index.html\">Our Wedding Slideshow<\/a><\/strong><strong><a data-ipb='nomediaparse' href=\"http:\/\/www.juancarlostapia.com\/s\/dreams\/2008\/october\/leia\/index.html\">Our Engagement Slideshow<\/a><\/strong><strong><a data-ipb='nomediaparse' href=\"http:\/\/www.youtube.com\/watch?v=gelvkrySKaw\">Our Wedding Video<\/a><\/strong><strong><a data-ipb='nomediaparse' href=\"http:\/\/www.youtube.com\/watch?v=ycwSTNzJJ6c\">Our Wedding Slideshow...on youtube<\/a><\/strong><\/div><\/div>","Email":"Lantonio@rnmail.net","IpAddress":"","GroupId":46,"GroupName":"VIP Member","JoinDate":1189819860,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207736.gif?_r=0","PhotoWidth":75,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Leia78","Id":207736,"Name":"Leia78","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":11375,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"44a80cf33624a691637e1c323b16d465","RawContent":"my FI has all but begged me to get a brazilian for the wedding, and i told him &amp;quot;i will if you will&amp;quot; hahahaha\n \n he was like wait, they do your buttcrack too right? yeah, forget it, count me out!","Attachments":[],"Id":195152,"PostDate":1202952588,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                my FI has all but begged me to get a brazilian for the wedding, and i told him \"i will if you will\" hahahaha<br \/> <br \/> he was like wait, they do your buttcrack too right? yeah, forget it, count me out!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mwall.hernandez@gmail.com","IpAddress":"208.179.124.226","GroupId":46,"GroupName":"VIP Member","JoinDate":1192196100,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207843.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Maura","Id":207843,"Name":"Maura","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":11375,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cb8fcbe6aa8d73ea8a70b98a5baf8055","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;mauraw&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;my FI has all but begged me to get a brazilian for the wedding, and i told him &amp;quot;i will if you will&amp;quot; hahahaha\n \n he was like wait, they do your buttcrack too right? yeah, forget it, count me out!&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;LOL, yes they do wax your buttocks region. That part doesn&#039;t hurt at all. But it is a little embarassing when you are in a doggie style position.","Attachments":[],"Id":195157,"PostDate":1202952757,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>mauraw<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">my FI has all but begged me to get a brazilian for the wedding, and i told him \"i will if you will\" hahahaha<br \/> <br \/> he was like wait, they do your buttcrack too right? yeah, forget it, count me out!<\/div> <\/td> <\/tr> <\/table> <\/div>LOL, yes they do wax your buttocks region. That part doesn't hurt at all. But it is a little embarassing when you are in a doggie style position.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"yari2566@mac.com","IpAddress":"173.60.223.125","GroupId":46,"GroupName":"VIP Member","JoinDate":1188368280,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207684.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"Yari","Id":207684,"Name":"Yari","IsOnline":false}}],"Id":"11375","Title":"Bikini Wax?","LastPostDate":1431441115},"Pages":{"TotalItems":331,"TotalPages":34,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":330},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
