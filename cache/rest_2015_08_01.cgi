31","IsOnline":false}},"Posts":[],"Id":"79197","Title":"Plus One Debacle","LastPostDate":1432341445},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":30,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":1385,"MovedTo":null,"MovedOn":0,"FirstPostId":1893234,"Rating":0,"RatingHits":0,"Starter":{"Id":277519,"Name":"veryvalentine","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277519.jpg?_r=1435850174","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"StartDate":1429105221,"LastPoster":{"Id":279978,"Name":"JJCB0418","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":60,"Preview":{"Id":1893234,"PostDate":1429105221,"PostContent":"Hello lovely ladies, \u00a0 I'm looking to get some advice and or ideas. \u00a0 \u00a0 Since my mother is no lon...","Author":{"Signature":"<div><br><div>\u00a0<\/div>\n<div>\u00a0<\/div>\n<div>Married on June 20th, 2015 at the Grand Sunset Princess Riviera Gazebo & Reception at the Chill Out with 60 guests<\/div>\n<div>\u00a0<\/div>\n<\/div>\n<div>\u00a0<\/div>\n<p>My planning thread:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78801-veryvaleros-wedding-planning-thread-grand-sunset-princess\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78801-veryvaleros-wedding-planning-thread-grand-sunset-princess\/<\/a><\/p>\n<p>My review thread: \u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79344-grand-sunset-princess-platinum-yucatan-princess-wedding\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79344-grand-sunset-princess-platinum-yucatan-princess-wedding\/<\/a>","Email":"rebecca.valero@gmail.com","IpAddress":"38.112.94.76","GroupId":3,"GroupName":"Member","JoinDate":1396964852,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277519.jpg?_r=1435850174","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"veryvalentine","Id":277519,"Name":"veryvalentine","IsOnline":false}},"Posts":[],"Id":"79067","Title":"Chair In Memory Of Mother","LastPostDate":1432217628},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":9,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":394,"MovedTo":null,"MovedOn":0,"FirstPostId":1896536,"Rating":0,"RatingHits":0,"Starter":{"Id":278661,"Name":"jeffandrobyn","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278661.jpg?_r=1404161707","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"IsOnline":false},"StartDate":1431956743,"LastPoster":{"Id":279978,"Name":"JJCB0418","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":60,"Preview":{"Id":1896536,"PostDate":1431956743,"PostContent":"My fiance and I are doing our own vows. I like what I wrote but I feel like it's too short. At th...","Author":{"Signature":"","Email":"robynbrooke81@gmail.com","IpAddress":"75.99.18.219","GroupId":40,"GroupName":"Jr. Member","JoinDate":1403529389,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278661.jpg?_r=1404161707","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"jeffand