":281478,"Name":"perianjay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"207.134.141.162","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79444,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"3452cc41349b8eb0dc0125ffa7bc1f98","RawContent":"&lt;p&gt;@[member=\"MegLeLy\"] Congrats and welcome! &amp;nbsp;As I&#039;m sure you can already tell, these forums and ladies are super helpful!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck and happy planning!&lt;\/p&gt;","Attachments":[],"Id":1901562,"PostDate":1438244832,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"284131\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/284131-meglely\/' title='Member profile'><span itemprop=\"name\">MegLeLy<\/span><\/a> Congrats and welcome! \u00a0As I'm sure you can already tell, these forums and ladies are super helpful!<\/p>\n<p>\u00a0<\/p>\n<p>Good luck and happy planning!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"deannaproteau@hotmail.com","IpAddress":"207.134.141.162","GroupId":40,"GroupName":"Jr. Member","JoinDate":1421424569,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281751.jpg?_r=1438177324","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"deecol","Id