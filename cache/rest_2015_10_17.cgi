147.126.210.46","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":25633,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4810e2850e0786e7aab96d392a4e344c","RawContent":"&lt;p&gt;Thanks for sharing&lt;\/p&gt;","Attachments":[],"Id":1867206,"PostDate":1408293526,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Thanks for sharing<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jsconner1983@yahoo.com","IpAddress":"67.173.180.132","GroupId":40,"GroupName":"Jr. Member","JoinDate":1363017807,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-267190.jpeg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Jahanee Conner","Id":267190,"Name":"Jahanee Conner","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"184.186.219.123","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":25633,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"e82591b775c2c428e102beecb4b905e8","RawContent":"&lt;p&gt;Another great website is www.clker.com - they have a ton of beach themed images in all different colors. You can download the .png image as is, or you can even edit the image to make it your own colors. I have attached a few of the images that I downloaded.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;img src=\"http:\/\/www.clker.com\/cliparts\/a\/5\/8\/c\/1206557741582718836a_sanyal59_Sunrise.svg.med.png\" alt=\"1206557741582718836a_sanyal59_Sunrise.sv\"&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"http:\/\/www.clker.com\/cliparts\/0\/I\/l\/j\/l\/K\/hibiscus-brenda-md.png\" alt=\"hibiscus-brenda-md.png\"&gt;&lt;img src=\"http:\/\/www.clker.com\/cliparts\/u\/y\/j\/l\/l\/g\/small-palm-tree-edited-md.png\" alt=\"small-palm-tree-edited-md.png\"&gt;&lt;img src=\"http:\/\/www.clker.com\/cliparts\/O\/s\/6\/y\/L\/6\/palm-tree-md.png\" alt=\"palm-tree-md.png\"&gt;&lt;img src=\"http:\/\/www.clker.com\/cliparts\/A\/U\/S\/i\/2\/V\/maehr-starfish-wedding-md.png\" alt=\"maehr-starfish-wedding-md.png\"&gt;&lt;\/p&gt;","Attachments":[],"Id":1882657,"PostDate":1421098919,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Another great website is www.clker.com - they have a ton of beach themed images in all different colors. You can download the .png image as is, or you can even edit the image to make it your own colors. I have attached a few of the images that I downloaded.<\/p>\n<p>\u00a0<span rel='lightbox'><img class='bbc_img' src=\"http:\/\/www.clker.com\/cliparts\/a\/5\/8\/c\/1206557741582718836a_sanyal59_Sunrise.svg.med.png\" alt=\"1206557741582718836a_sanyal59_Sunrise.sv\"><\/span><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/www.clker.com\/cliparts\/0\/I\/l\/j\/l\/K\/hibiscus-brenda-md.png\" alt=\"hibiscus-brenda-md.png\"><\/span><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/www.clker.com\/cliparts\/u\/y\/j\/l\/l\/g\/small-palm-tree-edited-md.png\" alt=\"small-palm-tree-edited-md.png\"><\/span><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/www.clker.com\/cliparts\/O\/s\/6\/y\/L\/6\/palm-tree-md.png\" alt=\"palm-tree-md.png\"><\/span><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/www.clker.com\/cliparts\/A\/U\/S\/i\/2\/V\/maehr-starfish-wedding-md.png\" alt=\"maehr-starfish-wedding-md.png\"><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-size:14px;\"><span style=\"font-family:verdana, geneva, sans-serif;\">\u201c...And it is an interesting biological fact that all of us have in our veins the exact same percentage of salt in our blood that exists in the ocean, and, therefore, we have salt in our blood, in our sweat, in our tears. We are tied to the ocean. And when we go back to the sea - whether it is to sail or to watch it - we are going back from whence we came.\" -John F Kennedy<\/span><\/span>","Email":"mhagedon05@hotmail.com","IpAddress":"67.171.182.209","GroupId":47,"GroupName":"Site Supporter","JoinDate":1310747969,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"none"},"FormattedName":"MissMeg","Id":242372,"Name":"MissMeg","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"198.163.47.9","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":25633,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d0f661f7c1bbeefdc874bb2e85a21a4a","RawContent":"&lt;p&gt;@[member=\"sandbride2b\"] Wow, great find! &amp;nbsp;Thanks for sharing!&lt;\/p&gt;","Attachments":[],"Id":1882662,"PostDate":1421104445,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@sandbride2b Wow, great find! \u00a0Thanks for sharing!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"slfehr@outlook.com","IpAddress":"24.114.26.10","GroupId":39,"GroupName":"Newbie","JoinDate":1420226577,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"pykx82","Id":281560,"Name":"pykx82","IsOnline":false}}],"Pages":{"TotalItems":33,"TotalPages":4,"CurrentPage":20,"NextPage":30,"PreviousPage":10,"LastPage":30},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
