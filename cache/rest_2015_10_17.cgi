evewright.netdna-cdn.com\/cdn\/profile\/photo-278025.jpg?_r=1438635345","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"jsparrow10","Id":278025,"Name":"jsparrow10","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"162.157.216.37","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79413,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4f01099107b5ecf44fc288eb5630a785","RawContent":"&lt;p&gt;@[member=\"jsparrow10\"] I love your brochure. Do you mind if I copy some of the wording and layouts you used?&lt;\/p&gt;","Attachments":[],"Id":1903590,"PostDate":1440715834,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"278025\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/278025-jsparrow10\/' title='Member profile'><span itemprop=\"name\">jsparrow10<\/span><\/a> I love your brochure. Do you mind if I copy some of the wording and layouts you used?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>~*~YYCBRIDE2016~*~<\/p><p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79227-yycbride2016-grand-sirenis-planning-thread-february-2016\/'>My planning thread\u00a0<\/a><\/p><p>\u00a0<\/p><p><a class='bbc_url' href='http:\/\/www.TickerFactory.com\/'><br><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10730;484\/st\/20160223\/e\/Our+Wedding\/dt\/-1\/k\/4bd8\/event.png\" alt=\"event.png\"><br><\/a><br>\u00a0","Email":"janellepaquin@hotmail.com","IpAddress":"162.157.216.37","GroupId":40,"GroupName":"Jr. Member","JoinDate":1432104904,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-283167.jpg?_r=1432133572","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"custom"},"FormattedName":"yycbride2016","Id":283167,"Name":"yycbride2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"199.126.252.6","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79413,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9dd1d548002a33aa36b744b01da9b2ed","RawContent":"&lt;p&gt;We had a bit of a welcome letter, an itinerary, a chart for people to write down their friends&#039; room numbers (which turned out everyone had wifi so no one used) and a map of the resort.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1903607,"PostDate":1440729120,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>We had a bit of a welcome letter, an itinerary, a chart for people to write down their friends' room numbers (which turned out everyone had wifi so no one used) and a map of the resort.\u00a0<\/p>\n<p>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<br><p><a data-ipb='nomediaparse' href='http:\/\/www.TickerFactory.com\/'><img src