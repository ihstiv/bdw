{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":4,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":true,"Views":869,"MovedTo":null,"MovedOn":0,"FirstPostId":1869468,"Rating":0,"RatingHits":0,"Starter":{"Id":279216,"Name":"eriddell","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279216.jpg?_r=1427247528","PhotoWidth":200,"PhotoHeight":113,"PhotoType":"custom"},"IsOnline":false},"StartDate":1409195863,"LastPoster":{"Id":272277,"Name":"desilu","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272277.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1869468,"PostDate":1409195863,"PostContent":"Hello All! \u00a0 I am new to this site, but looks like it has some helpful information. I am newly en...","Author":{"Signature":"<p><span style=\"color:#4b0082;\"><span style=\"font-size:24px;\"><span style=\"font-family:'comic sans ms', cursive;\">\u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0Erica<3\u00a0<\/span><\/span><\/span><\/p>\n<p><span style=\"color:#4b0082;\"><span style=\"font-size:24px;\"><span style=\"font-family:'comic sans ms', cursive;\">~Las Caletas Bride 2016~<\/span><\/span><\/span>","Email":"ericalriddell@gmail.com","IpAddress":"207.195.1.6","GroupId":39,"GroupName":"Newbie","JoinDate":1406664946,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279216.jpg?_r=1427247528","PhotoWidth":200,"PhotoHeight":113,"PhotoType":"custom"},"FormattedName":"eriddell","Id":279216,"Name":"eriddell","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"67.225.27.104","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77898,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"f70776abef6d02e8bc1fa328baa562c4","RawContent":"&lt;p&gt;Hello All!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I am new to this site, but looks like it has some helpful information. I am newly engaged ....Hurray! My fiance proposed about 3 months ago in our back yard. I was planting the last of my flowers when I hit something hard while digging. At first I was really freaked out as I thought I may have found something scary... like a dead body.. or head or something! I then decided to open the box and found a ring box... turned around and there was my fiance no one knee. It was a great moment...and great that he could surprise me like that as I am not easy to surprise!&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Anyways... We went to las calates about a year ago and knew that if we were ever to get married .... this would be the place! So we booked it for January 2016! Now to wait ... 1 year and 4 months cannot go fast enough! But it will be fun ! We just got a great price on the resort we wanted so that&#039;s exciting!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Has anyone stayed at Sunset Plaza Beach Resort in Puerto vallarta? (It has great reviews on trip advisor... so hopefully nothing changes in the next year)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Also.. any advice from brides that were married in Las Caletas?!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Nice meeting you All.. Happy Planning!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;-E&lt;\/p&gt;","Attachments":[],"Id":1869468,"PostDate":1409195863,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello All!<\/p>\n<p>\u00a0<\/p>\n<p>I am new to this site, but looks like it has some helpful information. I am newly engaged ....Hurray! My fiance proposed about 3 months ago in our back yard. I was planting the last of my flowers when I hit something hard while digging. At first I was really freaked out as I thought I may have found something scary... like a dead body.. or head or something! I then decided to open the box and found a ring box... turned around and there was my fiance no one knee. It was a great moment...and great that he could surprise me like that as I am not easy to surprise!\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Anyways... We went to las calates about a year ago and knew that if we were ever to get married .... this would be the place! So we booked it for January 2016! Now to wait ... 1 year and 4 months cannot go fast enough! But it will be fun ! We just got a great price on the resort we wanted so that's exciting!<\/p>\n<p>\u00a0<\/p>\n<p>Has anyone stayed at Sunset Plaza Beach Resort in Puerto vallarta? (It has great reviews on trip advisor... so hopefully nothing changes in the next year)<\/p>\n<p>\u00a0<\/p>\n<p>Also.. any advice from brides that were married in Las Caletas?!<\/p>\n<p>\u00a0<\/p>\n<p>Nice meeting you All.. Happy Planning!<\/p>\n<p>\u00a0<\/p>\n<p>-E<a class='resized_img' rel='lightbox[1869468]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2014\/post-279216-0-32190800-1409195763.jpg\" title=\"DSC_1821.JPG - Size: 94.73KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2014\/post-279216-0-32190800-1409195763.jpg\" class='bbc_img linked-image' alt=\"DSC_1821.JPG\" \/><\/a>\n\n<a class='resized_img' rel='lightbox[1869468]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2014\/post-279216-0-46471400-1409195777.jpg\" title=\"unnamed (1).jpg - Size: 198.13KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2014\/post-279216-0-46471400-1409195777.jpg\" class='bbc_img linked-image' alt=\"unnamed (1).jpg\" \/><\/a>\n\n<a class='resized_img' rel='lightbox[1869468]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2014\/post-279216-0-25345400-1409195793.jpg\" title=\"unnamed (3).jpg - Size: 105.93KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2014\/post-279216-0-25345400-1409195793.jpg\" class='bbc_img linked-image' alt=\"unnamed (3).jpg\" \/><\/a>\n\n<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#4b0082;\"><span style=\"font-size:24px;\"><span style=\"font-family:'comic sans ms', cursive;\">\u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0Erica<3\u00a0<\/span><\/span><\/span><\/p>\n<p><span style=\"color:#4b0082;\"><span style=\"font-size:24px;\"><span style=\"font-family:'comic sans ms', cursive;\">~Las Caletas Bride 2016~<\/span><\/span><\/span>","Email":"ericalriddell@gmail.com","IpAddress":"207.195.1.6","GroupId":39,"GroupName":"Newbie","JoinDate":1406664946,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279216.jpg?_r=1427247528","PhotoWidth":200,"PhotoHeight":113,"PhotoType":"custom"},"FormattedName":"eriddell","Id":279216,"Name":"eriddell","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.72.41.59","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77898,"EditedBy":"<strong>Edited by calgarybride2015, 30 August 2014 - 12:30 PM.<\/strong>","EditDate":1409430643,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"74ea8c3786e706b8348f2c4fb9bc606e","RawContent":"&lt;p&gt;Congrats&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;That&#039;s an awesome story and it gave me goosebumps!&lt;\/p&gt;\n&lt;p&gt;My fiance was creative in where he put the ring, but not with the words he chose.&lt;\/p&gt;\n&lt;p&gt;I think I heard &#039;you didn&#039;t say yes&#039; and I said &#039;you didn&#039;t ask&#039; LMAO! &amp;nbsp;he was too busy crying, although he swears it was sand in his eyes! ha!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;If Las Caletas is what I think it is, my friend (gym instructor) married there last year and it looked super beautiful. She stayed at a resort in Neovo though (not sure if its Puerto or Playa in front of it lol). at the Occidental Grand Xcaret.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;If you want I can see if she would mind if I shared her pictures with you.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck!&lt;\/p&gt;\n&lt;p&gt;I am marrying in January 2015 and I feel like it can&#039;t come quick enough.&lt;\/p&gt;","Attachments":[],"Id":1869917,"PostDate":1409430602,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congrats<\/p>\n<p>\u00a0<\/p>\n<p>That's an awesome story and it gave me goosebumps!<\/p>\n<p>My fiance was creative in where he put the ring, but not with the words he chose.<\/p>\n<p>I think I heard 'you didn't say yes' and I said 'you didn't ask' LMAO! \u00a0he was too busy crying, although he swears it was sand in his eyes! ha!<\/p>\n<p>\u00a0<\/p>\n<p>If Las Caletas is what I think it is, my friend (gym instructor) married there last year and it looked super beautiful. She stayed at a resort in Neovo though (not sure if its Puerto or Playa in front of it lol). at the Occidental Grand Xcaret.<\/p>\n<p>\u00a0<\/p>\n<p>If you want I can see if she would mind if I shared her pictures with you.<\/p>\n<p>\u00a0<\/p>\n<p>Good luck!<\/p>\n<p>I am marrying in January 2015 and I feel like it can't come quick enough.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399428602,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"174.0.148.35","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77898,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e6bf741fdcab4db01cf3a0c054918ce4","RawContent":"&lt;p&gt;Congrats on your engagement and upcoming Las Caletas wedding in 2016, eriddell !!! Love your story and the pictures that provide such wonderful visuals !&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Our wonderful Mexican venues provide such gorgeous backdrops for a wedding, as you can see in these magical wedding \"moments that matter\" Linc captured recently in our Mayan Riviera.....&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/fbcdn-sphotos-e-a.akamaihd.net\/hphotos-ak-xpa1\/t31.0-8\/10496123_10152641478484487_1952922690262007652_o.jpg\" alt=\"10496123_10152641478484487_1952922690262\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/fbcdn-sphotos-b-a.akamaihd.net\/hphotos-ak-xpa1\/t31.0-8\/10511441_10152641481294487_5058920532783006918_o.jpg\" alt=\"10511441_10152641481294487_5058920532783\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;with more at this link: &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.10152641474894487.1073741910.18683524486&amp;amp;type=3&#039;&gt;Dreams Tulum Wedding Album&amp;nbsp;&lt;\/a&gt;&amp;nbsp; for some added inspiration :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Wishing you all the best with your plans - cheers!!! team MTM :)&lt;\/p&gt;","Attachments":[],"Id":1870034,"PostDate":1409591332,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congrats on your engagement and upcoming Las Caletas wedding in 2016, eriddell !!! Love your story and the pictures that provide such wonderful visuals !<\/p>\n<p>\u00a0<\/p>\n<p>Our wonderful Mexican venues provide such gorgeous backdrops for a wedding, as you can see in these magical wedding \"moments that matter\" Linc captured recently in our Mayan Riviera.....<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/fbcdn-sphotos-e-a.akamaihd.net\/hphotos-ak-xpa1\/t31.0-8\/10496123_10152641478484487_1952922690262007652_o.jpg\" alt=\"10496123_10152641478484487_1952922690262\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/fbcdn-sphotos-b-a.akamaihd.net\/hphotos-ak-xpa1\/t31.0-8\/10511441_10152641481294487_5058920532783006918_o.jpg\" alt=\"10511441_10152641481294487_5058920532783\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>with more at this link: <a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10152641474894487.1073741910.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>Dreams Tulum Wedding Album\u00a0<\/a>\u00a0 for some added inspiration <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Wishing you all the best with your plans - cheers!!! team MTM <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280210660,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"76.182.220.98","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77898,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"272d1ed197f5644f8d144313206e8fb7","RawContent":"&lt;p&gt;I am also getting married at Las Caletas in October 2016. Your date is not too far away! You must be in or close to planning stages with them. How exciting. Hoping it goes well!&lt;\/p&gt;","Attachments":[],"Id":1905913,"PostDate":1444013856,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I am also getting married at Las Caletas in October 2016. Your date is not too far away! You must be in or close to planning stages with them. How exciting. Hoping it goes well!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"desireetaylor123@gmail.com","IpAddress":"72.190.21.83","GroupId":39,"GroupName":"Newbie","JoinDate":1375734234,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272277.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"desilu","Id":272277,"Name":"desilu","IsOnline":false}}],"Id":"77898","Title":"Las Caletas Wedding 2016","LastPostDate":1444013856},"Pages":{"TotalItems":4,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
