nks!","Attachments":[],"Id":1898636,"PostDate":1434394202,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi there,<br><br>\nLove the look of them!  What price are you looking for?  Thanks! \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lisesutherland@gmail.com","IpAddress":"74.88.106.146","GroupId":39,"GroupName":"Newbie","JoinDate":1424099287,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282134.jpg?_r=1441149164","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Mrsntobe","Id":282134,"Name":"Mrsntobe","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"74.101.223.7","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79267,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"311538e1170ba17f8dd824aa8023f82e","RawContent":"&lt;p&gt;bump. &amp;nbsp;what price for lanterns and sashes&lt;\/p&gt;","Attachments":[],"Id":1898963,"PostDate":1434846482,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>bump. \u00a0what price for lanterns and sashes<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"dathotgal51@yahoo.com","IpAddress":"173.77.182.126","GroupId":39,"GroupName":"Newbie","JoinDate":1423447125,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282047.jpg?_r=1445086348","PhotoWidth":200,"PhotoHeight":204,"PhotoType":"facebook"},"FormattedName":"dathotgal","Id":282047,"Name":"dathotgal","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.199.99.250","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79267,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0a6b8b448d23fc70ff82574acec68ced","RawContent":"The lanterns are $18 each.  \nThe sashes $2.00 each. \nHere are other items I am selling.\n6 small colorful lanterns for table center pieces or decorations. I used these at my welcome reception. Can be used for rehearsal dinner decor or any Mexican theme event. I have 6 and selling for $12.00 each.  Assorted vibrantly colors. Corol, aqua blue, red, yellow.\n\n\nI also have 6 colorful serapes runners to match.","Attachments":[{"Id":32735,"Name":"image.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_06_2015\/post-282290-0-76108500-1435413343.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_06_2015\/post-282290-0-76108500-1435413343_thumb.jpg","Width":1000,"Height":747},{"Id":32736,"Name":"image.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_06_2015\/post-282290-0-59370100-1435413356.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_06_2015\/post-282290-0-59370100-1435413356_thumb.jpg","Width":1000,"Height":747},{"Id":32737,"Name":"image.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_06_2015\/post-282290-0-24287300-14354133