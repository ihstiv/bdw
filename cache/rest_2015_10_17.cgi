a-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1436293677","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.241.131.23","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79652,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":3,"IsLiked":false,"PostKey":"9db30e1468b30f1dfcfd7ba705f04949","RawContent":"&lt;p&gt;Hello everyone!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Does anyone know of any &#039;fact sheets&#039; or something of that nature that are floating around? I&#039;m looking to provide my guests with a little sheet that goes over currency, things in the area\/excursions in the area etc etc.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Just wondering if anyone had something like this? I&#039;m going to make my own, but I wanted something to base it off of.&lt;\/p&gt;","Attachments":[],"Id":1906299,"PostDate":1444921791,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello everyone!<\/p>\n<p>\u00a0<\/p>\n<p>Does anyone know of any 'fact sheets' or something of that nature that are floating around? I'm looking to provide my guests with a little sheet that goes over currency, things in the area\/excursions in the area etc etc.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Just wondering if anyone had something like this? I'm going to make my own, but I wanted something to base it off of.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;1\/st\/20151215\/e\/Our+Wedding\/k\/ec4b\/event.png\" alt=\"event.png\"><\/a><br><br><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":42,"GroupName":"Sr. Member","JoinDate":1419437814,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1436293677","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"207.134.141.162","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79652,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"eb3ab78e7670d34ab06aad8b11e0f283","RawContent":"&lt;p&gt;Great idea&amp;nbsp;@[member=\"perianjay\"]! &amp;nbsp;I would love to do the same.&lt;\/p&gt;","Attachments":[],"Id":1906300,"PostDate":1444921973,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Great idea\u00a0@<a hovercard-ref=\"member\" hovercard-id=\"281478\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281478-perianjay\/' title='Member profile'><span itemprop=\"name\">perianjay<\/span><\/a>! \u00a0I would love to do the same.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div><img src=\"http:\/\/\" alt=\"\"><\/div>\n<div><br><div>\u00a0<\/div>\n<div><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;0\/st\/20160423\/e\/we+leave+for+Mexico%21\/k\/c059\/event.png\" alt=\"event.png\"><\/a>\u00a0 \u00a0\u00a0\u00a0 \u00a0\u00a0<a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;32;116\/st\/20160430\/e\/we+say+I+do%21\/k\/8afc\/event.png\" alt=\"event.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n<\/div>\n<p>\u00a0<\/p>\n<p>My Planning Thread:<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79580-deecols-planning-thread-gbp-april-30th-2016\/#entry1904529'>http:\/\/www.bestdestinationwedding.com\/topic\/79580-deecols-planning-thread-gbp-april-30th-2016\/#entry1904529<\/a>","Email":"deannaproteau@hotmail.com","IpAddress":"207.134.141.162","GroupId":40,"GroupName":"Jr. Member","JoinDate":1421442569,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281751.jpg?_r=1443808962","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"deecol","Id":281751,"Name":"deecol","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.202.225.11","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79652,"EditedBy":"","EditDate":1444922307,"EditReason":"","DeleteDate":0,"TotalLikes":5,"IsLiked":false,"PostKey":"8130fa4d7a115c4a394671e7ce8bdfd6","RawContent":"&lt;p&gt;If you want to add a link for excursions, I have one on BDW that your guests can book directly and pay for them:&amp;nbsp;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.amstardmc.com\/bestdestinationwedding\/&#039;&gt;https:\/\/www.amstardmc.com\/bestdestinationwedding\/&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I did an FAQ on my wedding website page for my wedding in cabo. &amp;nbsp;You can change it a bit to use for Cancun. (sorry for the funky formatting...too lazy to fix right now but you get the point)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"background-color:rgb(247,246,235);\"&gt;&lt;span style=\"color:rgb(0,0,0);\"&gt;&lt;span style=\"font-size:16px;\"&gt;&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;Frequently Asked Questions&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;\n\n&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/wrightvong.com\/htm\/faqs.htm#1&#039;&gt;What should I wear to the wedding?&lt;\/a&gt; &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/wrightvong.com\/htm\/faqs.htm#2&#039;&gt;Can I drink the water?&lt;\/a&gt; &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/wrightvong.com\/htm\/faqs.htm#3&#039;&gt;What food should I stay away from?&lt;\/a&gt; &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/wrightvong.com\/htm\/faqs.htm#4&#039;&gt;What will the weather be like?&lt;\/a&gt; &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/wrightvong.com\/htm\/faqs.htm#5&#039;&gt;Do I need a passport?&lt;\/a&gt; &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/wrightvong.com\/htm\/faqs.htm#6&#039;&gt;Can I use the U.S. Dollar?&lt;\/a&gt; &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/wrightvong.com\/htm\/faqs.htm#7&#039;&gt;Where is Los Cabos?&lt;\/a&gt;&lt;\/p&gt;\n\n&lt;div&gt;&lt;strong&gt;Wedding Attire&lt;\/strong&gt;&lt;\/div&gt;\n&lt;p&gt;What should I wear to the wedding? We are having a relaxed, beach wedding weekend, so we are encouraging a&amp;nbsp;&lt;strong&gt;\"beach chic\"&lt;\/strong&gt;&amp;nbsp;look for the events.&amp;nbsp; For the ceremony, men should wear a nice shirt and pants (Tommy Bahama look is good), suits and ties are ok but not required by any means. Women should wear dresses. Sandals are ok, but please no shorts and flip flops during the ceremony.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;div&gt;&lt;strong&gt;Montezuma&#039;s Revenge&lt;\/strong&gt;&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;p&gt;&lt;strong&gt;Can I drink the water?&lt;\/strong&gt;&lt;\/p&gt;\n&lt;div&gt;The water supply for all of Los Cabos is spring fed ground water.&amp;nbsp; The water here is very pure, but be careful. The pipes used for distribution of the water supply and other factors can lead to contamination.&amp;nbsp; Although many people drink the water directly from the tap, it is not recommended.&amp;nbsp; Anywhere in the world, a change in drinking water can cause stomach distress.&amp;nbsp;\n\n\nWe recommend that you drink only bottled or purified water.&amp;nbsp; All of the major hotels purify their water or serve purified water.   However,&amp;nbsp;you&amp;nbsp;are better off ALWAYS drinking bottled&amp;nbsp;water, even to brush your teeth. Dreams Resort provides free water bottles in your rooms.\n\n\n\"Auga Purificado\" is what you want.&lt;\/div&gt;\n\n&lt;p&gt;&lt;strong&gt;What food should I stay away from?&lt;\/strong&gt;&lt;\/p&gt;\n&lt;div&gt;We suggest steering clear&amp;nbsp;of anything that has been washed in unpurified water, such as lettuce (this means no salad), and fruit that can&#039;t be peeled.&amp;nbsp; When in doubt, do not eat it.&amp;nbsp;&lt;\/div&gt;\n\n&lt;div&gt;&lt;strong&gt;Weather&lt;\/strong&gt;&lt;\/div&gt;\n&lt;p&gt;What will the weather be like? It is paradise all year round with clear skies 360 days of the year and temperatures averaging around 78 degrees with minor fluctuations. Los Cabos may have about 5 rainy days each year generally in late August and September. The old saying - when it rains it pours, is very true of the rains in Los Cabos.\n\n\nIn the summer months, it can get VERY hot in Cabo, but hopefully May will still be on the mild side.&amp;nbsp;&lt;\/p&gt;\n&lt;div&gt;&lt;span style=\"font-family:tahoma, arial, helvetica, sans-serif;\"&gt;&lt;span style=\"font-size:10pt;\"&gt;Month&lt;\/span&gt;&lt;\/span&gt;\n&lt;p style=\"text-align:center;\"&gt;&lt;span style=\"font-family:tahoma, arial, helvetica, sans-serif;\"&gt;&lt;strong&gt;&lt;span style=\"font-family:arial;\"&gt;&lt;span style=\"font-size:10pt;\"&gt;Jan&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"text-align:center;\"&gt;&lt;span style=\"font-family:tahoma, arial, helvetica, sans-serif;\"&gt;&lt;strong&gt;&lt;span style=\"font-family:arial;\"&gt;&lt;span style=\"font-size:10pt;\"&gt;Feb&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"text-align:center;\"&gt;&lt;span style=\"font-family:tahoma, arial, helvetica, sans-serif;\"&gt;&lt;strong&gt;&lt;span style=\"font-family:arial;\"&gt;&lt;span style=\"font-size:10pt;\"&gt;Mar&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"text-align:center;\"&gt;&lt;span style=\"font-family:tahoma, arial, helvetica, sans-serif;\"&gt;&lt;strong&gt;&lt;span style=\"font-family:arial;\"&gt;&lt;span style=\"font-size:10pt;\"&gt;Apr&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"text-align:center;\"&gt;&lt;span style=\"font-family:tahoma, arial, helvetica, sans-serif;\"&gt;&lt;strong&gt;&lt;span style=\"font-family:arial;\"&gt;&lt;span style=\"font-size:10pt;\"&gt;May&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"text-align:center;\"&gt;&lt;span style=\"font-family:tahoma, arial, helvetica, sans-serif;\"&gt;&lt;strong&gt;&lt;span style=\"font-family:arial;\"&gt;&lt;span style=\"font-size:10pt;\"&gt;Jun&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"text-align:center;\"&gt;&lt;span style=\"font-family:tahoma, arial, helvetica, sans-serif;\"&gt;&lt;strong&gt;&lt;span style=\"font-family:arial;\"&gt;&lt;span style=\"font-size:10pt;\"&gt;Jul&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"text-align:center;\"&gt;&lt;span style=\"font-family:tahoma, arial, helvetica, sans-serif;\"&gt;&lt;strong&gt;&lt;span style=\"font-family:arial;\"&gt;&lt;span style=\"font-size:10pt;\"&gt;Aug&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"text-align:center;\"&gt;&lt;span style=\"font-family:tahoma, arial, helvetica, sans-serif;\"&gt;&lt;strong&gt;&lt;span style=\"font-family:arial;\"&gt;&lt;span style=\"font-size:10pt;\"&gt;Sep&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"text-align:center;\"&gt;&lt;span style=\"font-family:tahoma, arial, helvetica, sans-serif;\"&gt;&lt;strong&gt;&lt;span style=\"font-family:arial;\"&gt;&lt;span style=\"font-size:10pt;\"&gt;Oct&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"text-align:center;\"&gt;&lt;span style=\"font-family:tahoma, arial, helvetica, sans-serif;\"&gt;&lt;strong&gt;&lt;span style=\"font-family:arial;\"&gt;&lt;span style=\"font-size:10pt;\"&gt;Nov&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"text-align:center;\"&gt;&lt;span style=\"font-family:tahoma, arial, helvetica, sans-serif;\"&gt;&lt;strong&gt;&lt;span style=\"font-family:arial;\"&gt;&lt;span style=\"font-size:10pt;\"&gt;Dec&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-family:tahoma, arial, helvetica, sans-serif;\"&gt;&lt;strong&gt;&lt;span style=\"font-family:arial;\"&gt;&lt;span style=\"font-size:10pt;\"&gt;Temperature&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"text-align:center;\"&gt;&lt;span style=\"font-family:tahoma, arial, helvetica, sans-serif;\"&gt;&lt;strong&gt;&lt;span style=\"font-family:arial;\"&gt;&lt;span style=\"font-size:10pt;\"&gt;64&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"text-align:center;\"&gt;&lt;span style=\"font-family:tahoma, arial, helvetica, sans-serif;\"&gt;&lt;strong&gt;&lt;span style=\"font-family:arial;\"&gt;&lt;span style=\"font-size:10pt;\"&gt;66&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"text-align:center;\"&gt;&lt;span style=\"font-family:tahoma, arial, helvetica, sans-serif;\"&gt;&lt;strong&gt;&lt;span style=\"font-family:arial;\"&gt;&lt;span style=\"font-size:10pt;\"&gt;68&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"text-align:center;\"&gt;&lt;span style=\"font-family:tahoma, arial, helvetica, sans-serif;\"&gt;&lt;strong&gt;&lt;span style=\"font-family:arial;\"&gt;&lt;span style=\"font-size:10pt;\"&gt;70&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"text-align:center;\"&gt;&lt;span style=\"font-family:tahoma, arial, helvetica, sans-serif;\"&gt;&lt;strong&gt;&lt;span style=\"font-family:arial;\"&gt;&lt;span style=\"font-size:10pt;\"&gt;73&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"text-align:center;\"&gt;&lt;span style=\"font-family:tahoma, arial, helvetica, sans-serif;\"&gt;&lt;strong&gt;&lt;span style=\"font-family:arial;\"&gt;&lt;span style=\"font-size:10pt;\"&gt;79&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"text-align:center;\"&gt;&lt;span style=\"font-family:tahoma, arial, helvetica, sans-serif;\"&gt;&lt;strong&gt;&lt;span style=\"font-family:arial;\"&gt;&lt;span style=\"font-size:10pt;\"&gt;81&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"text-align:center;\"&gt;&lt;span style=\"font-family:tahoma, arial, helvetica, sans-serif;\"&gt;&lt;strong&gt;&lt;span style=\"font-family:arial;\"&gt;&lt;span style=\"font-size:10pt;\"&gt;82&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"text-align:center;\"&gt;&lt;span style=\"font-family:tahoma, arial, helvetica, sans-serif;\"&gt;&lt;strong&gt;&lt;span style=\"font-family:arial;\"&gt;&lt;span style=\"font-size:10pt;\"&gt;81&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"text-align:center;\"&gt;&lt;span style=\"font-family:tahoma, arial, helvetica, sans-serif;\"&gt;&lt;strong&gt;&lt;span style=\"font-family:arial;\"&gt;&lt;span style=\"font-size:10pt;\"&gt;79&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"text-align:center;\"&gt;&lt;span style=\"font-family:tahoma, arial, helvetica, sans-serif;\"&gt;&lt;strong&gt;&lt;span style=\"font-family:arial;\"&gt;&lt;span style=\"font-size:10pt;\"&gt;72&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"text-align:center;\"&gt;&lt;span style=\"font-family:tahoma, arial, helvetica, sans-serif;\"&gt;&lt;strong&gt;&lt;span style=\"font-family:arial;\"&gt;&lt;span style=\"font-size:10pt;\"&gt;68&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-family:tahoma, arial, helvetica, sans-serif;\"&gt;&lt;strong&gt;&lt;span style=\"font-family:arial;\"&gt;&lt;span style=\"font-size:10pt;\"&gt;Rain Fall&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"text-align:center;\"&gt;&lt;span style=\"font-family:tahoma, arial, helvetica, sans-serif;\"&gt;&lt;strong&gt;&lt;span style=\"font-family:arial;\"&gt;&lt;span style=\"font-size:10pt;\"&gt;0&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"text-align:center;\"&gt;&lt;span style=\"font-family:tahoma, arial, helvetica, sans-serif;\"&gt;&lt;strong&gt;&lt;span style=\"font-family:arial;\"&gt;&lt;span style=\"font-size:10pt;\"&gt;0&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"text-align:center;\"&gt;&lt;span style=\"font-family:tahoma, arial, helvetica, sans-serif;\"&gt;&lt;strong&gt;&lt;span style=\"font-family:arial;\"&gt;&lt;span style=\"font-size:10pt;\"&gt;0&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"text-align:center;\"&gt;&lt;span style=\"font-family:tahoma, arial, helvetica, sans-serif;\"&gt;&lt;strong&gt;&lt;span style=\"font-family:arial;\"&gt;&lt;span style=\"font-size:10pt;\"&gt;0&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"text-align:center;\"&gt;&lt;span style=\"font-family:tahoma, arial, helvetica, sans-serif;\"&gt;&lt;strong&gt;&lt;span style=\"font-family:arial;\"&gt;&lt;span style=\"font-size:10pt;\"&gt;0&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"text-align:center;\"&gt;&lt;span style=\"font-family:tahoma, arial, helvetica, sans-serif;\"&gt;&lt;strong&gt;&lt;span style=\"font-family:arial;\"&gt;&lt;span style=\"font-size:10pt;\"&gt;0&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"text-align:center;\"&gt;&lt;span style=\"font-family:tahoma, arial, helvetica, sans-serif;\"&gt;&lt;strong&gt;&lt;span style=\"font-family:arial;\"&gt;&lt;span style=\"font-size:10pt;\"&gt;.4&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"text-align:center;\"&gt;&lt;span style=\"font-family:tahoma, arial, helvetica, sans-serif;\"&gt;&lt;strong&gt;&lt;span style=\"font-family:arial;\"&gt;&lt;span style=\"font-size:10pt;\"&gt;1.6&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"text-align:center;\"&gt;&lt;span style=\"font-family:tahoma, arial, helvetica, sans-serif;\"&gt;&lt;strong&gt;&lt;span style=\"font-family:arial;\"&gt;&lt;span style=\"font-size:10pt;\"&gt;2.5&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"text-align:center;\"&gt;&lt;span style=\"font-family:tahoma, arial, helvetica, sans-serif;\"&gt;&lt;strong&gt;&lt;span style=\"font-family:arial;\"&gt;&lt;span style=\"font-size:10pt;\"&gt;1.2&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"text-align:center;\"&gt;&lt;span style=\"font-family:tahoma, arial, helvetica, sans-serif;\"&gt;&lt;strong&gt;&lt;span style=\"font-family:arial;\"&gt;&lt;span style=\"font-size:10pt;\"&gt;1.2&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"text-align:center;\"&gt;&lt;span style=\"font-family:tahoma, arial, helvetica, sans-serif;\"&gt;&lt;strong&gt;&lt;span style=\"font-family:arial;\"&gt;&lt;span style=\"font-size:10pt;\"&gt;0.8&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;p&gt;&lt;span style=\"color:rgb(0,0,0);\"&gt;&lt;span style=\"font-size:12px;\"&gt;Cabo San Lucas Average Temperatures (in F):\n\nMay highs: 80-85 &amp;nbsp; lows: 65-70\n\nJune highs: 80-85 &amp;nbsp; lows: 67-72\n\n\nCurrent weather in Los Cabos:&lt;\/span&gt;&lt;\/span&gt;\n&lt;img height=\"1\" src=\"http:\/\/image.weather.com\/web\/blank.gif\" width=\"1\" alt=\"blank.gif\"&gt;&lt;img height=\"1\" src=\"http:\/\/image.weather.com\/web\/blank.gif\" width=\"96\" alt=\"blank.gif\"&gt;&lt;img height=\"1\" src=\"http:\/\/image.weather.com\/web\/blank.gif\" width=\"168\" alt=\"blank.gif\"&gt;&lt;img height=\"20\" src=\"http:\/\/image.weather.com\/web\/blank.gif\" width=\"1\" alt=\"blank.gif\"&gt;&lt;img height=\"1\" src=\"http:\/\/image.weather.com\/web\/blank.gif\" width=\"1\" alt=\"blank.gif\"&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.weather.com\/weather\/local\/MXBS0007?cm_ven=WOWs_voap&amp;amp;cm_cat=Generic&amp;amp;cm_ite=link&amp;amp;cm_pla=Cityname&#039; title=\"As reported at Cabo San Lucas, Mexico. Oct 15 08:46 a.m. Local Time\"&gt;&lt;strong&gt;Los Cabos, Mexico&lt;\/strong&gt;&lt;\/a&gt;   &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.weather.com\/weather\/tenday\/MXBS0007?cm_ven=WOWs_voap&amp;amp;cm_cat=Generic&amp;amp;cm_ite=link&amp;amp;cm_pla=10-day&#039;&gt;Get the 10 day forecast&lt;\/a&gt; &lt;img height=\"120\" src=\"http:\/\/image.weather.com\/web\/blank.gif\" width=\"1\" alt=\"blank.gif\"&gt;\n\n\n  &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.weather.com\/outlook\/travel\/businesstraveler\/flights\/citywx\/MXBS0007?cm_ven=WOWs_voap&amp;amp;cm_cat=Generic&amp;amp;cm_ite=linkset&amp;amp;cm_pla=genLink1&amp;amp;par=OAP&amp;amp;site=GENXH&amp;amp;code=null&#039;&gt;Airport Delays&lt;\/a&gt;\n\n  &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.weather.com\/outlook\/recreation\/boatandbeach\/weather\/tenday\/MXBS0007?&amp;amp;when=thisweek&amp;amp;attrib=WXSP&amp;amp;cm_ven=WOWs_voap&amp;amp;cm_cat=Generic&amp;amp;cm_ite=linkset&amp;amp;cm_pla=genLink2&amp;amp;par=OAP&amp;amp;site=GENXH&amp;amp;code=null&#039;&gt;Beach Conditions&lt;\/a&gt;\n\n  &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.weather.com\/outlook\/health\/allergies\/hotspots\/?pollentype=treeMXBS0007?cm_ven=WOWs_voap&amp;amp;cm_cat=Generic&amp;amp;cm_ite=linkset&amp;amp;cm_pla=genLink3&amp;amp;par=OAP&amp;amp;site=GENXH&amp;amp;code=null&#039;&gt;Pollen Reports&lt;\/a&gt; &lt;img height=\"15\" src=\"http:\/\/image.weather.com\/web\/common\/blank.gif\" width=\"1\" alt=\"blank.gif\"&gt;&lt;img src=\"http:\/\/image.weather.com\/web\/common\/wxicons\/31\/32.gif?12122006\" alt=\"32.gif?12122006\"&gt;&lt;span style=\"font-size:18px;\"&gt;&lt;span style=\"font-family:verdana, arial;\"&gt;&lt;span style=\"color:rgb(0,0,0);\"&gt;81 \u00b0F&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;\n&lt;span style=\"font-family:verdana;\"&gt;&lt;span style=\"color:rgb(0,0,0);\"&gt;Sunny&lt;\/span&gt;&lt;\/span&gt; &lt;img height=\"5\" src=\"http:\/\/image.weather.com\/web\/blank.gif\" width=\"1\" alt=\"blank.gif\"&gt;&lt;img height=\"1\" src=\"http:\/\/image.weather.com\/web\/common\/blank.gif\" width=\"25\" alt=\"blank.gif\"&gt;Feels Like: 84\u00b0F\n&lt;img height=\"1\" src=\"http:\/\/image.weather.com\/web\/common\/blank.gif\" width=\"25\" alt=\"blank.gif\"&gt;Humidity: 70%\n&lt;img height=\"1\" src=\"http:\/\/image.weather.com\/web\/common\/blank.gif\" width=\"25\" alt=\"blank.gif\"&gt;&lt;strong&gt;Wind: N at 6 mph&lt;\/strong&gt; &lt;img height=\"1\" src=\"http:\/\/image.weather.com\/web\/common\/blank.gif\" width=\"25\" alt=\"blank.gif\"&gt;&amp;nbsp; &lt;img height=\"20\" src=\"http:\/\/image.weather.com\/web\/blank.gif\" width=\"1\" alt=\"blank.gif\"&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.weather.com\/weather\/hurricanecentral\/&amp;amp;cm_ven=WOWs_voap&amp;amp;cm_cat=Generic&amp;amp;cm_ite=link&amp;amp;cm_pla=prdt-dw?par=OAP&amp;amp;site=GENXH&amp;amp;code=null&#039;&gt;Keeping an eye on the Tropics&lt;\/a&gt;&lt;\/p&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;&lt;strong&gt;Travel Documents&lt;\/strong&gt;&lt;\/div&gt;\n&lt;p&gt;&lt;strong&gt;Do I need a passport?&lt;\/strong&gt;&lt;\/p&gt;\n&lt;div&gt;Short answer: YES! A passport book, not a passport card.&lt;\/div&gt;\n&lt;div&gt;&lt;strong&gt;Currency&lt;\/strong&gt;&lt;\/div&gt;\n&lt;p&gt;&lt;strong&gt;Can I use the U.S. Dollar?&lt;\/strong&gt;&lt;\/p&gt;\n&lt;div&gt;Dollars and Pesos are widely accepted all over Los Cabos.&amp;nbsp; Credit Cards are also accepted for most purchases, and you will often get the best excange rate by using a credit card.&amp;nbsp; ATM&#039;s are also avliable in downtown areas.&amp;nbsp;&lt;\/div&gt;\n\n&lt;div&gt;&lt;strong&gt;General Info&lt;\/strong&gt;&lt;\/div&gt;\n&lt;p&gt;&lt;strong&gt;Where is Los Cabos?&lt;\/strong&gt;&lt;\/p&gt;\n&lt;div&gt;Los Cabos is the municipality which includes the cities of Cabo San Lucas and San Jose del Cabo, and located in the state of Baja California Sur.\n\n\nCabo San Lucas is located at the southern tip of the Baja Peninsula in the State of Baja California Sur. Cabo is approximately 1,000 miles south of San Diego, California, 10 degrees below the Tropic of Cancer at a latitude of approximately 22 degrees. Cabo San Lucas is approximately 20 miles southwest of the Los Cabos International Airport.&lt;\/div&gt;","Attachments":[],"Id":1906301,"PostDate":1444922042,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>If you want to add a link for excursions, I have one on BDW that your guests can book directly and pay for them:\u00a0<a href='https:\/\/www.amstardmc.com\/bestdestinationwedding\/' class='bbc_url' title='External link' rel='nofollow external'>https:\/\/www.amstardm...inationwedding\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I did an FAQ on my wedding website page for my wedding in cabo. \u00a0You can change it a bit to use for Cancun. (sorry for the funky formatting...too lazy to fix right now but you get the point)<\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"background-color:rgb(247,246,235)\"><span  style=\"color:rgb(0,0,0)\"><span  style=\"font-size:16px\"><span  style=\"font-family:arial, helvetica, sans-serif\">Frequently Asked Questions<\/span><\/span><\/span><\/span><br>\n\u00a0<\/p>\n<p><a href='http:\/\/wrightvong.com\/htm\/faqs.htm#1' class='bbc_url' title='External link' rel='nofollow external'>What should I wear to the wedding?<\/a> <a href='http:\/\/wrightvong.com\/htm\/faqs.htm#2' class='bbc_url' title='External link' rel='nofollow external'>Can I drink the water?<\/a> <a href='http:\/\/wrightvong.com\/htm\/faqs.htm#3' class='bbc_url' title='External link' rel='nofollow external'>What food should I stay away from?<\/a> <a href='http:\/\/wrightvong.com\/htm\/faqs.htm#4' class='bbc_url' title='External link' rel='nofollow external'>What will the weather be like?<\/a> <a href='http:\/\/wrightvong.com\/htm\/faqs.htm#5' class='bbc_url' title='External link' rel='nofollow external'>Do I need a passport?<\/a> <a href='http:\/\/wrightvong.com\/htm\/faqs.htm#6' class='bbc_url' title='External link' rel='nofollow external'>Can I use the U.S. Dollar?<\/a> <a href='http:\/\/wrightvong.com\/htm\/faqs.htm#7' class='bbc_url' title='External link' rel='nofollow external'>Where is Los Cabos?<\/a><\/p>\n<br><div><strong>Wedding Attire<\/strong><\/div>\n<p>What should I wear to the wedding? We are having a relaxed, beach wedding weekend, so we are encouraging a\u00a0<strong>\"beach chic\"<\/strong>\u00a0look for the events.\u00a0 For the ceremony, men should wear a nice shirt and pants (Tommy Bahama look is good), suits and ties are ok but not required by any means. Women should wear dresses. Sandals are ok, but please no shorts and flip flops during the ceremony.<\/p>\n<p>\u00a0<\/p>\n<div><strong>Montezuma's Revenge<\/strong><\/div>\n<div>\u00a0<\/div>\n<p><strong>Can I drink the water?<\/strong><\/p>\n<div>The water supply for all of Los Cabos is spring fed ground water.\u00a0 The water here is very pure, but be careful. The pipes used for distribution of the water supply and other factors can lead to contamination.\u00a0 Although many people drink the water directly from the tap, it is not recommended.\u00a0 Anywhere in the world, a change in drinking water can cause stomach distress.\u00a0<br><br>\nWe recommend that you drink only bottled or purified water.\u00a0 All of the major hotels purify their water or serve purified water.\u00a0\u00a0 However,\u00a0you\u00a0are better off ALWAYS drinking bottled\u00a0water, even to brush your teeth. Dreams Resort provides free water bottles in your rooms.<br><br>\n\"Auga Purificado\" is what you want.<\/div>\n<br><p><strong>What food should I stay away from?<\/strong><\/p>\n<div>We suggest steering clear\u00a0of anything that has been washed in unpurified water, such as lettuce (this means no salad), and fruit that can't be peeled.\u00a0 When in doubt, do not eat it.\u00a0<\/div>\n<br><div><strong>Weather<\/strong><\/div>\n<p>What will the weather be like? It is paradise all year round with clear skies 360 days of the year and temperatures averaging around 78 degrees with minor fluctuations. Los Cabos may have about 5 rainy days each year generally in late August and September. The old saying - when it rains it pours, is very true of the rains in Los Cabos.<br><br>\nIn the summer months, it can get VERY hot in Cabo, but hopefully May will still be on the mild side.\u00a0<\/p>\n<div><span  style=\"font-family:tahoma, arial, helvetica, sans-serif\"><span  style=\"font-size:10pt\">Month<\/span><\/span>\n<p  style=\"text-align:center\"><span  style=\"font-family:tahoma, arial, helvetica, sans-serif\"><strong><span  style=\"font-family:arial\"><span  style=\"font-size:10pt\">Jan<\/span><\/span><\/strong><\/span><\/p>\n<p  style=\"text-align:center\"><span  style=\"font-family:tahoma, arial, helvetica, sans-serif\"><strong><span  style=\"font-family:arial\"><span  style=\"font-size:10pt\">Feb<\/span><\/span><\/strong><\/span><\/p>\n<p  style=\"text-align:center\"><span  style=\"font-family:tahoma, arial, helvetica, sans-serif\"><strong><span  style=\"font-family:arial\"><span  style=\"font-size:10pt\">Mar<\/span><\/span><\/strong><\/span><\/p>\n<p  style=\"text-align:center\"><span  style=\"font-family:tahoma, arial, helvetica, sans-serif\"><strong><span  style=\"font-family:arial\"><span  style=\"font-size:10pt\">Apr<\/span><\/span><\/strong><\/span><\/p>\n<p  style=\"text-align:center\"><span  style=\"font-family:tahoma, arial, helvetica, sans-serif\"><strong><span  style=\"font-family:arial\"><span  style=\"font-size:10pt\">May<\/span><\/span><\/strong><\/span><\/p>\n<p  style=\"text-align:center\"><span  style=\"font-family:tahoma, arial, helvetica, sans-serif\"><strong><span  style=\"font-family:arial\"><span  style=\"font-size:10pt\">Jun<\/span><\/span><\/strong><\/span><\/p>\n<p  style=\"text-align:center\"><span  style=\"font-family:tahoma, arial, helvetica, sans-serif\"><strong><span  style=\"font-family:arial\"><span  style=\"font-size:10pt\">Jul<\/span><\/span><\/strong><\/span><\/p>\n<p  style=\"text-align:center\"><span  style=\"font-family:tahoma, arial, helvetica, sans-serif\"><strong><span  style=\"font-family:arial\"><span  style=\"font-size:10pt\">Aug<\/span><\/span><\/strong><\/span><\/p>\n<p  style=\"text-align:center\"><span  style=\"font-family:tahoma, arial, helvetica, sans-serif\"><strong><span  style=\"font-family:arial\"><span  style=\"font-size:10pt\">Sep<\/span><\/span><\/strong><\/span><\/p>\n<p  style=\"text-align:center\"><span  style=\"font-family:tahoma, arial, helvetica, sans-serif\"><strong><span  style=\"font-family:arial\"><span  style=\"font-size:10pt\">Oct<\/span><\/span><\/strong><\/span><\/p>\n<p  style=\"text-align:center\"><span  style=\"font-family:tahoma, arial, helvetica, sans-serif\"><strong><span  style=\"font-family:arial\"><span  style=\"font-size:10pt\">Nov<\/span><\/span><\/strong><\/span><\/p>\n<p  style=\"text-align:center\"><span  style=\"font-family:tahoma, arial, helvetica, sans-serif\"><strong><span  style=\"font-family:arial\"><span  style=\"font-size:10pt\">Dec<\/span><\/span><\/strong><\/span><\/p>\n<p><span  style=\"font-family:tahoma, arial, helvetica, s