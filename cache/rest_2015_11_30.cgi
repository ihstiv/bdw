e":"STBMrsPowell","Id":284292,"Name":"STBMrsPowell","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"12.146.240.122","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78700,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"27b87d2cd4a6f5cfcf72f7c06a024c20","RawContent":"&lt;p&gt;We actually are getting the chance to view the resort later this October, the pictures look amazing&lt;\/p&gt;","Attachments":[],"Id":1905593,"PostDate":1443533161,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>We actually are getting the chance to view the resort later this October, the pictures look amazing<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"smhughes5@gmail.com","IpAddress":"24.236.71.15","GroupId":39,"GroupName":"Newbie","JoinDate":1414468192,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280892.jpg?_r=1424806022","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"StaceyMarieHughes","Id":280892,"Name":"StaceyMarieHughes","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.79.44.186","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78700,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5806b153bea7707f3bf43807adec2b1e","RawContent":"&lt;p&gt;My travel agent highly recommended this place. Her pics were beautiful! Currently trying to plan a trip down there to tour it and 2 other locations in December.&lt;\/p&gt;","Attachments":[],"Id":1906279,"PostDate":1444883166,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>My travel agent highly recommended this place. Her pics were beautiful! Currently trying to plan a trip down there to tour it and 2 other locations in December.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"townsendsmithwed@gmail.com","IpAddress":"173.66.3.166","GroupId":39,"GroupName":"Newbie","JoinDate":1427046004,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282503.jpeg?_r=1444096181","PhotoWidth":200,"PhotoHeight":217,"PhotoType":"custom"},"FormattedName":"tiffanyt","Id":282503,"Name":"tiffanyt","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"12.146.240.122","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78700,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5e6c77935c096d4c85a445ef08ddc91a","RawContent":"&lt;p&gt;We just got back a few days ago. The resort isn&#039;t completely finished, but it was amazing. The staff were very friendly and view was beautiful&lt;\/p&gt;","Attachments":[],"Id":1906968,"PostDate":1446223049,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>We just got back a few days ago. The resort isn't completely finished, but it was amazing. The staff were very friendly and view was beautiful<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"smhughes5@gmail.com","IpAddress":"24.236.71.15","GroupId":39,"GroupName":"Newbie","JoinDate":1414468192,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280892.jpg?_r=1424806022","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"StaceyMarieHughes","Id":280892,"Name":"StaceyMarieHughes","IsOnline":false}}],"Id":"78700","Title":"Moon Palace Jamaica Brides?","LastPostDate":1446223049},"Pages":{"TotalItems":10,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
