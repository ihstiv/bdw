{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":4,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":769,"MovedTo":null,"MovedOn":0,"FirstPostId":1834300,"Rating":0,"RatingHits":0,"Starter":{"Id":276756,"Name":"colivia","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276756.jpg?_r=1399903658","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"StartDate":1392688828,"LastPoster":{"Id":278273,"Name":"SuchALady777","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":25,"Preview":{"Id":1834300,"PostDate":1392688828,"PostContent":"Has anyone been married at an off-site venue in Aruba as opposed to getting married at the resort...","Author":{"Signature":"","Email":"olivia_colt.murski@outlook.com","IpAddress":"68.63.242.236","GroupId":40,"GroupName":"Jr. Member","JoinDate":1392688576,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276756.jpg?_r=1399903658","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"colivia","Id":276756,"Name":"colivia","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.63.242.236","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76393,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0477eb7e1fce70521428422806c4682c","RawContent":"Has anyone been married at an off-site venue in Aruba as opposed to getting married at the resort? My fianc\u00e9 and I are looking for a restaurant on the beach to have the ceremony and reception. Thank you for any information y&#039;all have!","Attachments":[],"Id":1834300,"PostDate":1392688828,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Has anyone been married at an off-site venue in Aruba as opposed to getting married at the resort? My fianc\u00e9 and I are looking for a restaurant on the beach to have the ceremony and reception. Thank you for any information y'all have!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"olivia_colt.murski@outlook.com","IpAddress":"68.63.242.236","GroupId":40,"GroupName":"Jr. Member","JoinDate":1392688576,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276756.jpg?_r=1399903658","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"colivia","Id":276756,"Name":"colivia","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.143.153.161","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76393,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"3d552e5081773977ceb2295c768da562","RawContent":"&lt;p&gt;There are some great venues that provide off site ceremonies and receptions and I know a fantastic wedding coordinator who arranges details with many of them.&amp;nbsp; It is a really good idea to have one person oversee the many moving parts - she has great connections and resources.&amp;nbsp; Doing it this way also gives you more leeway to have the event that you want - not the one that fits into the menu offered by a particular resort.&lt;\/p&gt;\n&lt;p&gt;Let me know if you want the coordinator&#039;s name&lt;\/p&gt;","Attachments":[],"Id":1834341,"PostDate":1392725934,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>There are some great venues that provide off site ceremonies and receptions and I know a fantastic wedding coordinator who arranges details with many of them.\u00a0 It is a really good idea to have one person oversee the many moving parts - she has great connections and resources.\u00a0 Doing it this way also gives you more leeway to have the event that you want - not the one that fits into the menu offered by a particular resort.<\/p>\n<p>Let me know if you want the coordinator's name<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><a class='bbc_url' href='http:\/\/wrighttravelagency.com\/inquiry\/'><span style='color: rgb(0,128,128)'>Looking for a travel agency that specializes in Destination Weddings<\/span><\/a><span style='color: rgb(0,128,128)'>? We are an award winning travel agency and you can read our reviews <\/span><a class='bbc_url' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style='color: rgb(0,128,128)'><strong class='bbc'>HERE.<\/strong><\/span><\/a><\/span><\/span><br \/>\n<br \/>\n<span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'><strong class='bbc'>Awards and recognition: <\/strong><\/span><\/span><\/span><\/span><br \/>\n<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'>Palace Resorts Top PRO Agency <\/span><\/span><\/span><\/span><br \/>\n<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'>Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator <\/span><\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>AMResorts Master Agent & Top Agency<\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>Travel Impressions Best of the Best Globe Winner<\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>Apple Vacations Golden Apple Winner<\/span><\/span><\/span>","Email":"kathy@wrighttravelagency.com","IpAddress":"50.143.153.161","GroupId":49,"GroupName":"Insiders","JoinDate":1391018664,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"TAkathy","Id":276390,"Name":"TAkathy","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"74.190.197.95","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76393,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fa1af7ed08af28b2d10cb4c0aa5e728f","RawContent":"&lt;p&gt;I am debating between off-site or on resort, my concerns is about the people watching&lt;\/p&gt;","Attachments":[],"Id":1847960,"PostDate":1399042747,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I am debating between off-site or on resort, my concerns is about the people watching<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"danellepellebon@yahoo.com","IpAddress":"74.190.197.95","GroupId":39,"GroupName":"Newbie","JoinDate":1210202805,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209293.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"DelightfulDani","Id":209293,"Name":"DelightfulDani","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"208.54.45.224","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76393,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a02a1ed5725271af85dbdc78b33cb218","RawContent":"I thought about Aruba, good luck!","Attachments":[],"Id":1861256,"PostDate":1405962044,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I thought about Aruba, good luck! \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"bseasebey@yahoo.com","IpAddress":"69.117.93.162","GroupId":40,"GroupName":"Jr. Member","JoinDate":1402061968,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"SuchALady777","Id":278273,"Name":"SuchALady777","IsOnline":false}}],"Id":"76393","Title":"Aruba Wedding Venues","LastPostDate":1405962044},"Pages":{"TotalItems":4,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
