Request Time: 0 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":11,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":671,"MovedTo":null,"MovedOn":0,"FirstPostId":1906764,"Rating":0,"RatingHits":0,"Starter":{"Id":284307,"Name":"Kirsteen","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284307.jpg?_r=1446946143","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"IsOnline":false},"StartDate":1445654775,"LastPoster":{"Id":278914,"Name":"MissJen3","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278914.jpg?_r=1427504777","PhotoWidth":200,"PhotoHeight":146,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":25,"Preview":{"Id":1906764,"PostDate":1445654775,"PostContent":"Hi Brides!  I'm planning my wedding for 2016 in Cuba! I want to pack and bring out of town bags f...","Author":{"Signature":"","Email":"kirsteenjones@gmail.com","IpAddress":"184.71.207.50","GroupId":39,"GroupName":"Newbie","JoinDate":1438870753,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284307.jpg?_r=1446946143","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"Kirsteen","Id":284307,"Name":"Kirsteen","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"172.219.159.183","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79675,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"82f064f56803d3d718748ce337b006fa","RawContent":"Hi Brides! \n\n\nI&#039;m planning my wedding for 2016 in Cuba! I want to pack and bring out of town bags for all of our guests with little goodies in it.  Does anyone have experience bringing these kind of things into Cuba? I&#039;m planning on keeping and briginf receipts for everything I buy, but I&#039;d be choked if it got taken away at customs. \n\n\nAny advice is appreciated. \n\n\nThanks!!!","Attachments":[],"Id":1906764,"PostDate":1445654775,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi Brides! <br><br>\nI'm planning my wedding for 2016 in Cuba! I want to pack and bring out of town bags for all of our guests with little goodies in it.  Does anyone have experience bringing these kind of things into Cuba? I'm planning on keeping and briginf receipts for everything I buy, but I'd be choked if it got taken away at customs. <br><br>\nAny advice is appreciated. <br><br>\nThanks!!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kirsteenjones@gmail.com","IpAddress":"184.71.207.50","GroupId":39,"GroupName":"Newbie","JoinDate":1438870753,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284307.jpg?_r=1446946143","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"Kirsteen","Id":284307,"Name":"Kirsteen","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.146.146.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79675,"EditedBy":"<strong>Edited by calgarybride2015, 24 October 2015 - 05:04 PM.<\/strong>","EditDate":1445735064,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bc3cc483b088c51bcbbc653d3128be0e","RawContent":"&lt;p&gt;Hello,&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I searched Cuba customs and most pages I found re-iterated what is on this webpage. &amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/gocuba.ca\/client\/tips\/show.php?tip_id=7&#039;&gt;http:\/\/gocuba.ca\/client\/tips\/show.php?tip_id=7&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We have one recent Cuba bride @[member=\"diadiamond\"]&lt;\/p&gt;\n&lt;p&gt;and maybe @[member=\"csho\"] can jump in too but she hasn&#039;t been around in awhile.&lt;\/p&gt;\n&lt;p&gt;I will find the other Varadero bride I can think of and edit my post with her username once I find it&lt;\/p&gt;\n&lt;p&gt;All three of these ladies have planning threads if you did a quick look thru that thread.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;EDIT - couldn&#039;t find the other one!!! &amp;nbsp; &amp;nbsp; &amp;nbsp;Even try doing a search for Cuba customs or Cuba planning up top and you will get tonnes of links to threads on this message board.&lt;\/p&gt;","Attachments":[],"Id":1906780,"PostDate":1445734952,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello,<\/p>\n<p>\u00a0<\/p>\n<p>I searched Cuba customs and most pages I found re-iterated what is on this webpage. \u00a0<\/p>\n<p><a href='http:\/\/gocuba.ca\/client\/tips\/show.php?tip_id=7' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/gocuba.ca\/cli...ow.php?tip_id=7<\/a><\/p>\n<p>\u00a0<\/p>\n<p>We have one recent Cuba bride @<a hovercard-ref=\"member\" hovercard-id=\"276748\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/276748-diadiamond\/' title='Member profile'><span itemprop=\"name\">diadiamond<\/span><\/a><\/p>\n<p>and maybe @<a hovercard-ref=\"member\" hovercard-id=\"261965\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/261965-csho\/' title='Member profile'><span itemprop=\"name\">csho<\/span><\/a> can jump in too but she hasn't been around in awhile.<\/p>\n<p>I will find the other Varadero bride I can think of and edit my post with her username once I find it<\/p>\n<p>All three of these ladies have planning threads if you did a quick look thru that thread.<\/p>\n<p>\u00a0<\/p>\n<p>Good luck!<\/p>\n<p>\u00a0<\/p>\n<p>EDIT - couldn't find the other one!!! \u00a0 \u00a0 \u00a0Even try doing a search for Cuba customs or Cuba planning up top and you will get tonnes of links to threads on this message board.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399428602,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"69.171.158.168","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79675,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"4c7f4f0e2b39fac07264e6a2063eb7bb","RawContent":"[quote name=\"Kirsteen\" post=\"1906764\" timestamp=\"1445654775\"]\nHi Brides!\n\nI&#039;m planning my wedding for 2016 in Cuba! I want to pack and bring out of town bags for all of our guests with little goodies in it. Does anyone have experience bringing these kind of things into Cuba? I&#039;m planning on keeping and briginf receipts for everything I buy, but I&#039;d be choked if it got taken away at customs.\n\nAny advice is appreciated.\n\nThanks!!![\/quote]\nI got married last month at Iberostar Varadero.  I&#039;m probably not the best person to help you out because I handed out my favours prior to leaving.  I don&#039;t think it should be a problem though.  Sorry I couldn&#039;t be of more help.  Happy planning hun!","Attachments":[],"Id":1906802,"PostDate":1445820059,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Kirsteen, on 23 October 2015 - 06:46 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Hi Brides!<br><br>\nI'm planning my wedding for 2016 in Cuba! I want to pack and bring out of town bags for all of our guests with little goodies in it. Does anyone have experience bringing these kind of things into Cuba? I'm planning on keeping and briginf receipts for everything I buy, but I'd be choked if it got taken away at customs.<br><br>\nAny advice is appreciated.<br><br>\nThanks!!!<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>I got married last month at Iberostar Varadero. \u00a0I'm probably not the best person to help you out because I handed out my favours prior to leaving. \u00a0I don't think it should be a problem though. \u00a0Sorry I couldn't be of more help. \u00a0Happy planning hun!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div><br><div>\u00a0<\/div>\n<div><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;484\/st\/20150924\/e\/Our+Wedding\/k\/8745\/event.png\" alt=\"event.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n<\/div>\n<div>\u00a0<\/div>\n<div>My Planning Thread:<\/div>\n<div>\u00a0<\/div>\n<div><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79153-diadiamonds-planning-thread-iberostar-varadero-cuba-sept242015\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79153-diadiamonds-planning-thread-iberostar-varadero-cuba-sept242015\/<\/a><\/div>\n<div>\u00a0<\/div>\n<div>\u00a0<\/div>\n","Email":"fadia.daniel@gmail.com","IpAddress":"76.64.81.211","GroupId":40,"GroupName":"Jr. Member","JoinDate":1392664043,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276748.jpg?_r=1445822927","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"diadiamond","Id":276748,"Name":"diadiamond","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"172.219.159.183","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79675,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"48fbb782d9faadb43e1286eb6fd8d75a","RawContent":"Thanks for your response! What were your favours if you don&#039;t mind me asking..? Also, how did you enjoy the iberostar. The resort we are going to is an iberostar one, but there are no ratings because it hasn&#039;t opened yet.","Attachments":[],"Id":1906803,"PostDate":1445820909,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks for your response! What were your favours if you don't mind me asking..? Also, how did you enjoy the iberostar. The resort we are going to is an iberostar one, but there are no ratings because it hasn't opened yet.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kirsteenjones@gmail.com","IpAddress":"184.71.207.50","GroupId":39,"GroupName":"Newbie","JoinDate":1438870753,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284307.jpg?_r=1446946143","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"Kirsteen","Id":284307,"Name":"Kirsteen","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.146.146.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79675,"EditedBy":"<strong>Edited by calgarybride2015, 25 October 2015 - 04:59 PM.<\/strong>","EditDate":1445821142,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bfc3b7b4c6d7d357a0dd3e86ab9d5bae","RawContent":"[quote name=\"Kirsteen\" post=\"1906803\" timestamp=\"1445820909\"]\nThanks for your response! What were your favours if you don&#039;t mind me asking..? Also, how did you enjoy the iberostar. The resort we are going to is an iberostar one, but there are no ratings because it hasn&#039;t opened yet.[\/quote]Ohhhh what&#039;s the name? We were in Cuba in 2014 but may go back for our anniversary!  Would try a different place though.   Love Cuba \n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1906804,"PostDate":1445821114,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Kirsteen, on 25 October 2015 - 04:55 PM, said:<\/p><div class='blockquote'><div class='quote'><p>\nThanks for your response! What were your favours if you don't mind me asking..? Also, how did you enjoy the iberostar. The resort we are going to is an iberostar one, but there are no ratings because it hasn't opened yet.<\/p><\/div><\/div>Ohhhh what's the name? We were in Cuba in 2014 but may go back for our anniversary!  Would try a different place though.   Love Cuba <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399428602,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"172.219.159.183","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79675,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c84b524da12fb0362a1cb20f4129366b","RawContent":"Iberostar playa pilar in cayo Coco. It&#039;s set to open in Nov\/Dec of this year.","Attachments":[],"Id":1906805,"PostDate":1445821178,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Iberostar playa pilar in cayo Coco. It's set to open in Nov\/Dec of this year. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kirsteenjones@gmail.com","IpAddress":"184.71.207.50","GroupId":39,"GroupName":"Newbie","JoinDate":1438870753,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284307.jpg?_r=1446946143","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"Kirsteen","Id":284307,"Name":"Kirsteen","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.146.146.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79675,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"361c0ec68c0e59ff225233066cb91a57","RawContent":"[quote name=\"Kirsteen\" post=\"1906805\" timestamp=\"1445821178\"]\nIberostar playa pilar in cayo Coco. It&#039;s set to open in Nov\/Dec of this year.[\/quote]Thanks! I was looking into Cayo Santa Maria but I think we may stick to Varadero as we like you can walk and explore on foot.  Husband doesn&#039;t like being secluded from the towns and locals.  Will be gorgeous though. \n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1906806,"PostDate":1445821318,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Kirsteen, on 25 October 2015 - 04:59 PM, said:<\/p><div class='blockquote'><div class='quote'><p>Iberostar playa pilar in cayo Coco. It's set to open in Nov\/Dec of this year.<\/p><\/div><\/div>\n<br>\nThanks! I was looking into Cayo Santa Maria but I think we may stick to Varadero as we like you can walk and explore on foot.  Husband doesn't like being secluded from the towns and locals.  Will be gorgeous though. <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399428602,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.247.221.156","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79675,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"c5b1b124e4612d46eb050440d110b045","RawContent":"&lt;p&gt;Hi @[member=\"Kirsteen\"]!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I am getting married in Cayo Coco Cuba in 25 days! Ahhh!&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I am planning on bringing a whole boat load of OOT bag items with me. I am certainly hoping that I will have no issues clearing customs. I honestly hadnt thought about it until I read your post. Eeeek!&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I have been in contact with the on site wedding coordinator and she told me that the staff encourages brides to bring as much as they would like, so I just assumed this also meant OOT bag items???   &lt;\/p&gt;\n&lt;p&gt;I have complied a spreadsheet of everything that was included in the bags, and the approx cost of the items. I plan to keep this, and the receipts (that I can find, just moved), with me with the wedding items that I was told to keep with me at the airport.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;All of our OOT items are being packed in our suitcases, and being farmed out to family memebers. My FI is carrying on our favours because they are glass.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;After the wedding I can give you an update as to how it all went.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Fingers crossed for me and that things go smoothly! LOL&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1906828,"PostDate":1445897495,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi @<a hovercard-ref=\"member\" hovercard-id=\"284307\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/284307-kirsteen\/' title='Member profile'><span itemprop=\"name\">Kirsteen<\/span><\/a>!<\/p>\n<p>\u00a0<\/p>\n<p>I am getting married in Cayo Coco Cuba in 25 days! Ahhh!\u00a0<\/p>\n<p>I am planning on bringing a whole boat load of OOT bag items with me. I am certainly hoping that I will have no issues clearing customs. I honestly hadnt thought about it until I read your post. Eeeek!\u00a0<\/p>\n<p>I have been in contact with the on site wedding coordinator and she told me that the staff encourages brides to bring as much as they would like, so I just assumed this also meant OOT bag items??? \u00a0\u00a0<\/p>\n<p>I have complied a spreadsheet of everything that was included in the bags, and the approx cost of the items. I plan to keep this, and the receipts (that I can find, just moved), with me with the wedding items that I was told to keep with me at the airport.\u00a0<\/p>\n<p>All of our OOT items are being packed in our suitcases, and being farmed out to family memebers. My FI is carrying on our favours because they are glass.\u00a0<\/p>\n<p>After the wedding I can give you an update as to how it all went.\u00a0<\/p>\n<p>Fingers crossed for me and that things go smoothly! LOL\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jen.tipler@gmail.com","IpAddress":"99.247.221.156","GroupId":40,"GroupName":"Jr. Member","JoinDate":1404873744,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278914.jpg?_r=1427504777","PhotoWidth":200,"PhotoHeight":146,"PhotoType":"custom"},"FormattedName":"MissJen3","Id":278914,"Name":"MissJen3","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.241.131.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79675,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c9bde025506c6475ed80b87df50c5b91","RawContent":"&lt;p&gt;I haven&#039;t even thought of this with going into Mexico. I&#039;m planning to bring a lot of OOT items and I didn&#039;t keep my receipts around. Hopefully I don&#039;t run into any issues!&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1906836,"PostDate":1445953043,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I haven't even thought of this with going into Mexico. I'm planning to bring a lot of OOT items and I didn't keep my receipts around. Hopefully I don't run into any issues!\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;1\/st\/20151215\/e\/Our+Wedding\/k\/ec4b\/event.png\" alt=\"event.png\"><\/a><br><br><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":42,"GroupName":"Sr. Member","JoinDate":1419437814,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1436293677","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.146.146.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79675,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6dc2d1246205e2928047e2b8f1eb7879","RawContent":"[quote name=\"perianjay\" post=\"1906836\" timestamp=\"1445953043\"]\nI haven&#039;t even thought of this with going into Mexico. I&#039;m planning to bring a lot of OOT items and I didn&#039;t keep my receipts around. Hopefully I don&#039;t run into any issues![\/quote]Mexico does have a limit. They have a webpage. I brought my receipts, hotel confirmation and guest list just in case but didn&#039;t have any issues.  The more recent brides on here who have been searched have stated it&#039;s for a wedding and have been ok too!!! \n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1906838,"PostDate":1445956015,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>perianjay, on 27 October 2015 - 05:37 AM, said:<\/p><div class='blockquote'><div class='quote'><p>I haven't even thought of this with going into Mexico. I'm planning to bring a lot of OOT items and I didn't keep my receipts around. Hopefully I don't run into any issues!<\/p><\/div><\/div>\n<br>\nMexico does have a limit. They have a webpage. I brought my receipts, hotel confirmation and guest list just in case but didn't have any issues.  The more recent brides on here who have been searched have stated it's for a wedding and have been ok too!!! <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399428602,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":true}}],"Id":"79675","Title":"Bringing 'out Of Town Bags' To Cuba","LastPostDate":1449090636},"Pages":{"TotalItems":11,"TotalPages":2,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
