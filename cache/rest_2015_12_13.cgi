{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":70,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":12362,"MovedTo":null,"MovedOn":0,"FirstPostId":1439374,"Rating":0,"RatingHits":0,"Starter":{"Id":238805,"Name":"kendal23","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-238805.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"StartDate":1303495571,"LastPoster":{"Id":277834,"Name":"ashleybeav","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":25,"Preview":{"Id":1439374,"PostDate":1303495571,"PostContent":"Hi All--We are just starting our destination wedding planning & we were hoping to get some sugge...","Author":{"Signature":"","Email":"kendalmgoodheart@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1302650088,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-238805.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"kendal23","Id":238805,"Name":"kendal23","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":60834,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b2de25d8ccd8ee2a4b766e480b64717f","RawContent":"&lt;p&gt; &lt;span style=\"display: block; padding-left: 6em;\"&gt;&lt;span&gt;Hi All--We are just starting our destination wedding planning &amp;amp; we were hoping to get some suggestions or recommendations on wedding planners in T&amp;amp;C. Any info (good or bad!) would be helpful! Thanks&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1439374,"PostDate":1303495571,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> <span  style=\"display: block\"><span>Hi All--We are just starting our destination wedding planning & we were hoping to get some suggestions or recommendations on wedding planners in T&C. Any info (good or bad!) would be helpful! Thanks<\/span><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kendalmgoodheart@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1302650088,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-238805.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"kendal23","Id":238805,"Name":"kendal23","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":60834,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"43a4d80c6bd35b772c6ee72b1864e49f","RawContent":"&lt;p&gt; &amp;nbsp;I just got married in T&amp;amp;C a little over a month ago at the Somerset with 85 guests.&amp;nbsp; Originally when we booked the wedding, the hotel employed a coordinator who was to take care of us.&amp;nbsp; She ended up quitting, and for us it was a blessing!&amp;nbsp; Diane from Island Harmony took over as our planner.&amp;nbsp; As soon as we spoke with her all, our nerves subsided.&amp;nbsp; She was FABULOUS.&amp;nbsp; She is originally&amp;nbsp;from NJ but has lived on the island 7 years now and has her own event planning business.&amp;nbsp; She was a GODSEND!&amp;nbsp; She picked right up where the other coordinator left off and had so many connections to vendors on the island and so many great ideas!&amp;nbsp; We inundated her with emails, and she was always so quick to respond, highly organized&amp;nbsp;and was just the sweetest woman ever to work with.&amp;nbsp; She genuinely cares to make your day special and&amp;nbsp;did her best to make it exactly how we envisioned it.&amp;nbsp; For us, she went above and beyond what we could have expected and we would recommend her to anyone!!&amp;nbsp; Her email is: &lt;a data-ipb=&#039;nomediaparse&#039; href=\"mailto:diane@islandharmony.com\"&gt;diane@islandharmony.com&lt;\/a&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Brianna&lt;\/p&gt;","Attachments":[],"Id":1440361,"PostDate":1303739557,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> \u00a0I just got married in T&C a little over a month ago at the Somerset with 85 guests.\u00a0 Originally when we booked the wedding, the hotel employed a coordinator who was to take care of us.\u00a0 She ended up quitting, and for us it was a blessing!\u00a0 Diane from Island Harmony took over as our planner.\u00a0 As soon as we spoke with her all, our nerves subsided.\u00a0 She was FABULOUS.\u00a0 She is originally\u00a0from NJ but has lived on the island 7 years now and has her own event planning business.\u00a0 She was a GODSEND!\u00a0 She picked right up where the other coordinator left off and had so many connections to vendors on the island and so many great ideas!\u00a0 We inundated her with emails, and she was always so quick to respond, highly organized\u00a0and was just the sweetest woman ever to work with.\u00a0 She genuinely cares to make your day special and\u00a0did her best to make it exactly how we envisioned it.\u00a0 For us, she went above and beyond what we could have expected and we would recommend her to anyone!!\u00a0 Her email is: <a href='mailto:diane@islandharmony.com' class='bbc_url' title='External link' rel='nofollow external'>diane@islandharmony.com<\/a><\/p> <p> \u00a0<\/p> <p> Brianna<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"bmredmond1@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1277612492,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-229600.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Soon-to-be-Mrs.D","Id":229600,"Name":"Soon-to-be-Mrs.D","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":60834,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5429af5665cb88f8fb994def86add612","RawContent":"&lt;p&gt; Kendal23 - I&#039;m in the same situation. &amp;nbsp;I&#039;d love to hear some honest reviews. &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1445993,"PostDate":1304517246,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Kendal23 - I'm in the same situation. \u00a0I'd love to hear some honest reviews. \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"loren.kokal@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1301933625,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-238512.JPG?_r=0","PhotoWidth":200,"PhotoHeight":154,"PhotoType":"custom"},"FormattedName":"kokalloa","Id":238512,"Name":"kokalloa","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":60834,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5fec5725580a79fa9da12b1a2aa1c891","RawContent":"&lt;p&gt; We have a total of 3 planners on island (yes that&#039;s 3 total).&amp;nbsp; Diane from Island Harmony, Teresa from Tropical Destination Management and then Nila Destinations.&amp;nbsp; Diane and Teresa are both owners of their businesses, Nila has employees who are hired to coordinate. Eden is currently doing the weddings for Nila but is leaving this summer and I don&#039;t know who is taking her place.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Some of the hotels have in house coordinators if you use them.&amp;nbsp; Others (Sommerset, Gansevoort) actually hire Diane or Teresa for their weddings so if you go with them you don&#039;t need to hire someone separately.&amp;nbsp; Lately we have done most of our weddings with Diane or Teresa, with a smaller percentage with Nila.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; This is a small island (the entire country of 9 islands has less than 20,000 people).&amp;nbsp; If you are not good at what you do here, you will not be in business for more than a season.&amp;nbsp; We all work, play, have kids in school together, play sports etc, so word gets around lightning fast if someone is not doing a good job.(we call it the coconut telegraph!)&amp;nbsp; All of these businesses have been established on island for 4+ years.  &lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; If you have any more specific questions let me know.&amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; If you check our blog, we will always mention the coordinator in our wedding posts if there was one.&amp;nbsp; You can search Island Harmony\/Tropical Destination Management\/ or Nila and the weddings they coordinated will come up and you can see their work if that would help.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Krys&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1446477,"PostDate":1304555651,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> We have a total of 3 planners on island (yes that's 3 total).\u00a0 Diane from Island Harmony, Teresa from Tropical Destination Management and then Nila Destinations.\u00a0 Diane and Teresa are both owners of their businesses, Nila has employees who are hired to coordinate. Eden is currently doing the weddings for Nila but is leaving this summer and I don't know who is taking her place.<\/p> <p> \u00a0<\/p> <p> Some of the hotels have in house coordinators if you use them.\u00a0 Others (Sommerset, Gansevoort) actually hire Diane or Teresa for their weddings so if you go with them you don't need to hire someone separately.\u00a0 Lately we have done most of our weddings with Diane or Teresa, with a smaller percentage with Nila.<\/p> <p> \u00a0<\/p> <p> This is a small island (the entire country of 9 islands has less than 20,000 people).\u00a0 If you are not good at what you do here, you will not be in business for more than a season.\u00a0 We all work, play, have kids in school together, play sports etc, so word gets around lightning fast if someone is not doing a good job.(we call it the coconut telegraph!)\u00a0 All of these businesses have been established on island for 4+ years.\u00a0\u00a0<\/p> <p> \u00a0<\/p> <p> If you have any more specific questions let me know.\u00a0<\/p> <p> \u00a0<\/p> <p> If you check our blog, we will always mention the coordinator in our wedding posts if there was one.\u00a0 You can search Island Harmony\/Tropical Destination Management\/ or Nila and the weddings they coordinated will come up and you can see their work if that would help.<\/p> <p> \u00a0<\/p> <p> Krys<\/p> <p> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kmann@tciway.tc","IpAddress":"65.255.54.194","GroupId":44,"GroupName":"Vendor","JoinDate":1213296967,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209917.gif?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Tropical Imaging","Id":209917,"Name":"Tropical Imaging","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":60834,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4246765c413a0532e8f14fe261163c89","RawContent":"&lt;p&gt; We got married at the Seven Stars resort a month ago and used their onsite event planner, Niki Flowers. She was excellent and I would highly recommend her. I&#039;m fairly anal and she not only made the planning process easy, she delivered on everything promised. Our wedding and reception (with 36 people) went flawlessly. Part of the reason I initially chose the Seven Stars was because I wanted an in-house planner. I couldn&#039;t bear the thought of incurring a 10-15% charge on top of my wedding bill to pay an outside planner.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Niki has been at the hotel for several months and has hosted\/planned a few weddings there. She is from London though and planned over 100 weddings in London. She is currently on maternity leave (our wedding was her last event) but her assistant Betina was very involved on our day as well. She is assuming Niki&#039;s role for the next few months and she seemed very put together. If your wedding is several months out, I wouldn&#039;t worry about starting with Betina and shifting to Niki when she&#039;s back, as both were very capable and knowledgeable about our wedding.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Hope that helps!&lt;\/p&gt;","Attachments":[],"Id":1447395,"PostDate":1304699328,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> We got married at the Seven Stars resort a month ago and used their onsite event planner, Niki Flowers. She was excellent and I would highly recommend her. I'm fairly anal and she not only made the planning process easy, she delivered on everything promised. Our wedding and reception (with 36 people) went flawlessly. Part of the reason I initially chose the Seven Stars was because I wanted an in-house planner. I couldn't bear the thought of incurring a 10-15% charge on top of my wedding bill to pay an outside planner.<\/p> <p> \u00a0<\/p> <p> Niki has been at the hotel for several months and has hosted\/planned a few weddings there. She is from London though and planned over 100 weddings in London. She is currently on maternity leave (our wedding was her last event) but her assistant Betina was very involved on our day as well. She is assuming Niki's role for the next few months and she seemed very put together. If your wedding is several months out, I wouldn't worry about starting with Betina and shifting to Niki when she's back, as both were very capable and knowledgeable about our wedding.<\/p> <p> \u00a0<\/p> <p> Hope that helps!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mandevillel@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1201409112,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208377.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"lm3682","Id":208377,"Name":"lm3682","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":60834,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c1bf6ae2b2ea6d0f485f0ba9aa51f1b5","RawContent":"&lt;p&gt; Thanks for all the terrific information! This is really going to help kick start our planning, thanks again!&lt;\/p&gt; &lt;p&gt; -K&lt;\/p&gt;","Attachments":[],"Id":1449721,"PostDate":1305079833,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Thanks for all the terrific information! This is really going to help kick start our planning, thanks again!<\/p> <p> -K<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kendalmgoodheart@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1302650088,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-238805.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"kendal23","Id":238805,"Name":"kendal23","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":60834,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"50581ec24c59a22b3f82e811681b3fbe","RawContent":"&lt;p&gt; Hey Kendal,&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; I have been emailing back and forth with Diane from Island Harmony the last few weeks and am about to book her.&amp;nbsp; I used to be a wedding planner and have been incredibly impressed with her.&amp;nbsp; She is fantastic, professional and very well versed on everything with the Island.&amp;nbsp; She also has wedding packages that can replace the ones that come with the hotels, so you are not double paying.&amp;nbsp; You can&#039;t go wrong by talking to Diane!&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Good luck!&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Karey&lt;\/p&gt;","Attachments":[],"Id":1454833,"PostDate":1305839426,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hey Kendal,<\/p> <p> \u00a0<\/p> <p> I have been emailing back and forth with Diane from Island Harmony the last few weeks and am about to book her.\u00a0 I used to be a wedding planner and have been incredibly impressed with her.\u00a0 She is fantastic, professional and very well versed on everything with the Island.\u00a0 She also has wedding packages that can replace the ones that come with the hotels, so you are not double paying.\u00a0 You can't go wrong by talking to Diane!<\/p> <p> \u00a0<\/p> <p> Good luck!<\/p> <p> \u00a0<\/p> <p> Karey<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kareyusc@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1167796024,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207007.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"kareyusc","Id":207007,"Name":"kareyusc","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":60834,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"98897fbce147a11a54d98f65761aa5a4","RawContent":"&lt;p&gt; Briana, thank you for your post here. I just emailed Diane per your suggestion, as I too am considering T&amp;amp;C as my destination. I &lt;em&gt;think&lt;\/em&gt; we&#039;ll have 100 guests, which narrows it down to just a few places. It was helpful to know that you had 85. Can you recommend the best way to search for hotels (anywhere in the Caribbean) that will accommodate 100 guests? Also, how did you narrow it down to T&amp;amp;C?&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Thanks again for your helpful post, and I hope your wedding was everything you hoped it would be.&lt;\/p&gt; &lt;p&gt; \n Best,&lt;\/p&gt; &lt;p&gt; Melanie&lt;\/p&gt;","Attachments":[],"Id":1472264,"PostDate":1308528517,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Briana, thank you for your post here. I just emailed Diane per your suggestion, as I too am considering T&C as my destination. I <em>think<\/em> we'll have 100 guests, which narrows it down to just a few places. It was helpful to know that you had 85. Can you recommend the best way to search for hotels (anywhere in the Caribbean) that will accommodate 100 guests? Also, how did you narrow it down to T&C?<\/p> <p> \u00a0<\/p> <p> Thanks again for your helpful post, and I hope your wedding was everything you hoped it would be.<\/p> <p> <br \/> Best,<\/p> <p> Melanie<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"melncampwedding@gmail.com","IpAddress":"","GroupId":47,"GroupName":"Site Supporter","JoinDate":1306610648,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-240523.jpg?_r=0","PhotoWidth":200,"PhotoHeight":113,"PhotoType":"custom"},"FormattedName":"MelnCamp","Id":240523,"Name":"MelnCamp","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":60834,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3931269ddc88b33f27bb4b66a3235722","RawContent":"&lt;p&gt; The best way to search in the T&amp;amp;C is www.turksandcaicosreservations.tc&amp;nbsp; (I have no affiliation with them, they are just known on island as the place to get the best service and best deals and have everything in one place)&amp;nbsp; They have all of the hotels\/resorts listed on one site and they keep up to date information of all booking specials.&amp;nbsp; Pretty much any of our main resorts should be able to m 100 guests.&amp;nbsp; The most popular here are The Regent Palms, Grace Bay Club, The Somerset, The Gansevoort, The Sands, Ocean Club\/Ocean Club West, Seven Stars, West Bay Club and we have a few more.&amp;nbsp; You can check our blog listed below for what weddings look like at each of the resorts.&amp;nbsp; If you have any other questions on resorts feel free to ask me, I have lived here 16 years and am happy to help.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Krys&lt;\/p&gt;","Attachments":[],"Id":1472403,"PostDate":1308567293,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> The best way to search in the T&C is www.turksandcaicosreservations.tc\u00a0 (I have no affiliation with them, they are just known on island as the place to get the best service and best deals and have everything in one place)\u00a0 They have all of the hotels\/resorts listed on one site and they keep up to date information of all booking specials.\u00a0 Pretty much any of our main resorts should be able to m 100 guests.\u00a0 The most popular here are The Regent Palms, Grace Bay Club, The Somerset, The Gansevoort, The Sands, Ocean Club\/Ocean Club West, Seven Stars, West Bay Club and we have a few more.\u00a0 You can check our blog listed below for what weddings look like at each of the resorts.\u00a0 If you have any other questions on resorts feel free to ask me, I have lived here 16 years and am happy to help.<\/p> <p> \u00a0<\/p> <p> Krys<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kmann@tciway.tc","IpAddress":"65.255.54.194","GroupId":44,"GroupName":"Vendor","JoinDate":1213296967,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209917.gif?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Tropical Imaging","Id":209917,"Name":"Tropical Imaging","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":60834,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c5a73af85d9011de2921ba280603723c","RawContent":"&lt;p&gt; Hi Melanie,&lt;\/p&gt; &lt;p&gt; We had some specific criteria that we used to narrow our wedding destination down to Turks and Caicos:&lt;\/p&gt; &lt;p&gt; 1) Really nice, clean beaches&lt;\/p&gt; &lt;p&gt; 2) Easily accessible from the US (most of our guests flew out of the northeast mainly NYC and Boston)&lt;\/p&gt; &lt;p&gt; 3) US dollar currency and english speaking&lt;\/p&gt; &lt;p&gt; 4)Cheaper accomodation options for our guests&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; I did a ton of research and it just sounded like T&amp;amp;C would be perfect.&amp;nbsp;After picking the island, I searched hotels\/resorts online (I actually used the website Krys suggested above a lot - very helpful) and picked 4 of them that we thought we&#039;d like and actually took a trip down there about a year before the wedding to scout it out.&amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; I think the planning trip was the best thing that we could have done.&amp;nbsp; We really knew what we wanted and where to tell people to stay once we met with all of the hotels.&amp;nbsp; We got married at the Somerset, but knew this was going to be way to expensive for our friends to stay at... most of our guests stayed at the Sibonne (realllllly budget friendly and literally right next door to the Somerset) and the Sands (moderately priced and located on the other side of the Sibonne).&amp;nbsp; Then there were a few people who stayed at the Alexandria, and one couple at Point Grace.&amp;nbsp; All were in close proximity (Alexandria was the farthest down the beach).&amp;nbsp; Good luck with your search - T&amp;amp;C will not disappoint AND Diane from Island Harmony is fabulous - you&#039;ll love her!&lt;\/p&gt;","Attachments":[],"Id":1472794,"PostDate":1308600311,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hi Melanie,<\/p> <p> We had some specific criteria that we used to narrow our wedding destination down to Turks and Caicos:<\/p> <p> 1) Really nice, clean beaches<\/p> <p> 2) Easily accessible from the US (most of our guests flew out of the northeast mainly NYC and Boston)<\/p> <p> 3) US dollar currency and english speaking<\/p> <p> 4)Cheaper accomodation options for our guests<\/p> <p> \u00a0<\/p> <p> I did a ton of research and it just sounded like T&C would be perfect.\u00a0After picking the island, I searched hotels\/resorts online (I actually used the website Krys suggested above a lot - very helpful) and picked 4 of them that we thought we'd like and actually took a trip down there about a year before the wedding to scout it out.\u00a0<\/p> <p> \u00a0<\/p> <p> I think the planning trip was the best thing that we could have done.\u00a0 We really knew what we wanted and where to tell people to stay once we met with all of the hotels.\u00a0 We got married at the Somerset, but knew this was going to be way to expensive for our friends to stay at... most of our guests stayed at the Sibonne (realllllly budget friendly and literally right next door to the Somerset) and the Sands (moderately priced and located on the other side of the Sibonne).\u00a0 Then there were a few people who stayed at the Alexandria, and one couple at Point Grace.\u00a0 All were in close proximity (Alexandria was the farthest down the beach).\u00a0 Good luck with your search - T&C will not disappoint AND Diane from Island Harmony is fabulous - you'll love her!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"bmredmond1@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1277612492,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-229600.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Soon-to-be-Mrs.D","Id":229600,"Name":"Soon-to-be-Mrs.D","IsOnline":false}}],"Id":"60834","Title":"Turks & Caicos Wedding Planner","LastPostDate":1414682065},"Pages":{"TotalItems":70,"TotalPages":7,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":60},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
