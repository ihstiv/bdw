ewright.netdna-cdn.com\/cdn\/monthly_09_2015\/post-279989-0-03828300-1441146018.jpg\" class='bbc_img linked-image' alt=\"image.jpg\" \/><\/a>\n\n<a class='resized_img' rel='lightbox[1903959]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_09_2015\/post-279989-0-93530300-1441146723.jpg\" title=\"image.jpg - Size: 84.14KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_09_2015\/post-279989-0-93530300-1441146723.jpg\" class='bbc_img linked-image' alt=\"image.jpg\" \/><\/a>\n\n<a class='resized_img' rel='lightbox[1903959]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_09_2015\/post-279989-0-12152600-1441146844.jpg\" title=\"image.jpg - Size: 48.81KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_09_2015\/post-279989-0-12152600-1441146844.jpg\" class='bbc_img linked-image' alt=\"image.jpg\" \/><\/a>\n\n<a class='resized_img' rel='lightbox[1903959]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_09_2015\/post-279989-0-58186000-1441146743.jpg\" title=\"image.jpg - Size: 75KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_09_2015\/post-279989-0-58186000-1441146743.jpg\" class='bbc_img linked-image' alt=\"image.jpg\" \/><\/a>\n\n<a class='resized_img' rel='lightbox[1903959]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_09_2015\/post-279989-0-10544300-1441146967.jpg\" title=\"image.jpg - Size: 34.96KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_09_2015\/post-279989-0-10544300-1441146967.jpg\" class='bbc_img linked-image' alt=\"image.jpg\" \/><\/a>\n\n<a class='resized_img' rel='lightbox[1903959]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_09_2015\/post-279989-0-21080400-1441147019.jpg\" title=\"image.jpg - Size: 87.68KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_09_2015\/post-279989-0-21080400-1441147019.jpg\" class='bbc_img linked-image' alt=\"image.jpg\" \/><\/a>\n\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kelleyren@msn.com","IpAddress":"207.229.178.37","GroupId":39,"GroupName":"Newbie","JoinDate":1411589348,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279989.jpg?_r=1441143034","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Dportbride","Id":279989,"Name":"Dportbride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.12.104","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79560,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b32eeced92c239e1fa7d6a251ee0eda8","RawContent":"&lt;p&gt;Congrats! What a stunning backdrop for your photos! Absolutely gorgeous! Glad it turned out as you hoped. It looks everyone had a great time! Thanks for the review. It&#039;s always a help for future brides.&lt;\/p&gt;","Attachments":[],"Id":1903975,"PostDate":1441149849,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congrats! What a stunning backdrop for your photos! Absolutely gorgeous! Glad it turned out as you hoped. It looks everyone had a great time! Thanks for the review. It's always a help for future brides.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283440999,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.51.43.112","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79560,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5c188f289397c71e90476258f1fa4f83","RawContent":"&lt;p&gt;&lt;span style=\"font-size:11.6666669845581px;\"&gt;Congrats!!! You looked amazing and your photos are beautiful&amp;nbsp; :)&lt;\/span&gt;&lt;span style=\"font-size:11.6666669845581px;\"&gt;&amp;nbsp;Looks like you had an incredible celebration!!!!&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1903982,"PostDate":1441157830,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><span  style=\"font-size:11.6666669845581px\">Congrats!!! You looked amazing and your photos are beautiful\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/span><span  style=\"font-size:11.6666669845581px\">\u00a0Looks like you had an incredible celebration!!!!<\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-size:18px;\"><span style=\"font-family:georgia;\"><strong>MARIESAM SANCHEZ PHOTOGRAPHY<\/strong><\/span><\/span><br>\nWEBSITE: <a  class=\"bbc_url\" href=\"http:\/\/www.mariesamsanchez.com\">www.mariesamsanchez.com<\/a><br>\nBLOG: <a  class=\"bbc_url\" href=\"http:\/\/www.mariesamsanchezblog.com\">www.mariesamsanchez.com<\/a><a data-ipb='nomediaparse' href='http:\/\/www.mariesamsanchez.com\/blog'>\/blog<\/a><br>\nCONTACT ME: <a  class=\"bbc_email\" href=\"mailto:mariesam.sanchez@gmail.com?subject=BDW%20Inquiry\" title=\"E-mail Link\">mariesam.sanchez@gmail.com<\/a><br><br><img src=\"http:\/\/i287.photobucket.com\/albums\/ll150\/msam007562\/063cb5c8-dbda-4822-87fe-ba3c0ebcdb7f.jpg\" alt=\"063cb5c8-dbda-4822-87fe-ba3c0ebcdb7f.jpg\">","Email":"mariesam.sanchez@gmail.com","IpAddress":"74.100.61.37","GroupId":38,"GroupName":"Moderators","JoinDate":1285936345,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232833.jpg?_r=1422091823","PhotoWidth":200,"PhotoHeight":220,"PhotoType":"custom"},"FormattedName":"MarieSamSanchezPhoto","Id":232833,"Name":"MarieSamSanchezPhoto","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.241.131.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79560,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7875e5a217458c5fdea411d3f5c7c061","RawContent":"&lt;p&gt;Wow! Loved looking at your pictures. What a beautiful day! You guys all looked great and I loved yours\/your bridesmaid bouquets.. I can&#039;t believe that they are artificial. They photographed so well!!&lt;\/p&gt;","Attachments":[],"Id":1904160,"PostDate":1441354948,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Wow! Loved looking at your pictures. What a beautiful day! You guys all looked great and I loved yours\/your bridesmaid bouquets.. I can't believe that they are artificial. They photographed so well!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;1\/st\/20151215\/e\/Our+Wedding\/k\/ec4b\/event.png\" alt=\"event.png\"><\/a><br><br><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":42,"GroupName":"Sr. Member","JoinDate":1419419814,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1436293677","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":false}}],"Id":"79560","Title":"Just Married At Riu Palace In Cabo San Lucas Mx 6-13-15","LastPostDate":1441354948},"Pages":{"TotalItems":4,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
