p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jeanneshop@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1298224348,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-236994.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"ERCBride312","Id":236994,"Name":"ERCBride312","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":64583,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"29a83107d3d88b354b825b33ad1386e0","RawContent":"&lt;p&gt; Hi Ashley -&amp;nbsp;&lt;\/p&gt; &lt;p&gt; I tried to reply a moment ago but it does not look like it worked. &amp;nbsp;Apologies for the double post if it happens. &amp;nbsp;There is an existing thread called Excellence Riviera Maya that is a little older and has a lot of information in it. &amp;nbsp;We are getting married at ERC on March 24, 2012. &amp;nbsp;We have vacationed at the resort for the past two years and love it. &amp;nbsp;Please let me know if you have any questions or if there is anything I can do to help.&lt;\/p&gt; &lt;p&gt; J&lt;\/p&gt;","Attachments":[],"Id":1550009,"PostDate":1322070028,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hi Ashley -\u00a0<\/p> <p> I tried to reply a moment ago but it does not look like it worked. \u00a0Apologies for the double post if it happens. \u00a0There is an existing thread called Excellence Riviera Maya that is a little older and has a lot of information in it. \u00a0We are getting married at ERC on March 24, 2012. \u00a0We have vacationed at the resort for the past two years and love it. \u00a0Please let me know if you have any questions or if there is anything I can do to help.<\/p> <p> J<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jeanneshop@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1298224348,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-236994.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"ERCBride312","Id":236994,"Name":"ERCBride312","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":64583,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fbe8388d02e9fc1950ff55df0eb3bb45","RawContent":"&lt;p&gt; Thanks J! I will definitely have to check out that thread!&lt;\/p&gt;","Attachments":[],"Id":1553129,"PostDate":1322864596,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Thanks J! I will definitely have to check out that thread!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ashleynchristian@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1311633878,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-242762.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"custom"},"FormattedName":"SunsetLove","Id":242762,"Name":"SunsetLove","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":64583,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0d37b89f4514d7f65d104667defab9dd","RawContent":"&lt;p&gt; Hi,&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; I&#039;m getting married at ERC on May 7, 2012. How is your planning going?&lt;\/p&gt;","Attachments":[],"Id":1553187,"PostDate":1322882995,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hi,<\/p> <p> \u00a0<\/p> <p> I'm getting married at ERC on May 7, 2012. How is your planning going?<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jennyc531@yahoo.com","IpAddress":"","GroupId":47,"GroupName":"Site Supporter","JoinDate":1309290733,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-241691.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"BunnyBride","Id":241691,"Name":"BunnyBride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":64583,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3e9ae359f4e772d8ab06f3a4cc6e12fa","RawContent":"&lt;p&gt; Hi! How exciting! Planning is going pretty good so far. We are working with Gloria...but we have been putting most of our efforts lately into the AHR. I finally got my dress ordered a few weeks ago though!&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; How is your planning coming along? Which package are you doing?&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; We are doing the Excellence package, because I our wedding is going to be pretty small. I think we may just go to dinner afterwards rather than have a reception. We are planning a big reception at home so I don&#039;t want to spend a ton of money for a big to-do down in Mexico.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Look forward to hearing all about your wedding!&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Ashley&lt;\/p&gt;","Attachments":[],"Id":1553770,"PostDate":1323100739,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hi! How exciting! Planning is going pretty good so far. We are working with Gloria...but we have been putting most of our efforts lately into the AHR. I finally got my dress ordered a few weeks ago though!<\/p> <p> \u00a0<\/p> <p> How is your planning coming along? Which package are you doing?<\/p> <p> \u00a0<\/p> <p> We are doing the Excellence package, because I our wedding is going to be pretty small. I think we may just go to dinner afterwards rather than have a reception. We are planning a big reception at home so I don't want to spend a ton of money for a big to-do down in Mexico.<\/p> <p> \u00a0<\/p> <p> Look forward to hearing all about your wedding!<\/p> <p> \u00a0<\/p> <p> Ashley<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ashleynchristian@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1311633878,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-242762.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"custom"},"FormattedName":"SunsetLove","Id":242762,"Name":"SunsetLove","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":64583,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"56ef7600800b9cce407ea4614f27197a","RawContent":"&lt;p&gt; Getting married @ ERC June 29th, 2012. &amp;nbsp;Who is Gloria (just curious... name isn&#039;t familiar &amp;amp; our dates are so close). &amp;nbsp;Excited!&lt;\/p&gt;","Attachments":[],"Id":1554968,"PostDate":1323326319,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Getting married @ ERC June 29th, 2012. \u00a0Who is Gloria (just curious... name isn't familiar & our dates are so close). \u00a0Excited!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"JConner17@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1318783185,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-246764.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"JConner17","Id":246764,"Name":"JConner17","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":64583,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"098ae4352495c13a89e796ceb76edd6a","RawContent":"&lt;p&gt; Yay! Another ERC bride! Gloria is the coordinator that I&#039;ve been working with. Our dates are super close! What have you planned so far?&lt;\/p&gt;","Attachments":[],"Id":1555093,"PostDate":1323369608,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Yay! Another ERC bride! Gloria is the coordinator that I've been working with. Our dates are super close! What have you planned so far?<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ashleynchristian@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1311633878,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-242762.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"custom"},"FormattedName":"SunsetLove","Id":242762,"Name":"SunsetLove","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":64583,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c5cb258ccdd24f7469d56119f4aafd58","RawContent":"&lt;p&gt; Ok, this is my third try trying to post! Hopefully this works!&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; I am working with nayeli.&amp;nbsp; We are getting the gold package.&amp;nbsp; So far everything is good.&amp;nbsp;I booked our air, honeymoon, dj and photgrapher. In process of getting the invitations made.&lt;\/p&gt;","Attachments":[],"Id":1555275,"PostDate":1323397406,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Ok, this is my third try trying to post! Hopefully this works!<\/p> <p> \u00a0<\/p> <p> I am working with nayeli.\u00a0 We are getting the gold package.\u00a0 So far everything is good.\u00a0I booked our air, honeymoon, dj and photgrapher. In process of getting the invitations made.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jennyc531@yahoo.com","IpAddress":"","GroupId":47,"GroupName":"Site Supporter","JoinDate":1309290733,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-241691.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"BunnyBride","Id":241691,"Name":"BunnyBride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":64583,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3fca7295a14faef3c6abf79dfd32152b","RawContent":"&lt;p&gt; Glad you were finally able to post :)&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Who are you using for you photographer? We just sent out our save-the-dates (a little late!), but I haven&#039;t decided what I want to do for the invitations yet.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; I am all over the place these days - I guess I&#039;m just kind of confused about what all is included and when we make our selections. No one has really explained everything to me. Do we make our selections (flowers, ceremony music, etc...) when we get down there?&lt;\/p&gt;","Attachments":[],"Id":1555513,"PostDate":1323463297,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Glad you were finally able to post <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p> <p> \u00a0<\/p> <p> Who are you using for you photographer? We just sent out our save-the-dates (a little late!), but I haven't decided what I want to do for the invitations yet.<\/p> <p> \u00a0<\/p> <p> I am all over the place these days - I guess I'm just kind of confused about what all is included and when we make our selections. No one has really explained everything to me. Do we make our selections (flowers, ceremony music, etc...) when we get down there?<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ashleynchristian@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1311633878,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-242762.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"custom"},"FormattedName":"SunsetLove","Id":242762,"Name":"SunsetLove","IsOnline":false}}],"Pages":{"TotalItems":1183,"TotalPages":119,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":1180},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
