Request Time: 0 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":1792,"QueuedPosts":0,"DeletedPosts":8,"HasUnreadPosts":true,"HasAttachments":true,"Views":135590,"MovedTo":null,"MovedOn":0,"FirstPostId":1521871,"Rating":0,"RatingHits":0,"Starter":{"Id":245483,"Name":"IdoBeach2012","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-245483.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"IsOnline":false},"StartDate":1316479414,"LastPoster":{"Id":262240,"Name":"MissAmber26","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-262240.jpg?_r=1421980656","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":2,"Preview":{"Id":1894852,"PostDate":1430321893,"PostContent":"Hi Everyone! I am new to this site. I am getting married on the sky deck at beach palace May 2016...","Author":{"Signature":"","Email":"mangjen56@gmail.com","IpAddress":"70.164.27.2","GroupId":39,"GroupName":"Newbie","JoinDate":1430256001,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"jj575757","Id":282898,"Name":"jj575757","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.164.27.2","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":63613,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"be4668704dab79e164c42dec44ea9cf6","RawContent":"&lt;p&gt;Hi Everyone!&lt;\/p&gt;\n&lt;p&gt;I am new to this site. I am getting married on the sky deck at beach palace May 2016. I am going to go with the Pure package. And I am also interested in using latinasia as a vendor for additional flowers\/ lighting. Has anyone used the pure package? If so, do you have any photos? Also, does anyone know if I have to pay a vendor fee to use Latinasia?? Also, the overhead lights for the sky terrace are those included or do we have to purchase those separately.&lt;\/p&gt;\n&lt;p&gt;Thanks everyone so much! And thank you amber for introducing me to this site!!&lt;\/p&gt;\n&lt;p&gt;-Jen&lt;\/p&gt;","Attachments":[],"Id":1894852,"PostDate":1430321893,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi Everyone!<\/p>\n<p>I am new to this site. I am getting married on the sky deck at beach palace May 2016. I am going to go with the Pure package. And I am also interested in using latinasia as a vendor for additional flowers\/ lighting. Has anyone used the pure package? If so, do you have any photos? Also, does anyone know if I have to pay a vendor fee to use Latinasia?? Also, the overhead lights for the sky terrace are those included or do we have to purchase those separately.<\/p>\n<p>Thanks everyone so much! And thank you amber for introducing me to this site!!<\/p>\n<p>-Jen<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mangjen56@gmail.com","IpAddress":"70.164.27.2","GroupId":39,"GroupName":"Newbie","JoinDate":1430256001,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"jj575757","Id":282898,"Name":"jj575757","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.241.131.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":63613,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"da90236c13b9d892e084bcef4e9aad2e","RawContent":"&lt;p&gt;@[member=\"jj575757\"] welcome! I&#039;m not going with any pre-packaged decor through the resort. I&#039;m sourcing all of my decor seperately in order to fit my vision, but I can confirm that LatinAsia and Zuniga are both Palace Approved vendors (no vendor fee).&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Overhead lights are additional and not included in the package. I think Latinasia charges about $150USD per string of ten lanterns + installation because they need to install tensors to hold the lanterns.&lt;\/p&gt;","Attachments":[],"Id":1894856,"PostDate":1430322218,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"282898\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/282898-jj575757\/' title='Member profile'><span itemprop=\"name\">jj575757<\/span><\/a> welcome! I'm not going with any pre-packaged decor through the resort. I'm sourcing all of my decor seperately in order to fit my vision, but I can confirm that LatinAsia and Zuniga are both Palace Approved vendors (no vendor fee).<\/p>\n<p>\u00a0<\/p>\n<p>Overhead lights are additional and not included in the package. I think Latinasia charges about $150USD per string of ten lanterns + installation because they need to install tensors to hold the lanterns.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;1\/st\/20151215\/e\/Our+Wedding\/k\/ec4b\/event.png\" alt=\"event.png\"><\/a><br><br><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":3,"GroupName":"Member","JoinDate":1419441414,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1428347017","PhotoWidth":169,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.41.201.34","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":63613,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7af5c24649575a768bb7bd1918700992","RawContent":"&lt;p&gt;I know I&#039;ve read the answer to this question on here before, but can&#039;t seem to find it now - I apologize for re-asking! &amp;nbsp;Can anyone tell me exactly how the complimentary rooms work? For example, once we have 10 rooms booked, can I assign the 11th room to someone and they will not have to pay? &amp;nbsp;Also, has anyone used their complimentary rooms for their honeymoon? &amp;nbsp;Any info you all have would be great. &amp;nbsp;This blog is so helpful!&lt;\/p&gt;","Attachments":[],"Id":1894882,"PostDate":1430337871,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I know I've read the answer to this question on here before, but can't seem to find it now - I apologize for re-asking! \u00a0Can anyone tell me exactly how the complimentary rooms work? For example, once we have 10 rooms booked, can I assign the 11th room to someone and they will not have to pay? \u00a0Also, has anyone used their complimentary rooms for their honeymoon? \u00a0Any info you all have would be great. \u00a0This blog is so helpful!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"erikahime@gmail.com","IpAddress":"208.191.153.24","GroupId":39,"GroupName":"Newbie","JoinDate":1421821507,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Danielle1","Id":281815,"Name":"Danielle1","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.208.129.21","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":63613,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"dd50adb2d7414e1c459962c2e1ef1611","RawContent":"@[member=\"jj575757\"] Welcome Jennifer!\n\n\n\n@[member=\"Danielle1\"]\n\n\nI can&#039;t find the email but I think my TA told me that we get a credit for the amount of free rooms. I&#039;ll look for the email again when I get off work.","Attachments":[],"Id":1894892,"PostDate":1430340860,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"282898\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/282898-jj575757\/' title='Member profile'><span itemprop=\"name\">jj575757<\/span><\/a> Welcome Jennifer!<br><br><br>\n@<a hovercard-ref=\"member\" hovercard-id=\"281815\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281815-danielle1\/' title='Member profile'><span itemprop=\"name\">Danielle1<\/span><\/a><br><br>\nI can't find the email but I think my TA told me that we get a credit for the amount of free rooms. I'll look for the email again when I get off work.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"Amaqt03@hotmail.com","IpAddress":"98.169.122.6","GroupId":39,"GroupName":"Newbie","JoinDate":1352514105,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-262240.jpg?_r=1421980656","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"MissAmber26","Id":262240,"Name":"MissAmber26","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.164.27.2","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":63613,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1643da8453e6a489c79d1e308ff20790","RawContent":"&lt;p style=\"margin-left:40px;\"&gt;Hi Everyone!&lt;\/p&gt;\n&lt;p style=\"margin-left:40px;\"&gt;I just wanted to let you know that my WC Nayeli told me that&amp;nbsp; the sky deck now has a new white gazebo. My TA is there right now and I asked her to please send pictures if she sees the new gazebo! Has anyone had a wedding with this new gazebo? I cant seem to find any pictures!&lt;\/p&gt;","Attachments":[],"Id":1894926,"PostDate":1430402155,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p  style=\"margin-left:40px\">Hi Everyone!<\/p>\n<p  style=\"margin-left:40px\">I just wanted to let you know that my WC Nayeli told me that\u00a0 the sky deck now has a new white gazebo. My TA is there right now and I asked her to please send pictures if she sees the new gazebo! Has anyone had a wedding with this new gazebo? I cant seem to find any pictures!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mangjen56@gmail.com","IpAddress":"70.164.27.2","GroupId":39,"GroupName":"Newbie","JoinDate":1430256001,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"jj575757","Id":282898,"Name":"jj575757","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.41.201.34","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":63613,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"23ec325e1b632c83e161f6786ef3c657","RawContent":"&lt;p&gt;Did anyone exceed their originally reserved rooms? &amp;nbsp;Our reserved rooms are almost full but guests are still booking... I&#039;m wondering if they will still be able to keep booking through our website even after our reserved rooms are booked?&lt;\/p&gt;","Attachments":[],"Id":1894934,"PostDate":1430407149,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Did anyone exceed their originally reserved rooms? \u00a0Our reserved rooms are almost full but guests are still booking... I'm wondering if they will still be able to keep booking through our website even after our reserved rooms are booked?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"erikahime@gmail.com","IpAddress":"208.191.153.24","GroupId":39,"GroupName":"Newbie","JoinDate":1421821507,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Danielle1","Id":281815,"Name":"Danielle1","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.241.131.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":63613,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bc4f0306988231c9258cbc0565b4b0e4","RawContent":"&lt;p&gt;@[member=\"Danielle1\"] We hit our maximum and our TA informed us that she would have to contact the operator (Transat Holidays) to see if she can get more at our room block price.&lt;\/p&gt;","Attachments":[],"Id":1894935,"PostDate":1430408218,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"281815\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281815-danielle1\/' title='Member profile'><span itemprop=\"name\">Danielle1<\/span><\/a> We hit our maximum and our TA informed us that she would have to contact the operator (Transat Holidays) to see if she can get more at our room block price.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;1\/st\/20151215\/e\/Our+Wedding\/k\/ec4b\/event.png\" alt=\"event.png\"><\/a><br><br><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":3,"GroupName":"Member","JoinDate":1419441414,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1428347017","PhotoWidth":169,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.41.201.34","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":63613,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"3296ec2b1d8d191076f371d2948dd30f","RawContent":"&lt;p&gt;@[member=\"perianjay\"] thanks! Did your reservation website just quit working? Were they able to accomodate you and did you just have to pay more money to reserve additional rooms?&lt;\/p&gt;","Attachments":[],"Id":1894936,"PostDate":1430408406,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"281478\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281478-perianjay\/' title='Member profile'><span itemprop=\"name\">perianjay<\/span><\/a> thanks! Did your reservation website just quit working? Were they able to accomodate you and did you just have to pay more money to reserve additional rooms?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"erikahime@gmail.com","IpAddress":"208.191.153.24","GroupId":39,"GroupName":"Newbie","JoinDate":1421821507,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Danielle1","Id":281815,"Name":"Danielle1","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.241.131.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":63613,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bccb7e5d7100b04fbea6c79fd00c1b6a","RawContent":"&lt;p&gt;@[member=\"Danielle1\"] We haven&#039;t had any bookings past our maximum. We actually blocked off the correct amount of rooms that we knew we would need. Anything past that would be a special request, but 95% of our guests already put their deposit down. We&#039;re past our deposit close date now. If anyone were to book now it would be separate.&lt;\/p&gt;","Attachments":[],"Id":1894938,"PostDate":1430410002,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"281815\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281815-danielle1\/' title='Member profile'><span itemprop=\"name\">Danielle1<\/span><\/a> We haven't had any bookings past our maximum. We actually blocked off the correct amount of rooms that we knew we would need. Anything past that would be a special request, but 95% of our guests already put their deposit down. We're past our deposit close date now. If anyone were to book now it would be separate.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;1\/st\/20151215\/e\/Our+Wedding\/k\/ec4b\/event.png\" alt=\"event.png\"><\/a><br><br><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":3,"GroupName":"Member","JoinDate":1419441414,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1428347017","PhotoWidth":169,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.41.201.34","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":63613,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"62e946149f1b1b36e4491bc6550cc924","RawContent":"&lt;p&gt;@[member=\"perianjay\"] Thanks so much for the information! I&#039;ll have my TA look into it :) Thanks!&lt;\/p&gt;","Attachments":[],"Id":1894939,"PostDate":1430410148,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"281478\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281478-perianjay\/' title='Member profile'><span itemprop=\"name\">perianjay<\/span><\/a> Thanks so much for the information! I'll have my TA look into it <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> Thanks!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"erikahime@gmail.com","IpAddress":"208.191.153.24","GroupId":39,"GroupName":"Newbie","JoinDate":1421821507,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Danielle1","Id":281815,"Name":"Danielle1","IsOnline":false}}],"Id":"63613","Title":"Beach Palace Cancun Brides","LastPostDate":1430511831},"Pages":{"TotalItems":1792,"TotalPages":180,"CurrentPage":1780,"NextPage":1790,"PreviousPage":1770,"LastPage":1790},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
