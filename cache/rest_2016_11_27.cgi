{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"166.137.252.29","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78597,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f3677d95807ff0ceed8d24bb7c7540b3","RawContent":"It&#039;s the one from the resort.  $1300 mic, lights, 4 hours.  \n\nI&#039;m wondering about the lighting on the sky bar.","Attachments":[],"Id":1893204,"PostDate":1429111330,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                It's the one from the resort.  $1300 mic, lights, 4 hours.  <br>\nI'm wondering about the lighting on the sky bar.  \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Gian-Luigi & Susan September 13, 2015 Finest Resort <a data-ipb='nomediaparse' href='http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A'>http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A<\/a>","Email":"susanlaurelli@yahoo.com","IpAddress":"47.17.228.244","GroupId":40,"GroupName":"Jr. Member","JoinDate":1414858204,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-280946.jpg?_r=1470416051","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"SusanMarie813","Id":280946,"Name":"SusanMarie813","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"170.200.168.13","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78597,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"930098168029f035dff8c25cb0be64a2","RawContent":"&lt;p&gt;My OOT bags below and my centerpieces I got them IKEA for $4.99 the centerpieces these are the big ones on special.&lt;\/p&gt;\n&lt;p&gt;OOT bags $3.99&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.ikea.com\/us\/en\/catalog\/products\/00252861\/&#039;&gt;http:\/\/www.ikea.com\/us\/en\/catalog\/products\/00252861\/&lt;\/a&gt;&lt;\/p&gt;\n&lt;div&gt;[sharedmedia=core:attachments:31772]&lt;\/div&gt;","Attachments":[],"Id":1894056,"PostDate":1429799412,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>My OOT bags below and my centerpieces I got them IKEA for $4.99 the centerpieces these are the big ones on special.<\/p>\n<p>OOT bags $3.99\u00a0<\/p>\n<p><a href='http:\/\/www.ikea.com\/us\/en\/catalog\/products\/00252861\/' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.ikea.com\/...ducts\/00252861\/<\/a><\/p>\n<div><a class='resized_img' rel='lightbox[1894055]' id='ipb-attach-url-31772-0-95983100-1479775096' href=\"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/monthly_04_2015\/post-280946-0-75946800-1429798999.jpg\" title=\"ikea-nipprig-woven-basket-gardenista.jpg - Size: 64.81KB\"><span rel='lightbox'><img class='bbc_img' itemprop=\"image\" src=\"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/monthly_04_2015\/post-280946-0-75946800-1429798999_thumb.jpg\" id='ipb-attach-img-31772-0-95983100-1479775096' style='width:150;height:113' class='attach' width=\"150\" height=\"113\" alt=\"ikea-nipprig-woven-basket-gardenista.jpg\" \/><\/span><\/a>\n<\/div>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Gian-Luigi & Susan September 13, 2015 Finest Resort <a data-ipb='nomediaparse' href='http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A'>http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A<\/a>","Email":"susanlaurelli@yahoo.com","IpAddress":"47.17.228.244","GroupId":40,"GroupName":"Jr. Member","JoinDate":1414858204,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-280946.jpg?_r=1470416051","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"SusanMarie813","Id":280946,"Name":"SusanMarie813","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.3.185.205","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78597,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d1d0f00fc8ccc4545afade2f2dcd2064","RawContent":"&lt;p&gt;@[member=\"airsusie\"] isnt your wedding coming up soon?&lt;\/p&gt;","Attachments":[],"Id":1894819,"PostDate":1430311370,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"280976\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='https:\/\/www.bestdestinationwedding.com\/user\/280976-airsusie\/' title='Member profile'><span itemprop=\"name\">airsusie<\/span><\/a> isnt your wedding coming up soon?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Gian-Luigi & Susan September 13, 2015 Finest Resort <a data-ipb='nomediaparse' href='http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A'>http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A<\/a>","Email":"susanlaurelli@yahoo.com","IpAddress":"47.17.228.244","GroupId":40,"GroupName":"Jr. Member","JoinDate":1414858204,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-280946.jpg?_r=1470416051","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"SusanMarie813","Id":280946,"Name":"SusanMarie813","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.3.185.205","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78597,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"bbdc4a4aeb12ecc0e9cd9e3e5e64ca67","RawContent":"&lt;p&gt;These are my bridesmaid dresses 2 cornflower and 2 prisimmon&lt;\/p&gt;","Attachments":[{"Id":31908,"Name":"388-f0474cf8a3a6d11014-medium prisimmon.jpg","Url":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/monthly_04_2015\/post-280946-0-56929300-1430318173.jpg","ScaledUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/monthly_04_2015\/post-280946-0-56929300-1430318173_thumb.jpg","Width":305,"Height":398},{"Id":31909,"Name":"388-4f7db1a7bed8345477-medium cornflower.jpg","Url":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/monthly_04_2015\/post-280946-0-16465200-1430318181.jpg","ScaledUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/monthly_04_2015\/post-280946-0-16465200-1430318181_thumb.jpg","Width":305,"Height":398}],"Id":1894851,"PostDate":1430318201,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>These are my bridesmaid dresses 2 cornflower and 2 prisimmon<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Gian-Luigi & Susan September 13, 2015 Finest Resort <a data-ipb='nomediaparse' href='http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A'>http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A<\/a>","Email":"susanlaurelli@yahoo.com","IpAddress":"47.17.228.244","GroupId":40,"GroupName":"Jr. Member","JoinDate":1414858204,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-280946.jpg?_r=1470416051","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"SusanMarie813","Id":280946,"Name":"SusanMarie813","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.166.154.81","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78597,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"73edafbc2d294d3e09e5871d0c573951","RawContent":"&lt;p&gt;@[member=\"SusanMarie813\"] it is! four weeks from tomorrow. i can&#039;t believe it. your OOT bags are cute and your dresses look great too. we don&#039;t have a wedding party and we are getting OOT tote bags printed w\/ a design our friend did for us, but they haven&#039;t arrived yet. will post a pic when they get here. we&#039;re down to the last minute details for sure. we are doing string lighting for the reception, but haven&#039;t decided on a lighted versus normal dance floor yet. leaning toward lighted dance floor because i&#039;m worried it&#039;ll be dark out on the beach.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;the thing that is going to take the most time b\/w now and the wedding is making these little donkey pinatas (i know; they look like terrier dogs. lol) to attach to our OOT bags (there is a donkey on our OOT bag design. haha)! &amp;nbsp;&lt;\/p&gt;","Attachments":[{"Id":31929,"Name":"unnamed (1).jpg","Url":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/monthly_05_2015\/post-280976-0-83711400-1430489038.jpg","ScaledUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/monthly_05_2015\/post-280976-0-83711400-1430489038_thumb.jpg","Width":1000,"Height":1000}],"Id":1895033,"PostDate":1430489178,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"280946\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='https:\/\/www.bestdestinationwedding.com\/user\/280946-susanmarie813\/' title='Member profile'><span itemprop=\"name\">SusanMarie813<\/span><\/a> it is! four weeks from tomorrow. i can't believe it. your OOT bags are cute and your dresses look great too. we don't have a wedding party and we are getting OOT tote bags printed w\/ a design our friend did for us, but they haven't arrived yet. will post a pic when they get here. we're down to the last minute details for sure. we are doing string lighting for the reception, but haven't decided on a lighted versus normal dance floor yet. leaning toward lighted dance floor because i'm worried it'll be dark out on the beach.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>the thing that is going to take the most time b\/w now and the wedding is making these little donkey pinatas (i know; they look like terrier dogs. lol) to attach to our OOT bags (there is a donkey on our OOT bag design. haha)! \u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"susieylee@hotmail.com","IpAddress":"173.166.154.81","GroupId":39,"GroupName":"Newbie","JoinDate":1415028059,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-280976.jpg?_r=1424642440","PhotoWidth":200,"PhotoHeight":230,"PhotoType":"custom"},"FormattedName":"airsusie","Id":280976,"Name":"airsusie","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.3.185.205","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78597,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fb151ea08a1ab831c36418ea9b8d876a","RawContent":"&lt;p&gt;Oh super cute!&amp;nbsp; We are not planning on doing a dance floor.. I hope we dont need one.&lt;\/p&gt;\n&lt;p&gt;4 weeks is going to come fast!!!!&lt;\/p&gt;","Attachments":[],"Id":1895042,"PostDate":1430490447,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Oh super cute!\u00a0 We are not planning on doing a dance floor.. I hope we dont need one.<\/p>\n<p>4 weeks is going to come fast!!!!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Gian-Luigi & Susan September 13, 2015 Finest Resort <a data-ipb='nomediaparse' href='http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A'>http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A<\/a>","Email":"susanlaurelli@yahoo.com","IpAddress":"47.17.228.244","GroupId":40,"GroupName":"Jr. Member","JoinDate":1414858204,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-280946.jpg?_r=1470416051","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"SusanMarie813","Id":280946,"Name":"SusanMarie813","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.166.154.81","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78597,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3ede1af3506a4278d5cd8eb0d9cd6474","RawContent":"&lt;p&gt;you probably will be fine w\/o a dance floor. we have to have one since our reception is going to be on the beach. yesterday was our rsvp deadline and it looks like 79 is our final number!&lt;\/p&gt;","Attachments":[],"Id":1895118,"PostDate":1430516705,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>you probably will be fine w\/o a dance floor. we have to have one since our reception is going to be on the beach. yesterday was our rsvp deadline and it looks like 79 is our final number!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"susieylee@hotmail.com","IpAddress":"173.166.154.81","GroupId":39,"GroupName":"Newbie","JoinDate":1415028059,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-280976.jpg?_r=1424642440","PhotoWidth":200,"PhotoHeight":230,"PhotoType":"custom"},"FormattedName":"airsusie","Id":280976,"Name":"airsusie","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.3.185.205","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78597,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8fe0492db276cf087158b73ebd62aa3c","RawContent":"Nice! Our count is 60.  I did an early rsvp.","Attachments":[],"Id":1895363,"PostDate":1430835631,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Nice! Our count is 60.  I did an early rsvp.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Gian-Luigi & Susan September 13, 2015 Finest Resort <a data-ipb='nomediaparse' href='http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A'>http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A<\/a>","Email":"susanlaurelli@yahoo.com","IpAddress":"47.17.228.244","GroupId":40,"GroupName":"Jr. Member","JoinDate":1414858204,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-280946.jpg?_r=1470416051","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"SusanMarie813","Id":280946,"Name":"SusanMarie813","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"198.161.230.10","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78597,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"51fbc8d6a6730960249f22ca1ffb65cd","RawContent":"&lt;p&gt;Hi Everyone&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I got married at the Finest Playa Mujeres on April 24 - it was perfect!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;A couple of tips :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;If you are getting married on the beach request the side of the beach by the stone gazebo, if you are getting married on the beach between the Excellence and Finest you will probably find a lot of beach goers standing around in their bathing suits watching (and ending up in the photos). There is no resort on the left side of Finest so that area is more quiet and will be more private.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Request the Sky Bar for your reception - it is beautiful!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;The flowers are pricey but are beyond anything that I would have imagined!! Worth every penny - so beautiful!!\n\n&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Do not use the hotels wedding photographer - spend the money and hire one from outside the resort (you do have to pay $500 as an outside vendor fee, but these are photos you will look at forever so you should definitely want the quality). I hired Sascha Gluck - he is AMAZING (check him out on facebook or google - he is worth hiring!!)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;The food is very good. Service is great.&lt;\/p&gt;\n&lt;p&gt;DJ is fantastic. There were some complaints that they shut us down at 11pm but I was fine with that. Be aware that this is not a \"party\" resort, if your guests want to party they will have to go into Cancun as all the bars at the resort shut down by 1am. We had no issues with this.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;\n&lt;\/p&gt;","Attachments":[],"Id":1895560,"PostDate":1430944396,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi Everyone<\/p>\n<p>\u00a0<\/p>\n<p>I got married at the Finest Playa Mujeres on April 24 - it was perfect!!<\/p>\n<p>\u00a0<\/p>\n<p>A couple of tips <img src='https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>If you are getting married on the beach request the side of the beach by the stone gazebo, if you are getting married on the beach between the Excellence and Finest you will probably find a lot of beach goers standing around in their bathing suits watching (and ending up in the photos). There is no resort on the left side of Finest so that area is more quiet and will be more private.<\/p>\n<p>\u00a0<\/p>\n<p>Request the Sky Bar for your reception - it is beautiful!!<\/p>\n<p>\u00a0<\/p>\n<p>The flowers are pricey but are beyond anything that I would have imagined!! Worth every penny - so beautiful!!<br>\n\u00a0<\/p>\n<p>Do not use the hotels wedding photographer - spend the money and hire one from outside the resort (you do have to pay $500 as an outside vendor fee, but these are photos you will look at forever so you should definitely want the quality). I hired Sascha Gluck - he is AMAZING (check him out on facebook or google - he is worth hiring!!)<\/p>\n<p>\u00a0<\/p>\n<p>The food is very good. Service is great.<\/p>\n<p>DJ is fantastic. There were some complaints that they shut us down at 11pm but I was fine with that. Be aware that this is not a \"party\" resort, if your guests want to party they will have to go into Cancun as all the bars at the resort shut down by 1am. We had no issues with this.<\/p>\n<p>\u00a0<\/p>\n<p>\n<a class='resized_img' rel='lightbox[1895560]' id='ipb-attach-url-' href=\"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/monthly_05_2015\/post-280995-0-46077800-1430944181.jpg\" title=\"IMG_4426.JPG -  70.84KB\"><img itemprop=\"image\" src=\"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/monthly_05_2015\/post-280995-0-46077800-1430944181.jpg\" class='bbc_img linked-image' alt=\"IMG_4426.JPG\" \/><\/a>\n\n<a class='resized_img' rel='lightbox[1895560]' id='ipb-attach-url-' href=\"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/monthly_05_2015\/post-280995-0-41573700-1430944190.jpg\" title=\"IMG_4425.JPG -  107.45KB\"><img itemprop=\"image\" src=\"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/monthly_05_2015\/post-280995-0-41573700-1430944190.jpg\" class='bbc_img linked-image' alt=\"IMG_4425.JPG\" \/><\/a>\n\n<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jeaninealvarez@hotmail.com","IpAddress":"198.161.230.10","GroupId":39,"GroupName":"Newbie","JoinDate":1415136920,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-280995.jpg?_r=1430944627","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"jeaninealvarez","Id":280995,"Name":"jeaninealvarez","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"162.255.221.24","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78597,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2df09ff8983e2699910ed01d48c3314d","RawContent":"Hi everyone,\n\n\nI am so delighted to find this board; will be the Finest bride in November ! Woohoo \n\nwe just started planning and gathered some questions to ask the wedding coordinator. We received the latest wedding information booklet and there are lots of questions to ask and so far you ladies have answered lots of them! \n\n\nLooking forward to hear more updates from you guys.","Attachments":[],"Id":1895581,"PostDate":1430961460,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi everyone,<br><br>\nI am so delighted to find this board; will be the Finest bride in November ! Woohoo <br>\nwe just started planning and gathered some questions to ask the wedding coordinator. We received the latest wedding information booklet and there are lots of questions to ask and so far you ladies have answered lots of them! <br><br>\nLooking forward to hear more updates from you guys.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"gao.alice.ting@gmail.com","IpAddress":"162.255.221.24","GroupId":39,"GroupName":"Newbie","JoinDate":1430790917,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-282978.jpg?_r=1430792312","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Alicecc2015","Id":282978,"Name":"Alicecc2015","IsOnline":false}}],"Pages":{"TotalItems":487,"TotalPages":49,"CurrentPage":50,"NextPage":60,"PreviousPage":40,"LastPage":480},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
