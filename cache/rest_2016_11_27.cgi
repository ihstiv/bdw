d":280946,"Name":"SusanMarie813","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"170.200.168.13","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78597,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"37806217723b3d7fb6ef276e813061ff","RawContent":"&lt;p&gt;@[member=\"airsusie\"] did you go to the hotel yet?&lt;\/p&gt;","Attachments":[],"Id":1890610,"PostDate":1427215214,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"280976\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='https:\/\/www.bestdestinationwedding.com\/user\/280976-airsusie\/' title='Member profile'><span itemprop=\"name\">airsusie<\/span><\/a> did you go to the hotel yet?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Gian-Luigi & Susan September 13, 2015 Finest Resort <a data-ipb='nomediaparse' href='http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A'>http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A<\/a>","Email":"susanlaurelli@yahoo.com","IpAddress":"47.17.228.244","GroupId":40,"GroupName":"Jr. Member","JoinDate":1414858204,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-280946.jpg?_r=1470416051","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"SusanMarie813","Id":280946,"Name":"SusanMarie813","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"187.153.194.205","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78597,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0feb58fd33ccda86510ed1e7203e1c6d","RawContent":"@[member=\"SusanMarie813\"] am here now! It&#039;s really great and will post pix when I&#039;m back. The resort and venues are all beautiful. We&#039;ve made most of our decisions and can&#039;t wait to come back in two months!","Attachments":[],"Id":1890749,"PostDate":1427302525,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"280946\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='https:\/\/www.bestdestinationwedding.com\/user\/280946-susanmarie813\/' title='Member profile'><span itemprop=\"name\">SusanMarie813<\/span><\/a> am here now! It's really great and will post pix when I'm back. The resort and venues are all beautiful. We've made most of our decisions and can't wait to come back in two months!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"susieylee@hotmail.com","IpAddress":"173.166.154.81","GroupId":39,"GroupName":"Newbie","JoinDate":1415028059,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-280976.jpg?_r=1424642440","PhotoWidth":200,"PhotoHeight":230,"PhotoType":"custom"},"FormattedName":"airsusie","Id":280976,"Name":"airsusie","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"107.77.76.93","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78597,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4658b38a809f95550654bcc0a650bf4e","RawContent":"GREAT!","Attachments":[],"Id":1890750,"PostDate":1427302786,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                GREAT!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Gian-Luigi & Susan September 13, 2015 Finest Resort <a data-ipb='nomediaparse' href='http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A'>http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A<\/a>","Email":"susanlaurelli@yahoo.com","IpAddress":"47.17.228.244","GroupId":40,"GroupName":"Jr. Member","JoinDate":1414858204,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-280946.jpg?_r=1470416051","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"SusanMarie813","Id":280946,"Name":"SusanMarie813","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"76.111.92.73","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78597,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"75c67bc4210c0d43186643eb92e72c7a","RawContent":"&lt;p&gt;hi everyone - we just got back from a four night planning trip at the finest yesterday. &amp;nbsp;it was great ... the resort is beautiful. &amp;nbsp;we didn&#039;t want to leave! the food was good. &amp;nbsp;the service was fantastic. &amp;nbsp;we spent an entire afternoon w\/ teresa doing a tasting and going over all our options. &amp;nbsp;she is wonderful. &amp;nbsp;we also met with the tour group operator who was helpful. &amp;nbsp;i would upload the pix, but there are a lot of files, so here&#039;s a &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/picasaweb.google.com\/106000194200672006868\/FinestPlayaMujeresMarch2015?authuser=0&amp;amp;authkey=Gv1sRgCMCn08W-vZXssQE&amp;amp;feat=directlink&#039;&gt;picasa album&lt;\/a&gt; w\/ captions explaining the various venue sites. feel free to download the images for yourself. &amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;most of the pix are of outside venues. &amp;nbsp;teresa told us that the only inside venue for now is lizo. &amp;nbsp;las dunas is covered so you can still do cocktail\/reception there if it rains. &amp;nbsp;our group booking deadline has passed and we will be closer to 80 (gulp!), so it&#039;s too big a group to do sky bar (although we are planning to do our welcome cocktail hour here on thurs). &amp;nbsp;sky bar is definitely a beautiful space. &amp;nbsp;we&#039;ll do ceremony on the beach, cocktail at las dunas, and dinner on the beach outside of las dunas. &amp;nbsp;lizo is going to be our rain backup for the ceremony and reception. what i really liked about the wedding gazebo and beach areas is that they are fairly private, especially once the sun goes down. &amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;i also got a hair\/makeup trial. &amp;nbsp;the hair was fine and i will go with the spa for that. &amp;nbsp;i wasn&#039;t crazy about makeup, but she really tried. &amp;nbsp;i had to keep asking her to make little corrections, but i know it&#039;s difficult to do makeup on asian features if you&#039;re not famiiar with them. &amp;nbsp;i knew this was likely to be the case, so i&#039;m asking a good friend to do my makeup instead. &amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;the restaurants were good - very solid for an all inclusive. &amp;nbsp;we didn&#039;t try all the restaurants, but obviously liked some better than others. &amp;nbsp;the wedding food was all very good too. the design and layout are just really nice and well done and thought out. &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1890945,"PostDate":1427415464,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>hi everyone - we just got back from a four night planning trip at the finest yesterday. \u00a0it was great ... the resort is beautiful. \u00a0we didn't want to leave! the food was good. \u00a0the service was fantastic. \u00a0we spent an entire afternoon w\/ teresa doing a tasting and going over all our options. \u00a0she is wonderful. \u00a0we also met with the tour group operator who was helpful. \u00a0i would upload the pix, but there are a lot of files, so here's a <a href='https:\/\/picasaweb.google.com\/106000194200672006868\/FinestPlayaMujeresMarch2015?authuser=0&authkey=Gv1sRgCMCn08W-vZXssQE&feat=directlink' class='bbc_url' title='External link' rel='nofollow external'>picasa album<\/a> w\/ captions explaining the various venue sites. feel free to download the images for yourself. \u00a0<\/p>\n<p>\u00a0<\/p>\n<p>most of the pix are of outside venues. \u00a0teresa told us that the only inside venue for now is lizo. \u00a0las dunas is covered so you can still do cocktail\/reception there if it rains. \u00a0our group booking deadline has passed and we will be closer to 80 (gulp!), so it's too big a group to do sky bar (although we are planning to do our welcome cocktail hour here on thurs). \u00a0sky bar is definitely a beautiful space. \u00a0we'll do ceremony on the beach, cocktail at las dunas, and dinner on the beach outside of las dunas. \u00a0lizo is going to be our rain backup for the ceremony and reception. what i really liked about the wedding gazebo and beach areas is that they are fairly private, especially once the sun goes down. \u00a0<\/p>\n<p>\u00a0<\/p>\n<p>i also got a hair\/makeup trial. \u00a0the hair was fine and i will go with the spa for that. \u00a0i wasn't crazy about makeup, but she really tried. \u00a0i had to keep asking her to make little corrections, but i know it's difficult to do makeup on asian features if you're not famiiar with them. \u00a0i knew this was likely to be the case, so i'm asking a good friend to do my makeup instead. \u00a0<\/p>\n<p>\u00a0<\/p>\n<p>the restaurants were good - very solid for an all inclusive. \u00a0we didn't try all the restaurants, but obviously liked some better than others. \u00a0the wedding food was all very good too. the design and layout are just really nice and well done and thought out. \u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"susieylee@hotmail.com","IpAddress":"173.166.154.81","GroupId":39,"GroupName":"Newbie","JoinDate":1415028059,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-280976.jpg?_r=1424642440","PhotoWidth":200,"PhotoHeight":230,"PhotoType":"custom"},"FormattedName":"airsusie","Id":280976,"Name":"airsusie","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"166.137.252.47","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78597,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"eea05a3b6db5f749288da2edfe75ef56","RawContent":"Great review.  :)","Attachments":[],"Id":1890946,"PostDate":1427415603,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Great review.  <img src='https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Gian-Luigi & Susan September 13, 2015 Finest Resort <a data-ipb='nomediaparse' href='http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A'>http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A<\/a>","Email":"susanlaurelli@yahoo.com","IpAddress":"47.17.228.244","GroupId":40,"GroupName":"Jr. Member","JoinDate":1414858204,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-280946.jpg?_r=1470416051","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"SusanMarie813","Id":280946,"Name":"SusanMarie813","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"76.111.92.73","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78597,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"9c8555c9527b042513d66472239f2420","RawContent":"&lt;p&gt;just went back and read the posts to see if there was anything i forgot. &amp;nbsp;someone (i think @amandapanda) was asking about rehearsal dinner venues. &amp;nbsp;teresa said you could do this at any of the restaurants. &amp;nbsp;i think they charge you per person. &amp;nbsp;my fiance and i discussed at length and actually decided not to do a rehearsal\/welcome dinner and use that money toward a 4 hour welcome snorkeling\/sunset cruise (through seasons tour) and have them back on the resort in time for dinner instead. that way the guests get something \"extra\" and can still take advantage of the many restaurants that are included anyway. &amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;also, i will say about the beach is that the water is beautiful and turquoise (maybe not as much as further south in places like tulum, but still beautiful). &amp;nbsp;however, there are a lot of little sticks and pebbles in the sand. &amp;nbsp;it&#039;s not super smooth, fine sand. &amp;nbsp;in a way, it&#039;s nicer because the beach is rustic and more natural looking w\/ shrubs etc, but just a heads up in case it was something you had your heart set on. &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1890948,"PostDate":1427416202,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>just went back and read the posts to see if there was anything i forgot. \u00a0someone (i think @amandapanda) was asking about rehearsal dinner venues. \u00a0teresa said you could do this at any of the restaurants. \u00a0i think they charge you per person. \u00a0my fiance and i discussed at length and actually decided not to do a rehearsal\/welcome dinner and use that money toward a 4 hour welcome snorkeling\/sunset cruise (through seasons tour) and have them back on the resort in time for dinner instead. that way the guests get something \"extra\" and can still take advantage of the many restaurants that are included anyway. \u00a0<\/p>\n<p>\u00a0<\/p>\n<p>also, i will say about the beach is that the water is beautiful and turquoise (maybe not as much as further south in places like tulum, but still beautiful). \u00a0however, there are a lot of little sticks and pebbles in the sand. \u00a0it's not super smooth, fine sand. \u00a0in a way, it's nicer because the beach is rustic and more natural looking w\/ shrubs etc, but just a heads up in case it was something you had your heart set on. \u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"susieylee@hotmail.com","IpAddress":"173.166.154.81","GroupId":39,"GroupName":"Newbie","JoinDate":1415028059,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-280976.jpg?_r=1424642440","PhotoWidth":200,"PhotoHeight":230,"PhotoType":"custom"},"FormattedName":"airsusie","Id":280976,"Name":"airsusie","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"107.77.100.86","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78597,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b51371ee34d4ff15e19fb42343ca5965","RawContent":"Hi everyone! It&#039;s been quite on this board lately! I&#039;m still looking at options for our wedding and I think I&#039;m gotten the decorations and flowers down however I am having a hard time deciding on what type of entertainment to pick for the rehearsal dinner and the wedding! Any recommendation? Has anyone had any contact or experience with the band or the DJ that is offered through the resort?","Attachments":[],"Id":1893191,"PostDate":1429107327,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi everyone! It's been quite on this board lately! I'm still looking at options for our wedding and I think I'm gotten the decorations and flowers down however I am having a hard time deciding on what type of entertainment to pick for the rehearsal dinner and the wedding! Any recommendation? Has anyone had any contact or experience with the band or the DJ that is offered through the resort?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"nilou.ebrahimi@gmail.com","IpAddress":"73.183.176.208","GroupId":39,"GroupName":"Newbie","JoinDate":1424015726,"Photo":{"HasPhoto":false,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"NE112015","Id":282124,"Name":"NE112015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.3.185.205","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78597,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0cd01b9fa3dee0eb9b030ae4e7490a65","RawContent":"We are going with DJ Mannia for the reception, the music trio for cocktail, and a sound system for our welcome party.  Trying to decide if I want to do a violin for the ceremony.  My friend just did it in the Bahamas and it was lovely.  \nDecorations and flowers what are you doing?","Attachments":[],"Id":1893193,"PostDate":1429108276,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We are going with DJ Mannia for the reception, the music trio for cocktail, and a sound system for our welcome party.  Trying to decide if I want to do a violin for the ceremony.  My friend just did it in the Bahamas and it was lovely.  <br \/>Decorations and flowers what are you doing? \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Gian-Luigi & Susan September 13, 2015 Finest Resort <a data-ipb='nomediaparse' href='http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A'>http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A<\/a>","Email":"susanlaurelli@yahoo.com","IpAddress":"47.17.228.244","GroupId":40,"GroupName":"Jr. Member","JoinDate":1414858204,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-280946.jpg?_r=1470416051","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"SusanMarie813","Id":280946,"Name":"SusanMarie813","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"107.77.100.86","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78597,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7e893dd1e4cebd471c143fc278627dc6","RawContent":"@[member=\"SusanMarie813\"] we are planning on having our reception on the sky bar deck and I am going to do Tiffany chairs and gold chargers and flower centerpiece (PC09 and PC29 from the resort catalogue). Also I am going to ask to add some string light bulbs over the dance floor. I wanted to do little tequila bottles as my escort cards however found out they are $11 per Blt  based on the pricing from the company The resort works with. That&#039;s a little expensive since I am already doing welcome bags that&#039;s taking a big chunk of my budget. So I am going to have to find a different option. Do you mind sharing the price for the DJ and what&#039;s included? Are they the same ones working with the resort or is a vendor you are bringing in? I&#039;m already bringing in my own photographer that I have to pay vendor fee for","Attachments":[],"Id":1893201,"PostDate":1429110193,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"280946\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='https:\/\/www.bestdestinationwedding.com\/user\/280946-susanmarie813\/' title='Member profile'><span itemprop=\"name\">SusanMarie813<\/span><\/a> we are planning on having our reception on the sky bar deck and I am going to do Tiffany chairs and gold chargers and flower centerpiece (PC09 and PC29 from the resort catalogue). Also I am going to ask to add some string light bulbs over the dance floor. I wanted to do little tequila bottles as my escort cards however found out they are $11 per Blt  based on the pricing from the company The resort works with. That's a little expensive since I am already doing welcome bags that's taking a big chunk of my budget. So I am going to have to find a different option. Do you mind sharing the price for the DJ and what's included? Are they the same ones working with the resort or is a vendor you are bringing in? I'm already bringing in my own photographer that I have to pay vendor fee for \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"nilou.ebrahimi@gmail.com","IpAddress":"73.183.176.208","GroupId":39,"GroupName":"Newbie","JoinDate":1424015726,"Photo":{"HasPhoto":false,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"NE112015","Id":282124,"Name":"NE112015","IsOnline":false}}],"Pages":{"TotalItems":487,"TotalPages":49,"CurrentPage":40,"NextPage":50,"PreviousPage":30,"LastPage":480},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
